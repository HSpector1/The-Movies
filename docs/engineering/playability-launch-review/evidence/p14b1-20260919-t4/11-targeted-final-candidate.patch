+    })
+  })
+})
+
+// The recovered engine's natural rival chain authors its own actor promises,
+// binds them at expiry, then films. Search the actual receipts for a take shared
+// by multiple beneficiaries; never manufacture an outcome or guess an event ID.
+let sharedCache: { state: GameState; promises: ProfessionalPromise[] } | undefined
+function sharedTakeOutcomes(): { state: GameState; promises: ProfessionalPromise[] } {
+  if (sharedCache !== undefined) return sharedCache
+  let state = p13aGeneratedStudio()
+  for (let week = 0; week <= 230; week++) {
+    const groups = new Map<string, ProfessionalPromise[]>()
+    for (const promise of state.promises) {
+      if (promise.outcome !== 'SATISFIED') continue
+      for (const eventId of promise.evidenceRefs) groups.set(eventId, [...(groups.get(eventId) ?? []), promise])
+    }
+    const shared = [...groups.values()].find((promises) => new Set(promises.map((p) => p.beneficiaryPersonId)).size >= 2)
+    if (shared !== undefined) {
+      sharedCache = { state, promises: shared }
+      return sharedCache
+    }
+    state = tick(state)
+  }
+  throw new Error('fixture: no multi-beneficiary promise outcome from a shared real take within 230 weeks')
+}
+
+describe('P14B.1 T4: terminal V29 promise reference integrity', () => {
+  it('round-trips several beneficiaries sharing one real take and distinct own outcome receipts', () => {
+    const { state, promises } = sharedTakeOutcomes()
+    expect(new Set(promises.map((p) => p.beneficiaryPersonId)).size).toBeGreaterThanOrEqual(2)
+    expect(new Set(promises.map((p) => p.outcomeEventId)).size).toBe(promises.length)
+    const shared = state.firstTakes.find((take) => promises.every((p) => p.evidenceRefs.includes(take.eventId)))!
+    expect(shared).toBeDefined()
+    for (const promise of promises) {
+      const employment = state.hollywood!.employment.find((e) => e.contractId === promise.contractId)!
+      expect(employment.terms.talentId).toBe(promise.beneficiaryPersonId)
+      expect(employment.studioId).toBe(promise.issuerStudioId)
+      expect(shared.studioId).toBe(promise.issuerStudioId)
+      expect(Object.values(shared.cast)).toContain(promise.beneficiaryPersonId)
+      const outcome = state.talentMarket.receipts.find((r) => r.eventId === promise.outcomeEventId)!
+      expect(outcome.kind).toBe('promiseOutcome')
+      expect(outcome.talentId).toBe(promise.beneficiaryPersonId)
+      expect(outcome.studioId).toBe(promise.issuerStudioId)
+      expect(outcome.week).toBe(promise.outcomeWeek)
+    }
+    const json = JSON.stringify(envelope(state))
+    expect(JSON.stringify(validateSaveV29(JSON.parse(json)))).toBe(json)
+  }, 120_000)
+
+  it.each(['missing', 'null', 'unknown', 'wrong receipt kind', 'another beneficiary', 'wrong outcome week'])('rejects %s outcome receipt references', (fault) => {
+    const { state, promises } = sharedTakeOutcomes()
+    const target = promises[0]!
+    rejects(state, (raw) => {
+      const row = raw.state.promises.find((p) => p.promiseId === target.promiseId)!
+      if (fault === 'missing') delete row.outcomeEventId
+      else if (fault === 'null') row.outcomeEventId = null
+      else if (fault === 'unknown') row.outcomeEventId = 'missing-market-event'
+      else if (fault === 'wrong receipt kind') row.outcomeEventId = state.talentMarket.receipts.find((r) => r.kind !== 'promiseOutcome')!.eventId
+      else if (fault === 'wrong outcome week') row.outcomeWeek = target.outcomeWeek! - 1
+      else {
+        // Swap two valid IDs so a uniqueness-only check cannot catch the fault.
+        const sibling = raw.state.promises.find((p) => p.promiseId === promises[1]!.promiseId)!
+        row.outcomeEventId = promises[1]!.outcomeEventId
+        sibling.outcomeEventId = target.outcomeEventId
+      }
+    })
+  })
+
+  it.each(['missing take', 'non-take receipt', 'wrong studio or cast', 'empty', 'duplicate', 'outside window', 'wrong progress', 'unbound outcome'])('rejects %s qualifying evidence', (fault) => {
+    const { state, promises } = sharedTakeOutcomes()
+    const target = promises[0]!
+    rejects(state, (raw) => {
+      const row = raw.state.promises.find((p) => p.promiseId === target.promiseId)!
+      if (fault === 'missing take') row.evidenceRefs = ['missing-first-take']
+      else if (fault === 'non-take receipt') row.evidenceRefs = [target.outcomeEventId]
+      else if (fault === 'wrong studio or cast') {
+        const unrelated = state.firstTakes.find((t) => t.studioId !== target.issuerStudioId
+          || !Object.values(t.cast).includes(target.beneficiaryPersonId))!
+        expect(unrelated).toBeDefined()
+        row.evidenceRefs = [unrelated.eventId]
+      } else if (fault === 'empty') row.evidenceRefs = []
+      else if (fault === 'duplicate') row.evidenceRefs = [target.evidenceRefs[0], target.evidenceRefs[0]]
+      else if (fault === 'outside window') row.windowStartWeek = target.outcomeWeek! + 1
+      else if (fault === 'wrong progress') row.progress = 0
+      else row.contractId = null
+    })
+  })
+})
