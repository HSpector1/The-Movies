+    expect(state.promises.filter((p) => p.beneficiaryPersonId === talentId)).toEqual([])
+    validateSaveV29(JSON.parse(JSON.stringify(makeSave(state))))
+    cached = { state, talentId }
+  }
+  return structuredClone(cached)
