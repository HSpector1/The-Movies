+// Five primitive-string-cache groups; all original28 groups above remain byte-exact.
+const cacheEncoders=[referenceEncoder.boundedJson,candidate.boundedJson]
+function cacheTrace(make,makeLimit,pattern){
+  const logs=[],outputs=[]
+  for(const encoder of cacheEncoders){const log=[];logs.push(log);const value=make(log),limit=makeLimit(log);if(pattern)assert.throws(()=>encoder(value,limit),pattern);else outputs.push(encoder(value,limit))}
+  assert.deepEqual(logs[1],logs[0]);if(!pattern)assert.deepEqual(outputs[1],outputs[0])
+}
+test('primitive cache repeated strings escaping surrogates and chunk seams',()=>{
+  for(const s of ['', 'ascii', 'quote"slash\\', '\n\r\t\b\f', 'é', '😀', '\ud800', '\udfff']){
+    const value=[s,s,{first:s,second:[s,s]}],raw=chunkEqual(value);chunkEqual(value,raw.length);chunkRefusal(()=>value,/STOP_(JSON|STRING)_CAP/,raw.length-1)
+  }
+  for(const s of ['same','é😀\n','\ud800'])chunkEqual(Array(4200).fill(s))
+})
+test('primitive cache hit raw and aggregate caps preserve coercion and source traces',()=>{
+  const make=log=>new Proxy(['same','same'],{get(t,k,r){log.push('get:'+String(k));return Reflect.get(t,k,r)}})
+  // [ add, first raw, first token add, comma add, second raw, second token add, ] add.
+  cacheTrace(make,log=>{let n=0;return {valueOf(){log.push('limit:'+ ++n);return n===5?3:100}}},/STOP_STRING_CAP/)
+  cacheTrace(make,log=>{let n=0;return {valueOf(){log.push('limit:'+ ++n);return n===6?10:100}}},/STOP_JSON_CAP/)
+  for(const fail of [()=>NaN,()=>Symbol('limit'),()=>{throw Error('LIMIT_HIT_THROW')}])cacheTrace(make,log=>{let n=0;return {valueOf(){log.push('limit:'+ ++n);return n===5?fail():100}}},/STOP_STRING_CAP|TypeError|LIMIT_HIT_THROW/)
+  cacheTrace(make,log=>({valueOf(){log.push('limit');return 100}}))
+})
+test('primitive cache key value interactions retain existing key-cache chronology',()=>{
+  for(const s of ['é😀\n','\ud800']){
+    const valueFirst=[s,{[s]:s},{[s]:s}],keyFirst=[{[s]:s},s,{[s]:s}]
