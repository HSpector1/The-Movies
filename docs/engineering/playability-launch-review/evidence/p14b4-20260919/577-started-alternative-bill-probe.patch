+// ── world(): enumerator test :66-198 verbatim copy ──────────────────────────────────────────
+type World = { opened: GameState; unscheduled: GameState; ready: GameState; actors: Record<CastSlot, string>
+  ids: Record<CastSlot, string>; productionId: string; projects: readonly string[]; directorId: string; craftId: string
+  writerId: string; start: number }
+const live = (state: GameState): GameState => makeSave(state).state
+function root(state: GameState, id: string): ProfessionalPromise {
+  const rows = state.promises.filter((p) => p.promiseId === id)
+  expect(rows).toHaveLength(1)
+  return rows[0]!
+}
+function currentRoot(state: GameState, personId: string): ProfessionalPromise {
+  const proposal = currentProposals(state, personId).find((p) => p.issuerStudioId === player(state))
+  assert.ok(proposal)
+  expect(proposal.promises).toHaveLength(1)
+  return root(state, proposal.promises[0]!)
+}
+function sign(state: GameState, role: 'actor' | 'writer' | 'director' | 'craft', termWeeks: number) {
+  for (let steps = 0; steps < 60; steps++) {
+    const person = hiringMarketIds(state, state.market.tick).map((id) => state.talent.find((p) => p.id === id))
+      .find((p) => p?.role === role)
+    if (person !== undefined) return { state: applyActions(state, [{ kind: 'signContract', talentId: person.id, termWeeks }]), id: person.id }
+    state = tick(state)
+  }
+  throw new Error('UNEXECUTED fixture: no lawful hireable ' + role + ' within60 ticks')
+}
+const commissionPayload = (state: GameState, writerId: string, conceptId: string) => {
+  const concept = state.concepts.find((c) => c.id === conceptId)!
+  return { conceptId, writerId, shape: { opening: 'slowSetup' as const, midpoint: 'revelation' as const, ending: 'bittersweet' as const },
+    promise: { genre: concept.genre, intendedSegments: ['adult' as const], ranges: {
+      intimacy: [-0.5, 0.5] as [number, number], tonalWeight: [-0.5, 0.5] as [number, number], kineticEnergy: [-0.5, 0.5] as [number, number] } } }
+}
+function readyScript(state: GameState, writerId: string, conceptId: string) {
+  const oldIds = new Set(state.scriptDevelopment.projects.map((p) => p.id))
+  state = applyActions(state, [{ kind: 'commissionScript', project: commissionPayload(state, writerId, conceptId) }])
+  const minted = state.scriptDevelopment.projects.filter((p) => !oldIds.has(p.id))
+  expect(minted).toHaveLength(1)
+  const projectId = minted[0]!.id
+  for (let steps = 0; state.scriptDevelopment.projects.find((p) => p.id === projectId)!.status !== 'review'; steps++) {
+    if (steps >= 20) throw new Error('UNEXECUTED fixture: actual screenplay never reached Review within20 ticks')
+    state = tick(state)
+  }
+  state = applyActions(state, [{ kind: 'acceptScript', projectId }])
+  expect(state.scriptDevelopment.projects.find((p) => p.id === projectId)).toMatchObject({ status: 'ready', productionId: null })
+  return { state, projectId }
+}
+let cached: World | undefined
+function world(): World {
+  if (cached !== undefined) return structuredClone(cached)
+  let state = fund(p13aGeneratedStudio())
+  const lead = sign(state, 'actor', 52); state = lead.state
+  const antagonist = sign(state, 'actor', 52); state = antagonist.state
+  const support = sign(state, 'actor', 52); state = support.state
+  const writer = sign(state, 'writer', 208); state = writer.state
+  const director = sign(state, 'director', 208); state = director.state
+  const craft = sign(state, 'craft', 208); state = craft.state
+  const actors = { lead: lead.id, antagonist: antagonist.id, support: support.id }
+  const starts = Object.values(actors).map((id) => state.contracts.find((c) => c.talentId === id)!.endWeekExclusive)
+  expect(new Set(starts).size).toBe(1)
+  const start = starts[0]!
+  expect(state.studio.activeProductions).toEqual([])
+  expect(state.operations.mode).toBe('managed')
+  if (state.scriptDevelopment.mode === 'legacy') state = applyActions(state, [{ kind: 'activateScriptDevelopment' }])
+  expect(state.scriptDevelopment.projects).toEqual([])
+  const concepts = state.concepts.slice(0, 2)
+  const first = readyScript(state, writer.id, concepts[0]!.id); state = first.state
+  const second = readyScript(state, writer.id, concepts[1]!.id); state = second.state
+  const stage = 'facility-soundstage-07'
+  const mounted = state.sets.find((s) => s.mountedOn === stage && s.status !== 'retired')
+  if (mounted !== undefined) state = applyActions(state, [{ kind: 'strikeSet', setId: mounted.id }])
+  state = applyActions(state, [{ kind: 'commissionSet', commission: { blueprintId: 'set-grand-ballroom', stageFacilityId: stage } }])
+  state = advanceTo(state, state.market.tick + TUNING.SET_BUILD_WEEKS_BAND_HIGH)
+  expect(state.market.tick).toBeLessThanOrEqual(start - 7)
+  state = advanceTo(state, start - 7)
+  for (const id of Object.values(actors)) {
+    state = submitProposal(state, { talentId: id, issuerStudioId: player(state), termWeeks: 52, premiumTier: 1.25 })
+  }
+  const opened = structuredClone(state)
+  const ids: Record<CastSlot, string> = { lead: '', antagonist: '', support: '' }
+  for (const slot of SLOTS) {
+    state = attachPromise(state, actors[slot], player(state), { ...p1(), windowStartWeek: start, dueWeekExclusive: start + 52 })
+    const promised = currentRoot(state, actors[slot])
+    expect(promised.feasibilityReceipt.classification).toBe('REASONABLY_ACHIEVABLE')
+    ids[slot] = promised.promiseId
+  }
+  state = advanceTo(state, start)
+  for (const slot of SLOTS) {
+    const promised = root(state, ids[slot])
+    expect(promised).toMatchObject({ outcome: null, progress: 0, evidenceRefs: [] })
+    assert.notEqual(promised.contractId, null)
+    expect(currentProposals(state, actors[slot])).toEqual([])
+  }
+  state = applyActions(state, [{ kind: 'greenlightScriptProject', production: {
+    projectId: first.projectId, directorId: director.id, craftIds: [craft.id], cast: actors,
+    budget: { negative: concepts[0]!.baseNegativeCost, marketing: 0 },
+  } }])
+  const film = state.studio.activeProductions.at(-1)
+  assert.ok(film, 'UNEXECUTED fixture: greenlight was not actually admitted')
+  state = tick(tick(tick(state)))
+  const rehearsal = state.operations.workflows.find((w) => w.productionId === film.id)
+  assert.ok(rehearsal)
+  expect(rehearsal.phase).toBe('rehearsal')
+  state = applyActions(state, [{ kind: 'setProductionSetupRecipe', productionId: film.id,
+    recipeId: 'ballroom-reveal-lighting-01', expectedPlanRevision: rehearsal.planRevision }])
+  for (let steps = 0; state.studio.activeProductions.find((p) => p.id === film.id)!.remainingTicks !== 5; steps++) {
+    if (steps >= 40) throw new Error('UNEXECUTED fixture: actual managed film never reached first Shooting week within40 ticks')
+    state = tick(state)
+  }
+  state = applyActions(state, [{ kind: 'assignShootingDirector', productionId: film.id, directorId: director.id }])
+  for (let steps = 0; state.operations.workflows.find((w) => w.productionId === film.id)!.shootingTask?.status !== 'ready'; steps++) {
+    if (steps >= 6) throw new Error('UNEXECUTED fixture: physical scenery did not arrive within6 actual ticks; no manual bypass')
+    state = tick(state)
+  }
+  // E5: the REAL state immediately before scheduleShootingTake (capacity test :172); status 'ready' fails condition (b).
+  const unscheduled = structuredClone(state)
+  expect(unscheduled.operations.workflows.find((w) => w.productionId === film.id)).toMatchObject({
+    phase: 'shooting', blocker: null, shootingTask: { status: 'ready' } })
+  state = applyActions(state, [{ kind: 'scheduleShootingTake', productionId: film.id }])
+  expect(state.operations.workflows.find((w) => w.productionId === film.id)).toMatchObject({
+    phase: 'shooting', blocker: null, shootingTask: { status: 'scheduled' } })
+  expect(state.firstTakes.filter((t) => t.productionId === film.id)).toEqual([])
+  cached = { opened: live(opened), unscheduled: live(unscheduled), ready: live(state), actors, ids, productionId: film.id,
+    projects: [first.projectId, second.projectId], directorId: director.id, craftId: craft.id, writerId: writer.id, start }
+  return structuredClone(cached)
+}
+// ── drafts and in-memory window variants: enumerator test :200-225 (twoWeekOn generalised to `weeks`) ──
+function rootDraft(state: GameState, id: string): PromiseDraft {
+  const promised = root(state, id)
+  return { family: promised.family, predicate: promised.predicate, issuerStudioId: promised.issuerStudioId,
+    beneficiaryPersonId: promised.beneficiaryPersonId, promiseId: promised.promiseId,
+    startWeek: promised.windowStartWeek, termWeeks: promised.dueWeekExclusive - promised.windowStartWeek,
+    windowStartWeek: promised.windowStartWeek, dueWeekExclusive: promised.dueWeekExclusive }
+}
+function variantsOn(base: GameState, w: World, patches: Partial<Record<CastSlot, Patch>>): GameState {
+  const changes = new Map<string, Patch>(SLOTS.flatMap((slot) => patches[slot] === undefined ? [] : [[w.ids[slot], patches[slot]!]]))
+  return { ...clone(base), promises: base.promises.map((p) => {
+    const chosen = changes.get(p.promiseId)
+    return chosen === undefined ? clone(p) : { ...clone(p), ...chosen }
+  }) }
+}
+function windowOn(w: World, base: GameState, material: Record<CastSlot, Material>, weeks: number): GameState {
+  const now = base.market.tick
+  return variantsOn(base, w, { lead: { ...material.lead, windowStartWeek: now, dueWeekExclusive: now + weeks },
+    antagonist: { ...material.antagonist, windowStartWeek: now, dueWeekExclusive: now + weeks },
+    support: { ...material.support, windowStartWeek: now, dueWeekExclusive: now + weeks } })
+}
+
+// ── the probe ───────────────────────────────────────────────────────────────────────────────
+const actorIds = (w: World): string[] => [...Object.values(w.actors)].sort()
+type Attempt = StartedOwnerReplayResult<Production>['attempts'][number]
+function summarize(attempt: Attempt) {
+  const provenanceTakeWeeks = attempt.provenance.filter((o) => o.kind === 'firstTake').map((o) => o.at.week)
+  if (attempt.kind === 'complete') {
+    const pictures = attempt.trace.paths.flatMap((p) => p.kind === 'jointTracePicture' ? [p] : [])
+    return { kind: 'complete' as const, traceKey: attempt.trace.traceKey,
+      firstTakeWeeks: pictures.map((p) => p.firstTake?.week ?? null), provenanceTakeWeeks,
+      projectionWeek: attempt.projection.week, additionalHolds: attempt.trace.additionalHolds.length,
+      provenanceRows: attempt.provenance.length, reason: null, detail: null, through: null }
+  }
+  return { kind: 'cut' as const, traceKey: attempt.traceKey, firstTakeWeeks: null, provenanceTakeWeeks,
+    projectionWeek: null, additionalHolds: null, provenanceRows: attempt.provenance.length,
+    reason: attempt.reason, detail: attempt.detail, through: attempt.through }
+}
+const plansAt = (productionId: string, weeks: readonly number[]): StartedProductionPlan[] => weeks.map((week) => ({
+  traceKey: `probe:w${week}`, commands: [{ week, ordinal: 0, productionId, kind: 'scheduleTake' as const }] }))
+const NONE: StartedProductionPlan = { traceKey: 'probe:none', commands: [] }
+function runStarted(w: World, state: GameState, plans: readonly StartedProductionPlan[], horizonEndWeek: number, work = CAP) {
+  const input: StartedOwnerReplayInput<Production> = { source: state, issuerId: player(state), claimPersonIds: actorIds(w),
+    plans, horizonEndWeek, preparationWork: 0, limits: { work, span: LIMITS.span, alternatives: LIMITS.alternatives } }
+  return replayStartedProductionPlans(input)
+}
+const emit = (row: Record<string, unknown>): void => { console.log('B4_BUDGET_576 ' + JSON.stringify(row)) }
+const work: Record<string, number> = {}
+function measure(w: World, scenario: string, state: GameState, plans: readonly StartedProductionPlan[], horizonEndWeek: number,
+  extra: Record<string, unknown> = {}): StartedOwnerReplayResult<Production> {
+  const now = state.market.tick
+  const result = runStarted(w, state, plans, horizonEndWeek)
+  work[scenario] = result.preparationWork
+  const complete = result.attempts.length === plans.length && result.attempts.every((a) => a.kind === 'complete')
+  emit({ scenario, fixture: FIXTURE, productionId: w.productionId, now, horizonEndWeek, k: plans.length,
+    planWeeks: plans.map((p) => p.commands.map((c) => c.week)).flat(), producerWork: result.preparationWork,
+    fitsCap: complete && result.omissions.length === 0, attempts: result.attempts.map(summarize),
+    producerOmissions: result.omissions, fixedHolds: result.fixedHolds.length, capRaised: null, ...extra })
+  return result
+}
+function capRaised(w: World, scenario: string, state: GameState, plans: readonly StartedProductionPlan[], horizonEndWeek: number, cap: number): void {
+  const base = { scenario, fixture: FIXTURE, productionId: w.productionId, now: state.market.tick, horizonEndWeek, k: plans.length,
+    planWeeks: plans.map((p) => p.commands.map((c) => c.week)).flat(), capRaised: cap }
+  try {
+    const result = runStarted(w, state, plans, horizonEndWeek, cap)
+    emit({ ...base, producerWork: result.preparationWork, attempts: result.attempts.map(summarize),
+      producerOmissions: result.omissions, fixedHolds: result.fixedHolds.length })
+  } catch (error) {
+    emit({ ...base, producerWork: null, attempts: null, producerOmissions: null, fixedHolds: null,
+      refused: error instanceof Error ? error.message : String(error) })
+  }
+}
+/** `complete` = every lawful scheduling week inside [now, now+weeks) has a plan (k === weeks); a pair is a partial set. */
+const fits: { weeks: number; k: number; planWeeks: number[]; complete: boolean }[] = []
+
+describe('576-M Started-alternative bill on world().unscheduled (measurement; numbers never asserted)', () => {
+  const w = world()
+  const state = w.unscheduled
+  const now = state.market.tick
+  it('fixture preconditions (the only assertions in this file)', () => {
+    assert.ok(Number.isSafeInteger(now) && now === w.ready.market.tick, 'UNCONSTRUCTIBLE: unscheduled/ready are not the same week')
+    assert.ok(state.hollywood !== null && player(state) === state.hollywood.playerStudioId, 'UNCONSTRUCTIBLE: no player studio')
+    const pictures = state.studio.activeProductions
+    assert.ok(pictures.length === 1 && pictures[0]!.id === w.productionId, 'UNCONSTRUCTIBLE: expected exactly the one started picture')
+    assert.ok(pictures[0]!.remainingTicks === 5 && pictures[0]!.startTick < now, 'UNCONSTRUCTIBLE: picture is not at its first Shooting week')
+    const workflow = state.operations.workflows.find((row) => row.productionId === w.productionId)
+    assert.ok(workflow !== undefined && workflow.phase === 'shooting' && workflow.blocker === null
+      && workflow.shootingTask?.status === 'ready', 'UNCONSTRUCTIBLE: workflow is not shooting/ready/blocker null')
+    assert.ok(state.firstTakes.every((t) => t.productionId !== w.productionId), 'UNCONSTRUCTIBLE: a first take is already recorded')
+    assert.ok(actorIds(w).length === 3, 'UNCONSTRUCTIBLE: three fixture actors expected')
+    emit({ scenario: 'S0-identity', fixture: FIXTURE, now, start: w.start, productionId: w.productionId, issuerId: player(state),
+      claimPersonIds: actorIds(w), startTick: pictures[0]!.startTick, remainingTicks: pictures[0]!.remainingTicks,
+      activeProductions: pictures.length, workflows: state.operations.workflows.length, firstTakes: state.firstTakes.length,
+      producerLimits: { work: CAP, span: LIMITS.span, alternatives: LIMITS.alternatives }, kernelLimits: LIMITS, preparationWork: 0 })
+  })
+  it('S1 prepare-only (plans: []) at horizons now+2 and now+5', () => {
+    measure(w, 'S1-prepare-h2', state, [], now + 2)
+    measure(w, 'S1-prepare-h5', state, [], now + 5)
+  })
+  it('S2 the no-command plan on the UNSCHEDULED picture at now+2 and now+5', () => {
+    measure(w, 'S2-none-h2', state, [NONE], now + 2)
+    measure(w, 'S2-none-h5', state, [NONE], now + 5)
+  })
+  it('S3 k=1: scheduleTake at now, horizons now+2 and now+5', () => {
+    measure(w, 'S3-k1-h2', state, plansAt(w.productionId, [now]), now + 2)
+    measure(w, 'S3-k1-h5', state, plansAt(w.productionId, [now]), now + 5)
+  })
+  /** k = 2..maxK plans scheduling at now..now+k-1 under horizon now+h; marginal per added plan; raised caps attempted ONCE at the
+   * first workLimit cut (source refuses them; the refusal is the evidence); then each alternative alone (its own bill, lawful cap). */
+  function sweep(h: number, maxK: number): void {
+    const horizon = now + h
+    let previous = work[`S3-k1-h${h}`] ?? measure(w, `S3-k1-h${h}`, state, plansAt(w.productionId, [now]), horizon).preparationWork
+    let raisedTried = false
+    for (let k = 2; k <= maxK; k++) {
+      const weeks = Array.from({ length: k }, (_, j) => now + j)
+      const plans = plansAt(w.productionId, weeks)
+      const result = measure(w, `S4-k${k}-h${h}`, state, plans, horizon)
+      emit({ scenario: `S4-k${k}-h${h}-marginal`, k, previousK: k - 1, previousWork: previous, producerWork: result.preparationWork,
+        marginal: result.preparationWork - previous, cutAtThisK: result.attempts.some((a) => a.kind === 'cut') })
+      previous = result.preparationWork
+      const complete = result.attempts.length === k && result.attempts.every((a) => a.kind === 'complete') && result.omissions.length === 0
+      if (complete) fits.push({ weeks: h, k, planWeeks: weeks, complete: k === h })
+      if (!raisedTried && result.attempts.some((a) => a.kind === 'cut' && a.reason === 'workLimit')) {
+        raisedTried = true
+        for (const cap of [400000, 800000]) capRaised(w, `S4-k${k}-h${h}-capRaised`, state, plans, horizon, cap)
+      }
+    }
+    for (let j = 1; j < maxK; j++) measure(w, `S4-single-w${j}-h${h}`, state, plansAt(w.productionId, [now + j]), horizon)
+  }
+  it('S4 k=2,3,4 at horizon now+5 (schedule at now..now+3), then the cheapest pair (now+2, now+3)', () => {
+    sweep(5, 4)
+    pair(5, [now + 2, now + 3])
+  })
+  /** A PARTIAL alternative set (cheapest pairs by the standalone rows); a certificate would need the complete lawful set. */
+  function pair(h: number, weeks: number[]): void {
+    const result = measure(w, `S4-pair-w${weeks.map((x) => x - now).join('w')}-h${h}`, state, plansAt(w.productionId, weeks), now + h)
+    if (result.attempts.length === weeks.length && result.attempts.every((a) => a.kind === 'complete') && result.omissions.length === 0) {
+      fits.push({ weeks: h, k: weeks.length, planWeeks: weeks, complete: false })
+    }
+  }
+  it('S4b (added, same question) horizons now+3 and now+4: every lawful k inside the window, then the cheapest pairs', () => {
+    sweep(3, 3)
+    sweep(4, 4)
+    pair(3, [now, now + 2]); pair(3, [now + 1, now + 2])
+    pair(4, [now + 1, now + 3]); pair(4, [now + 2, now + 3])
+  })
+  it('S5 horizon now+2: k=1 at now; the now+1 plan alone (take would land at now+2 = horizon); both together', () => {
+    const horizon = now + 2
+    measure(w, 'S5-k1-h2', state, plansAt(w.productionId, [now]), horizon)
+    measure(w, 'S5-single-w1-h2', state, plansAt(w.productionId, [now + 1]), horizon)
+    const result = measure(w, 'S5-k2-h2', state, plansAt(w.productionId, [now, now + 1]), horizon)
+    emit({ scenario: 'S5-k2-h2-marginal', k: 2, previousWork: work['S5-k1-h2'], producerWork: result.preparationWork,
+      marginal: result.preparationWork - work['S5-k1-h2']! })
+    if (result.attempts.length === 2 && result.attempts.every((a) => a.kind === 'complete') && result.omissions.length === 0) {
+      fits.push({ weeks: 2, k: 2, planWeeks: [now, now + 1], complete: true })
+    }
+    // The never-schedule trace is a lawful owner choice too; the complete set for [now, now+2) may need it.
+    const withNone = measure(w, 'S5-k3-h2-withNone', state, [...plansAt(w.productionId, [now, now + 1]), NONE], horizon)
+    emit({ scenario: 'S5-k3-h2-withNone-marginal', k: 3, previousWork: result.preparationWork, producerWork: withNone.preparationWork,
+      marginal: withNone.preparationWork - result.preparationWork })
+  })
