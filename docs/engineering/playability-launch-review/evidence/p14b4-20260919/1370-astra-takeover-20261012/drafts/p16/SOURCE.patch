+export type EstatePending = { subject: RightSubject; reason: EstatePendingReason; status: 'pending' | 'archived' }
+export type EstateBidStatus = 'sealed' | 'won' | 'lost' | 'disqualified'
+export type EstateBid = { id: string; estateId: string; lotId: string; bidderId: string; amount: number; week: number; status: EstateBidStatus; disqualification: string | null }
+export type EstateRecord = {
+  estateId: string
+  closureId: string
+  studioId: string
+  closureWeek: number
+  opensWeek: number
+  closesWeek: number
