+function expectedMoneyByStudio(transactions: readonly RightsTransaction[]): Map<string, { rightsConsideration: number; dueDiligenceFee: number; acquisitionOutlay: number }> {
+  const out = new Map<string, { rightsConsideration: number; dueDiligenceFee: number; acquisitionOutlay: number }>()
+  const at = (id: string) => { let row = out.get(id); if (row === undefined) { row = { rightsConsideration: 0, dueDiligenceFee: 0, acquisitionOutlay: 0 }; out.set(id, row) } return row }
