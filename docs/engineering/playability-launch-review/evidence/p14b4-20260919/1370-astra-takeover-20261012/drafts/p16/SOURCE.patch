+    expect(sale.offerRefusal(state, { offerorId: r02, counterpartyId: r01, direction: 'buy', instrument: { ...instrument, right: 'R4', scope: { use: 'television' } }, price }, week, STABLE)).toBe('r4ConsumerNotLive')
