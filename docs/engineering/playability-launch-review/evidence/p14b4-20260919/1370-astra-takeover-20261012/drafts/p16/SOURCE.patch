+    expect(rivalCash(closed, r03)).toBe(rivalCash(state, r03))
+    expect(record.proceeds.map((p) => [p.lotId, p.amount])).toEqual([['lot-a', 100_000], ['lot-b', 50_000]])
+    const txs = closed.rights.transactions.filter((t) => t.kind === 'estateSale')
