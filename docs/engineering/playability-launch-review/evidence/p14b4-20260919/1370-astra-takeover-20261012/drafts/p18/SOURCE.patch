+// ── P18 r2 — the television save era: number, guards, forged facts, downgrade, history, engagement ──
+//
+// Review findings F17/F49 (the era is Save51 on an explicit pair; every name derives from the pair),
+// F09/F37/F26 (one forged input per refusal, each with its own message, receipts replayed against the
+// season, the agreement, the counters and the ledger), F11/F38 (a non-player producer is refused),
+// F26 (the downgrade guards), F40 (every TV ledger kind below its era), F27/F31/F35 (the historical
+// V5 -> V6 engagement reading), F15 (the roster-wall historical hash), F34 (typed visibility),
+// F13d (save/load while blocked) and F13e (the frozen P15C snapshot keeps its bytes in the Save51 era).
+//
+// Every save starts from a live state the engine produced through public verbs and `tick`; the
+// forgeries are edits of the exported JSON, which is what a forged file is.
+import { createHash } from 'node:crypto'
+import { readFileSync } from 'node:fs'
+import { gunzipSync } from 'node:zlib'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { applyActions } from '../src/core/actions.js'
+import * as saveModule from '../src/core/save.js'
+import { convertV5ToV6, exportSave, importSave, makeSave, makeSaveV5, migrateToLive, stableStringify, validateSave, validateSaveV5 } from '../src/core/save.js'
+import { tick } from '../src/core/tick.js'
+import { televisionPublicView } from '../src/core/tvDistribution.js'
+import { cancelTvSeasonAtTerminalEvent } from '../src/core/tvSeason.js'
+import * as tvTypes from '../src/core/tvTypes.js'
+import { TV_LEDGER_KINDS } from '../src/core/tvTypes.js'
+import type { TvRightsAuthority } from '../src/core/tvTypes.js'
+import type { GameState, GameStateV18 } from '../src/core/types.js'
+import { generateWorld } from '../src/core/worldgen.js'
+import { historicalHashState, liftV18Control, makeSave as makeSaveV18 } from '../src/harness/roster-wall/historical-control.js'
+import { commission, greenlightFilm, liveSeason, sig, SOUND_STAGE, tickUntil, ticks, tv, tvNaturalStudio } from './helpers/p18-fixtures.js'
+
+type Envelope = { saveVersion: number; seed: string; state: Record<string, unknown> & { television: Record<string, unknown> } }
+const save = saveModule as unknown as Record<string, unknown>
+const LIVE = save.P18_SAVE_VERSION as number
+const PRED = save.P18_PREDECESSOR_SAVE_VERSION as number
+const named = (name: string): ((input: unknown) => { saveVersion: number; state: Record<string, unknown> }) => {
+  const candidate = save[name]
+  if (typeof candidate !== 'function') throw new Error(`save.ts exports no ${name}`)
+  return candidate as (input: unknown) => { saveVersion: number; state: Record<string, unknown> }
+}
+const convertDown = () => named(`convertV${LIVE}ToV${PRED}`)
+const validatePredecessor = () => named(`validateSaveV${PRED}`)
+const REVOKE_DISTRIBUTE: TvRightsAuthority = (q) => q.right === 'distribute' ? { ok: false, reason: `revoked at week ${q.week}` } : { ok: true }
+
+const states: Record<'live' | 'delivered' | 'cancelled' | 'arrears' | 'expired' | 'blocked' | 'filmHeld', GameState> = {} as never
+beforeAll(() => {
+  const fixture = tvNaturalStudio()
+  const committed = commission(fixture)
+  // a film greenlit the same week on the season's own stage reaches rehearsal first and keeps Soundstage 12
+  states.filmHeld = ticks(greenlightFilm(committed, fixture, 0).state, 5)
+  states.live = ticks(committed, 2)
+  states.delivered = tickUntil(committed, (s) => tv(s).seasons[0]!.status === 'delivered', 21, 'delivery')
+  const working = tick(committed)
+  states.cancelled = applyActions(working, [{ kind: 'cancelTvSeason', seasonId: liveSeason(working).seasonId }])
+  states.arrears = cancelTvSeasonAtTerminalEvent(working, liveSeason(working).seasonId, working.market.tick, 'closure')
+  states.expired = tick(states.delivered, { tvRights: REVOKE_DISTRIBUTE })
+  let blocked = ticks(committed, 4)
+  const house = blocked.sets.find((s) => s.mountedOn === SOUND_STAGE && s.status !== 'retired')!
+  blocked = tick(applyActions(blocked, [{ kind: 'strikeSet', setId: house.id }]))
+  states.blocked = blocked
+}, 240_000)
+
+const envelopeOf = (state: GameState): Envelope => JSON.parse(exportSave(makeSave(state))) as Envelope
+const forged = (state: GameState, edit: (envelope: Envelope) => void): Envelope => {
+  const envelope = envelopeOf(state)
+  edit(envelope)
+  return envelope
