+  v12ExactKeys(save, ['saveVersion', 'seed', 'state', 'broadcastCache'], 'save');
+  if (save.saveVersion !== P18_SAVE_VERSION) throw new Error(`validateSaveV51: expected version ${P18_SAVE_VERSION}`);
+  const raw = v14Record(checkEnvelope(save, 'validateSaveV51'), 'state');
+  if (!Object.hasOwn(raw, TELEVISION_ROOT_KEY)) throw new Error('validateSaveV51: the television root is missing');
