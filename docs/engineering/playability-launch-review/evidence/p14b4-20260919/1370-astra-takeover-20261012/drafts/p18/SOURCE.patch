+    exact(s, ['seasonId', 'seriesId', 'workId', 'agreementId', 'producerStudioId', 'propertyId', 'commissionerId', 'seasonNumber', 'episodes', 'rulesetVersion',
+      'grant', 'roster', 'credits', 'adoptionId', 'commitWeek', 'dueWeek', 'finalWeek', 'status', 'work', 'reservations', 'setId', 'writerReleasedWeek',
+      'deliveredWeek', 'cancelledWeek', 'cancellationCause', 'distribution'], label, `seasons[${index}]`)
+    const what = `seasons[${index}]`
