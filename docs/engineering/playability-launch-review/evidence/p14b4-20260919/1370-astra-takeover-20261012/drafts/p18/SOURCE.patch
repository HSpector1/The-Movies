+import { TV_COMMISSIONER_ID, TV_LEDGER_KINDS, TV_LICENCE_USE, TV_RULESET_VERSION, TV_WORK_BLOCK_ORDER } from './tvTypes.js'
+import type { TelevisionRoot, TvAgreement, TvLedgerKind, TvMilestoneKind, TvMilestoneRecord, TvReceipt, TvReceiptKind, TvSeason } from './tvTypes.js'
+import type { GameState } from './types.js'
+
+export const TELEVISION_ROOT_KEY = 'television'
+const SEASON_STATUSES = ['live', 'delivered', 'cancelled']
+const AGREEMENT_STATUSES = ['live', 'settled', 'cancelled']
+const CANCELLATION_CAUSES = ['voluntary', 'deadline', 'rightsLost', 'participantLost', 'closure', 'absorption']
+const TICK_CANCELLATION_CAUSES = ['deadline', 'rightsLost', 'participantLost']
+const ROLES = ['writer', 'director', 'lead', 'antagonist', 'support', 'craft']
+const CAPABILITIES = ['development-casting', 'soundstage', 'set-scenery', 'post', 'laboratory']
+const MILESTONE_KINDS = ['scripts', 'pictureLock', 'delivery']
+const WITHHELD_REASONS = ['stage-has-no-body', 'scenery-shop-has-no-body']
+const GRANT_KEYS = ['propertyId', 'producerStudioId', 'productionAuthorityId', 'productionScope', 'productionExclusive', 'productionEndExclusive',
+  'commissionerId', 'distributionAuthorityId', 'distributionScope', 'distributionExclusive', 'distributionEndExclusive']
+const TERM_KEYS = ['fee', 'advance', 'milestones', 'unitSpend', 'dueWeek', 'finalWeek', 'lateDeductionPerWeek', 'lateDeductionMax', 'cancellationCharge', 'distributionWeeks'] as const
+
+const RECEIPT_BASE = ['receiptId', 'kind', 'week', 'seasonId', 'agreementId']
+/** The exact fields each receipt kind carries beyond the base. */
+const RECEIPT_FIELDS: Record<TvReceiptKind, readonly string[]> = {
+  commissioned: ['seriesId', 'commitWeek'],
+  advancePaid: ['amount'],
+  unitCredited: ['block', 'creditedUnits'],
+  blockCompleted: ['block'],
+  writerReleased: ['talentId'],
+  milestoneEarned: ['milestone', 'amount'],
+  milestonePaid: ['milestone', 'amount'],
+  delivered: ['deliveryWeek', 'lateWeeks', 'deduction'],
+  cancelled: ['cause', 'refundFrozen', 'chargeAssessed', 'refundPaid', 'chargePaid'],
+  advanceRefundPaid: ['amount', 'remaining'],
+  cancellationChargePaid: ['amount', 'remaining'],
+  distributionExpired: ['availableUntilExclusive', 'cause'],
+}
+const STALL_FIELDS: Record<string, readonly string[]> = {
+  'facility-capacity': ['kind', 'capability'],
+  'set-unavailable': ['kind'],
+  'scenery-load-in': ['kind', 'weeksRemaining'],
+  'scenery-load-in-withheld': ['kind', 'reason'],
+  cash: ['kind', 'required', 'available'],
+}
+/** Each TV ledger kind and the one receipt kind that records the same payment. */
+const LEDGER_RECEIPT_KIND: Record<TvLedgerKind, TvReceiptKind> = {
+  tvAdvance: 'advancePaid',
+  tvMilestonePayment: 'milestonePaid',
+  tvProductionSpend: 'unitCredited',
+  tvAdvanceRefund: 'advanceRefundPaid',
+  tvCancellationCharge: 'cancellationChargePaid',
+}
+
+const isRecord = (value: unknown): value is Record<string, unknown> => typeof value === 'object' && value !== null && !Array.isArray(value)
+
+export function isTvLedgerKind(kind: unknown): kind is TvLedgerKind {
+  return typeof kind === 'string' && (TV_LEDGER_KINDS as readonly string[]).includes(kind)
+}
+
+function fail(label: string, message: string): never {
+  throw new Error(`${label}: television ${message}`)
+}
+
+function rec(value: unknown, label: string, what: string): Record<string, unknown> {
+  if (!isRecord(value)) fail(label, `${what} must be a plain object`)
+  return value
+}
+
+function exact(value: Record<string, unknown>, keys: readonly string[], label: string, what: string): void {
+  for (const key of keys) if (!Object.hasOwn(value, key)) fail(label, `${what} is missing "${key}"`)
+  for (const key of Object.keys(value)) if (!keys.includes(key)) fail(label, `${what} has unknown field "${key}"`)
+}
+
+function int(value: unknown, label: string, what: string, min = 0): number {
+  if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < min) fail(label, `${what} must be an integer >= ${min}`)
+  return value
+}
+
+function intOrNull(value: unknown, label: string, what: string, min = 0): number | null {
+  return value === null ? null : int(value, label, what, min)
+}
+
+function str(value: unknown, label: string, what: string): string {
+  if (typeof value !== 'string' || value.length === 0) fail(label, `${what} must be a non-empty string`)
+  return value
+}
+
+function strOrNull(value: unknown, label: string, what: string): string | null {
+  return value === null ? null : str(value, label, what)
+}
+
+function oneOf(value: unknown, allowed: readonly string[], label: string, what: string): string {
+  if (typeof value !== 'string' || !allowed.includes(value)) fail(label, `${what} must be one of ${allowed.join('/')}`)
+  return value
