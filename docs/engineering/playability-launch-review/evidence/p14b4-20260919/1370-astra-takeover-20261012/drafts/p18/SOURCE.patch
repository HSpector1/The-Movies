+    str(s.propertyId, label, `series[${index}].propertyId`)
+    strOrNull(s.originProductionId, label, `series[${index}].originProductionId`)
+    str(s.producerStudioId, label, `series[${index}].producerStudioId`)
+    int(s.createdWeek, label, `series[${index}].createdWeek`)
+    if (!Array.isArray(s.seasonIds) || s.seasonIds.length === 0) fail(label, `series[${index}].seasonIds must list the series' seasons`)
