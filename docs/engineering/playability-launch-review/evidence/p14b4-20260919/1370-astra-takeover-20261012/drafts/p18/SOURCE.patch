diff --git a/src/core/tvCommission.ts b/src/core/tvCommission.ts
new file mode 100644
index 00000000..00221263
--- /dev/null
+++ b/src/core/tvCommission.ts
@@ -0,0 +1,344 @@
+// ── P18 — admission and the one atomic commitment (contract §3, §4 "Commitment", §5) ──────
+//
+// Every refusal is decided BEFORE anything moves and names its own cause in a fixed order;
+// `tvCommissionPreview` and the action share one admission so the preview is the whole truth.
+// Acceptance mints the exact identities, freezes the terms and the credits, pays the
+// recoupable advance once, holds one Development & Casting slot and reserves the six people.
+// No RNG, no clock.
+
+import { boundedStableSort } from './boundedStableSort.js'
+import { retirementRecordFor } from './careerLifecycle.js'
+import { activeContract, busyTalentIds, economyEngaged, weeklyPayroll } from './employment.js'
+import { facilitySlotKey, occupiedResourceSlots } from './occupancy.js'
+import { expectedWeeklyOperatingCostAt } from './placement.js'
+import { PROJECT_UNIT, researchWeekQuote } from './technology.js'
+import { technologyEntry } from './technologyCatalogue.js'
+import { adoptionChainOperational } from './technologyAdoption.js'
+import { TUNING } from './tuning.js'
+import { liveTvSeason, tvRightsFromGrant } from './tvReaders.js'
+import { appendTvReceipt, tvArrearsOutstanding, tvLedgerRow, tvNextReceiptId, tvTermsFor } from './tvSettlement.js'
+import { TV_COMMISSIONER_ID, TV_LICENCE_USE, TV_RULESET_VERSION } from './tvTypes.js'
+import type {
+  CommissionTvSeasonPayload, TelevisionRoot, TvAgreement, TvAgreementTerms, TvCredit, TvReservation, TvRight, TvRightsAuthority, TvRole, TvSeason, TvSeries,
+} from './tvTypes.js'
+import type { Contract, CreativeRole, GameState } from './types.js'
+
+const pad4 = (n: number): string => String(n).padStart(4, '0')
+
+export type TvAdmissionQuote = {
+  weeks: number
+  cash: number
+  floor: number
+  /** Σ over the next twenty advances [C, C+20) of each mandatory weekly charge, week by week (contract §5). */
+  payroll: number
+  overhead: number
+  facilityOpex: number
+  research: number
+  /** CONTRACT GAP (P18): no loan root exists at this base; P15B's `loanInstallmentDue` sum joins here. */
+  loanInstallments: number
+  provision: number
+  required: number
+  ok: boolean
+}
+
+/**
+ * The research the next `weeks` advances will charge, week by week: each active player project
+ * spends its usable budget for the weeks its seated scientists' EXACT contracts cover and its
+ * remaining work lasts; a project that loses its seats pauses and charges nothing more. The
+ * research module's own week quote is the authority (`researchWeekQuote`).
+ */
+function researchSpendForecast(state: GameState, from: number, weeks: number): number {
+  const own = state.hollywood?.playerStudioId
+  let total = 0
+  for (const project of state.technology.projects) {
+    if (project.studioId !== own || project.status !== 'active') continue
+    let remaining = technologyEntry(project.technologyId).work * PROJECT_UNIT - Math.round(project.verifiedWork * PROJECT_UNIT)
+    for (let week = from; week < from + weeks && remaining > 0; week++) {
+      const quote = researchWeekQuote(state, project, undefined, week)
+      if (quote.output === 0) break
+      total += quote.spend
+      remaining -= Math.round(quote.output * PROJECT_UNIT)
+    }
+  }
+  return total
+}
+
+/**
+ * Contract §3/§5 admission quote: cash floor + the full mandatory fixed obligations of the next
+ * twenty advances + the cancellation provision, before the advance. Each week is charged exactly
+ * as the tick will charge it, from current facts and their scheduled changes: payroll from each
+ * contract's exact term (no assumed renewal), overhead from the contracts still held that week,
+ * facility operating cost from the placement record with its scheduled completions, and research
+ * spend while each project runs. Queued intents and physical plans hold nothing and are
+ * cancellable, so they are not mandatory.
+ */
+export function tvAdmissionQuote(state: GameState, week: number): TvAdmissionQuote {
+  const weeks = TUNING.TV_ADMISSION_QUOTE_WEEKS
+  const founded = state.founding === null
+  const charged = founded && economyEngaged(state)
+  let payroll = 0
+  let overhead = 0
+  let facilityOpex = 0
+  for (let w = week; w < week + weeks; w++) {
+    if (founded) payroll += weeklyPayroll(state, w)
+    if (charged) {
+      overhead += TUNING.OVERHEAD_BASE + TUNING.OVERHEAD_PER_EMPLOYEE * state.contracts.filter((contract) => contract.endWeekExclusive > w).length
+      facilityOpex += expectedWeeklyOperatingCostAt(state.placement, state.ledger, w)
+    }
+  }
+  const research = charged ? researchSpendForecast(state, week, weeks) : 0
+  const loanInstallments = 0
+  const floor = TUNING.TV_ADMISSION_CASH_FLOOR
+  const provision = TUNING.TV_ADMISSION_CANCELLATION_PROVISION
+  const required = floor + payroll + overhead + facilityOpex + research + loanInstallments + provision
+  return { weeks, cash: state.studio.cash, floor, payroll, overhead, facilityOpex, research, loanInstallments, provision, required, ok: state.studio.cash >= required }
+}
+
+const ROSTER_ROLES: readonly [TvRole, CreativeRole, string][] = [
+  ['writer', 'writer', 'writing'], ['director', 'director', 'directing'], ['lead', 'actor', 'acting'],
+  ['antagonist', 'actor', 'acting'], ['support', 'actor', 'acting'], ['craft', 'craft', 'craft'],
+]
+
+function rosterId(payload: CommissionTvSeasonPayload, role: TvRole): string {
+  switch (role) {
+    case 'writer': return payload.roster.writerId
+    case 'director': return payload.roster.directorId
+    case 'lead': return payload.roster.cast.lead
+    case 'antagonist': return payload.roster.cast.antagonist
+    case 'support': return payload.roster.cast.support
+    case 'craft': return payload.roster.craftId
+  }
+}
+
+type Admitted = {
+  player: string
+  commitWeek: number
+  series: TvSeries | null
+  reservation: TvReservation
+  credits: TvCredit[]
+  contracts: Map<string, Contract>
+}
+
+function playerContractId(state: GameState, contract: Contract): string | null {
+  const h = state.hollywood
+  if (h === null) return null
+  const row = h.employment.find((entry) => entry.studioId === h.playerStudioId && entry.endedWeek === null
+    && entry.terms.talentId === contract.talentId && entry.terms.startWeek === contract.startWeek)
+  return row?.contractId ?? null
+}
+
+/** The grant projection's own facts, before any live question (contract §3: scope, exclusivity, two instruments). */
+function grantShapeRefusal(payload: CommissionTvSeasonPayload): string | null {
+  const grant = payload.grant
+  if (grant.propertyId !== payload.propertyId) return `the grant names property "${grant.propertyId}", not "${payload.propertyId}"`
+  for (const id of [grant.productionAuthorityId, grant.distributionAuthorityId]) {
+    if (typeof id !== 'string' || id.length === 0) return 'each grant authority must carry a non-empty id'
+  }
+  if (grant.productionAuthorityId === grant.distributionAuthorityId) return 'the production and distribution authorities must be two separately identified single-grantee grants'
+  if (grant.productionScope !== TV_LICENCE_USE) return `the production authority scope "${String(grant.productionScope)}" is not television`
+  if (grant.distributionScope !== TV_LICENCE_USE) return `the distribution authority scope "${String(grant.distributionScope)}" is not television`
+  if (typeof grant.productionExclusive !== 'boolean') return 'the production authority must state its exclusivity'
+  if (grant.distributionExclusive !== true) return 'the distribution authority must be exclusive: the commissioner distributes under an exclusive television licence'
+  return null
+}
+
+/**
+ * The fixed-order admission. A string is the refusal; otherwise the facts the commitment needs.
+ * `rights` defaults to the provenance resolver over the payload's own grant facts (the P16 adapter
+ * point, REPORT (d)); the P16 rebase passes the live projection instead.
+ */
+export function admitTvCommission(state: GameState, payload: CommissionTvSeasonPayload, rights: TvRightsAuthority = tvRightsFromGrant(payload.grant)): string | Admitted {
+  const C = state.market.tick
+  if (state.hollywood === null) return 'the campaign has no founded player studio identity'
+  if (!economyEngaged(state)) return 'the studio economy is not engaged: a season needs an entered operating studio'
+  if (state.founding !== null) return 'the studio is still in its founding draft'
+  if (state.operations.mode !== 'managed') return 'production operations are not managed'
+  const player = state.hollywood.playerStudioId
+  const arrears = tvArrearsOutstanding(state, player)
+  if (arrears > 0) return `outstanding TV obligations of ${arrears} must be settled before a new season is admitted`
+  const live = liveTvSeason(state.television)
+  if (live !== null) return `one active season per studio: "${live.seasonId}" is live`
+  // the series handle and the property
+  let series: TvSeries | null = null
+  if (payload.series.kind === 'existing') {
+    const wanted = payload.series.seriesId
+    const found = state.television.series.find((row) => row.seriesId === wanted)
+    if (found === undefined || found.producerStudioId !== player) return `unknown series "${wanted}" for this studio`
+    series = found
+    if (series.propertyId !== payload.propertyId) return `property "${payload.propertyId}" is not the series' property "${series.propertyId}"`
+  } else if (typeof payload.series.title !== 'string' || payload.series.title.trim().length === 0) {
+    return 'a new series needs a non-empty title'
+  }
+  if (typeof payload.propertyId !== 'string' || payload.propertyId.length === 0) return 'property id must be a non-empty string'
+  if (payload.originProductionId !== null && !state.studio.releasedFilms.some((film) => film.productionId === payload.originProductionId)) {
+    return `originProductionId "${payload.originProductionId}" is not a released film of this studio (an exact id, never a title)`
+  }
+  // the grant projection (contract §3): two separately identified instruments, television use,
+  // exclusive distribution; then the LIVE rights read for every week the season could need: the
+  // producer's production right for every week of [C, C+20] and the commissioner's exclusive
+  // distribution right for every week of [C, C+72), the whole possible availability interval
+  // (finding 1 / review F02: a payload id, a cached end or two sampled weeks is not present permission)
+  const shape = grantShapeRefusal(payload)
+  if (shape !== null) return shape
+  const grant = payload.grant
+  const ask = (right: TvRight, subjectStudioId: string, authorityId: string, week: number): string | null => {
+    const answer = rights({ subjectStudioId, propertyId: payload.propertyId, right, scope: TV_LICENCE_USE, exclusive: right === 'distribute', authorityId, week })
+    return answer.ok ? null : `the ${right === 'produce' ? "producer's produce" : "commissioner's distribute"} right is not granted at week ${week}: ${answer.reason}`
+  }
+  for (let week = C; week <= C + TUNING.TV_FINAL_WEEKS; week++) {
+    const refusal = ask('produce', player, grant.productionAuthorityId, week)
+    if (refusal !== null) return refusal
+  }
+  for (let week = C; week < C + TUNING.TV_FINAL_WEEKS + TUNING.TV_DISTRIBUTION_WEEKS; week++) {
+    const refusal = ask('distribute', TV_COMMISSIONER_ID, grant.distributionAuthorityId, week)
+    if (refusal !== null) return refusal
+  }
+  // the sound chain
+  const adoption = state.technology.adoptions.find((row) => row.id === payload.adoptionId)
+  if (adoption === undefined || adoption.studioId !== player || adoption.postFacilityId === null || !adoptionChainOperational(state, adoption)) {
+    return `"${payload.adoptionId}" is not this studio's operational synchronized-dialogue chain (stage, capture and Post)`
+  }
+  // capacity: one free Development & Casting slot, acquired now, never queued
+  const occupied = occupiedResourceSlots(state, { capability: 'development-casting' })
+  let reservation: TvReservation | null = null
+  for (const facility of boundedStableSort([...state.operations.facilities], (a, b) => (a.id < b.id ? -1 : a.id > b.id ? 1 : 0))) {
+    if (facility.capability !== 'development-casting') continue
+    for (let slot = 0; slot < facility.capacity && reservation === null; slot++) {
+      if (!occupied.has(facilitySlotKey(facility.id, slot))) reservation = { facilityId: facility.id, capability: 'development-casting', slot }
+    }
+    if (reservation !== null) break
+  }
+  if (reservation === null) return 'no free development-casting slot for the scripts block this week; a season is never queued'
+  // the six people
+  const ids = ROSTER_ROLES.map(([role]) => rosterId(payload, role))
+  if (new Set(ids).size !== ids.length) return 'the six roster people must be distinct'
+  const busy = busyTalentIds(state)
+  const credits: TvCredit[] = []
+  const contracts = new Map<string, Contract>()
+  for (const [role, profession, profile] of ROSTER_ROLES) {
+    const id = rosterId(payload, role)
+    const person = state.talent.find((t) => t.id === id)
+    if (person === undefined) return `unknown talent "${id}" in the roster`
+    if (person.role !== profession) return `"${id}" has no ${profile} skill profile (role ${person.role})`
+    if (busy.has(id)) return `"${id}" is already engaged (a production seat, a writing task, a research seat or a live season)`
+    const contract = activeContract(state, id, C)
+    if (contract === undefined) return `"${id}" is not studio-contracted at week ${C}`
+    if (contract.endWeekExclusive < C + TUNING.TV_FINAL_WEEKS) {
+      return `"${id}"'s contract ends at week ${contract.endWeekExclusive} and does not cover the production window [${C}, ${C + TUNING.TV_FINAL_WEEKS})`
+    }
+    const record = retirementRecordFor(state, id)
+    if (record !== undefined && !(record.status === 'announced' && record.effectiveWeek >= C + TUNING.TV_FINAL_WEEKS)) {
+      return `"${id}" has a retirement record (${record.status}) that cannot release a twenty-week seat taken at week ${C}`
+    }
+    const contractId = playerContractId(state, contract)
+    if (contractId === null) return `"${id}" has no recorded P12 employment row for the credit`
+    credits.push({ talentId: id, name: person.name, role, contractId })
+    contracts.set(id, contract)
+  }
+  const quote = tvAdmissionQuote(state, C)
+  if (!quote.ok) return `cash ${quote.cash} is below the admission quote ${quote.required} (floor ${quote.floor} + ${quote.weeks} weeks of fixed obligations + provision ${quote.provision}); the advance is not counted`
+  return { player, commitWeek: C, series, reservation, credits, contracts }
+}
+
+export type TvCommissionPreview = {
+  refusal: string | null
+  quote: TvAdmissionQuote
+  terms: TvAgreementTerms
+  commitWeek: number
+  dueWeek: number
+  finalWeek: number
+}
+
+export function tvCommissionPreview(state: GameState, payload: CommissionTvSeasonPayload, rights?: TvRightsAuthority): TvCommissionPreview {
+  const C = state.market.tick
+  const admitted = admitTvCommission(state, payload, rights)
+  const terms = tvTermsFor(C)
+  return { refusal: typeof admitted === 'string' ? admitted : null, quote: tvAdmissionQuote(state, C), terms, commitWeek: C, dueWeek: terms.dueWeek, finalWeek: terms.finalWeek }
+}
+
+/** The one atomic commitment. Throws the admission refusal; returns the same state by reference on none. */
+export function commissionTvSeason(state: GameState, payload: CommissionTvSeasonPayload, rights?: TvRightsAuthority): GameState {
+  const admitted = admitTvCommission(state, payload, rights)
+  if (typeof admitted === 'string') throw new Error(`applyActions: commissionTvSeason rejected — ${admitted}`)
+  const C = admitted.commitWeek
+  const root = state.television
+  let next: TelevisionRoot = { ...root }
+  let series = admitted.series
+  if (series === null) {
+    series = {
+      seriesId: `tv-series-${pad4(root.nextSeries)}`,
+      title: (payload.series as { title: string }).title,
+      propertyId: payload.propertyId,
+      originProductionId: payload.originProductionId,
+      producerStudioId: admitted.player,
+      createdWeek: C,
+      seasonIds: [],
+    }
+    next = { ...next, nextSeries: root.nextSeries + 1, series: [...root.series, series] }
+  }
+  const seasonId = `tv-season-${pad4(root.nextSeason)}`
+  const agreementId = `tv-agreement-${pad4(root.nextAgreement)}`
+  const terms = tvTermsFor(C)
+  const season: TvSeason = {
+    seasonId,
+    seriesId: series.seriesId,
+    workId: `tv-work-${pad4(root.nextSeason)}`,
+    agreementId,
+    producerStudioId: admitted.player,
+    propertyId: payload.propertyId,
+    commissionerId: TV_COMMISSIONER_ID,
+    seasonNumber: series.seasonIds.length + 1,
+    episodes: TUNING.TV_SEASON_EPISODES,
+    rulesetVersion: TV_RULESET_VERSION,
+    grant: { ...payload.grant },
+    roster: { ...payload.roster, cast: { ...payload.roster.cast } },
+    credits: admitted.credits,
+    adoptionId: payload.adoptionId,
+    commitWeek: C,
+    dueWeek: terms.dueWeek,
+    finalWeek: terms.finalWeek,
+    status: 'live',
+    work: { block: 'scripts', creditedUnits: 0, blockCredited: 0, lastCreditedWeek: null, stall: null, stageHeldSinceWeek: null },
+    reservations: [admitted.reservation],
+    setId: null,
+    writerReleasedWeek: null,
+    deliveredWeek: null,
+    cancelledWeek: null,
+    cancellationCause: null,
+    distribution: null,
+  }
+  const agreement: TvAgreement = {
+    agreementId,
+    seasonId,
+    studioId: admitted.player,
+    commissionerId: TV_COMMISSIONER_ID,
+    rulesetVersion: TV_RULESET_VERSION,
+    terms,
+    earned: 0,
+    received: terms.advance,
+    advanceReturned: 0,
+    advanceRefundFrozen: null,
+    cancellationChargeAssessed: 0,
+    cancellationChargePaid: 0,
+    milestones: [],
+    status: 'live',
+    cancelledWeek: null,
+  }
+  next = {
+    ...next,
+    nextSeason: root.nextSeason + 1,
+    nextAgreement: root.nextAgreement + 1,
+    series: next.series.map((row) => row.seriesId === series!.seriesId ? { ...row, seasonIds: [...row.seasonIds, seasonId] } : row),
+    seasons: [...root.seasons, season],
+    agreements: [...root.agreements, agreement],
+  }
+  next = appendTvReceipt(next, { kind: 'commissioned', week: C, seasonId, agreementId, seriesId: series.seriesId, commitWeek: C })
+  const advanceReceiptId = tvNextReceiptId(next)
+  next = appendTvReceipt(next, { kind: 'advancePaid', week: C, seasonId, agreementId, amount: terms.advance })
+  return {
+    ...state,
+    television: next,
+    studio: { ...state.studio, cash: state.studio.cash + terms.advance },
+    ledger: [...state.ledger, tvLedgerRow(C, 'tvAdvance', terms.advance, agreementId, advanceReceiptId, `tv recoupable advance ${agreementId}`)],
+  }
+}
diff --git a/src/core/tvDistribution.ts b/src/core/tvDistribution.ts
