+// p13a-core-causal-01, week 53). Pinned by sha256 of the checked-in gzip AND of its decompressed
+// bytes, recomputed by this author against the file rather than copied from manifest prose.
+const PREDECESSOR = new URL('./fixtures/p14/genuine-v45-recovery-predecessors-1363/p13a-week-53.save45.json.gz', import.meta.url)
+function genuineV45(): { raw: string; parsed: Envelope } {
+  const gz = readFileSync(PREDECESSOR)
+  expect(gz.byteLength).toBe(90405)
+  expect(sha(gz)).toBe('fd4b8f0986453d1b735dda8410ffd05c841289d0fd51d9fe1a6707128947dc68')
+  const raw = gunzipSync(gz).toString('utf8')
+  expect(Buffer.byteLength(raw, 'utf8')).toBe(774318)
+  expect(sha(raw)).toBe('d66a6809c3fc3dacf6a83386cad320d94c70264384f47e5f83a0bd0320768d07')
+  const parsed = importSave(raw) as Envelope
+  expect(parsed.saveVersion).toBe(45)
+  return { raw, parsed }
+}
+
+describe('P18 television save step — constants and dispatch', () => {
+  it('P18_SAVE_VERSION is the live version, Save51, and its predecessor is Save45 at this base', () => {
+    expect(LIVE).toBe(51)
+    expect(PRED).toBe(45)
+    expect(LIVE_SAVE_VERSION).toBe(LIVE)
+  })
+
+  it('makeSave stamps the live version, carries the television root, and migrateToLive is the identity on it', () => {
+    const state = p13aGeneratedStudio('p18-save51-fresh')
+    const envelope = makeSave(state)
+    expect(envelope.saveVersion).toBe(LIVE)
+    expect(Object.hasOwn(envelope.state, 'television')).toBe(true)
+    expect(stableStringify(migrateToLive(envelope))).toBe(stableStringify(envelope))
+    expect(stableStringify(validateSave(JSON.parse(exportSave(envelope))))).toBe(stableStringify(envelope))
+  })
+
+  it('a fresh world carries an empty television root recorded from week 0 with every allocator at 1', () => {
+    const world = generateWorld('p18-save51-world') as GameState & { television?: unknown }
+    expect(world.television).toEqual(initialTelevisionRoot(0))
+    expect(initialTelevisionRoot(0)).toEqual({
+      version: 1, recordedFromWeek: 0, nextSeries: 1, nextSeason: 1, nextAgreement: 1, nextReceipt: 1,
+      series: [], seasons: [], agreements: [], receipts: [],
+    })
+  })
+
+  it('validateSave refuses the version after the live one by name', () => {
+    expect(() => validateSave({ saveVersion: LIVE + 1, seed: 's', state: {}, broadcastCache: [] }))
+      .toThrow(new RegExp(`unknown saveVersion ${LIVE + 1}`))
+  })
+})
+
+describe('P18 television save step — genuine predecessor migration and lossless downgrade', () => {
+  it('migrates the genuine Save45 week-53 capture with an empty root at the save\'s own week and nothing else moved', () => {
+    const { parsed } = genuineV45()
+    const predecessor = migrateToPredecessor()(parsed)
+    const migrated = migrateToLive(parsed) as unknown as { saveVersion: number; state: GameState & { television: unknown } }
+    expect(migrated.saveVersion).toBe(LIVE)
+    // the empty root is recorded from the capture's OWN week, 53 (review F47: a literal, not the implementation's oracle)
+    expect(migrated.state.television).toEqual({ version: 1, recordedFromWeek: 53, nextSeries: 1, nextSeason: 1, nextAgreement: 1, nextReceipt: 1,
+      series: [], seasons: [], agreements: [], receipts: [] })
+    const { television: _television, ...rest } = migrated.state
+    expect(stableStringify(rest)).toBe(stableStringify(predecessor.state))
+    // a second migration is a no-op
+    expect(stableStringify(migrateLive()(migrated))).toBe(stableStringify(migrated))
+  })
+
+  it('downgrades losslessly while the root is empty: the predecessor bytes come back exactly', () => {
+    const { parsed } = genuineV45()
+    const predecessor = migrateToPredecessor()(parsed)
+    const migrated = migrateLive()(parsed)
+    const back = convertDown()(migrated)
+    expect(back.saveVersion).toBe(PRED)
+    expect(stableStringify(back)).toBe(stableStringify(predecessor))
+    expect(stableStringify(validatePredecessor()(back))).toBe(stableStringify(predecessor))
+  })
+
+  it('the live validator requires the root and refuses a malformed one by name', () => {
+    const fresh = makeSave(p13aGeneratedStudio('p18-save51-shape'))
+    const { television: _television, ...withoutRoot } = fresh.state as GameState & { television: unknown }
+    expect(() => validateLive()({ ...fresh, state: withoutRoot })).toThrow(/television/)
+    expect(() => validateLive()({ ...fresh, state: { ...fresh.state, television: { version: 2 } } })).toThrow(/television/)
+    expect(() => validateLive()({ ...fresh, saveVersion: PRED })).toThrow(new RegExp(`expected version ${LIVE}`))
+  })
+
+  it('the frozen predecessor reader refuses the live shape (the television key) and every TV ledger kind', () => {
+    const fresh = makeSave(p13aGeneratedStudio('p18-save51-era'))
+    expect(() => validatePredecessor()({ ...fresh, saveVersion: PRED })).toThrow(/has unknown field "television"/)
+    const { television: _television, ...stripped } = fresh.state as GameState & { television: unknown }
+    // two frozen laws refuse the row independently: the correlation field is unknown to every older era,
+    // and without it the kind itself is outside the era's enum
+    const row = { week: stripped.market.tick, kind: 'tvAdvance', amount: 120_000, note: 'forged', tvAgreementId: 'tv-agreement-0001' }
+    const forged = { ...stripped, studio: { ...stripped.studio, cash: stripped.studio.cash + 120_000 }, ledger: [...stripped.ledger, row] }
+    expect(() => validatePredecessor()({ ...fresh, saveVersion: PRED, state: forged })).toThrow(/unknown field "tvAgreementId"/)
+    const { tvAgreementId: _correlation, ...uncorrelated } = row
+    const forgedKind = { ...forged, ledger: [...stripped.ledger, uncorrelated] }
+    expect(() => validatePredecessor()({ ...fresh, saveVersion: PRED, state: forgedKind })).toThrow(/kind must be one of/)
+  })
+
+  it('a frozen builder refuses a non-empty television root before any older refusal', () => {
+    const state = p13aGeneratedStudio('p18-save51-frozen')
+    const root = initialTelevisionRoot(state.market.tick)
+    const forgedSeries = { ...root, nextSeries: 2, series: [{ seriesId: 'tv-series-0001', title: 'x', propertyId: 'p', originProductionId: null,
+      producerStudioId: state.hollywood!.playerStudioId, createdWeek: state.market.tick, seasonIds: [] }] }
+    expect(() => makeSaveV18({ ...state, television: forgedSeries } as unknown as Parameters<typeof makeSaveV18>[0])).toThrow(/television/)
+  })
+})
