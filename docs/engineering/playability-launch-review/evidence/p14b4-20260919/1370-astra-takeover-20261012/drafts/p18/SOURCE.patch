+// ── P18 — one season workload: capacity, weekly work, money, delivery and cancellation (contract §4–§7) ──
+//
+// Twelve counted work units in five blocks (3/1/1/4/3), at most one unit per weekly advance.
+// CAPACITY is requested inside the one allocation owner: the season is a typed participant of
+// `advanceManagedProductions`' fixed-point sweep, served at its own place in the existing
+// admitted-work order (longest waiting first; on equal waits productions before seasons, then id)
+// and retaining every claim it already holds (Codex finding 4).
+// MONEY is settled separately at tick step 7.7: a unit is credited only when the required valid
+// people, the live production AND distribution rights, the occupied capacity and the paid weekly
+// production cost all exist for that week. Block resources follow the production resource-release
+// law: what the next block requires is retained (rehearsal → shooting keeps the stage and its set);
+// everything else releases the week the block completes. The scenery load-in reuses the engine's
+// geometry and is withheld, never waived, when the trip cannot be derived.
+//
+// Pure: no RNG, no clock, no I/O. The caller owns the cash it hands in and the ledger rows it
+// gets back; this module never writes `operations.workflows`.
+
+import { boundedStableSort } from './boundedStableSort.js'
+import { lifecycleStatus } from './careerLifecycle.js'
+import { activeContract } from './employment.js'
+import { facilitySlotKey } from './occupancy.js'
+import type { SweepParticipant } from './operations.js'
+import { facilityBodyCentre, gridDistance, sceneryLoadInWeeksForDistance } from './sceneryLoadIn.js'
+import { bindableSetsOn, heldSetIds, wearSetAtWrap } from './sets.js'
+import { recordTvDistributionExpiry, tvDistributionRight } from './tvDistribution.js'
+import {
+  initialTelevisionRoot, liveTvSeason, nextTvBlock, televisionOccupiedFacilitySlots, TV_WORK_BLOCKS, tvBlockDefinition, tvEngagedTalentIds,
+  tvHeldSetIds, tvReservedPeople, tvRightsFromGrant, tvSeasonHoldingSet, tvSeasonRights, tvUnitsThrough, tvWorkUnitsTotal,
+} from './tvReaders.js'
+import type { TvWorkBlockDefinition } from './tvReaders.js'
+import {
+  appendTvReceipt, applyTvObligationPayment, assertTvMoneyInvariant, freezeTvCancellation, tvAvailableWholeDollars, tvLateDeduction, tvLedgerRow,
+  tvMilestonePayment, tvNextReceiptId, tvOutstanding,
+} from './tvSettlement.js'
+import { TV_LICENCE_USE } from './tvTypes.js'
+import type {
+  TelevisionRoot, TvAgreement, TvCancellationCause, TvMilestoneKind, TvReservation, TvRightsAuthority, TvSceneryWithheldReason, TvSeason, TvStall,
+  TvTerminalCause,
+} from './tvTypes.js'
+import type { GameState, LedgerEntry, StudioOperations, StudioSet } from './types.js'
+
+export {
+  initialTelevisionRoot, liveTvSeason, nextTvBlock, televisionOccupiedFacilitySlots, TV_WORK_BLOCKS, tvBlockDefinition, tvEngagedTalentIds,
+  tvHeldSetIds, tvRightsFromGrant, tvSeasonHoldingSet, tvSeasonRights, tvUnitsThrough, tvWorkUnitsTotal,
+}
+export type { TvWorkBlockDefinition }
+
+/** The people a live season needs this week: the five company members and, until scripts complete, the writer. */
+export function tvRequiredParticipants(season: TvSeason): string[] {
+  return tvReservedPeople(season)
+}
+
+function compareId<T extends { id: string }>(a: T, b: T): number {
+  return a.id < b.id ? -1 : a.id > b.id ? 1 : 0
+}
+
+function reservationKey(reservation: TvReservation): string {
+  return facilitySlotKey(reservation.facilityId, reservation.slot)
+}
+
+export type TvAllocationContext = {
+  operations: StudioOperations
+  /** Candidate sets for the stage+set composite, as the advance found them. */
+  sets: readonly StudioSet[]
+  /** Every other owner's slot keys, bare `facilityId:slot`. The season's own slots are excluded. */
+  occupied: ReadonlySet<string>
+  /** Sets other holders stand on right now. */
+  heldSets: ReadonlySet<string>
+  stageFacilityId: string
