index 00000000..115bc6dd
--- /dev/null
+++ b/src/core/tvDistribution.ts
@@ -0,0 +1,134 @@
+// ── P18 — the one distribution model (contract §6) and the public projection (§8) ─────────
+//
+// An exclusive fixed-fee licence window: the whole season is available to its named commissioner
+// during [deliveryWeek, deliveryWeek + 52), covered by the ACTUAL exclusive distribution grant,
+// asked live at delivery and for every use (finding 1). No weekly royalties, viewers, advertising
+// yields, platform balances, theatrical runs or synthetic FilmResults. Expiry — the window's end or
+// a revoked right — stops availability; it neither reverses earned fees nor remints the work.
+
+import { tvRightsFromGrant } from './tvReaders.js'
+import { appendTvReceipt } from './tvSettlement.js'
+import { TV_LICENCE_USE, TV_RECEIPT_VISIBILITY } from './tvTypes.js'
+import type { GameState } from './types.js'
+import type { TelevisionRoot, TvCancellationCause, TvRightsAuthority, TvRole, TvSeason, TvSeasonStatus } from './tvTypes.js'
+
+/** The commissioner's EXCLUSIVE television distribution right at `week`, asked live. */
+export function tvDistributionRight(season: TvSeason, rights: TvRightsAuthority, week: number): ReturnType<TvRightsAuthority> {
+  return rights({ subjectStudioId: season.commissionerId, propertyId: season.propertyId, right: 'distribute', scope: TV_LICENCE_USE, exclusive: true,
+    authorityId: season.grant.distributionAuthorityId, week })
+}
+
+/**
+ * Whether the delivered season is available to its commissioner at `week`. The default authority
+ * answers from the season's own grant (REPORT (d)); a recorded expiry — the window's end or a
+ * revocation the tick observed — is final.
+ */
+export function tvSeasonAvailableAt(season: TvSeason, week: number, rights: TvRightsAuthority = tvRightsFromGrant(season.grant)): boolean {
+  const window = season.distribution
+  if (season.status !== 'delivered' || window === null) return false
+  if (window.expiredRecordedWeek !== null && week >= window.expiredRecordedWeek) return false
+  if (week < window.availableFromWeek || week >= window.availableUntilExclusive) return false
+  return tvDistributionRight(season, rights, week).ok
+}
+
+/** At boundary T, record — once — the expiry of every delivered window that has ended or lost its right. */
+export function recordTvDistributionExpiry(root: TelevisionRoot, boundary: number, rightsFor: (season: TvSeason) => TvRightsAuthority): TelevisionRoot {
+  let next = root
+  for (const season of root.seasons) {
+    const window = season.distribution
+    if (season.status !== 'delivered' || window === null || window.expiredRecordedWeek !== null) continue
+    const cause = boundary >= window.availableUntilExclusive ? 'window'
+      : tvDistributionRight(season, rightsFor(season), boundary).ok ? null : 'rightsLost'
+    if (cause === null) continue
+    next = {
+      ...next,
+      seasons: next.seasons.map((row) => row.seasonId === season.seasonId
+        ? { ...row, distribution: { ...window, expiredRecordedWeek: boundary } }
+        : row),
+    }
+    next = appendTvReceipt(next, { kind: 'distributionExpired', week: boundary, seasonId: season.seasonId,
+      agreementId: season.agreementId, availableUntilExclusive: window.availableUntilExclusive, cause })
+  }
+  return next
+}
+
+/** One public fact (contract §8 typed visibility): identity and week, never an amount or a private term. */
+export type TvPublicFact =
+  | { kind: 'commissioned'; week: number }
+  | { kind: 'delivered'; week: number }
+  | { kind: 'cancelled'; week: number; cause: TvCancellationCause }
+  | { kind: 'distributionExpired'; week: number; cause: 'window' | 'rightsLost' }
+
+/** Public facts only (contract §8): no fee, advance, cash, grant price or private terms. */
+export type TvPublicSeasonView = {
+  seasonId: string
+  seasonNumber: number
+  episodes: number
+  status: TvSeasonStatus
+  commitWeek: number
+  deliveredWeek: number | null
+  cancelledWeek: number | null
+  availableFromWeek: number | null
+  /** The EFFECTIVE end: the window's end, or the boundary an earlier expiry was recorded at. */
+  availableUntilExclusive: number | null
+  /** Why availability ended, once it has: the window ran out or the right was lost. Null while open. */
+  distributionEndCause: 'window' | 'rightsLost' | null
+  credits: readonly { talentId: string; name: string; role: TvRole }[]
+  facts: readonly TvPublicFact[]
+}
+export type TvPublicSeriesView = {
+  seriesId: string
+  title: string
+  producerStudioId: string
+  propertyId: string
+  originProductionId: string | null
+  seasons: TvPublicSeasonView[]
+}
+export type TvPublicView = { series: TvPublicSeriesView[] }
+
+function publicFacts(root: TelevisionRoot, seasonId: string): TvPublicFact[] {
+  const facts: TvPublicFact[] = []
+  for (const receipt of root.receipts) {
+    if (receipt.seasonId !== seasonId || TV_RECEIPT_VISIBILITY[receipt.kind] !== 'public') continue
+    switch (receipt.kind) {
+      case 'commissioned': facts.push({ kind: 'commissioned', week: receipt.week }); break
+      case 'delivered': facts.push({ kind: 'delivered', week: receipt.week }); break
+      case 'cancelled': facts.push({ kind: 'cancelled', week: receipt.week, cause: receipt.cause }); break
+      case 'distributionExpired': facts.push({ kind: 'distributionExpired', week: receipt.week, cause: receipt.cause }); break
+      default: throw new Error(`tv public view: receipt kind ${receipt.kind} is public but has no public projection`)
+    }
+  }
+  return facts
+}
+
+export function televisionPublicView(state: Pick<GameState, 'television'>): TvPublicView {
+  const root = state.television
+  return {
+    series: root.series.map((series) => ({
+      seriesId: series.seriesId,
+      title: series.title,
+      producerStudioId: series.producerStudioId,
+      propertyId: series.propertyId,
+      originProductionId: series.originProductionId,
+      seasons: root.seasons.filter((season) => season.seriesId === series.seriesId).map((season) => {
+        const window = season.distribution
+        const expired = root.receipts.find((r) => r.kind === 'distributionExpired' && r.seasonId === season.seasonId)
+        return {
+          seasonId: season.seasonId,
+          seasonNumber: season.seasonNumber,
+          episodes: season.episodes,
+          status: season.status,
+          commitWeek: season.commitWeek,
+          deliveredWeek: season.deliveredWeek,
+          cancelledWeek: season.cancelledWeek,
+          availableFromWeek: window?.availableFromWeek ?? null,
+          availableUntilExclusive: window === null ? null
+            : window.expiredRecordedWeek === null ? window.availableUntilExclusive : Math.min(window.availableUntilExclusive, window.expiredRecordedWeek),
+          distributionEndCause: expired?.kind === 'distributionExpired' ? expired.cause : null,
+          credits: season.credits.map((credit) => ({ talentId: credit.talentId, name: credit.name, role: credit.role })),
+          facts: publicFacts(root, season.seasonId),
+        }
+      }),
+    })),
+  }
+}
