+/** A lawful fractional balance: a film greenlit this week whose marketing leaves exactly `target` (± float noise). */
+function drainTo(state: GameState, fixture: ReturnType<typeof base>, target: number, conceptIndex = 0): GameState {
+  const concept = state.concepts[conceptIndex]!
+  const marketing = state.studio.cash - concept.baseNegativeCost - target
+  if (marketing < 0) throw new Error(`fixture: cannot drain ${state.studio.cash} to ${target}`)
+  const drained = greenlightFilm(state, fixture, conceptIndex, fixture.filmRoster, marketing).state
+  expect(Math.abs(drained.studio.cash - target)).toBeLessThan(1e-6)
+  return drained
