+    case 'advancePaid': case 'milestoneEarned': case 'milestonePaid': int(r.amount, label, `${what}.amount`); break
+    case 'unitCredited': oneOf(r.block, TV_WORK_BLOCK_ORDER, label, `${what}.block`); int(r.creditedUnits, label, `${what}.creditedUnits`, 1); break
+    case 'blockCompleted': oneOf(r.block, TV_WORK_BLOCK_ORDER, label, `${what}.block`); break
+    case 'writerReleased': str(r.talentId, label, `${what}.talentId`); break
+    case 'delivered': for (const key of ['deliveryWeek', 'lateWeeks', 'deduction']) int(r[key], label, `${what}.${key}`); break
+    case 'cancelled':
+      oneOf(r.cause, CANCELLATION_CAUSES, label, `${what}.cause`)
+      for (const key of ['refundFrozen', 'chargeAssessed', 'refundPaid', 'chargePaid']) int(r[key], label, `${what}.${key}`)
+      break
+    case 'advanceRefundPaid': case 'cancellationChargePaid': int(r.amount, label, `${what}.amount`, 1); int(r.remaining, label, `${what}.remaining`); break
+    case 'distributionExpired': int(r.availableUntilExclusive, label, `${what}.availableUntilExclusive`); oneOf(r.cause, ['window', 'rightsLost'], label, `${what}.cause`); break
+  }
+  if (kind === 'milestoneEarned' || kind === 'milestonePaid') oneOf(r.milestone, MILESTONE_KINDS, label, `${what}.milestone`)
+}
+
+/** Shape, identities, allocators, terms, the receipt log and the money law of the root alone. */
+export function validateTelevisionRoot(value: unknown, label: string): TelevisionRoot {
+  const root = rec(value, label, 'root')
+  exact(root, ['version', 'recordedFromWeek', 'nextSeries', 'nextSeason', 'nextAgreement', 'nextReceipt', 'series', 'seasons', 'agreements', 'receipts'], label, 'root')
+  if (root.version !== 1) fail(label, 'root version must be 1')
+  int(root.recordedFromWeek, label, 'root.recordedFromWeek')
+  for (const key of ['series', 'seasons', 'agreements', 'receipts']) {
+    if (!Array.isArray(root[key])) fail(label, `root.${key} must be an array`)
+  }
+  const series = root.series as unknown[]
+  const seasons = root.seasons as unknown[]
+  const agreements = root.agreements as unknown[]
+  const receipts = root.receipts as unknown[]
