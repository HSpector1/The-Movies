+    }
+    if (terms.dueWeek !== season.dueWeek || terms.finalWeek !== season.finalWeek) fail(label, `${what}.terms schedule disagrees with its season`)
+    for (const key of ['earned', 'received', 'advanceReturned', 'cancellationChargeAssessed', 'cancellationChargePaid']) int(a[key], label, `${what}.${key}`)
+    intOrNull(a.advanceRefundFrozen, label, `${what}.advanceRefundFrozen`)
+    const status = oneOf(a.status, AGREEMENT_STATUSES, label, `${what}.status`)
+    intOrNull(a.cancelledWeek, label, `${what}.cancelledWeek`)
+    if (!Array.isArray(a.milestones)) fail(label, `${what}.milestones must be an array`)
+    let earnedByMilestones = 0
+    let paidByMilestones = 0
+    a.milestones.forEach((m, i) => {
+      const row = rec(m, label, `${what}.milestones[${i}]`)
+      exact(row, ['kind', 'week', 'earned', 'paid'], label, `${what}.milestones[${i}]`)
+      if (oneOf(row.kind, MILESTONE_KINDS, label, `${what}.milestones[${i}].kind`) !== MILESTONE_KINDS[i]) fail(label, `${what}.milestones are out of order`)
+      int(row.week, label, `${what}.milestones[${i}].week`)
+      earnedByMilestones += int(row.earned, label, `${what}.milestones[${i}].earned`)
+      paidByMilestones += int(row.paid, label, `${what}.milestones[${i}].paid`)
+    })
+    if (earnedByMilestones !== a.earned) fail(label, `${what}.earned disagrees with its milestones`)
+    if ((terms.advance as number) + paidByMilestones !== a.received) fail(label, `${what}.received disagrees with the advance and the paid milestones`)
+    const seasonStatus = season.status
+    if ((status === 'live') !== (seasonStatus === 'live')) fail(label, `${what} and its season disagree on being live`)
+    if (seasonStatus === 'delivered' && status !== 'settled') fail(label, `${what} must be settled once its season is delivered`)
+    if (seasonStatus === 'cancelled' && status === 'live') fail(label, `${what} is live under a cancelled season`)
+    if ((seasonStatus === 'cancelled') !== (a.cancelledWeek !== null)) fail(label, `${what}.cancelledWeek disagrees with its season`)
+    try {
+      assertTvMoneyInvariant(a as unknown as TvAgreement)
+    } catch (error) {
+      fail(label, (error as Error).message)
+    }
+  })
+  let previousWeek = -1
+  receipts.forEach((row, index) => {
+    const r = rec(row, label, `receipts[${index}]`)
+    const kind = oneOf(r.kind, Object.keys(RECEIPT_FIELDS), label, `receipts[${index}].kind`) as TvReceiptKind
+    const what = `receipts[${index}] (${kind})`
+    exact(r, [...RECEIPT_BASE, ...RECEIPT_FIELDS[kind]], label, what)
+    sequentialId(r.receiptId, 'tv-receipt', index, label, `receipts[${index}].receiptId`)
+    const week = int(r.week, label, `${what}.week`)
+    if (week < previousWeek) fail(label, `${what} is dated before the receipt it follows`)
+    previousWeek = week
+    if (!(seasons as Record<string, unknown>[]).some((s) => s.seasonId === r.seasonId && s.agreementId === r.agreementId)) fail(label, `receipts[${index}] names no recorded season/agreement pair`)
+    validateReceiptFields(r, kind, label, what)
+  })
+  const validated = root as unknown as TelevisionRoot
+  replayTelevision(validated, label)
+  return validated
+}
+
+/** The ledger row one money receipt must have: its kind, signed amount and ledger week. */
+type LedgerExpectation = { receiptId: string; kind: TvLedgerKind; agreementId: string; amount: number; week: number }
+
+/**
+ * Replay every season's receipts under the contract's law and prove the season and agreement
+ * equal what the log implies. Returns the ledger row each money receipt must have.
+ */
+export function replayTelevision(root: TelevisionRoot, label: string): LedgerExpectation[] {
+  const expectations: LedgerExpectation[] = []
+  root.seasons.forEach((season, index) => {
+    const agreement = root.agreements[index]!
+    const terms = agreement.terms
+    const log = root.receipts.filter((receipt) => receipt.seasonId === season.seasonId)
+    let i = 0
+    function breaks(receipt: TvReceipt, why: string): never {
+      return fail(label, `receipt "${receipt.receiptId}" (${receipt.kind}) breaks the season law of "${season.seasonId}": ${why}`)
+    }
+    /** The next receipt must be exactly `draft`; returns it. */
+    const expectNext = (draft: Record<string, unknown> & { kind: TvReceiptKind; week: number }): TvReceipt => {
+      const receipt = log[i]
+      if (receipt === undefined) fail(label, `season "${season.seasonId}" is missing its ${draft.kind} receipt at week ${draft.week}`)
+      const { receiptId: _receiptId, ...body } = receipt as TvReceipt & Record<string, unknown>
+      const expected = { ...draft, seasonId: season.seasonId, agreementId: agreement.agreementId }
+      if (canonical(body) !== canonical(expected)) breaks(receipt, `expected ${canonical(expected)}`)
+      i++
+      return receipt
+    }
+    const C = season.commitWeek
+    expectNext({ kind: 'commissioned', week: C, seriesId: season.seriesId, commitWeek: C })
+    const advance = expectNext({ kind: 'advancePaid', week: C, amount: terms.advance })
+    expectations.push({ receiptId: advance.receiptId, kind: 'tvAdvance', agreementId: agreement.agreementId, amount: terms.advance, week: C })
+    let units = 0
+    let lastWeek: number | null = null
+    let earned = 0
+    let received = terms.advance
+    const milestones: TvMilestoneRecord[] = []
+    let writerReleased: number | null = null
+    let delivered: number | null = null
+    let cancelled: { week: number; cause: string } | null = null
+    let frozen = 0
+    let charge = 0
+    let returned = 0
+    let chargePaid = 0
+    let expired: number | null = null
+    const milestone = (kind: TvMilestoneKind, amount: number, week: number): void => {
+      earned += amount
+      const pay = tvMilestonePayment(earned, received)
+      expectNext({ kind: 'milestoneEarned', week, milestone: kind, amount })
+      if (pay > 0) {
+        const paid = expectNext({ kind: 'milestonePaid', week, milestone: kind, amount: pay })
+        expectations.push({ receiptId: paid.receiptId, kind: 'tvMilestonePayment', agreementId: agreement.agreementId, amount: pay, week: week - 1 })
+        received += pay
+      }
+      milestones.push({ kind, week, earned: amount, paid: pay })
+    }
+    while (i < log.length) {
+      const receipt = log[i]!
+      switch (receipt.kind) {
+        case 'unitCredited': {
+          if (delivered !== null || cancelled !== null) breaks(receipt, 'no work is credited after delivery or cancellation')
+          const unit = units + 1
+          const block = tvBlockOfUnit(unit)
+          if (block === null) breaks(receipt, `unit ${unit} is past the twelve-unit workload`)
+          const week = receipt.week
+          if (week <= (lastWeek ?? C) || week > season.finalWeek) breaks(receipt, `a unit is credited at most once per boundary inside (${lastWeek ?? C}, ${season.finalWeek}]`)
+          expectNext({ kind: 'unitCredited', week, block: block!, creditedUnits: unit })
+          expectations.push({ receiptId: receipt.receiptId, kind: 'tvProductionSpend', agreementId: agreement.agreementId, amount: -terms.unitSpend, week: week - 1 })
+          units = unit
+          lastWeek = week
+          if (unit === tvUnitsThrough(block!, tvBlockDefinition(block!).units)) {
+            expectNext({ kind: 'blockCompleted', week, block: block! })
+            if (block === 'scripts') {
+              milestone('scripts', terms.milestones.scripts, week)
+              expectNext({ kind: 'writerReleased', week, talentId: season.roster.writerId })
+              writerReleased = week
+            } else if (block === 'shooting') {
+              milestone('pictureLock', terms.milestones.pictureLock, week)
+            } else if (block === 'post') {
+              const deduction = tvLateDeduction(terms, week)
+              milestone('delivery', terms.milestones.delivery - deduction, week)
+              expectNext({ kind: 'delivered', week, deliveryWeek: week, lateWeeks: Math.max(0, week - terms.dueWeek), deduction })
+              delivered = week
+            }
+          }
+          break
+        }
+        case 'cancelled': {
+          if (delivered !== null || cancelled !== null) breaks(receipt, 'only a live season is cancelled, once')
+          const week = receipt.week
+          if (week < (lastWeek ?? C) || week > season.finalWeek) breaks(receipt, `a cancellation falls inside [${lastWeek ?? C}, ${season.finalWeek}]`)
+          if (receipt.cause === 'deadline' && week !== season.finalWeek) breaks(receipt, `a deadline cancellation falls at the final boundary ${season.finalWeek}`)
+          frozen = Math.max(0, terms.advance - earned)
+          charge = terms.cancellationCharge
+          const refundPaid = receipt.refundPaid
+          const paidCharge = receipt.chargePaid
+          if (refundPaid > frozen || paidCharge > charge || (paidCharge > 0 && refundPaid !== frozen)) {
+            breaks(receipt, `a cancellation pays at most the frozen refund ${frozen}, refund first, then at most K ${charge}`)
+          }
+          expectNext({ kind: 'cancelled', week, cause: receipt.cause, refundFrozen: frozen, chargeAssessed: charge, refundPaid, chargePaid: paidCharge })
+          cancelled = { week, cause: receipt.cause }
+          const ledgerWeek = TICK_CANCELLATION_CAUSES.includes(receipt.cause) ? week - 1 : week
+          if (refundPaid > 0) {
+            const paid = expectNext({ kind: 'advanceRefundPaid', week, amount: refundPaid, remaining: frozen - refundPaid })
+            expectations.push({ receiptId: paid.receiptId, kind: 'tvAdvanceRefund', agreementId: agreement.agreementId, amount: -refundPaid, week: ledgerWeek })
+          }
+          if (paidCharge > 0) {
+            const paid = expectNext({ kind: 'cancellationChargePaid', week, amount: paidCharge, remaining: charge - paidCharge })
+            expectations.push({ receiptId: paid.receiptId, kind: 'tvCancellationCharge', agreementId: agreement.agreementId, amount: -paidCharge, week: ledgerWeek })
+          }
+          returned = refundPaid
+          chargePaid = paidCharge
+          break
+        }
+        case 'advanceRefundPaid': {
+          if (cancelled === null || receipt.week < cancelled.week) breaks(receipt, 'a refund is paid only after a cancellation froze it')
+          const owed = frozen - returned
+          if (receipt.amount > owed) breaks(receipt, `the refund still owed is ${owed}`)
+          expectNext({ kind: 'advanceRefundPaid', week: receipt.week, amount: receipt.amount, remaining: owed - receipt.amount })
+          expectations.push({ receiptId: receipt.receiptId, kind: 'tvAdvanceRefund', agreementId: agreement.agreementId, amount: -receipt.amount, week: receipt.week })
+          returned += receipt.amount
+          break
+        }
+        case 'cancellationChargePaid': {
+          if (cancelled === null || receipt.week < cancelled.week) breaks(receipt, 'a charge is paid only after a cancellation assessed it')
+          if (frozen - returned > 0) breaks(receipt, 'the refund is paid before the charge')
+          const owed = charge - chargePaid
+          if (receipt.amount > owed) breaks(receipt, `the charge still owed is ${owed}`)
+          expectNext({ kind: 'cancellationChargePaid', week: receipt.week, amount: receipt.amount, remaining: owed - receipt.amount })
+          expectations.push({ receiptId: receipt.receiptId, kind: 'tvCancellationCharge', agreementId: agreement.agreementId, amount: -receipt.amount, week: receipt.week })
+          chargePaid += receipt.amount
+          break
+        }
+        case 'distributionExpired': {
+          if (delivered === null || expired !== null) breaks(receipt, 'only a delivered window expires, once')
+          const until = delivered + terms.distributionWeeks
+          if (receipt.week <= delivered || receipt.week > until) breaks(receipt, `an expiry falls inside (${delivered}, ${until}]`)
+          expectNext({ kind: 'distributionExpired', week: receipt.week, availableUntilExclusive: until, cause: receipt.week === until ? 'window' : 'rightsLost' })
+          expired = receipt.week
+          break
+        }
+        default:
+          breaks(receipt, `no ${receipt.kind} receipt is lawful here`)
+      }
+    }
+    // the season and the agreement are exactly what the log implies
+    const seasonSays = (field: string, log: unknown, stored: unknown): void => {
+      if (canonical(log) !== canonical(stored)) fail(label, `season "${season.seasonId}" disagrees with its receipts on ${field} (receipts ${canonical(log)}, season ${canonical(stored)})`)
+    }
+    const agreementSays = (field: string, log: unknown, stored: unknown): void => {
+      if (canonical(log) !== canonical(stored)) fail(label, `agreement "${agreement.agreementId}" disagrees with its receipts on ${field} (receipts ${canonical(log)}, agreement ${canonical(stored)})`)
+    }
+    seasonSays('creditedUnits', units, season.work.creditedUnits)
+    seasonSays('lastCreditedWeek', lastWeek, season.work.lastCreditedWeek)
+    seasonSays('writerReleasedWeek', writerReleased, season.writerReleasedWeek)
+    seasonSays('deliveredWeek', delivered, season.deliveredWeek)
+    seasonSays('cancelledWeek', cancelled?.week ?? null, season.cancelledWeek)
+    seasonSays('cancellationCause', cancelled?.cause ?? null, season.cancellationCause)
+    seasonSays('expiredRecordedWeek', expired, season.distribution?.expiredRecordedWeek ?? null)
+    agreementSays('earned', earned, agreement.earned)
+    agreementSays('received', received, agreement.received)
+    agreementSays('milestones', milestones, agreement.milestones)
+    agreementSays('advanceRefundFrozen', cancelled === null ? null : frozen, agreement.advanceRefundFrozen)
+    agreementSays('cancellationChargeAssessed', cancelled === null ? 0 : charge, agreement.cancellationChargeAssessed)
+    agreementSays('advanceReturned', returned, agreement.advanceReturned)
+    agreementSays('cancellationChargePaid', chargePaid, agreement.cancellationChargePaid)
+    agreementSays('cancelledWeek', cancelled?.week ?? null, agreement.cancelledWeek)
+    const owed = frozen - returned + charge - chargePaid
+    agreementSays('status', delivered !== null ? 'settled' : cancelled === null ? 'live' : owed === 0 ? 'settled' : 'cancelled', agreement.status)
+  })
+  return expectations
+}
+
+/** The non-empty-root refusal every frozen builder and the downgrade share; null when the root is empty and no TV row exists. */
+export function tvDowngradeRefusal(state: Record<string, unknown>): string | null {
+  const root = state.television
+  if (isRecord(root)) {
+    for (const key of ['series', 'seasons', 'agreements', 'receipts']) {
+      const rows = root[key]
+      if (Array.isArray(rows) && rows.length > 0) return `cannot downgrade or discard a recorded television ${key} row (${rows.length} recorded)`
+    }
+    for (const key of ['nextSeries', 'nextSeason', 'nextAgreement', 'nextReceipt']) {
+      if (root[key] !== 1) return `cannot downgrade or discard a television allocator that has moved (${key} = ${String(root[key])})`
+    }
+  }
+  if (Array.isArray(state.ledger) && state.ledger.some((row) => isRecord(row) && isTvLedgerKind(row.kind))) {
+    return 'cannot downgrade or discard a television ledger row'
+  }
+  return null
+}
+
+/** The state the predecessor chain proves: no root, no TV ledger row, cash net of those rows. Other keys keep their order. */
+export function televisionProjection(raw: Record<string, unknown>): Record<string, unknown> {
+  const projection = Object.fromEntries(Object.entries(raw).filter(([key]) => key !== TELEVISION_ROOT_KEY))
+  if (!Array.isArray(raw.ledger) || !isRecord(raw.studio) || typeof raw.studio.cash !== 'number') return projection
+  let net = 0
+  const ledger = raw.ledger.filter((row) => {
+    if (!isRecord(row) || !isTvLedgerKind(row.kind)) return true
+    if (typeof row.amount === 'number') net += row.amount
+    return false
+  })
+  return { ...projection, ledger, studio: { ...raw.studio, cash: raw.studio.cash - net } }
+}
+
+/**
+ * Every cross-root law: the producer is the player studio (contract §1 rival path deferred, REPORT
+ * (e)), capacity against real facilities, the adoption's exact chain and every other owner,
+ * people and the set; then every TV ledger row against the one receipt that records it.
+ */
+export function validateTelevisionState(state: GameState, label: string): void {
+  const root = state.television
+  const player = state.hollywood?.playerStudioId ?? null
+  const facilities = new Map(state.operations.facilities.map((facility) => [facility.id, facility]))
+  for (const season of root.seasons) {
+    const what = `season "${season.seasonId}"`
+    if (season.producerStudioId !== player) fail(label, `${what} names producer "${season.producerStudioId}", not the player studio "${String(player)}"`)
+    for (const reservation of season.reservations) {
+      const facility = facilities.get(reservation.facilityId)
+      if (facility === undefined) fail(label, `${what} reserves unknown facility "${reservation.facilityId}"`)
+      if (facility.capability !== reservation.capability) fail(label, `${what} reservation capability disagrees with facility "${reservation.facilityId}"`)
+      if (reservation.slot >= facility.capacity) fail(label, `${what} reservation is outside facility "${reservation.facilityId}"`)
+    }
+    if (season.setId !== null && !state.sets.some((set) => set.id === season.setId)) fail(label, `${what} names unknown set "${season.setId}"`)
+    for (const credit of season.credits) {
+      if (!state.talent.some((person) => person.id === credit.talentId)) fail(label, `${what} credits unknown talent "${credit.talentId}"`)
+      if (!(state.hollywood?.employment ?? []).some((row) => row.contractId === credit.contractId && row.terms.talentId === credit.talentId)) {
+        fail(label, `${what} credit "${credit.talentId}" names no recorded employment contract "${credit.contractId}"`)
+      }
+    }
+    if (season.status === 'live') {
+      const adoption = state.technology.adoptions.find((row) => row.id === season.adoptionId)
+      if (adoption === undefined || adoption.studioId !== season.producerStudioId) fail(label, `${what} names no adoption "${season.adoptionId}" of its producer`)
+      const stage = season.reservations.find((reservation) => reservation.capability === 'soundstage')
+      if (stage !== undefined && stage.facilityId !== adoption.stageFacilityId) fail(label, `${what} holds stage "${stage.facilityId}", not its adoption's stage "${adoption.stageFacilityId}"`)
+      const post = season.reservations.find((reservation) => reservation.capability === 'post')
+      if (post !== undefined && post.facilityId !== adoption.postFacilityId) fail(label, `${what} holds Post "${post.facilityId}", not its adoption's Post "${String(adoption.postFacilityId)}"`)
+      if (stage !== undefined && !state.sets.some((set) => set.id === season.setId && set.mountedOn === stage.facilityId)) {
+        fail(label, `${what} holds set "${String(season.setId)}", which does not stand on its stage "${stage.facilityId}"`)
+      }
+    }
+  }
+  if (root.seasons.some((season) => season.status === 'live')) {
+    assertNoDoubleBookedResourceSlots(state, (booking) => `${label}: television slot "${booking.key}" is claimed by ${booking.held.owner} "${booking.held.ownerId}" and ${booking.claimed.owner} "${booking.claimed.ownerId}"`)
+  }
+  // the ledger: every TV row is the one row of the one receipt that records the same payment
+  const expected = new Map(replayTelevision(root, label).map((row) => [row.receiptId, row]))
+  const agreements = new Set(root.agreements.map((agreement) => agreement.agreementId))
+  const rowsPerReceipt = new Map<string, number>()
+  state.ledger.forEach((row, index) => {
+    if (!isTvLedgerKind(row.kind)) return
+    const what = `ledger[${index}] ${row.kind}`
+    exact(row as unknown as Record<string, unknown>, ['week', 'kind', 'amount', 'note', 'tvAgreementId', 'tvReceiptId'], label, what)
+    const agreementId = str((row as { tvAgreementId?: unknown }).tvAgreementId, label, `${what}.tvAgreementId`)
+    if (!agreements.has(agreementId)) fail(label, `${what} names unknown agreement "${agreementId}"`)
+    if (!Number.isSafeInteger(row.amount) || row.amount === 0) fail(label, `${what} amount must be a non-zero integer`)
+    const positive = row.kind === 'tvAdvance' || row.kind === 'tvMilestonePayment'
+    if (positive !== row.amount > 0) fail(label, `${what} has the wrong sign`)
+    const receiptId = str((row as { tvReceiptId?: unknown }).tvReceiptId, label, `${what}.tvReceiptId`)
+    const want = expected.get(receiptId)
+    const receiptKind = LEDGER_RECEIPT_KIND[row.kind]
+    if (want === undefined || want.kind !== row.kind || want.agreementId !== agreementId) {
+      fail(label, `${what} names receipt "${receiptId}", which is not a ${receiptKind} receipt of agreement "${agreementId}"`)
+    }
+    if (row.amount !== want.amount) fail(label, `${what} amount ${row.amount} disagrees with receipt "${receiptId}" (${want.amount})`)
+    if (row.week !== want.week) fail(label, `${what} week ${row.week} disagrees with receipt "${receiptId}" (week ${want.week})`)
+    rowsPerReceipt.set(receiptId, (rowsPerReceipt.get(receiptId) ?? 0) + 1)
+  })
+  for (const want of expected.values()) {
+    const count = rowsPerReceipt.get(want.receiptId) ?? 0
+    if (count !== 1) fail(label, `receipt "${want.receiptId}" (${LEDGER_RECEIPT_KIND[want.kind]}) has ${count} ledger rows`)
+  }
+}
