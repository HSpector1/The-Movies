+// ── P18 bounded first season — the typed television records (`tv-limited-season/v1`) ─────
+//
+// Authority: 1367-stage/p18-prep/P18-FIRST-SEASON-CONTRACT.md (adopted 1367-G under 1342-O
+// ruling 10). One limited series, one commissioned six-episode season produced as ONE
+// twelve-unit workload, one typed external commissioner, one fixed-fee exclusive
+// distribution window. Six is delivery metadata, not six production clocks.
+//
+// Types only, plus the identity constants the contract names verbatim and the typed
+// visibility of each fact kind. No behaviour.
+
+import type { CastSlot, FacilityCapability } from './types.js'
+
+/** Contract §4: the provisional ruleset every season of this checkpoint is written under. */
+export const TV_RULESET_VERSION = 'tv-limited-season/v1' as const
+/** Contract §3: the versioned external party. It has no employees, facilities or rank. */
+export const TV_COMMISSIONER_ID = 'p18-limited-season-commissioner-v1' as const
+/** Contract §4: the five work blocks, in the only order they may run. */
+export const TV_WORK_BLOCK_ORDER = ['scripts', 'preparation', 'rehearsal', 'shooting', 'post'] as const
+export type TvWorkBlock = (typeof TV_WORK_BLOCK_ORDER)[number]
+/** The P16 licence use (`LicenceScope.use`) both authorities must carry. */
+export const TV_LICENCE_USE = 'television' as const
+
+/** The five player ledger kinds (contract §5), positive receipts first. */
+export const TV_LEDGER_KINDS = ['tvAdvance', 'tvMilestonePayment', 'tvProductionSpend', 'tvAdvanceRefund', 'tvCancellationCharge'] as const
+export type TvLedgerKind = (typeof TV_LEDGER_KINDS)[number]
+
+export type TvRole = 'writer' | 'director' | 'lead' | 'antagonist' | 'support' | 'craft'
+
+/**
+ * The grant-set READ PROJECTION (contract §3): two separately identified single-grantee P16
+ * authorities, never one multi-grantee licence. `productionAuthorityId` proves the producer's
+ * development, production and delivery permission; `distributionAuthorityId` proves the named
+ * commissioner's exclusive television distribution permission. Each authority carries the P16
+ * licence facts the consumer checks: its use (`LicenceScope.use`) and exclusivity
+ * (`Licence.exclusive`). Half-open upstream terms.
+ *
+ * CONTRACT GAP (P18, REPORT (d)): P16 is not landed at this base, so these facts arrive on the
+ * commission payload as an injected adapter input and are persisted on the season as provenance.
+ * Admission validates identity, party, scope, exclusivity and window cover; every later boundary
+ * asks the live `TvRightsAuthority`, whose default answers from the asking season's own grant.
+ * The P16 rebase replaces that default with `permissionFor(state, studioId, subject, 'R4', { use }, week)`.
+ */
+export type TvGrantFacts = {
+  propertyId: string
+  producerStudioId: string
+  productionAuthorityId: string
+  /** P16 `LicenceScope.use` of the production authority; admission requires `television`. */
+  productionScope: string
+  /** P16 `Licence.exclusive` of the production authority. Production needs no exclusivity. */
+  productionExclusive: boolean
+  /** Must exceed C + 20: the production authority covers permitted delivery. */
+  productionEndExclusive: number
+  commissionerId: string
+  distributionAuthorityId: string
+  /** P16 `LicenceScope.use` of the distribution authority; admission requires `television`. */
+  distributionScope: string
+  /** Must be true: the commissioner distributes under an EXCLUSIVE television licence (contract §3, §6). */
+  distributionExclusive: boolean
+  /** Must be at least C + 72: the whole possible availability interval. */
+  distributionEndExclusive: number
+}
+
+/**
+ * The live rights read (contract §3, §6; Codex review finding 1): exact subject, right, use,
+ * exclusivity, authority and week, asked at admission for every week the season could need,
+ * before every work unit and delivery (both rights), and for every distribution use.
+ */
+export type TvRight = 'produce' | 'distribute'
+export type TvRightsQuery = {
+  subjectStudioId: string
+  propertyId: string
+  right: TvRight
+  scope: typeof TV_LICENCE_USE
+  /** True when only an exclusive licence answers (distribution); false accepts any lawful holder. */
+  exclusive: boolean
+  authorityId: string
+  week: number
+}
+export type TvRightsAnswer = { ok: true } | { ok: false; reason: string }
+export type TvRightsAuthority = (query: TvRightsQuery) => TvRightsAnswer
+
+export type TvRoster = {
+  writerId: string
+  directorId: string
+  cast: Record<CastSlot, string>
+  craftId: string
+}
+
+/** A new series mints an identity; an existing one names its exact id (never its title). */
+export type TvSeriesRef = { kind: 'new'; title: string } | { kind: 'existing'; seriesId: string }
+
+export type CommissionTvSeasonPayload = {
+  series: TvSeriesRef
+  propertyId: string
+  /** An exact released film of this studio the series descends from, or null. Never a title. */
+  originProductionId: string | null
+  grant: TvGrantFacts
+  roster: TvRoster
+  /** The player's operational synchronized-dialogue adoption: its stage and Post are the chain. */
+  adoptionId: string
+}
+
+/** Immutable attribution frozen at commitment, each on the exact P12 employment record. */
+export type TvCredit = { talentId: string; name: string; role: TvRole; contractId: string }
+
+export type TvReservation = { facilityId: string; capability: FacilityCapability; slot: number }
+
+/** Why a scenery trip cannot be derived. The season withholds the trip exactly as the film law does. */
+export type TvSceneryWithheldReason = 'stage-has-no-body' | 'scenery-shop-has-no-body'
+
+export type TvStall =
+  | { kind: 'facility-capacity'; capability: FacilityCapability }
+  | { kind: 'set-unavailable' }
+  | { kind: 'scenery-load-in'; weeksRemaining: number }
+  | { kind: 'scenery-load-in-withheld'; reason: TvSceneryWithheldReason }
+  | { kind: 'cash'; required: number; available: number }
+
+export type TvSeasonWork = {
+  block: TvWorkBlock
+  /** 0..12, the counted units credited so far. */
+  creditedUnits: number
+  /** Units credited inside the current block. */
+  blockCredited: number
+  /** The boundary week the last unit was credited at; the same-week guard. */
+  lastCreditedWeek: number | null
+  stall: TvStall | null
+  /** The week the sound stage was acquired; the scenery load-in's called week. */
+  stageHeldSinceWeek: number | null
+}
+
+export type TvSeasonStatus = 'live' | 'delivered' | 'cancelled'
+export type TvCancellationCause = 'voluntary' | 'deadline' | 'rightsLost' | 'participantLost' | 'closure' | 'absorption'
+/** The two internal terminal causes the P15B closure and P16 absorption handlers name. */
+export type TvTerminalCause = Extract<TvCancellationCause, 'closure' | 'absorption'>
+
+export type TvDistributionWindow = {
+  availableFromWeek: number
+  availableUntilExclusive: number
+  expiredRecordedWeek: number | null
+}
+
+export type TvSeries = {
+  seriesId: string
+  title: string
+  propertyId: string
+  originProductionId: string | null
+  producerStudioId: string
+  createdWeek: number
+  seasonIds: string[]
+}
+
+export type TvSeason = {
+  seasonId: string
+  seriesId: string
+  workId: string
+  agreementId: string
+  producerStudioId: string
+  propertyId: string
+  commissionerId: string
+  seasonNumber: number
+  episodes: number
+  rulesetVersion: string
+  grant: TvGrantFacts
+  roster: TvRoster
+  credits: TvCredit[]
+  adoptionId: string
+  commitWeek: number
+  dueWeek: number
+  finalWeek: number
+  status: TvSeasonStatus
+  work: TvSeasonWork
+  reservations: TvReservation[]
+  /** The set bound with the stage; survives as the record of what was shot on. */
+  setId: string | null
+  writerReleasedWeek: number | null
+  deliveredWeek: number | null
+  cancelledWeek: number | null
+  cancellationCause: TvCancellationCause | null
+  distribution: TvDistributionWindow | null
+}
+
+export type TvMilestoneKind = 'scripts' | 'pictureLock' | 'delivery'
+
+/** Contract §5, frozen at acceptance so a later tuning change never rewrites an agreement. */
+export type TvAgreementTerms = {
+  fee: number
+  advance: number
+  milestones: Record<TvMilestoneKind, number>
+  unitSpend: number
+  dueWeek: number
+  finalWeek: number
+  lateDeductionPerWeek: number
+  lateDeductionMax: number
+  cancellationCharge: number
+  distributionWeeks: number
+}
+
+export type TvMilestoneRecord = { kind: TvMilestoneKind; week: number; earned: number; paid: number }
+export type TvAgreementStatus = 'live' | 'settled' | 'cancelled'
+
+export type TvAgreement = {
+  agreementId: string
+  seasonId: string
+  studioId: string
+  commissionerId: string
+  rulesetVersion: string
+  terms: TvAgreementTerms
+  /** E — cumulative earned fee, a noncash fact. */
+  earned: number
+  /** P — gross commissioning cash actually received, the advance included. */
+  received: number
+  /** R — advance principal actually returned. */
+  advanceReturned: number
+  /** U0 — the refund principal frozen at cancellation; null while live or after delivery. */
+  advanceRefundFrozen: number | null
+  /** K — assessed once at cancellation, else 0. */
+  cancellationChargeAssessed: number
+  cancellationChargePaid: number
+  milestones: TvMilestoneRecord[]
+  status: TvAgreementStatus
+  cancelledWeek: number | null
+}
+
+type TvReceiptBase = { receiptId: string; week: number; seasonId: string; agreementId: string }
+export type TvReceipt = TvReceiptBase & (
+  | { kind: 'commissioned'; seriesId: string; commitWeek: number }
+  | { kind: 'advancePaid'; amount: number }
+  | { kind: 'unitCredited'; block: TvWorkBlock; creditedUnits: number }
+  | { kind: 'blockCompleted'; block: TvWorkBlock }
+  | { kind: 'writerReleased'; talentId: string }
+  | { kind: 'milestoneEarned'; milestone: TvMilestoneKind; amount: number }
+  | { kind: 'milestonePaid'; milestone: TvMilestoneKind; amount: number }
+  | { kind: 'delivered'; deliveryWeek: number; lateWeeks: number; deduction: number }
+  | { kind: 'cancelled'; cause: TvCancellationCause; refundFrozen: number; chargeAssessed: number; refundPaid: number; chargePaid: number }
+  | { kind: 'advanceRefundPaid'; amount: number; remaining: number }
+  | { kind: 'cancellationChargePaid'; amount: number; remaining: number }
+  | { kind: 'distributionExpired'; availableUntilExclusive: number; cause: 'window' | 'rightsLost' }
+)
+export type TvReceiptKind = TvReceipt['kind']
+
+/**
+ * Contract §8 typed visibility. The commitment and the terminal facts (delivery, cancellation,
+ * distribution expiry) are public history; money, work progress and the writer's release are
+ * private terms of the agreement. Visibility is a property of the fact's TYPE, so it is a typed
+ * table rather than a stored per-row copy of the same fact.
+ */
+export type TvFactVisibility = 'public' | 'private'
+export const TV_RECEIPT_VISIBILITY: Readonly<Record<TvReceiptKind, TvFactVisibility>> = Object.freeze({
+  commissioned: 'public',
+  advancePaid: 'private',
+  unitCredited: 'private',
+  blockCompleted: 'private',
+  writerReleased: 'private',
+  milestoneEarned: 'private',
+  milestonePaid: 'private',
+  delivered: 'public',
+  cancelled: 'public',
+  advanceRefundPaid: 'private',
+  cancellationChargePaid: 'private',
+  distributionExpired: 'public',
+})
+
+export type TelevisionRoot = {
+  version: 1
+  recordedFromWeek: number
+  nextSeries: number
+  nextSeason: number
+  nextAgreement: number
+  nextReceipt: number
+  series: TvSeries[]
+  seasons: TvSeason[]
+  agreements: TvAgreement[]
+  receipts: TvReceipt[]
+}
+
+/** One outstanding existing-contract claim (contract §7), the P15 closed-claims integration record. */
+export type TvObligation = {
+  agreementId: string
+  studioId: string
+  counterpartyId: string
+  kind: 'advanceRefund' | 'cancellationCharge'
+  total: number
+  paid: number
+  outstanding: number
+  cancelledWeek: number
+}
