+/** The player's own third stage at a lawful origin chosen by `pick` among every legal one; ticked until operational. */
+function placeStage(state: GameState, pick: (origins: { gx: number; gy: number; distance: number }[]) => { gx: number; gy: number }): { state: GameState; stageId: string; placementId: number } {
+  const shop = facilityBodyCentre(state, SHOP)!
+  const origins: { gx: number; gy: number; distance: number }[] = []
+  for (let gy = 0; gy < 64; gy++) for (let gx = 0; gx < 64; gx++) {
+    if (queryPlacement(state, { blueprintId: 'stage-standard', origin: { gx, gy } }).ok) origins.push({ gx, gy, distance: gridDistance(shop, { gx: gx + 2, gy: gy + 2 }) })
+  }
+  const before = new Set(state.operations.facilities.map((f) => f.id))
+  state = applyActions(state, [{ kind: 'placeFacility', placement: { blueprintId: 'stage-standard', origin: pick(origins) } }])
+  const placementId = state.placement.facilities.at(-1)!.id
+  state = tickUntil(state, (s) => s.operations.facilities.some((f) => f.capability === 'soundstage' && !before.has(f.id)), TUNING.STAGE_STANDARD_BUILD_WEEKS + 2, 'third stage')
+  return { state, stageId: state.operations.facilities.find((f) => f.capability === 'soundstage' && !before.has(f.id))!.id, placementId }
