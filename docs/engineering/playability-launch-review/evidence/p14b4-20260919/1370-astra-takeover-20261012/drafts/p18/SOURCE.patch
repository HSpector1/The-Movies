+describe('F13e — the frozen P15C snapshot keeps its exact bytes through the Save51 era (contract §9)', () => {
+  // The genuine 2040 freeze minted by the landed Save45 writer (tests/fixtures/p15/p15c2-frozen-v2-save45, natural route L).
+  // P18 adds a root and a tick step; neither may move one byte of the frozen official Legacy: not the migration into the
+  // television era, not the public codec, not a P18 advance past the boundary, not the downgrade guard back to the predecessor.
+  const FROZEN = './fixtures/p15/p15c2-frozen-v2-save45/'
+  const sha256 = (text: string): string => createHash('sha256').update(text).digest('hex')
+  it('migration, the codec, one P18 advance and the downgrade leave the official Legacy byte-identical to the capture', () => {
+    const manifest = JSON.parse(readFileSync(new URL(`${FROZEN}MANIFEST.json`, import.meta.url), 'utf8')) as { officialSha256: string; capture: { name: string; sha256: string } }
+    const raw = gunzipSync(readFileSync(new URL(`${FROZEN}${manifest.capture.name}`, import.meta.url)))
+    expect(createHash('sha256').update(raw).digest('hex')).toBe(manifest.capture.sha256)
+    const captured = importSave(raw.toString('utf8'))
+    expect(captured.saveVersion).toBe(45) // the capture stays the genuine Save45 it was minted as, whatever the predecessor era
+    const officialOf = (state: { campaignLegacy: { official: unknown } }) => sha256(stableStringify(state.campaignLegacy.official))
+    const capturedState = captured.state as unknown as GameState
+    expect(officialOf(capturedState)).toBe(manifest.officialSha256)
+    const legacyBytes = stableStringify(capturedState.campaignLegacy)
+
+    const live = migrateToLive(captured)
+    expect(live.saveVersion).toBe(LIVE)
+    const migrated = live.state as GameState
+    expect(stableStringify(migrated.campaignLegacy)).toBe(legacyBytes)
+    expect(migrated.television).toEqual({ version: 1, recordedFromWeek: 6240, nextSeries: 1, nextSeason: 1, nextAgreement: 1, nextReceipt: 1,
+      series: [], seasons: [], agreements: [], receipts: [] })
+    // the television root is the only addition over the capture read in the predecessor era (Save45 here, Save50 after the rebase)
+    const { television: _television, ...withoutTelevision } = migrated
+    expect(stableStringify(withoutTelevision)).toBe(stableStringify(named(`migrateToV${PRED}`)(captured).state))
+
+    const reloaded = migrateToLive(importSave(exportSave(makeSave(migrated)))).state as GameState
+    expect(stableStringify(reloaded)).toBe(stableStringify(migrated))
+
+    const advanced = tick(reloaded)
+    expect(advanced.market.tick).toBe(6241)
+    expect(officialOf(advanced)).toBe(manifest.officialSha256)
+    expect(tv(advanced).receipts).toEqual([])
+
+    const down = convertDown()(makeSave(advanced))
+    expect(down.saveVersion).toBe(PRED)
+    expect(() => validatePredecessor()(down)).not.toThrow()
+    expect(sha256(stableStringify((down.state as { campaignLegacy: { official: unknown } }).campaignLegacy.official))).toBe(manifest.officialSha256)
+  }, 300_000)
+})
