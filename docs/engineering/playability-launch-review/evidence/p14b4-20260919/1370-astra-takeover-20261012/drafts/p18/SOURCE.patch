+/**
+ * The reviewer's probe-f route: a silent film on Soundstage 7 greenlit at the season's week C, its
+ * director assigned whenever its shooting task is unassigned; at C+4 an optional extra player action,
+ * then the film's take is scheduled and the C+4 advance runs. Returns the state at C+5, the week the
+ * film wraps while the season enters shooting.
+ */
+function filmBesideSeason(fixture: TvRouteFixture, atC: GameState, atC4?: (state: GameState) => GameState): { state: GameState; productionId: string; C: number } {
+  const C = atC.market.tick
+  const film = greenlightSilent(atC, fixture, 0)
+  let state = film.state
+  while (state.market.tick < C + 4) {
+    state = tick(state)
+    if (workflowOf(state, film.productionId).shootingTask?.status === 'unassigned') {
+      state = applyActions(state, [{ kind: 'assignShootingDirector', productionId: film.productionId, directorId: fixture.filmRoster.directorId }])
+    }
+  }
+  expect(workflowOf(state, film.productionId).reservations.map((r) => r.facilityId)).toContain(OTHER_STAGE)
+  if (atC4 !== undefined) state = atC4(state)
+  state = applyActions(state, [{ kind: 'scheduleShootingTake', productionId: film.productionId }])
+  return { state: tick(state), productionId: film.productionId, C }
+}
