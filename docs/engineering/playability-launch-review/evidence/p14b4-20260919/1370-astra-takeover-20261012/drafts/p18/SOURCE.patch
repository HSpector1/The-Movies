+// ── P18 bounded first season — bounded terms of `tv-limited-season/v1` (contract §4, §5) ──
+//
+// Every provisional figure the compact contract authored is a named TUNING constant with the
+// range the contract states. These are tuning hypotheses under 1342-O ruling 10, not measured
+// balance; a change is a versioned contract amendment and bumps TV_RULESET_VERSION.
+import { describe, expect, it } from 'vitest'
+import { TUNING } from '../src/core/tuning.js'
+import { TV_COMMISSIONER_ID, TV_RULESET_VERSION, TV_WORK_BLOCK_ORDER } from '../src/core/tvTypes.js'
+import { TV_WORK_BLOCKS, tvWorkUnitsTotal } from '../src/core/tvSeason.js'
+
+const positiveInteger = (n: number): boolean => Number.isSafeInteger(n) && n > 0
+
+describe('P18 tv-limited-season/v1 bounded terms', () => {
+  it('names the ruleset and the versioned external commissioner exactly as the contract does', () => {
+    expect(TV_RULESET_VERSION).toBe('tv-limited-season/v1')
+    expect(TV_COMMISSIONER_ID).toBe('p18-limited-season-commissioner-v1')
+  })
+
+  it('six episodes are delivery metadata; the workload is twelve counted units in the 3/1/1/4/3 order', () => {
+    expect(TUNING.TV_SEASON_EPISODES).toBe(6)
+    expect(TV_WORK_BLOCK_ORDER).toEqual(['scripts', 'preparation', 'rehearsal', 'shooting', 'post'])
+    expect(TV_WORK_BLOCKS.map((b) => b.block)).toEqual(TV_WORK_BLOCK_ORDER)
+    expect(TV_WORK_BLOCKS.map((b) => b.units)).toEqual([3, 1, 1, 4, 3])
+    expect([TUNING.TV_SCRIPT_UNITS, TUNING.TV_PREPARATION_UNITS, TUNING.TV_REHEARSAL_UNITS, TUNING.TV_SHOOTING_UNITS, TUNING.TV_POST_UNITS])
+      .toEqual([3, 1, 1, 4, 3])
+    expect(tvWorkUnitsTotal()).toBe(12)
+    for (const block of TV_WORK_BLOCKS) expect(positiveInteger(block.units)).toBe(true)
+  })
+
+  it('each block names the capabilities the contract table requires', () => {
+    const byBlock = Object.fromEntries(TV_WORK_BLOCKS.map((b) => [b.block, [...b.capabilities]]))
+    expect(byBlock).toEqual({
+      scripts: ['development-casting'],
+      preparation: ['development-casting'],
+      rehearsal: ['soundstage'],
+      shooting: ['soundstage', 'set-scenery'],
+      post: ['post'],
+    })
+  })
+
+  it('money terms are integer dollars in the contract §5 table and reconcile with each other', () => {
+    expect(TUNING.TV_SEASON_FEE).toBe(600_000)
+    expect(TUNING.TV_SEASON_ADVANCE).toBe(120_000)
+    expect(TUNING.TV_MILESTONE_SCRIPTS).toBe(120_000)
+    expect(TUNING.TV_MILESTONE_PICTURE_LOCK).toBe(240_000)
+    expect(TUNING.TV_MILESTONE_DELIVERY).toBe(240_000)
+    expect(TUNING.TV_UNIT_SPEND).toBe(25_000)
+    expect(TUNING.TV_CANCELLATION_CHARGE).toBe(120_000)
+    expect(TUNING.TV_LATE_DEDUCTION_PER_WEEK).toBe(12_000)
+    expect(TUNING.TV_LATE_DEDUCTION_MAX).toBe(48_000)
+    for (const n of [TUNING.TV_SEASON_FEE, TUNING.TV_SEASON_ADVANCE, TUNING.TV_MILESTONE_SCRIPTS, TUNING.TV_MILESTONE_PICTURE_LOCK,
+      TUNING.TV_MILESTONE_DELIVERY, TUNING.TV_UNIT_SPEND, TUNING.TV_CANCELLATION_CHARGE, TUNING.TV_LATE_DEDUCTION_PER_WEEK,
+      TUNING.TV_LATE_DEDUCTION_MAX]) expect(positiveInteger(n)).toBe(true)
+    // the three milestones are the whole fee; the advance is fully recoupable from the first one
+    expect(TUNING.TV_MILESTONE_SCRIPTS + TUNING.TV_MILESTONE_PICTURE_LOCK + TUNING.TV_MILESTONE_DELIVERY).toBe(TUNING.TV_SEASON_FEE)
+    expect(TUNING.TV_SEASON_ADVANCE).toBeLessThanOrEqual(TUNING.TV_MILESTONE_SCRIPTS)
+    // twelve credited units are the $300,000 the contract states
+    expect(TUNING.TV_UNIT_SPEND * tvWorkUnitsTotal()).toBe(300_000)
+  })
+
+  it('schedule terms: due C+16, final C+20, four late weeks cap the deduction at the stated maximum', () => {
+    expect(TUNING.TV_DUE_WEEKS).toBe(16)
+    expect(TUNING.TV_FINAL_WEEKS).toBe(20)
+    expect(TUNING.TV_FINAL_WEEKS).toBeGreaterThan(TUNING.TV_DUE_WEEKS)
+    expect(TUNING.TV_LATE_DEDUCTION_PER_WEEK * (TUNING.TV_FINAL_WEEKS - TUNING.TV_DUE_WEEKS)).toBe(TUNING.TV_LATE_DEDUCTION_MAX)
+    expect(TUNING.TV_LATE_DEDUCTION_MAX).toBeLessThan(TUNING.TV_MILESTONE_DELIVERY)
+    // the twelve-unit minimum route fits inside the due boundary
+    expect(tvWorkUnitsTotal()).toBeLessThanOrEqual(TUNING.TV_DUE_WEEKS)
+  })
+
+  it('distribution is 52 half-open weeks from accepted delivery; the admission quote covers the full production window', () => {
+    expect(TUNING.TV_DISTRIBUTION_WEEKS).toBe(52)
+    expect(TUNING.TV_ADMISSION_QUOTE_WEEKS).toBe(TUNING.TV_FINAL_WEEKS)
+    expect(TUNING.TV_ADMISSION_CASH_FLOOR).toBe(300_000)
+    expect(TUNING.TV_ADMISSION_CASH_FLOOR).toBe(TUNING.TV_UNIT_SPEND * tvWorkUnitsTotal())
+    expect(TUNING.TV_ADMISSION_CANCELLATION_PROVISION).toBe(TUNING.TV_CANCELLATION_CHARGE)
+    for (const n of [TUNING.TV_DISTRIBUTION_WEEKS, TUNING.TV_ADMISSION_QUOTE_WEEKS, TUNING.TV_ADMISSION_CASH_FLOOR,
+      TUNING.TV_ADMISSION_CANCELLATION_PROVISION]) expect(positiveInteger(n)).toBe(true)
+  })
