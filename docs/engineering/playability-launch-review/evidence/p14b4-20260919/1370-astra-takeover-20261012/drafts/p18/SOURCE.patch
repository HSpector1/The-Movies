+// ── P18 — the pure money law of `tv-limited-season/v1` (contract §5, §7) ────────────────
+//
+// E = cumulative earned fee (noncash). P = gross commissioning cash received, advance
+// included. R = advance principal returned. Live: R = 0 and a milestone pays
+// max(0, E_new − P). Cancellation freezes U0 = max(0, A − E) and assesses K once; the
+// outstanding refund is max(0, U0 − R), never U0 again after a partial return. Invariant after
+// any settlement attempt: P − R = E + advanceRefundUnpaid and K = paid + unpaid.
+//
+// Every payment moves WHOLE dollars: available cash is floor(max(0, cash)), so a fractional
+// balance pays what it can and keeps its residue (contract §7 "from available nonnegative cash").
+//
+// Pure: no RNG, no clock. The law reads no studio id; arrears are summed per producer.
+
+import { TUNING } from './tuning.js'
+import { TV_COMMISSIONER_ID, TV_RULESET_VERSION } from './tvTypes.js'
+import type { TelevisionRoot, TvAgreement, TvAgreementTerms, TvObligation, TvReceipt } from './tvTypes.js'
+import type { GameState, LedgerEntry } from './types.js'
+
+export function tvTermsFor(commitWeek: number): TvAgreementTerms {
+  if (!Number.isSafeInteger(commitWeek) || commitWeek < 0) throw new Error(`tv settlement: commit week must be a whole week (got ${String(commitWeek)})`)
+  return {
+    fee: TUNING.TV_SEASON_FEE,
+    advance: TUNING.TV_SEASON_ADVANCE,
+    milestones: { scripts: TUNING.TV_MILESTONE_SCRIPTS, pictureLock: TUNING.TV_MILESTONE_PICTURE_LOCK, delivery: TUNING.TV_MILESTONE_DELIVERY },
+    unitSpend: TUNING.TV_UNIT_SPEND,
+    dueWeek: commitWeek + TUNING.TV_DUE_WEEKS,
+    finalWeek: commitWeek + TUNING.TV_FINAL_WEEKS,
+    lateDeductionPerWeek: TUNING.TV_LATE_DEDUCTION_PER_WEEK,
+    lateDeductionMax: TUNING.TV_LATE_DEDUCTION_MAX,
+    cancellationCharge: TUNING.TV_CANCELLATION_CHARGE,
+    distributionWeeks: TUNING.TV_DISTRIBUTION_WEEKS,
+  }
+}
+
+/** Live milestone payment: max(0, E_new − P). Ordinarily scripts pays $0 (the advance recoups). */
+export function tvMilestonePayment(earnedAfter: number, received: number): number {
+  return Math.max(0, earnedAfter - received)
+}
+
+/** 12,000 × max(0, T − (C+16)), at most 48,000. A delivery past C+20 is not priced: it is forbidden. */
+export function tvLateDeduction(terms: TvAgreementTerms, deliveryWeek: number): number {
+  if (!Number.isSafeInteger(deliveryWeek)) throw new Error(`tv settlement: delivery week must be a whole week (got ${String(deliveryWeek)})`)
+  if (deliveryWeek > terms.finalWeek) {
+    throw new Error(`tv settlement: delivery at week ${deliveryWeek} is past the final permitted boundary ${terms.finalWeek}`)
+  }
+  return Math.min(terms.lateDeductionMax, terms.lateDeductionPerWeek * Math.max(0, deliveryWeek - terms.dueWeek))
+}
+
+export function tvDeliveryMilestoneEarned(terms: TvAgreementTerms, deliveryWeek: number): number {
+  return terms.milestones.delivery - tvLateDeduction(terms, deliveryWeek)
+}
+
+/** Whole dollars a payment may move from `cash`: floor(max(0, cash)). The fractional residue never moves. */
+export function tvAvailableWholeDollars(cash: number): number {
+  if (!Number.isFinite(cash)) throw new Error(`tv settlement: available cash must be a finite number (got ${String(cash)})`)
+  return Math.floor(Math.max(0, cash))
+}
+
+export function tvOutstanding(agreement: TvAgreement): { advanceRefund: number; cancellationCharge: number; total: number } {
+  const frozen = agreement.advanceRefundFrozen ?? 0
+  const advanceRefund = Math.max(0, frozen - agreement.advanceReturned)
+  const cancellationCharge = Math.max(0, agreement.cancellationChargeAssessed - agreement.cancellationChargePaid)
+  return { advanceRefund, cancellationCharge, total: advanceRefund + cancellationCharge }
+}
+
+/** Freeze U0 and assess K once. A no-op on anything but a live agreement. */
+export function freezeTvCancellation(agreement: TvAgreement, week: number): TvAgreement {
+  if (agreement.status !== 'live') return agreement
+  return {
+    ...agreement,
+    status: 'cancelled',
+    cancelledWeek: week,
+    advanceRefundFrozen: Math.max(0, agreement.terms.advance - agreement.earned),
+    cancellationChargeAssessed: agreement.terms.cancellationCharge,
+  }
+}
+
+/** Apply a whole-dollar payment to the remaining refund first, then the remaining charge. */
+export function applyTvObligationPayment(agreement: TvAgreement, amount: number): { agreement: TvAgreement; refund: number; charge: number } {
+  if (agreement.status !== 'cancelled') throw new Error('tv settlement: only a cancelled agreement with outstanding obligations accepts a payment')
+  if (!Number.isSafeInteger(amount) || amount <= 0) throw new Error('tv settlement: amount must be a positive whole-dollar integer')
+  const outstanding = tvOutstanding(agreement)
+  if (amount > outstanding.total) throw new Error('tv settlement: amount exceeds the outstanding balance')
+  const refund = Math.min(amount, outstanding.advanceRefund)
+  const charge = amount - refund
+  const next: TvAgreement = {
+    ...agreement,
+    advanceReturned: agreement.advanceReturned + refund,
+    cancellationChargePaid: agreement.cancellationChargePaid + charge,
+  }
+  const settled = tvOutstanding(next).total === 0
+  return { agreement: settled ? { ...next, status: 'settled' } : next, refund, charge }
+}
+
+export function assertTvMoneyInvariant(agreement: TvAgreement): void {
+  const fail = (detail: string): never => { throw new Error(`tv money invariant (${agreement.agreementId}): ${detail}`) }
+  for (const [key, n] of Object.entries({ earned: agreement.earned, received: agreement.received, advanceReturned: agreement.advanceReturned,
+    cancellationChargeAssessed: agreement.cancellationChargeAssessed, cancellationChargePaid: agreement.cancellationChargePaid })) {
+    if (!Number.isSafeInteger(n) || n < 0) fail(`${key} must be a non-negative integer`)
+  }
+  if (agreement.advanceRefundFrozen !== null && (!Number.isSafeInteger(agreement.advanceRefundFrozen) || agreement.advanceRefundFrozen < 0)) {
+    fail('advanceRefundFrozen must be null or a non-negative integer')
+  }
+  if (agreement.earned > agreement.terms.fee) fail('earned exceeds the contracted fee')
+  if (agreement.cancellationChargePaid > agreement.cancellationChargeAssessed) fail('charge paid exceeds the charge assessed')
+  if (agreement.advanceReturned > (agreement.advanceRefundFrozen ?? 0)) fail('advance returned exceeds the frozen refund principal')
+  const outstanding = tvOutstanding(agreement)
+  const unearned = agreement.status === 'live' || agreement.advanceRefundFrozen === null
+    ? Math.max(0, agreement.terms.advance - agreement.earned)
+    : outstanding.advanceRefund
+  if (agreement.received - agreement.advanceReturned !== agreement.earned + unearned) fail('P − R must equal E + the unearned advance')
+  if (agreement.cancellationChargeAssessed !== agreement.cancellationChargePaid + outstanding.cancellationCharge) fail('K must equal paid + unpaid')
+  if (agreement.status === 'live' && (agreement.advanceReturned !== 0 || agreement.cancellationChargeAssessed !== 0 || agreement.advanceRefundFrozen !== null)) {
+    fail('a live agreement has no return, charge or frozen principal')
+  }
+  if (agreement.status === 'settled' && outstanding.total !== 0) fail('a settled agreement has nothing outstanding')
+  if (agreement.status === 'cancelled' && outstanding.total === 0) fail('a cancelled agreement with nothing outstanding is settled')
+  if (agreement.status !== 'live' && agreement.status !== 'settled' && agreement.status !== 'cancelled') fail('unknown status')
+}
+
+/** Every outstanding claim, oldest cancellation first then agreement id — the P15 closed-claims record. */
+export function tvObligations(state: Pick<GameState, 'television'>): TvObligation[] {
+  const rows: TvObligation[] = []
+  const cancelled = state.television.agreements
+    .filter((agreement) => agreement.status === 'cancelled' && agreement.cancelledWeek !== null)
+    .sort((a, b) => (a.cancelledWeek! - b.cancelledWeek!) || (a.agreementId < b.agreementId ? -1 : a.agreementId > b.agreementId ? 1 : 0))
+  for (const agreement of cancelled) {
+    const outstanding = tvOutstanding(agreement)
+    const base = { agreementId: agreement.agreementId, studioId: agreement.studioId, counterpartyId: agreement.commissionerId, cancelledWeek: agreement.cancelledWeek! }
+    if (outstanding.advanceRefund > 0) {
+      rows.push({ ...base, kind: 'advanceRefund', total: agreement.advanceRefundFrozen ?? 0, paid: agreement.advanceReturned, outstanding: outstanding.advanceRefund })
+    }
+    if (outstanding.cancellationCharge > 0) {
+      rows.push({ ...base, kind: 'cancellationCharge', total: agreement.cancellationChargeAssessed, paid: agreement.cancellationChargePaid, outstanding: outstanding.cancellationCharge })
+    }
+  }
+  return rows
+}
+
+/** One producer's unpaid refunds and charges: while positive, that producer may not be admitted a new season. */
+export function tvArrearsOutstanding(state: Pick<GameState, 'television'>, studioId: string): number {
+  return tvObligations(state).filter((row) => row.studioId === studioId).reduce((sum, row) => sum + row.outstanding, 0)
+}
+
+// ── receipts and ledger rows: the two correlated records every payment writes ──────────
+
+/** A receipt without its id, per kind (a distributive omit keeps every arm's own fields). */
+export type TvReceiptDraft = TvReceipt extends infer R ? (R extends TvReceipt ? Omit<R, 'receiptId'> : never) : never
+
+/** The id the next appended receipt will carry. */
+export function tvNextReceiptId(root: TelevisionRoot): string {
+  return `tv-receipt-${String(root.nextReceipt).padStart(4, '0')}`
+}
+
+export function appendTvReceipt(root: TelevisionRoot, draft: TvReceiptDraft): TelevisionRoot {
+  const receiptId = tvNextReceiptId(root)
+  return { ...root, nextReceipt: root.nextReceipt + 1, receipts: [...root.receipts, { ...draft, receiptId } as TvReceipt] }
+}
+
+/** A TV cash row: correlated to its agreement AND to the one receipt that records the same payment. */
+export function tvLedgerRow(week: number, kind: LedgerEntry['kind'] & `tv${string}`, amount: number, agreementId: string, receiptId: string, note: string): LedgerEntry {
+  if (!Number.isSafeInteger(amount) || amount === 0) throw new Error(`tv ledger: ${kind} amount must be a non-zero whole-dollar integer`)
+  return { week, kind, amount, note, tvAgreementId: agreementId, tvReceiptId: receiptId } as LedgerEntry
+}
+
+export type SettleTvObligationsRequest = { agreementId: string; expectedRemaining: number; amount: number }
+
+/** The public `settleTvObligations` refusal, or null. Reads no closure root: the parent gates actual closure. */
+export function settleTvObligationsRefusal(state: GameState, request: SettleTvObligationsRequest): string | null {
+  const agreement = state.television.agreements.find((row) => row.agreementId === request.agreementId)
+  if (agreement === undefined) return `no TV agreement "${request.agreementId}"`
+  if (agreement.status !== 'cancelled') return `agreement "${request.agreementId}" has no outstanding obligation (status ${agreement.status})`
+  const remaining = tvOutstanding(agreement).total
+  if (!Number.isSafeInteger(request.expectedRemaining) || request.expectedRemaining !== remaining) {
+    return `expectedRemaining ${String(request.expectedRemaining)} is stale; the outstanding balance of "${request.agreementId}" differs`
+  }
+  if (!Number.isSafeInteger(request.amount) || request.amount <= 0) return 'amount must be a positive whole-dollar integer'
+  if (request.amount > remaining) return `amount ${request.amount} exceeds the outstanding balance`
+  if (request.amount > tvAvailableWholeDollars(state.studio.cash)) return `amount ${request.amount} exceeds available nonnegative cash`
+  return null
+}
+
+/** Pay a lawful portion: refund first, then the charge; exact receipts; no interest, refinancing or forgiveness. */
+export function settleTvObligations(state: GameState, request: SettleTvObligationsRequest): GameState {
+  const refusal = settleTvObligationsRefusal(state, request)
+  if (refusal !== null) throw new Error(`applyActions: settleTvObligations rejected — ${refusal}`)
+  const week = state.market.tick
+  const agreement = state.television.agreements.find((row) => row.agreementId === request.agreementId)!
+  const paid = applyTvObligationPayment(agreement, request.amount)
+  assertTvMoneyInvariant(paid.agreement)
+  let root: TelevisionRoot = { ...state.television, agreements: state.television.agreements.map((row) => row === agreement ? paid.agreement : row) }
+  const ledger: LedgerEntry[] = []
+  const outstanding = tvOutstanding(paid.agreement)
+  if (paid.refund > 0) {
+    const receiptId = tvNextReceiptId(root)
+    root = appendTvReceipt(root, { kind: 'advanceRefundPaid', week, seasonId: agreement.seasonId, agreementId: agreement.agreementId, amount: paid.refund, remaining: outstanding.advanceRefund })
+    ledger.push(tvLedgerRow(week, 'tvAdvanceRefund', -paid.refund, agreement.agreementId, receiptId, `tv advance refund ${agreement.agreementId}`))
+  }
+  if (paid.charge > 0) {
+    const receiptId = tvNextReceiptId(root)
+    root = appendTvReceipt(root, { kind: 'cancellationChargePaid', week, seasonId: agreement.seasonId, agreementId: agreement.agreementId, amount: paid.charge, remaining: outstanding.cancellationCharge })
+    ledger.push(tvLedgerRow(week, 'tvCancellationCharge', -paid.charge, agreement.agreementId, receiptId, `tv cancellation charge ${agreement.agreementId}`))
+  }
+  return { ...state, television: root, studio: { ...state.studio, cash: state.studio.cash - request.amount }, ledger: [...state.ledger, ...ledger] }
+}
+
+export { TV_COMMISSIONER_ID, TV_RULESET_VERSION }
