+/** A film on the film company with NO sound method: the allocator takes the first free stage, Soundstage 7. */
+function greenlightSilent(state: GameState, fixture: TvRouteFixture, conceptIndex: number): { state: GameState; productionId: string } {
+  const writer = state.talent.find((t) => t.role === 'writer' && t.id !== fixture.roster.writerId)!
