+}
+
+export type TvSweepOutcome = { reservations: TvReservation[]; setId: string | null }
+type TvAllocation = ({ ok: true } & TvSweepOutcome) | { ok: false; stall: TvStall }
+
+/**
+ * Acquire what `block` requires, retaining what the season already holds. The sound chain is
+ * exact: the soundstage must be the adoption's stage and Post its Post. Rehearsal acquires the
+ * stage+set composite atomically (`productionPhases.ts` §3.2); shooting retains both.
+ */
+export function allocateTvBlock(season: TvSeason, block: TvWorkBlockDefinition, context: TvAllocationContext): TvAllocation {
+  const occupied = new Set(context.occupied)
+  const facilities = boundedStableSort([...context.operations.facilities], compareId).filter((facility) =>
+    facility.capability === 'soundstage' ? facility.id === context.stageFacilityId
+      : facility.capability === 'post' ? facility.id === context.postFacilityId
+        : true)
+  const reservations: TvReservation[] = []
+  let setId = season.setId
+  const needsStage = block.capabilities.includes('soundstage')
+  const retainingStage = needsStage && season.reservations.some((reservation) => reservation.capability === 'soundstage')
+  if (needsStage && !retainingStage) {
+    const stage = facilities.find((facility) => facility.capability === 'soundstage')
+    if (stage === undefined) return { ok: false, stall: { kind: 'facility-capacity', capability: 'soundstage' } }
+    let free = -1
+    for (let slot = 0; slot < stage.capacity; slot++) {
+      if (!occupied.has(facilitySlotKey(stage.id, slot))) { free = slot; break }
+    }
+    if (free < 0) return { ok: false, stall: { kind: 'facility-capacity', capability: 'soundstage' } }
+    const candidates = bindableSetsOn(context.sets, stage.id, context.heldSets)
+    if (candidates.length === 0) return { ok: false, stall: { kind: 'set-unavailable' } }
+    setId = candidates[0]!.id
+  }
+  for (const capability of block.capabilities) {
+    const retained = season.reservations.find((reservation) => reservation.capability === capability)
+    if (retained !== undefined) {
+      reservations.push(retained)
+      occupied.add(reservationKey(retained))
+      continue
+    }
+    let allocated: TvReservation | null = null
+    for (const facility of facilities) {
+      if (facility.capability !== capability) continue
+      for (let slot = 0; slot < facility.capacity; slot++) {
+        const key = facilitySlotKey(facility.id, slot)
+        if (occupied.has(key)) continue
+        allocated = { facilityId: facility.id, capability, slot }
+        occupied.add(key)
+        break
+      }
+      if (allocated !== null) break
+    }
+    if (allocated === null) return { ok: false, stall: { kind: 'facility-capacity', capability } }
+    reservations.push(allocated)
+  }
+  return { ok: true, reservations, setId }
+}
+
+/**
+ * Weeks the scenery still has to travel from the shop to the stage (0 when it is on the stage), or
+ * the reason the trip cannot be derived. The film law withholds an underivable trip and never
+ * guesses (`sceneryLoadIn.ts`); the season does the same: it waits, it is never waived.
+ */
+export function tvSceneryLoadIn(state: Pick<GameState, 'placement' | 'property'>, season: TvSeason, week: number): number | TvSceneryWithheldReason {
+  const stage = season.reservations.find((reservation) => reservation.capability === 'soundstage')
+  const scenery = season.reservations.find((reservation) => reservation.capability === 'set-scenery')
+  const called = season.work.stageHeldSinceWeek
+  if (stage === undefined || scenery === undefined || called === null) return 0
+  const to = facilityBodyCentre(state, stage.facilityId)
+  if (to === null) return 'stage-has-no-body'
+  const from = facilityBodyCentre(state, scenery.facilityId)
+  if (from === null) return 'scenery-shop-has-no-body'
+  return Math.max(0, sceneryLoadInWeeksForDistance(gridDistance(from, to)) - (week - called))
+}
+
+function replaceSeason(root: TelevisionRoot, season: TvSeason): TelevisionRoot {
+  return { ...root, seasons: root.seasons.map((row) => row.seasonId === season.seasonId ? season : row) }
+}
+
+function replaceAgreement(root: TelevisionRoot, agreement: TvAgreement): TelevisionRoot {
+  return { ...root, agreements: root.agreements.map((row) => row.agreementId === agreement.agreementId ? agreement : row) }
+}
+
+function agreementFor(root: TelevisionRoot, season: TvSeason): TvAgreement {
+  const agreement = root.agreements.find((row) => row.agreementId === season.agreementId)
+  if (agreement === undefined) throw new Error(`tv season: season ${season.seasonId} names no agreement ${season.agreementId}`)
+  return agreement
+}
+
+/** The production right, asked live for the boundary the work would reach (contract §3, §6; finding 1). */
+export function tvProductionRight(season: TvSeason, rights: TvRightsAuthority, week: number): ReturnType<TvRightsAuthority> {
+  return rights({ subjectStudioId: season.producerStudioId, propertyId: season.propertyId, right: 'produce', scope: TV_LICENCE_USE, exclusive: false,
+    authorityId: season.grant.productionAuthorityId, week })
+}
+
+/**
+ * Why the advance W → W+1 must cancel the live season before any work, or null. Both rights of
+ * the grant set are asked for the boundary T = W+1 the work would reach: a production right that
+ * no longer covers T, or an exclusive distribution right that no longer covers T (so it cannot
+ * cover delivery), cancels for rightsLost. Read by the sweep (a doomed season acquires nothing)
+ * and by the money step (which performs the cancellation).
+ */
+export function tvAdvancePreflight(state: GameState, season: TvSeason, week: number, rights: TvRightsAuthority): TvCancellationCause | null {
+  if (week >= season.finalWeek) return 'deadline'
+  const boundary = week + 1
+  if (!tvProductionRight(season, rights, boundary).ok) return 'rightsLost'
+  if (!tvDistributionRight(season, rights, boundary).ok) return 'rightsLost'
+  for (const talentId of tvRequiredParticipants(season)) {
+    if (activeContract(state, talentId, week) === undefined || lifecycleStatus(state, talentId) === 'retired') return 'participantLost'
+  }
+  return null
+}
+
+/** The season's place in the admitted-work order: weeks it has waited beyond its credited units. */
+export function tvWaitWeeks(season: TvSeason, week: number): number {
+  return Math.max(0, week - season.commitWeek - season.work.creditedUnits)
+}
+
+export type TvSweepRequest = {
+  seasonId: string
+  participant: SweepParticipant
+  /** The cause of the last refused attempt this sweep; read after the sweep when no outcome came back. */
+  failure: { stall: TvStall | null }
+}
+
+/**
+ * The live season as a typed participant of the week's one allocation sweep. Returns null when
+ * nothing may be requested (no live season, not managed, founding open). A season the money step
+ * will cancel this advance keeps what it holds and takes nothing new. `rights` is an explicit live
+ * authority; absent, the season's own grant answers.
+ */
+export function tvSweepRequest(state: GameState, week: number, rights?: TvRightsAuthority): TvSweepRequest | null {
+  const season = liveTvSeason(state.television)
+  if (season === null || state.founding !== null || state.operations.mode !== 'managed') return null
+  const held = new Set(season.reservations.map(reservationKey))
+  const failure: TvSweepRequest['failure'] = { stall: null }
+  const adoption = state.technology.adoptions.find((row) => row.id === season.adoptionId)
+  if (adoption === undefined || adoption.postFacilityId === null) {
+    throw new Error(`tv season: live season "${season.seasonId}" names no operational adoption "${season.adoptionId}"`)
+  }
+  const doomed = tvAdvancePreflight(state, season, week, tvSeasonRights(season, rights)) !== null
+  const block = tvBlockDefinition(season.work.block)
+  const participant: SweepParticipant = {
+    id: season.seasonId,
+    kind: 'tvSeason',
+    waitWeeks: tvWaitWeeks(season, week),
+    held,
+    attempt: (occupiedByOthers, operations, sets) => {
+      if (doomed) return { held, result: { reservations: season.reservations, setId: season.setId } satisfies TvSweepOutcome }
+      const allocation = allocateTvBlock(season, block, {
+        operations, sets, occupied: occupiedByOthers, heldSets: heldSetIds(operations),
+        stageFacilityId: adoption.stageFacilityId, postFacilityId: adoption.postFacilityId!,
+      })
+      if (!allocation.ok) {
+        failure.stall = allocation.stall
+        return null
+      }
+      return { held: new Set(allocation.reservations.map(reservationKey)), result: { reservations: allocation.reservations, setId: allocation.setId } satisfies TvSweepOutcome }
+    },
+  }
+  return { seasonId: season.seasonId, participant, failure }
+}
+
+/** Write the sweep's answer onto the season: what it now holds, or why it waits. */
+export function applyTvSweep(root: TelevisionRoot, request: TvSweepRequest, outcome: TvSweepOutcome | undefined, week: number): TelevisionRoot {
+  const season = root.seasons.find((row) => row.seasonId === request.seasonId)
+  if (season === undefined || season.status !== 'live') return root
+  if (outcome === undefined) {
+    return replaceSeason(root, { ...season, work: { ...season.work, stall: request.failure.stall ?? season.work.stall } })
+  }
+  const acquiredStage = outcome.reservations.some((r) => r.capability === 'soundstage') && !season.reservations.some((r) => r.capability === 'soundstage')
+  return replaceSeason(root, {
+    ...season,
+    reservations: outcome.reservations,
+    setId: outcome.setId,
+    work: { ...season.work, stall: null, stageHeldSinceWeek: acquiredStage ? week : season.work.stageHeldSinceWeek },
+  })
+}
+
+type MoneyStep = { root: TelevisionRoot; cash: number; ledger: LedgerEntry[] }
+
+/** Earn a milestone at boundary T and pay max(0, E_new − P) at the advance week W. */
+function earnMilestone(step: MoneyStep, season: TvSeason, kind: TvMilestoneKind, amount: number, boundary: number, ledgerWeek: number): MoneyStep {
+  const agreement = agreementFor(step.root, season)
+  const earned = agreement.earned + amount
+  const pay = tvMilestonePayment(earned, agreement.received)
+  const next: TvAgreement = {
+    ...agreement,
+    earned,
+    received: agreement.received + pay,
+    milestones: [...agreement.milestones, { kind, week: boundary, earned: amount, paid: pay }],
+  }
+  let root = replaceAgreement(step.root, next)
+  root = appendTvReceipt(root, { kind: 'milestoneEarned', week: boundary, seasonId: season.seasonId, agreementId: agreement.agreementId, milestone: kind, amount })
+  const ledger = [...step.ledger]
+  let cash = step.cash
+  if (pay > 0) {
+    const receiptId = tvNextReceiptId(root)
+    root = appendTvReceipt(root, { kind: 'milestonePaid', week: boundary, seasonId: season.seasonId, agreementId: agreement.agreementId, milestone: kind, amount: pay })
+    ledger.push(tvLedgerRow(ledgerWeek, 'tvMilestonePayment', pay, agreement.agreementId, receiptId, `tv ${kind} milestone ${agreement.agreementId}`))
+    cash += pay
+  }
+  return { root, cash, ledger }
+}
+
+export type TvCancellationWeeks = { boundary: number; ledger: number }
+
+/**
+ * The one cancellation settlement (contract §7): freeze U0, assess K once, release capacity and
+ * people once, and — when `pay` — settle from available nonnegative cash in WHOLE dollars, refund
+ * first, then K; whatever cannot be paid stays an explicit agreement obligation and the fractional
+ * residue stays in cash. The closure path passes `pay: false`: P15's estate owns those payments.
+ * Callers guard liveness: the public verb refuses a non-live season, the terminal path is a no-op.
+ */
+export function cancelTvSeasonCore(root: TelevisionRoot, seasonId: string, weeks: TvCancellationWeeks, cause: TvCancellationCause,
+  cash: number, pay: boolean): MoneyStep {
+  const season = root.seasons.find((row) => row.seasonId === seasonId)
+  if (season === undefined) throw new Error(`tv season: no TV season "${seasonId}"`)
+  if (season.status !== 'live') throw new Error(`tv season: season "${seasonId}" is not live (status ${season.status})`)
+  let agreement = freezeTvCancellation(agreementFor(root, season), weeks.boundary)
+  let refundPaid = 0
+  let chargePaid = 0
+  if (pay) {
+    const outstanding = tvOutstanding(agreement)
+    let available = tvAvailableWholeDollars(cash)
+    refundPaid = Math.min(outstanding.advanceRefund, available)
+    available -= refundPaid
+    chargePaid = Math.min(outstanding.cancellationCharge, available)
+    const total = refundPaid + chargePaid
+    if (total > 0) {
+      agreement = applyTvObligationPayment(agreement, total).agreement
+      cash -= total
+    }
+  }
+  assertTvMoneyInvariant(agreement)
+  const cancelled: TvSeason = {
+    ...season,
+    status: 'cancelled',
+    cancelledWeek: weeks.boundary,
+    cancellationCause: cause,
+    reservations: [],
+    work: { ...season.work, stall: null },
+  }
+  let next = replaceAgreement(replaceSeason(root, cancelled), agreement)
+  const outstanding = tvOutstanding(agreement)
+  next = appendTvReceipt(next, { kind: 'cancelled', week: weeks.boundary, seasonId, agreementId: agreement.agreementId, cause,
+    refundFrozen: agreement.advanceRefundFrozen ?? 0, chargeAssessed: agreement.cancellationChargeAssessed, refundPaid, chargePaid })
+  const ledger: LedgerEntry[] = []
+  if (refundPaid > 0) {
+    const receiptId = tvNextReceiptId(next)
+    next = appendTvReceipt(next, { kind: 'advanceRefundPaid', week: weeks.boundary, seasonId, agreementId: agreement.agreementId, amount: refundPaid, remaining: outstanding.advanceRefund })
+    ledger.push(tvLedgerRow(weeks.ledger, 'tvAdvanceRefund', -refundPaid, agreement.agreementId, receiptId, `tv advance refund ${agreement.agreementId}`))
+  }
+  if (chargePaid > 0) {
+    const receiptId = tvNextReceiptId(next)
+    next = appendTvReceipt(next, { kind: 'cancellationChargePaid', week: weeks.boundary, seasonId, agreementId: agreement.agreementId, amount: chargePaid, remaining: outstanding.cancellationCharge })
+    ledger.push(tvLedgerRow(weeks.ledger, 'tvCancellationCharge', -chargePaid, agreement.agreementId, receiptId, `tv cancellation charge ${agreement.agreementId}`))
+  }
+  return { root: next, cash, ledger }
+}
+
+/** The public `cancelTvSeason` verb: the producer cancels explicitly before accepted delivery. */
+export function cancelTvSeason(state: GameState, seasonId: string): GameState {
+  const season = state.television.seasons.find((row) => row.seasonId === seasonId)
+  if (season === undefined) throw new Error(`applyActions: cancelTvSeason rejected — no TV season "${seasonId}"`)
+  if (season.status !== 'live') throw new Error(`applyActions: cancelTvSeason rejected — season "${seasonId}" is not live (status ${season.status})`)
+  const week = state.market.tick
+  const result = cancelTvSeasonCore(state.television, seasonId, { boundary: week, ledger: week }, 'voluntary', state.studio.cash, true)
+  return { ...state, television: result.root, studio: { ...state.studio, cash: result.cash }, ledger: [...state.ledger, ...result.ledger] }
+}
+
+/**
+ * The internal terminal path the P15B closure handler and the P16 absorption handler call
+ * (contract §7). A season that is no longer live is a no-op: repeating an internal terminal
+ * policy performs no new work, payment, charge or id allocation. `closure` moves no cash: the
+ * obligations stay frozen for the estate's claim union (`tvObligations`). `absorption` cancels
+ * under the same disclosed terms in the seller's account: refund first, then K, from its
+ * available nonnegative cash in whole dollars, the rest recorded unpaid.
+ */
+export function cancelTvSeasonAtTerminalEvent(state: GameState, seasonId: string, week: number, cause: TvTerminalCause): GameState {
+  const season = state.television.seasons.find((row) => row.seasonId === seasonId)
+  if (season === undefined) throw new Error(`tv season: terminal ${cause} names no TV season "${seasonId}"`)
+  if (season.status !== 'live') return state
+  const result = cancelTvSeasonCore(state.television, seasonId, { boundary: week, ledger: week }, cause, state.studio.cash, cause === 'absorption')
+  return { ...state, television: result.root, studio: { ...state.studio, cash: result.cash }, ledger: [...state.ledger, ...result.ledger] }
+}
+
+export type TelevisionAdvanceFacts = {
+  /** Cash after this week's mandatory studio charges. */
+  cash: number
+  /** The sets root this advance will finalize (wear applies here). */
+  sets: readonly StudioSet[]
+  /** An explicit live authority; absent, every season's own grant answers. */
+  rights?: TvRightsAuthority | undefined
+}
+
+export type TelevisionAdvance = { television: TelevisionRoot; cash: number; ledger: LedgerEntry[]; sets: readonly StudioSet[] }
+
+/**
+ * Tick step 7.7, the MONEY step: at most one valid paid work unit for the live season at advance
+ * W → W+1 on the capacity the week's one sweep granted it, with milestones, delivery and the
+ * final-boundary cancellation resolved at T = W + 1. Runs after the week's mandatory charges
+ * (contract §5) so "available cash" is literal; it allocates nothing (finding 4).
+ */
+export function advanceTelevisionWeek(state: GameState, facts: TelevisionAdvanceFacts, week: number): TelevisionAdvance {
+  const boundary = week + 1
+  const rightsFor = (season: TvSeason): TvRightsAuthority => tvSeasonRights(season, facts.rights)
+  let root = recordTvDistributionExpiry(state.television, boundary, rightsFor)
+  let cash = facts.cash
+  const ledger: LedgerEntry[] = []
+  let sets = facts.sets
+  const season = liveTvSeason(root)
+  if (season === null || state.founding !== null || state.operations.mode !== 'managed') return { television: root, cash, ledger, sets }
+  const done = (): TelevisionAdvance => ({ television: root, cash, ledger, sets })
+  const cancel = (cause: TvCancellationCause): TelevisionAdvance => {
+    const result = cancelTvSeasonCore(root, season.seasonId, { boundary, ledger: week }, cause, cash, true)
+    root = result.root
+    cash = result.cash
+    ledger.push(...result.ledger)
+    return done()
+  }
+  const finishBoundary = (): TelevisionAdvance => {
+    const current = root.seasons.find((row) => row.seasonId === season.seasonId)!
+    // Resolve lawful delivery first; an incomplete season at T = C + 20 cancels for deadline failure.
+    if (current.status === 'live' && boundary >= current.finalWeek) return cancel('deadline')
+    return done()
+  }
+  // No advance beginning at the final boundary performs work; both rights and the people are asked live.
+  const preflight = tvAdvancePreflight(state, season, week, rightsFor(season))
+  if (preflight !== null) return cancel(preflight)
+
+  const block = tvBlockDefinition(season.work.block)
+  let working = season
+  const holdsAll = block.capabilities.every((capability) => working.reservations.some((reservation) => reservation.capability === capability))
+  if (!holdsAll) {
+    // The sweep already wrote why it waits (`applyTvSweep`); a season with no recorded cause names the first missing capability.
+    if (working.work.stall === null) {
+      const missing = block.capabilities.find((capability) => !working.reservations.some((reservation) => reservation.capability === capability))!
+      root = replaceSeason(root, { ...working, work: { ...working.work, stall: { kind: 'facility-capacity', capability: missing } } })
+    }
+    return finishBoundary()
+  }
+  if (working.work.block === 'shooting') {
+    const loadIn = tvSceneryLoadIn(state, working, week)
+    if (typeof loadIn === 'string') {
+      root = replaceSeason(root, { ...working, work: { ...working.work, stall: { kind: 'scenery-load-in-withheld', reason: loadIn } } })
+      return finishBoundary()
+    }
+    if (loadIn > 0) {
+      root = replaceSeason(root, { ...working, work: { ...working.work, stall: { kind: 'scenery-load-in', weeksRemaining: loadIn } } })
+      return finishBoundary()
+    }
+  }
+  const agreement = agreementFor(root, working)
+  if (cash < agreement.terms.unitSpend) {
+    root = replaceSeason(root, { ...working, work: { ...working.work, stall: { kind: 'cash', required: agreement.terms.unitSpend, available: cash } } })
+    return finishBoundary()
+  }
+  // The real expense and the unit, atomically: one receipt, one ledger row correlated to it.
+  cash -= agreement.terms.unitSpend
+  const creditedUnits = working.work.creditedUnits + 1
+  const blockCredited = working.work.blockCredited + 1
+  working = { ...working, work: { ...working.work, creditedUnits, blockCredited, lastCreditedWeek: boundary, stall: null } }
+  const unitReceiptId = tvNextReceiptId(root)
+  root = appendTvReceipt(root, { kind: 'unitCredited', week: boundary, seasonId: working.seasonId, agreementId: agreement.agreementId, block: working.work.block, creditedUnits })
+  ledger.push(tvLedgerRow(week, 'tvProductionSpend', -agreement.terms.unitSpend, agreement.agreementId, unitReceiptId,
+    `tv unit ${creditedUnits}/${tvWorkUnitsTotal()} ${working.work.block} ${working.seasonId}`))
+  if (blockCredited === block.units) {
+    root = appendTvReceipt(root, { kind: 'blockCompleted', week: boundary, seasonId: working.seasonId, agreementId: agreement.agreementId, block: working.work.block })
+    let money: MoneyStep = { root, cash, ledger: [] }
+    switch (working.work.block) {
+      case 'scripts': {
+        money = earnMilestone(money, working, 'scripts', agreement.terms.milestones.scripts, boundary, week)
+        working = { ...working, writerReleasedWeek: boundary }
+        money.root = appendTvReceipt(money.root, { kind: 'writerReleased', week: boundary, seasonId: working.seasonId, agreementId: agreement.agreementId, talentId: working.roster.writerId })
+        break
+      }
+      case 'shooting': {
+        money = earnMilestone(money, working, 'pictureLock', agreement.terms.milestones.pictureLock, boundary, week)
+        sets = wearSetAtWrap(sets, working.setId)
+        break
+      }
+      case 'post': {
+        const deduction = tvLateDeduction(agreement.terms, boundary)
+        money = earnMilestone(money, working, 'delivery', agreement.terms.milestones.delivery - deduction, boundary, week)
+        const settled = agreementFor(money.root, working)
+        money.root = replaceAgreement(money.root, { ...settled, status: 'settled' })
+        working = {
+          ...working,
+          status: 'delivered',
+          deliveredWeek: boundary,
+          reservations: [],
+          distribution: { availableFromWeek: boundary, availableUntilExclusive: boundary + agreement.terms.distributionWeeks, expiredRecordedWeek: null },
+        }
+        money.root = appendTvReceipt(money.root, { kind: 'delivered', week: boundary, seasonId: working.seasonId, agreementId: agreement.agreementId,
+          deliveryWeek: boundary, lateWeeks: Math.max(0, boundary - agreement.terms.dueWeek), deduction })
+        break
+      }
+      case 'preparation':
+      case 'rehearsal':
+        break
+    }
+    root = money.root
+    cash = money.cash
+    ledger.push(...money.ledger)
+    if (working.status === 'live') {
+      const next = nextTvBlock(working.work.block)
+      if (next === null) throw new Error(`tv season: block ${working.work.block} completed with no successor and no delivery`)
+      const retained = tvBlockDefinition(next).capabilities
+      working = {
+        ...working,
+        reservations: working.reservations.filter((reservation) => retained.includes(reservation.capability)),
+        work: { ...working.work, block: next, blockCredited: 0 },
+      }
+    }
+  }
+  root = replaceSeason(root, working)
+  assertTvMoneyInvariant(agreementFor(root, working))
+  return finishBoundary()
+}
