+}
+const until = (endExclusive: number, right: 'produce' | 'distribute'): TvRightsAuthority => (q) =>
+  q.right !== right || q.week < endExclusive ? { ok: true } : { ok: false, reason: `${right} authority ends at ${endExclusive}` }
+const REVOKE_PRODUCE: TvRightsAuthority = (q) => q.right === 'produce' ? { ok: false, reason: `production authority revoked at week ${q.week}` } : { ok: true }
+const REVOKE_DISTRIBUTE: TvRightsAuthority = (q) => q.right === 'distribute' ? { ok: false, reason: `distribution authority revoked at week ${q.week}` } : { ok: true }
+const refusal = (preview: { refusal: string | null }): string => preview.refusal ?? 'ADMITTED (no refusal)'
+const isTv = (row: LedgerEntry): boolean => row.kind.startsWith('tv')
+/** Cash the TV step was handed: the cash before the advance plus every non-TV row the advance appended. */
+const cashEnteringTvStep = (before: GameState, after: GameState): number =>
+  before.studio.cash + after.ledger.slice(before.ledger.length).filter((row) => !isTv(row)).reduce((sum, row) => sum + row.amount, 0)
+const reload = (state: GameState): GameState => migrateToLive(importSave(exportSave(makeSave(state)))).state as GameState
