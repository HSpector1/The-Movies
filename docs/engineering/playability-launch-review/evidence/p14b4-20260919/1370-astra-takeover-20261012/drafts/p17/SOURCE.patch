+    expect(booking.quote).toEqual({ perceivedActingOVR: 20, fame: 85, ruleVersion: P17_CAMEO_RULE_VERSION, capabilityVersion: P17_CAMEO_CAPABILITY_VERSION, profileVersion: P17_CAMEO_PROFILE_VERSION })
