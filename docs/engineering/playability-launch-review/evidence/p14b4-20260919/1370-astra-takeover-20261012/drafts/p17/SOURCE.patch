+// ── The expected state after a migration into the P17 era (P17 r2 pin sweep, review T14) ───────────
+//
+// convertPredecessorToP17 (src/core/save.ts) adds P17's two roots EMPTY, after every predecessor key, and infers
+// nothing from old films. A test that compares a migrated live state with its old input wraps the expected side
+// once here, at the place R8's own `withEmptyRecovery` wraps it (tests/helpers/recovery-migration-expectation.ts
+// on db3fc572). Comparison oracle only; never a producer or reader input.
+import { initialP17Roots, p17DowngradeRefusal, stripP17Roots } from '../../src/core/continuationSave.js'
+
+export function withEmptyP17Roots<T extends object>(state: T): T & ReturnType<typeof initialP17Roots> {
+  return { ...state, ...initialP17Roots() }
+}
+
+/** An older-era projection of a live state (a forged old envelope, a frozen-digest control) drops P17's two
+ * top-level roots only while they hold nothing: the guard-before-strip form the P15 roots take
+ * (tests/helpers/p15-roots.ts). A lineage edge or a cameo booking is real authority, and the strip would hide it,
+ * so the guard is the production downgrade's own refusal. A state from an older era carries no root and reads as empty. */
+export function stripEmptyP17Roots<T extends object>(state: T, label: string): T {
+  const refusal = p17DowngradeRefusal(state as Record<string, unknown>)
+  if (refusal !== null) throw new Error(`${label}: ${refusal}; the P17 strip would hide real authority`)
+  return stripP17Roots(state) as unknown as T
+}
