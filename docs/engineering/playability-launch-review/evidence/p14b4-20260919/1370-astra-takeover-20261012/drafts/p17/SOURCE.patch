+/** Hand-built P16 stand-in: a film→property map and a studio→property grant set, answered as P16's
+ * `rightsAuthority(subject R1, 'R3', week, scope)` would answer (Codex review 2026-10-10 finding 4). */
+function rightsOf(propertyOf: Record<string, string>, grants: Record<string, string[]>): ContinuationRights {
+  return {
+    storyPropertyOf: (filmId) => propertyOf[filmId] ?? null,
+    authority: ({ storyPropertyId }) => {
+      const holder = Object.keys(grants).find((studioId) => grants[studioId]!.includes(storyPropertyId))
+      return holder === undefined ? { kind: 'unavailable', reason: 'noHolder' } : { kind: 'authority', studioId: holder }
+    },
+  }
+}
+
+type WorldSpec = { week: number; root?: FranchiseRoot; rights: ContinuationRights; released?: FilmResult[]; locked?: string[] }
+function world(spec: WorldSpec): ContinuationWorld {
+  const released = new Map((spec.released ?? []).map((r) => [r.productionId, r]))
+  return {
+    week: spec.week,
+    franchises: spec.root ?? emptyFranchiseRoot(),
+    rights: spec.rights,
+    releasedFilm: (id) => {
+      const r = released.get(id)
+      return r ? { result: r, audience01: r.segmentScores.adult / 100 } : null
+    },
+    isLocked: (id) => (spec.locked ?? []).includes(id),
+  }
