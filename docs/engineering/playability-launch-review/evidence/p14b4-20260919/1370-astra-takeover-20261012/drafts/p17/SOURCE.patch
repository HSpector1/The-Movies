+  // person, fee inputs, basis, retirement facts, booking occupancy and studio money.
+  const quoteToken = JSON.stringify([
+    P17_CAMEO_RULE_VERSION, P17_CAMEO_CAPABILITY_VERSION, P17_CAMEO_PROFILE_VERSION, args.studioId, greenlightWeek, talent.id, workWeek, basis, profession,
+    perceivedActingOVR, talent.fame, fee, current?.status ?? null, current?.effectiveWeek ?? null, actorEpisode?.status ?? null, otherWeeks, state.studio.cash,
+  ])
+  const shooting = nominalShootingWeeks(greenlightWeek)
+  const onSchedule = shooting.includes(workWeek)
+  const readinessRisk =
+    `${talent.name} works one week only: week ${workWeek}. The appearance completes only if the picture performs shooting work that week ` +
+    `(standard schedule: weeks ${shooting.join(' and ')}; a managed picture shoots only after its take is scheduled). ` +
+    (onSchedule ? '' : `Week ${workWeek} is not a standard shooting week of this picture, so on the standard schedule the appearance is missed. `) +
+    `A missed or cancelled appearance retains ${money(retained)} of the ${money(fee)} fee and refunds ${money(fee - retained)}.`
+  const disclosures = otherWeeks.map((w) => `Also reserved for a guest appearance in week ${w}.`)
+  if (basis === 'employee') disclosures.push('Booked as an own-employee appearance: if their employment ends before the work week, the booking is cancelled with the standard refund.')
+  return {
+    ok: true, talentId: talent.id, name: talent.name, profession, basis, greenlightWeek, workWeek, fee, retained, refundable: fee - retained,
+    perceivedActingOVR, fame: talent.fame, nominalShootingWeeks: shooting, readinessRisk, disclosures, quoteToken,
+  }
+}
+
+/** The player's cameo quote for a guest and one work week at this week's greenlight (cameo contract §4: "A quote must
+ * state that readiness risk"). An unaccepted quote changes no state. */
+export function cameoQuote(state: GameState, args: { talentId: string; workWeek: number }): CameoQuoteResult {
