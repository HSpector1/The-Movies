+
+    // ── meters: release counts and peaks are reads of the installment list ──
+    const releasedOn = (pred: (e: Edge) => boolean): Edge[] => edges.filter((e) => e.releasedWeek !== null && pred(e))
+    const spinoffBranchIds = new Set([...branches.values()].filter((b) => b.kind === 'spinoff').map((b) => b.id))
+    if (meter.firstFilmExempt !== true) fail(`${pl}.meter`, 'the property meter keeps its first-film exemption flag')
+    if (meter.releaseCount !== releasedOn((e) => !spinoffBranchIds.has(e.branchId)).length) fail(`${pl}.meter`, 'releaseCount is the number of released main/reboot installments')
+    if (meter.peakInstallmentId !== null && !releasedOn((e) => e.child === meter.peakInstallmentId).length) fail(`${pl}.meter`, `peakInstallmentId ${String(meter.peakInstallmentId)} is not a released installment of the property`)
+    for (const [subId, subMeter] of subs) {
+      const branchId = spinoffOf.get(subId)
+      const own = branchId === undefined ? [] : releasedOn((e) => e.branchId === branchId)
+      if (subMeter.releaseCount !== own.length) fail(`${pl}.subProperties.${subId}.meter`, 'releaseCount is the number of released films on its spin-off continuity')
+      if (subMeter.peakInstallmentId !== null && !own.some((e) => e.child === subMeter.peakInstallmentId)) fail(`${pl}.subProperties.${subId}.meter`, `peakInstallmentId ${String(subMeter.peakInstallmentId)} is not a released film of its spin-off continuity`)
+    }
+
+    // ── milestones: closed enum, append-only, each a reading of its continuity's own gaps (rev02 §10) ──
+    const milestoneFilms = new Set<string>()
+    let lastWeek = -1
+    arr(prop.milestones, `${pl}.milestones`).forEach((m, j) => {
+      const ml = `${pl}.milestones[${j}]`
+      const milestone = rec(m, ml)
+      exactKeys(milestone, ['milestoneId', 'productionId', 'week'], ml)
+      enumOf(milestone.milestoneId, MILESTONE_IDS, `${ml}.milestoneId`)
+      const productionId = str(milestone.productionId, `${ml}.productionId`)
+      const week = num(milestone.week, `${ml}.week`, { int: true, min: 0, max: ctx.week })
+      if (milestoneFilms.has(productionId)) fail(ml, `duplicate milestone for ${productionId}`)
+      milestoneFilms.add(productionId)
+      if (week < lastWeek) fail(ml, 'milestones are appended in week order')
+      lastWeek = week
+      const edge = byChild.get(productionId)
+      if (edge === undefined || edge.releasedWeek !== week) fail(ml, `${productionId} is not an installment released at week ${week}`)
+      const earlier = edges.filter((e) => e.branchId === edge.branchId && e.releasedWeek !== null && e.releasedWeek < week).map((e) => e.releasedWeek!)
+      const previous = earlier.length === 0 ? null : Math.max(...earlier)
+      if (previous === null || week - previous < TUNING.P17_DORMANT_WEEKS) fail(ml, `activeAgain needs a prior gap of at least ${TUNING.P17_DORMANT_WEEKS} weeks on continuity ${edge.branchId}`)
+    })
+  })
+  for (let n = 1; n < nextOrdinal; n++) {
+    if (!ordinals.has(n)) fail(`${label}.nextOrdinal`, `nextOrdinal ${nextOrdinal} skips ordinal ${n}: every minted ordinal names a persisted id`)
+  }
+}
+
+const BOOKING_KEYS = ['bookingId', 'studioId', 'productionId', 'talentId', 'workWeek', 'bookedWeek', 'basis', 'profession', 'fee', 'retained', 'quote', 'status', 'completedWeek', 'completedExecution', 'cancelledWeek', 'cancelReason', 'refund', 'releasedWeek', 'careerEvent'] as const
+const STATUSES = ['reserved', 'completed', 'cancelled'] as const
+const BASES = ['employee', 'freelance'] as const
+const PROFESSIONS = ['writer', 'director', 'actor', 'craft', 'scientist'] as const
+const CANCEL_REASONS = ['explicit', 'missedWork', 'productionCancelled', 'employmentExit', 'rightsLoss'] as const
+
+type BookingFacts = { id: string; productionId: string; talentId: string; bookedWeek: number; workWeek: number; fee: number; status: (typeof STATUSES)[number]; cancelledWeek: number | null; refund: number | null; label: string }
+
+export function validateCameoRoot(raw: unknown, label: string, ctx: P17ValidationContext): asserts raw is CameoRoot {
+  const root = rec(raw, label)
+  exactKeys(root, ['version', 'nextOrdinal', 'bookings'], label)
+  if (root.version !== 1) fail(label, 'version must be 1')
+  const nextOrdinal = num(root.nextOrdinal, `${label}.nextOrdinal`, { int: true, min: 1 })
+  const bookings = arr(root.bookings, `${label}.bookings`)
+  if (nextOrdinal !== bookings.length + 1) fail(`${label}.nextOrdinal`, `nextOrdinal ${nextOrdinal} is not one past the ${bookings.length} minted bookings (bookings are never deleted)`)
+  const facts: BookingFacts[] = []
+  const liveWeeks = new Set<string>()
+  // ── 1. each booking, leaf-exact, with its frozen quote and its own facts ──
+  bookings.forEach((b, i) => {
+    const bl = `${label}.bookings[${i}]`
+    const booking = rec(b, bl)
+    exactKeys(booking, BOOKING_KEYS, bl)
+    const id = str(booking.bookingId, `${bl}.bookingId`)
+    if (id !== `cameo-${i + 1}`) fail(bl, `bookingId ${id} is not the ordinal-minted cameo-${i + 1}`)
+    const studioId = str(booking.studioId, `${bl}.studioId`)
+    const talentId = str(booking.talentId, `${bl}.talentId`)
+    if (!ctx.talentIds.has(talentId)) fail(bl, `talentId ${talentId} is not a known person`)
+    const productionId = str(booking.productionId, `${bl}.productionId`)
+    if (!ctx.productionIds.has(productionId)) fail(bl, `productionId ${productionId} is not a persisted production`)
+    const bookedWeek = num(booking.bookedWeek, `${bl}.bookedWeek`, { int: true, min: TUNING.P17_CAMEO_UNLOCK_WEEK, max: ctx.week })
+    if (!ctx.isPlayerStudioAt(studioId, bookedWeek)) fail(bl, `studio ${studioId} was not the player studio at week ${bookedWeek}; no other studio has a booking route at this checkpoint`)
+    const workWeek = num(booking.workWeek, `${bl}.workWeek`, { int: true, min: 0 })
+    if (!(bookedWeek < workWeek && workWeek <= bookedWeek + TUNING.PRODUCTION_TICKS)) fail(bl, `work week ${workWeek} must satisfy ${bookedWeek} < workWeek <= ${bookedWeek + TUNING.PRODUCTION_TICKS}`)
+    const basis = enumOf(booking.basis, BASES, `${bl}.basis`)
+    enumOf(booking.profession, PROFESSIONS, `${bl}.profession`)
+    const quote = rec(booking.quote, `${bl}.quote`)
+    exactKeys(quote, ['perceivedActingOVR', 'fame', 'ruleVersion', 'capabilityVersion', 'profileVersion'], `${bl}.quote`)
+    const ovr = num(quote.perceivedActingOVR, `${bl}.quote.perceivedActingOVR`, { min: 0, max: 100 })
+    const fame = num(quote.fame, `${bl}.quote.fame`, { min: 0, max: 100 })
+    if (quote.ruleVersion !== P17_CAMEO_RULE_VERSION) fail(bl, `quote.ruleVersion must be ${P17_CAMEO_RULE_VERSION}`)
+    if (quote.capabilityVersion !== P17_CAMEO_CAPABILITY_VERSION) fail(bl, `quote.capabilityVersion must be ${P17_CAMEO_CAPABILITY_VERSION}`)
+    if (quote.profileVersion !== P17_CAMEO_PROFILE_VERSION) fail(bl, `quote.profileVersion must be ${P17_CAMEO_PROFILE_VERSION}`)
+    const fee = num(booking.fee, `${bl}.fee`, { int: true, min: 1 })
+    if (fee !== cameoFee(ovr, fame)) fail(bl, `fee ${fee} is not the frozen quote's fee ${cameoFee(ovr, fame)}`)
+    const retained = num(booking.retained, `${bl}.retained`, { int: true, min: 0 })
+    if (retained !== cameoRetained(fee)) fail(bl, `retained ${retained} is not the declared charge ${cameoRetained(fee)} of fee ${fee}`)
+    const status = enumOf(booking.status, STATUSES, `${bl}.status`)
+    const completedWeek = numOrNull(booking.completedWeek, `${bl}.completedWeek`, { int: true, min: 0 })
+    const completedExecution = numOrNull(booking.completedExecution, `${bl}.completedExecution`, { min: 0 })
+    const cancelledWeek = numOrNull(booking.cancelledWeek, `${bl}.cancelledWeek`, { int: true, min: 0, max: ctx.week })
+    const cancelReason = booking.cancelReason === null ? null : enumOf(booking.cancelReason, CANCEL_REASONS, `${bl}.cancelReason`)
+    const refund = numOrNull(booking.refund, `${bl}.refund`, { int: true, min: 0 })
+    const releasedWeek = numOrNull(booking.releasedWeek, `${bl}.releasedWeek`, { int: true, min: 0 })
+    const careerEvent = booking.careerEvent
+    if (status !== 'cancelled') {
+      const key = `${talentId}@${workWeek}`
+      if (liveWeeks.has(key)) fail(bl, `${talentId} holds two live appearances in week ${workWeek}`)
+      liveWeeks.add(key)
+    }
+    if (status === 'reserved') {
+      if (completedWeek !== null || completedExecution !== null || cancelledWeek !== null || cancelReason !== null || refund !== null || releasedWeek !== null || careerEvent !== null) fail(bl, 'a reserved booking carries no completion, cancellation, release or credit fact')
+      if (workWeek < ctx.week) fail(bl, `a reserved booking for week ${workWeek} would have resolved before week ${ctx.week}`)
+      if (!ctx.activePlayerProductionIds.has(productionId)) fail(bl, `a reserved booking names in-flight production ${productionId}, which is not in the slate`)
+    } else if (status === 'completed') {
+      if (completedWeek !== workWeek || completedExecution === null) fail(bl, 'completed work records its week and frozen execution')
+      if (workWeek >= ctx.week) fail(bl, `work in week ${workWeek} cannot have completed before week ${ctx.week}`)
+      if (cancelledWeek !== null || cancelReason !== null || refund !== null) fail(bl, 'completed work carries no cancellation fact')
+      const actual = ctx.releaseWeekOf(productionId)
+      if (releasedWeek !== (actual ?? null)) fail(bl, `releasedWeek ${String(releasedWeek)} is not ${productionId}'s release week ${String(actual ?? null)}`)
+      // the permanent credit is written by the careers step at release: a released picture whose principals were credited
+      // credits its completed guests too; no credit exists before the release
+      if (careerEvent !== null && releasedWeek === null) fail(bl, 'a cameo career credit exists only once its picture has released')
+      if (careerEvent === null && releasedWeek !== null && ctx.careerCreditedFilmIds.has(productionId)) fail(bl, `the released appearance on ${productionId} lacks its cameo career credit`)
+      if (careerEvent !== null) {
+        const event = rec(careerEvent, `${bl}.careerEvent`)
+        if (event.role !== 'cameo' || event.discipline !== 'acting' || event.billingWeight !== TUNING.P17_CAMEO_VISIBILITY_WEIGHT) fail(`${bl}.careerEvent`, 'a cameo credit is an acting record with role cameo at the cameo visibility weight')
+        if (event.eventId !== `${productionId}:${talentId}` || event.talentId !== talentId || event.filmId !== productionId || event.releaseWeek !== releasedWeek) fail(`${bl}.careerEvent`, 'the credit names its booking\'s person, film and release week')
+        ctx.careerEventLeaf({ ...event, role: 'support', billingWeight: event.billingWeight }, `${bl}.careerEvent`)
+      }
+    } else {
+      if (cancelledWeek === null || cancelReason === null || refund !== fee - retained) fail(bl, 'a cancelled booking records its week, reason and the one refund of fee − retained')
+      if (completedWeek !== null || completedExecution !== null || releasedWeek !== null || careerEvent !== null) fail(bl, 'a cancelled booking carries no completion, release or credit fact')
+      if (cancelReason === 'missedWork' || cancelReason === 'rightsLoss') {
+        if (cancelledWeek !== workWeek) fail(bl, `a ${cancelReason} closure happens in the work week ${workWeek}`)
+      } else if (!(bookedWeek <= cancelledWeek && cancelledWeek <= workWeek)) {
+        fail(bl, `an ${cancelReason} cancellation happens between the booking week ${bookedWeek} and the work week ${workWeek}`)
+      }
+      if (cancelReason === 'employmentExit' && basis !== 'employee') fail(bl, 'only an own-employee appearance closes on employment exit')
+    }
+    facts.push({ id, productionId, talentId, bookedWeek, workWeek, fee, status, cancelledWeek, refund, label: bl })
+  })
+  // ── 2. per production: bookings are made once, at its greenlight; at most two distinct guests, none a principal ──
+  const byProduction = new Map<string, BookingFacts[]>()
+  for (const f of facts) byProduction.set(f.productionId, [...(byProduction.get(f.productionId) ?? []), f])
+  for (const [productionId, group] of byProduction) {
+    if (group.length > TUNING.P17_CAMEO_MAX_GUESTS) fail(group[TUNING.P17_CAMEO_MAX_GUESTS]!.label, `production ${productionId} carries ${group.length} guests; at most ${TUNING.P17_CAMEO_MAX_GUESTS} are ever booked`)
+    if (new Set(group.map((f) => f.talentId)).size !== group.length) fail(group[1]!.label, `the same guest is booked twice on ${productionId}`)
+    if (new Set(group.map((f) => f.bookedWeek)).size !== 1) fail(group[1]!.label, `every guest on ${productionId} is booked at its one greenlight`)
+    const participants = ctx.participantsOf(productionId)
+    if (participants !== undefined) {
+      const principals = new Set([participants.writer.talentId, participants.director.talentId, participants.cast.lead.talentId, participants.cast.antagonist.talentId, participants.cast.support.talentId, ...participants.craft.map((c) => c.talentId)])
+      for (const f of group) if (principals.has(f.talentId)) fail(f.label, `guest ${f.talentId} is a principal of ${productionId}`)
+    }
+  }
+  // ── 3. ledger: one fee row per booking, one refund row per cancellation, and no other P17 row ──
+  const feeRows = ctx.ledger.filter((e) => e.note === P17_CAMEO_FEE_NOTE)
+  const refundRows = ctx.ledger.filter((e) => e.note === P17_CAMEO_REFUND_NOTE)
+  const take = (rows: LedgerEntry[], want: { week: number; amount: number; talentId: string; productionId: string }): boolean => {
+    const at = rows.findIndex((e) => e.kind === 'freelancerFee' && e.week === want.week && e.amount === want.amount && e.talentId === want.talentId && e.productionId === want.productionId)
+    if (at < 0) return false
+    rows.splice(at, 1)
+    return true
+  }
+  const fees = [...feeRows]
+  const refunds = [...refundRows]
+  for (const f of facts) {
+    if (!take(fees, { week: f.bookedWeek, amount: -f.fee, talentId: f.talentId, productionId: f.productionId })) fail(f.label, `booking ${f.id} has no fee ledger row (charged −${f.fee} in week ${f.bookedWeek})`)
+    if (f.status === 'cancelled' && !take(refunds, { week: f.cancelledWeek!, amount: f.refund!, talentId: f.talentId, productionId: f.productionId })) fail(f.label, `cancelled booking ${f.id} has no refund ledger row (+${f.refund} in week ${f.cancelledWeek})`)
+  }
+  if (fees.length > 0) fail(`${label}`, `${fees.length} cameo fee ledger row(s) name no booking`)
+  if (refunds.length > 0) fail(`${label}`, `${refunds.length} cameo refund ledger row(s) name no cancelled booking`)
+}
