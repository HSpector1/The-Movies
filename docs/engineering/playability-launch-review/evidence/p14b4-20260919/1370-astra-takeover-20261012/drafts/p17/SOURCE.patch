+// ── The live save era, named once (1370-AR r3 aliases; P17 r2 at base 6510c971) ───────────────
+//
+// A test whose meaning is "the live save" imports these instead of a numbered reader, chain or
+// literal, so a save bump edits this file alone. Era reads of a genuine numbered artifact keep
+// their numbered reader and never route through here.
+//
+// The API is the integrator's (founding r3, `tests/helpers/live-era.ts` on db3fc572). At this base the
+// live era is P17's step over Save45; at the rebase this file is the founding helper with three edits
+// (REPORT r2 §e): the expected constant becomes P17_SAVE_VERSION's assigned number, the live reader is
+// `validateSaveP17`, and `downgradeLiveTo45` gains `convertP17ToPredecessor` as its first hop.
+//
+// `validateSave` in src/core/save.ts is the version dispatcher (it admits every known version and
+// returns the all-eras union), so it cannot stand in for the live reader; the live reader is the
+// strict validator of the envelope `makeSave` writes, named here.
+import { convertP17ToPredecessor, validateSaveP17, type LiveSaveFile, type SaveFileV45 } from '../../src/core/save.js'
+
+/** What `LIVE_SAVE_VERSION` must equal; `expect(LIVE_SAVE_VERSION).toBe(EXPECTED_LIVE_SAVE_VERSION)` guards pin it here. */
+export const EXPECTED_LIVE_SAVE_VERSION = 46
+
+/** The live reader: the strict validator of the envelope `makeSave` writes. */
+export const validateLiveSave: (input: unknown) => LiveSaveFile = validateSaveP17
+
+/** The live envelope down to the Save45 era through every public step, each refusal preserved. */
+export const downgradeLiveTo45 = (save: LiveSaveFile): SaveFileV45 => convertP17ToPredecessor(save)
