+export function featuredGuestQuote(state: GameState, exclude: ReadonlySet<string>, workWeek: number): CameoQuoteView | null {
+  if (featuredCapacity(state.market.tick) === 0) return null
+  const ranked = state.talent.filter((t) => !exclude.has(t.id)).sort((a, b) => b.fame - a.fame || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0))
