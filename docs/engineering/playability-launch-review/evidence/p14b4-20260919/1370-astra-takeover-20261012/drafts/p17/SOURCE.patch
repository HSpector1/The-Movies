+// ── P17 r2 — the save step is named for its era, never for its number (F16) ──────────────────────────────
+//
+// Review r1 finding F16: REPORT §e renamed SaveFileV46/GameStateV46/validateSaveV46/convertV45ToV46/convertV46ToV45/
+// migrateToV46 "with word boundaries" on the tree rebased onto P16's Save49 — a chain that already contains R8's
+// Save46 step under exactly those identifiers, so the recipe would have rewritten R8's step into duplicate V50
+// definitions (Codex REVIEW item 1: "Renaming the number … would lose earlier laws"). Integrator order: R8 Save46,
+// founding Save47, P15B Save48, P16 Save49, P17 Save50, P18 Save51.
+//
+// The guard: no identifier in the save, type or export surface names a step by the P17 number. At this base the
+// number is 46; after the rebase it is 50; in neither tree may a P17 symbol carry it, so the rebase edits only the
+// constant pair and the predecessor bindings (REPORT r2 §e).
+
+import { readFileSync } from 'node:fs'
+import { describe, expect, it } from 'vitest'
+import { P17_SAVE_VERSION } from '../src/core/continuationSave.js'
+
+describe('P17 r2 — era-neutral save step symbols (F16)', () => {
+  it('no identifier in save.ts, types.ts or index.ts names the P17 step by its save number', () => {
+    const numbered = new RegExp(`\\b[A-Za-z_]\\w*V${P17_SAVE_VERSION}\\b`, 'g')
+    for (const file of ['src/core/save.ts', 'src/core/types.ts', 'src/core/index.ts']) {
+      const found = [...new Set([...readFileSync(file, 'utf8').matchAll(numbered)].map((m) => m[0]))].sort()
+      expect(found, `${file} names the P17 step by number`).toEqual([])
+    }
+  })
+})
