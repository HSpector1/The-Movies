+++ b/tests/helpers/p17-fixtures.ts
@@ -0,0 +1,232 @@
+// ── P17 shared test fixtures — lawful worlds and greenlight payloads (no state surgery) ──
+//
+// Every world here is reached by ordinary routes: `generateWorld` ticked forward (the headless M0A world), and
+// the late-start living industry (`activateStudioOperations` + `initializeHollywood(..., 'migration')` at the
+// week the M0A world reached — the same governed migration a pre-industry save takes). The rights authority is
+// the injected adapter (package PROGRESS D2/D11): a P16 stand-in answering `rightsAuthority`'s shape.
+
+import { applyActions } from '../../src/core/actions.js'
+import { assignmentRefusal } from '../../src/core/careerLifecycle.js'
+import type { CameoBookingRequest } from '../../src/core/cameo.js'
+import type { ContinuationRights } from '../../src/core/continuation.js'
+import { cameoQuote, p17StudioId } from '../../src/core/continuationGreenlight.js'
+import { hiringMarketIds } from '../../src/core/employment.js'
+import { MARKETING_BUDGET_LEVELS } from '../../src/core/grid.js'
+import { initializeHollywood } from '../../src/core/hollywood.js'
+import { resolveShape } from '../../src/core/shape.js'
+import { tick, type TickOptions } from '../../src/core/tick.js'
+import { TUNING } from '../../src/core/tuning.js'
+import { generateWorld } from '../../src/core/worldgen.js'
+import type { Action, FilmConcept, FilmShape, GameState, Talent } from '../../src/core/types.js'
+
+export const SHAPE: FilmShape = { opening: 'slowSetup', midpoint: 'reversal', ending: 'bittersweet' }
+export type GreenlightPayload = Extract<Action, { kind: 'greenlight' }>['production']
+export type ApplyDeps = Parameters<typeof applyActions>[2]
+
+/** Seat-eligible people of one role, newest first, never reusing `used`. Throws when the premise cannot be met. */
+export function pick(state: GameState, role: 'writer' | 'director' | 'actor', count: number, used: Set<string>): string[] {
+  const out: string[] = []
+  for (const person of [...state.talent].reverse()) {
+    if (out.length === count) break
+    if (person.role !== role || used.has(person.id)) continue
+    if (role !== 'writer' && assignmentRefusal(state, person.id, state.market.tick, role) !== null) continue
+    out.push(person.id)
+    used.add(person.id)
+  }
+  if (out.length !== count) throw new Error(`premise: not enough free ${role}s`)
+  return out
+}
+
+/** A legacy-regime greenlight payload for `concept` with fresh principals. */
+export function payload(state: GameState, concept: FilmConcept, used: Set<string>): GreenlightPayload {
+  const [writerId] = pick(state, 'writer', 1, used)
+  const [directorId] = pick(state, 'director', 1, used)
+  const [lead, antagonist, support] = pick(state, 'actor', 3, used)
+  return {
+    conceptId: concept.id,
+    shape: SHAPE,
+    promise: { genre: concept.genre, intendedSegments: ['adult'], ranges: { intimacy: [-1, 1], tonalWeight: [-1, 1], kineticEnergy: [-1, 1] } },
+    writerId: writerId!,
+    directorId: directorId!,
+    craftIds: [],
+    cast: { lead: lead!, antagonist: antagonist!, support: support! },
+    budget: { negative: concept.baseNegativeCost * resolveShape(SHAPE).budgetDemandMultiplier * state.era.costScale, marketing: MARKETING_BUDGET_LEVELS[0] },
+  }
+}
+
+/** Run the newest active production to Release Ready, commit it, release it. */
+export function produceAndRelease(state: GameState, action: Extract<Action, { kind: 'greenlight' }>, deps?: ApplyDeps, options?: TickOptions): GameState {
+  let s = applyActions(state, [action], deps)
+  const id = s.studio.activeProductions[s.studio.activeProductions.length - 1]!.id
+  for (let i = 0; i < TUNING.PRODUCTION_TICKS; i++) s = tick(s, options)
+  if (s.studio.activeProductions.find((p) => p.id === id)?.remainingTicks !== 1) throw new Error('premise: the picture did not reach Release Ready')
+  s = applyActions(s, [{ kind: 'commitPictureToRelease', productionId: id }], deps)
+  s = tick(s, options)
+  if (!s.studio.releasedFilms.some((f) => f.productionId === id)) throw new Error('premise: the picture did not release')
+  return s
+}
+
+/** A P16 stand-in: each listed film belongs to `prop-<first film>`, whose R3 authority `holder` has
+ * (default: the player studio) for weeks [from, until). Outside the term the answer is a dated lapse. */
+export function rightsFor(filmIds: string | readonly string[], opts: { holder?: string; from?: number; until?: number } = {}): ContinuationRights {
+  const ids = typeof filmIds === 'string' ? [filmIds] : filmIds
+  const property = `prop-${ids[0]!}`
+  return {
+    storyPropertyOf: (id) => (ids.includes(id) ? property : null),
+    authority: ({ storyPropertyId, week }) => {
+      if (storyPropertyId !== property) return { kind: 'unavailable', reason: 'unknownSubject' }
+      if (week < (opts.from ?? 0) || week >= (opts.until ?? Number.POSITIVE_INFINITY)) return { kind: 'unavailable', reason: `licence term ended at week ${opts.until}` }
+      return { kind: 'authority', studioId: opts.holder ?? p17StudioId({ hollywood: null }) }
+    },
+  }
+}
+
+/** A rights stand-in whose answer is decided per call (revocation and restoration mid-campaign). */
+export function switchableRights(filmId: string, live: { held: boolean; holder?: string }): ContinuationRights {
+  const property = `prop-${filmId}`
+  return {
+    storyPropertyOf: (id) => (id === filmId ? property : null),
+    authority: ({ storyPropertyId }) =>
+      storyPropertyId === property && live.held ? { kind: 'authority', studioId: live.holder ?? 'player' } : { kind: 'unavailable', reason: 'revoked' },
+  }
+}
+
+/** The headless M0A world ticked naturally to `week` (never surgically dated). */
+export function m0aWorldAt(seed: string, week: number): GameState {
+  let world = generateWorld(seed)
+  while (world.market.tick < week) world = tick(world)
+  return world
+}
+
+/** A lawful living industry that starts at week 1872 (the 1956 cameo unlock): the M0A world ticked there,
+ * Studio Operations activated, the living industry initialized by its governed `migration` path, then
+ * `extraWeeks` living weeks so rivals enter, hire and greenlight. */
+export function lateLivingWorld(seed: string, extraWeeks = 12): GameState {
+  const m0a = m0aWorldAt(seed, TUNING.P17_CAMEO_UNLOCK_WEEK)
+  let s = initializeHollywood(applyActions({ ...m0a, economyEngagedEver: true }, [{ kind: 'activateStudioOperations' }]), 'migration')
+  for (let i = 0; i < extraWeeks; i++) s = tick(s)
+  return s
+}
+
+/**
+ * Engaged regime (D-11.12/D-11.13): sign people from the LIVE hiring listing until every needed role is on contract.
+ * The listing is a seeded sample, so a week without a needed role re-rolls by advancing one week. Deterministic; a
+ * premise that cannot be met throws instead of passing vacuously.
+ */
+export type StaffRole = 'director' | 'actor' | 'craft'
+export function signStaff(state: GameState, need: Record<StaffRole, number>, exclude: ReadonlySet<string>): { state: GameState; ids: Record<StaffRole, string[]> } {
+  const ids: Record<StaffRole, string[]> = { director: [], actor: [], craft: [] }
+  let s = state
+  for (let guard = 0; guard < 60; guard++) {
+    const missing = (Object.keys(need) as StaffRole[]).filter((r) => ids[r].length < need[r])
+    if (missing.length === 0) return { state: s, ids }
+    const candidate = hiringMarketIds(s)
+      .map((id) => s.talent.find((t) => t.id === id)!)
+      .find((t) => !exclude.has(t.id) && (missing as string[]).includes(t.role) && assignmentRefusal(s, t.id, s.market.tick, t.role as StaffRole) === null)
+    if (candidate === undefined) {
+      s = tick(s) // the listing re-rolls weekly
+      continue
+    }
+    s = applyActions(s, [{ kind: 'signContract', talentId: candidate.id, termWeeks: TUNING.CONTRACT_MIN_WEEKS }])
+    ids[candidate.role as StaffRole].push(candidate.id)
+  }
+  throw new Error('premise: could not staff the engaged picture from the hiring listing')
+}
+
+/** An engaged-regime payload: contracted director, craft and cast; a free credited writer. */
+export function engagedPayload(state: GameState, concept: FilmConcept, staff: Record<StaffRole, string[]>, exclude: ReadonlySet<string>): GreenlightPayload {
+  const onContract = new Set(Object.values(staff).flat())
+  const [writerId] = pick(state, 'writer', 1, new Set([...exclude, ...onContract]))
+  return {
+    ...payload(state, concept, new Set([...exclude, ...onContract, writerId!])),
+    writerId: writerId!,
+    directorId: staff.director[0]!,
+    craftIds: [staff.craft[0]!],
+    cast: { lead: staff.actor[0]!, antagonist: staff.actor[1]!, support: staff.actor[2]! },
+  }
+}
+
+/**
+ * A lawful late MANAGED studio at `week`: the M0A world ticked there, Studio Operations activated, the living industry
+ * initialized by its governed `migration` path, a writer, a director, four actors and a craft lead signed from the
+ * live hiring listing, then managed script development and casting sessions activated — every step a public action.
+ * (A late `beginFounding` route is NOT used: at week > 0 its founding signings fail the save boundary with "employment
+ * start lacks its actual player signing payment" — a base defect outside P17, probe-late-founded-save.ts.)
+ */
+export function lateManagedStudio(seed: string, week = TUNING.P17_CAMEO_UNLOCK_WEEK): GameState {
+  const m0a = m0aWorldAt(seed, week)
+  const living = initializeHollywood(applyActions({ ...m0a, economyEngagedEver: true }, [{ kind: 'activateStudioOperations' }]), 'migration')
+  let s = signStaff(living, { director: 1, actor: 4, craft: 1 }, new Set()).state
+  const writer = hiringMarketIds(s).find((id) => s.talent.find((t) => t.id === id)!.role === 'writer')
+  if (writer === undefined) throw new Error('premise: no writer in the hiring listing')
+  s = applyActions(s, [{ kind: 'signContract', talentId: writer, termWeeks: TUNING.CONTRACT_MIN_WEEKS }])
+  return applyActions(s, [{ kind: 'activateScriptDevelopment' }, { kind: 'activateCastingSessions' }])
+}
+
+export const contractedOf = (state: GameState, role: Talent['role']): string[] =>
+  state.talent.filter((t) => t.role === role && state.contracts.some((c) => c.talentId === t.id)).map((t) => t.id)
+
+/** Commission a screenplay with `writerId`, let it complete, accept it. Returns the state and the Ready project id. */
+export function readyProject(state: GameState, writerId: string, conceptIndex: number): { state: GameState; projectId: string } {
+  const concept = state.concepts[conceptIndex]!
+  let s = applyActions(state, [{
+    kind: 'commissionScript',
+    project: {
+      conceptId: concept.id, writerId, shape: { opening: 'slowSetup', midpoint: 'revelation', ending: 'bittersweet' },
+      promise: { genre: concept.genre, intendedSegments: ['adult'], ranges: { intimacy: [-0.4, 0.6], tonalWeight: [0, 0.8], kineticEnergy: [-0.7, 0.2] } },
+    },
+  }])
+  const projectId = s.scriptDevelopment.projects[s.scriptDevelopment.projects.length - 1]!.id
+  for (let guard = 0; guard < 8 && s.scriptDevelopment.projects.find((p) => p.id === projectId)!.status !== 'review'; guard++) s = tick(s)
+  if (s.scriptDevelopment.projects.find((p) => p.id === projectId)!.status !== 'review') throw new Error('premise: the screenplay never reached review')
+  s = applyActions(s, [{ kind: 'acceptScript', projectId }])
+  return { state: s, projectId }
+}
+
+/** The managed package from the studio's own contracts: first director, first craft, first three actors. */
+export function ownPackage(state: GameState, projectId: string, exclude: ReadonlySet<string> = new Set()): Extract<Action, { kind: 'greenlightScriptProject' }>['production'] {
+  const actors = contractedOf(state, 'actor').filter((id) => !exclude.has(id))
+  const project = state.scriptDevelopment.projects.find((p) => p.id === projectId)!
+  const concept = state.concepts.find((c) => c.id === project.conceptId)!
+  return {
+    projectId,
+    directorId: contractedOf(state, 'director').filter((id) => !exclude.has(id))[0]!,
+    craftIds: [contractedOf(state, 'craft')[0]!],
+    cast: { lead: actors[0]!, antagonist: actors[1]!, support: actors[2]! },
+    budget: { negative: concept.baseNegativeCost * resolveShape(project.shape).budgetDemandMultiplier * state.era.costScale, marketing: 0 },
+  }
+}
+
+/** Drive the managed production `id` to release: Director + take at Shooting, commit at Release Ready. Bounded, loud. */
+export function managedRunToRelease(state: GameState, id: string, deps?: ApplyDeps, options?: TickOptions): GameState {
+  let s = state
+  for (let step = 0; step < 60; step++) {
+    if (s.studio.releasedFilms.some((f) => f.productionId === id)) return s
+    const production = s.studio.activeProductions.find((p) => p.id === id)
+    if (production === undefined) throw new Error(`premise: production ${id} left the slate without releasing`)
+    const workflow = s.operations.workflows.find((w) => w.productionId === id)!
+    if (workflow.phase === 'shooting' && workflow.shootingTask?.status === 'unassigned') {
+      s = applyActions(s, [{ kind: 'assignShootingDirector', productionId: id, directorId: production.directorId }, { kind: 'scheduleShootingTake', productionId: id }], deps)
+    }
+    if (production.remainingTicks === 1 && !s.releaseAuthority.commitments.some((r) => r.productionId === id)) {
+      s = applyActions(s, [{ kind: 'commitPictureToRelease', productionId: id }], deps)
+    }
+    s = tick(s, options)
+  }
+  throw new Error(`premise: production ${id} did not release within 60 weeks`)
+}
+
+/** Sum of the ledger: the cash-reconciliation probe (cash − Σledger stays constant across lawful routes). */
+export function ledgerSum(state: GameState): number {
+  return state.ledger.reduce((sum, e) => sum + e.amount, 0)
+}
+
+/** The exact quote a booking accepts (cameo contract §4; review F28): a request carries `cameoQuote`'s token. */
+export function book(state: GameState, talentId: string, workWeek: number): CameoBookingRequest {
+  const q = cameoQuote(state, { talentId, workWeek })
+  if (!q.ok) throw new Error(`premise: ${talentId} is not quotable for week ${workWeek}: ${q.reason}`)
+  return { talentId, workWeek, quoteToken: q.quoteToken }
+}
+
+/** A request for a refusal case: the package- and person-level law refuse before the quote comparison. */
+export const unquoted = (talentId: string, workWeek: number): CameoBookingRequest => ({ talentId, workWeek, quoteToken: 'unquoted' })
