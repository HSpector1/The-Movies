+
+function reject(reason: string): never {
+  throw new Error(`applyActions: greenlight rejected — ${reason}`)
+}
+
+/** Cameo contract §4 eligibility for one request at greenlight: package-level law, then the person-level law, then the
+ * accepted quote must be exactly the evaluated one. Refuses loudly, never mutates. */
+export function cameoEligibility(
+  state: GameState,
+  args: { studioId: string; productionId: string; greenlightWeek: number; principalIds: ReadonlySet<string>; request: CameoBookingRequest; committed: number; requestedTalentIds: ReadonlySet<string> },
+): CameoQuoteCommit {
+  const { request, greenlightWeek } = args
+  if (featuredCapacity(greenlightWeek) === 0) reject(`featured/cameo bookings unlock at week ${TUNING.P17_CAMEO_UNLOCK_WEEK} (1956 Week 1); week ${greenlightWeek} has no capability`)
+  if (args.committed >= TUNING.P17_CAMEO_MAX_GUESTS) reject(`at most ${TUNING.P17_CAMEO_MAX_GUESTS} guests per production (two already committed)`)
+  if (args.requestedTalentIds.has(request.talentId)) reject(`guest ${request.talentId} is requested twice`)
+  if (args.principalIds.has(request.talentId)) reject(`guest ${request.talentId} is already credited on this picture`)
+  if (typeof request.quoteToken !== 'string' || request.quoteToken.length === 0) reject(`a booking names the exact quote it accepts: guest ${request.talentId} carries no quote token (cameoQuote)`)
+  const quote = evaluateCameoPerson(state, { studioId: args.studioId, greenlightWeek, talentId: request.talentId, workWeek: request.workWeek })
+  if (!quote.ok) reject(quote.reason)
+  if (request.quoteToken !== quote.quoteToken) reject(`stale cameo quote for ${request.talentId}: a quote input changed since it was quoted (re-quote: fee ${money(quote.fee)}, week ${request.workWeek})`)
+  return {
+    studioId: args.studioId,
+    productionId: args.productionId,
+    talentId: quote.talentId,
+    workWeek: request.workWeek,
+    bookedWeek: greenlightWeek,
+    basis: quote.basis,
+    profession: quote.profession,
+    fee: quote.fee,
+    perceivedActingOVR: quote.perceivedActingOVR,
+    fame: quote.fame,
+  }
+}
+
+/** Everything the greenlight needs before it mutates: refuses atomically, returns the forecast inputs and the commits. */
+export function prepareP17Greenlight(state: GameState, action: { continuation?: ContinuationRequest; cameos?: CameoBookingRequest[] }, ctx: P17GreenlightContext): P17GreenlightPrep {
+  const prep: P17GreenlightPrep = { inputs: {}, continuation: null, cameoCommits: [], cameoFees: 0 }
+  if (action.continuation) {
+    const world = continuationWorldOf(state, ctx.rights ?? continuationRightsFor(state), ctx.week)
+    const quote = continuationQuote(world, {
+      studioId: ctx.studioId,
+      productionId: ctx.productionId,
+      request: action.continuation,
+      proposed: { writerId: ctx.writer.id, directorId: ctx.director.id, cast: { lead: ctx.cast.lead.id, antagonist: ctx.cast.antagonist.id, support: ctx.cast.support.id } },
+    })
+    if (!quote.ok) reject(`continuation refused: ${quote.reason}`)
+    prep.continuation = { world, quote }
+    prep.inputs.inheritedAwareness01 = quote.inheritedAwareness01
+  }
+  if (action.cameos && action.cameos.length > 0) {
+    const principalIds = new Set([ctx.writer.id, ctx.director.id, ctx.cast.lead.id, ctx.cast.antagonist.id, ctx.cast.support.id, ...ctx.craftHires.map((c) => c.id)])
+    const requested = new Set<string>()
+    const committed = committedGuestsFor(cameosOf(state), ctx.productionId).length
+    for (const request of action.cameos) {
+      const commit = cameoEligibility(state, { studioId: ctx.studioId, productionId: ctx.productionId, greenlightWeek: ctx.week, principalIds, request, committed: committed + prep.cameoCommits.length, requestedTalentIds: requested })
+      requested.add(commit.talentId)
+      prep.cameoCommits.push(commit)
+      prep.cameoFees += commit.fee
+    }
+    const guests = prep.cameoCommits.map((c) => state.talent.find((t) => t.id === c.talentId)!)
+    prep.inputs.cameoPublicityDelta = cameoPublicityDelta(
+      [ctx.cast.lead, ctx.cast.antagonist, ctx.cast.support].map((t) => ({ fame: t.fame })),
+      prep.cameoCommits.map((c, i) => ({ fame: guests[i]!.fame, profession: c.profession })),
+      state.market.segments,
+    )
+    // the forecast reads PERCEIVED acting against the screenplay's support requirement (the explicit cameo fit convention)
+    prep.inputs.cameoExecutions = guests.map((g) => castSlotExecution(g, ctx.concept, 'support', ctx.shapeEffects, ctx.promise, 'perceived', ctx.shape))
+  }
+  return prep
+}
+
+export function p17CameoFeeRows(prep: P17GreenlightPrep, week: number, productionId: string): LedgerEntry[] {
+  return prep.cameoCommits.map((c) => ({ week, kind: 'freelancerFee', amount: -c.fee, talentId: c.talentId, productionId, note: P17_CAMEO_FEE_NOTE }))
+}
+
+export function p17RefundRows(refunds: readonly CameoRefund[], week: number): LedgerEntry[] {
+  return refunds.map((r) => ({ week, kind: 'freelancerFee', amount: r.amount, talentId: r.talentId, productionId: r.productionId, note: P17_CAMEO_REFUND_NOTE }))
+}
+
+/** The atomic commit after the main production exists: the lineage edge and the bookings. */
+export function commitP17Greenlight(state: GameState, prep: P17GreenlightPrep, args: { productionId: string; studioId: string }): GameState {
+  let next = state
+  if (prep.continuation) {
+    next = { ...next, franchises: commitContinuationGreenlight({ ...prep.continuation.world, franchises: franchisesOf(next) }, prep.continuation.quote, { studioId: args.studioId, productionId: args.productionId }) }
+  }
+  if (prep.cameoCommits.length > 0) {
+    let cameos = cameosOf(next)
+    for (const c of prep.cameoCommits) cameos = commitCameoBooking(cameos, c)
+    next = { ...next, cameos }
+  }
+  return next
+}
+
+/** Codex finding 5b: the factual work of each newly COMPLETED appearance, recorded once on the acted-work counter at
+ * shooting completion (never at booking, never again at release); an unknown guest is a forged root and throws. */
+export function creditCompletedCameoWork(talent: readonly Talent[], completed: readonly { talentId: string }[]): Talent[] {
+  if (completed.length === 0) return [...talent]
+  const credits = new Map<string, number>()
+  for (const b of completed) credits.set(b.talentId, (credits.get(b.talentId) ?? 0) + 1)
+  for (const id of credits.keys()) if (!talent.some((t) => t.id === id)) throw new Error(`tick: completed cameo work names unknown talent "${id}"`)
+  return talent.map((t) => {
+    const n = credits.get(t.id)
+    return n === undefined ? t : { ...t, workHistory: { ...t.workHistory, acting: t.workHistory.acting + n } }
+  })
+}
+
+/** The player's in-flight continuations whose PRODUCING studio lacks the live grant this week, with the refusal: the
+ * pictures the tick holds (no work, no release) until the grant returns or the studio cancels (review F04/F10). The
+ * read model a surface uses to say why a picture stopped. */
+export function p17RightsHolds(state: GameState, rights: ContinuationRights = continuationRightsFor(state), week = state.market.tick): Map<string, string> {
+  return continuationHolds(franchisesOf(state), state.studio.activeProductions.map((p) => p.id), rights, week, p17StudioId(state))
+}
+
+/** The release-time inputs for one picture (it is releasing, so its grant was read and held this week): the live
+ * continuation read through the SAME composing function the quote ran, and the COMPLETED guests' publicity, frozen
+ * executions and attention delta. */
+export function p17ReleaseInputs(
+  state: GameState,
+  args: { productionId: string; week: number; cast: Record<CastSlot, Talent>; writerId: string; directorId: string },
+  rights: ContinuationRights,
+): { inputs: { inheritedAwareness01?: number; cameoPublicityDelta?: Record<SegmentId, number>; cameoExecutions?: number[] }; attentionDelta: number | undefined; guests: { talentId: string }[] } {
+  const inputs: { inheritedAwareness01?: number; cameoPublicityDelta?: Record<SegmentId, number>; cameoExecutions?: number[] } = {}
+  const live = continuationInputsAtRelease(continuationWorldOf(state, rights, args.week), args.productionId, {
+    writerId: args.writerId,
+    directorId: args.directorId,
+    cast: { lead: args.cast.lead.id, antagonist: args.cast.antagonist.id, support: args.cast.support.id },
+  })
+  if (live !== null) inputs.inheritedAwareness01 = live
+  const completed = completedGuestsFor(cameosOf(state), args.productionId)
+  let attentionDelta: number | undefined
+  if (completed.length > 0) {
+    const guests = completed.map((b) => {
+      const guest = state.talent.find((t) => t.id === b.talentId)
+      if (guest === undefined) throw new Error(`tick: completed cameo guest "${b.talentId}" is unknown`)
+      return { fame: guest.fame, profession: b.profession }
+    })
+    const delta = cameoPublicityDelta([args.cast.lead, args.cast.antagonist, args.cast.support].map((t) => ({ fame: t.fame })), guests, state.market.segments)
+    inputs.cameoPublicityDelta = delta
+    inputs.cameoExecutions = completed.map((b) => b.completedExecution!)
+    attentionDelta = cameoAttentionDelta(delta, state.market.segments)
+  }
+  return { inputs, attentionDelta, guests: completed.map((b) => ({ talentId: b.talentId })) }
+}
+
+/** The `mintSubProperty` action (review F07): the player's hook on an exact released or locked film, under the live
+ * grant. The frozen participant record comes from the public result or, at greenlight, the locked Production. */
+export function applyMintSubProperty(state: GameState, action: Extract<Action, { kind: 'mintSubProperty' }>, rights: ContinuationRights): GameState {
+  const film = publicFilmById(state)
+  const franchises = mintSubPropertyHook(
+    continuationWorldOf(state, rights),
+    { studioId: p17StudioId(state), productionId: action.productionId, kind: action.hookKind, citedTalentIds: action.citedTalentIds },
+    (id) => film(id) ?? state.studio.activeProductions.find((p) => p.id === id) ?? null,
+  )
+  return { ...state, franchises }
+}
+
+/** The `cancelCameoBooking` action (review F12; cameo contract §4 "explicit cancellation"): one unperformed booking of
+ * this studio closes once with its linked refund of fee − retained; completed, cancelled, unknown or foreign refuse. */
+export function applyCancelCameoBooking(state: GameState, action: Extract<Action, { kind: 'cancelCameoBooking' }>): GameState {
+  const root = cameosOf(state)
+  const booking = root.bookings.find((b) => b.bookingId === action.bookingId)
+  if (!booking) throw new Error(`applyActions: cancelCameoBooking rejected — no booking ${action.bookingId}`)
+  // the player's id is `player` until the living industry starts, its industry id after (a booking keeps the id it was made under)
+  if (booking.studioId !== p17StudioId(state) && booking.studioId !== 'player') throw new Error(`applyActions: cancelCameoBooking rejected — ${action.bookingId} belongs to ${booking.studioId}`)
+  const week = state.market.tick
+  const cancelled = cancelCameoBooking(root, booking.bookingId, week, 'explicit')
+  const refund: CameoRefund = { bookingId: booking.bookingId, talentId: booking.talentId, productionId: booking.productionId, amount: cancelled.refund }
+  return {
+    ...state,
+    cameos: cancelled.root,
+    studio: { ...state.studio, cash: state.studio.cash + refund.amount },
+    ledger: [...state.ledger, ...p17RefundRows([refund], week)],
+  }
+}
+
+/** Every permanent cameo career record (Talent Profile / Autopsy read it beside the frozen V8 list; package D17). */
+export function cameoCareerEvents(state: Pick<GameState, 'cameos'>): CameoCareerEvent[] {
+  return cameosOf(state).bookings.flatMap((b) => (b.careerEvent === null ? [] : [b.careerEvent]))
+}
+
+/** The Bridge's DirectSequel candidates (package D22): one per StoryProperty of a released player film whose live R3
+ * grant the studio holds over the greenlight and earliest release weeks, citing that property's latest released film.
+ * The greenlight itself re-runs the full legality matrix. Empty under the default authority (no P16 producer). */
+export function p17SequelCandidates(state: GameState, rights: ContinuationRights = continuationRightsFor(state)): { storyPropertyId: string; predecessorProductionId: string }[] {
+  if (rights === NO_RIGHTS_AUTHORITY) return []
+  const studioId = p17StudioId(state)
+  const week = state.market.tick
+  const latest = new Map<string, FilmResult>()
+  for (const film of state.studio.releasedFilms) {
+    const property = rights.storyPropertyOf(film.productionId)
+    if (property === null) continue
+    const best = latest.get(property)
+    if (best === undefined || film.releaseTick > best.releaseTick || (film.releaseTick === best.releaseTick && film.productionId > best.productionId)) latest.set(property, film)
+  }
+  const out: { storyPropertyId: string; predecessorProductionId: string }[] = []
+  for (const [storyPropertyId, film] of [...latest.entries()].sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))) {
+    if (continuationRightsRefusal(rights, studioId, storyPropertyId, 'directSequel', week) !== null) continue
+    if (continuationRightsRefusal(rights, studioId, storyPropertyId, 'directSequel', week + TUNING.PRODUCTION_TICKS) !== null) continue
+    out.push({ storyPropertyId, predecessorProductionId: film.productionId })
+  }
+  return out
+}
