@@ -0,0 +1,248 @@
+// ── P17 Shape A — bounded cameo/featured-role law ─────────────────────────────
+//
+// Authority: 1367-stage/p17-prep/P17-CAMEO-CONTRACT.md, adopted as versioned PROVISIONAL rules by 1367-G
+// (§2 capability and profile table; §3 publicity delta, performance weight, credits; §4 quote, one-week
+// work, fee, cancellation; §5 persistence); rev02 §13 Shape A and §14 fame ≠ skill. Three principals stay
+// required; guests live in their own root (`cameos`), never inside the frozen `FilmParticipants` leaf.
+//
+// Pure: no RNG, no I/O. The action/tick wiring lives in continuationGreenlight.ts, actions.ts, tick.ts.
+
+import { fameReach } from './economy.js'
+import { clamp } from './math.js'
+import { TUNING } from './tuning.js'
+import type { CameoBooking, CameoCancelReason, CameoCareerEvent, CameoRoot, CreativeRole, Segment, SegmentId } from './types.js'
+
+export type { CameoBooking, CameoRoot } from './types.js'
+
+export const P17_CAMEO_RULE_VERSION = 'p17-cameo/v1' as const
+/** The capability table (1956 unlock, ≤2 guests) and the profession profile table a quote was evaluated under
+ * (cameo contract §5 "quote rule/capability/profile versions"). A retune of either is a new version. */
+export const P17_CAMEO_CAPABILITY_VERSION = 'p17-cameo-capability/v1' as const
+export const P17_CAMEO_PROFILE_VERSION = 'p17-cameo-profile/v1' as const
+export const P17_CAMEO_FEE_NOTE = 'P17 cameo appearance fee (one-week featured booking)'
+export const P17_CAMEO_REFUND_NOTE = 'P17 cameo booking refund (fee less the retained reservation charge)'
+
+/** A booking request on a greenlight: the guest, the one work week, and the exact quote it accepts (`cameoQuote`'s
+ * token). A changed quote input refuses as stale before any mutation (cameo contract §4; review F28). */
+export type CameoBookingRequest = { talentId: string; workWeek: number; quoteToken: string }
+
+export function emptyCameoRoot(): CameoRoot {
+  return { version: 1, nextOrdinal: 1, bookings: [] }
+}
+
+/** Absent-safe read of the root (pre-step in-memory fragments; the save boundary requires the root). */
+export function cameosOf(state: { cameos?: CameoRoot }): CameoRoot {
+  return state.cameos ?? emptyCameoRoot()
+}
+
+// ── §2 capability and profile ─────────────────────────────────────────────────
+/** Featured/cameo capacity at a week: 0 before the 1956 unlock, two from it on. `additionalPrincipals` is always 0. */
+export function featuredCapacity(week: number): 0 | 2 {
+  return week >= TUNING.P17_CAMEO_UNLOCK_WEEK ? TUNING.P17_CAMEO_MAX_GUESTS : 0
+}
+
+export function cameoProfileAffinity(profession: CreativeRole, segmentId: SegmentId): number {
+  return TUNING.P17_CAMEO_PROFILE[profession][segmentId]
+}
+
+// ── §4 price ──────────────────────────────────────────────────────────────────
+/** fee = round(0.35·(SALARY_BASE + SALARY_SKILL_COEF·(ovr/100)² + SALARY_FAME_COEF·(fame/100)²)); one rounding. */
+export function cameoFee(perceivedActingOVR: number, fame: number): number {
+  const ovr = clamp(perceivedActingOVR, 0, 100) / 100
+  const f = clamp(fame, 0, 100) / 100
+  return Math.round(TUNING.P17_CAMEO_FEE_FRACTION * (TUNING.SALARY_BASE + TUNING.SALARY_SKILL_COEF * ovr * ovr + TUNING.SALARY_FAME_COEF * f * f))
+}
+
+export function cameoRetained(fee: number): number {
+  return Math.round(fee * TUNING.P17_CAMEO_CANCEL_RETAINED_FRACTION)
+}
+
+// ── §3 publicity ──────────────────────────────────────────────────────────────
+export type PublicityName = { fame: number; profession: CreativeRole }
+
+function pool(names: readonly { fame: number; affinity: number }[]): number {
+  let p = 0
+  names.forEach((n, rank) => {
+    p += fameReach(n.fame) * Math.pow(TUNING.P17_CAMEO_RANK_DECAY, rank) * n.affinity
+  })
+  return p
+}
+
+/**
+ * delta(segment) = (P_all − P_principals) / 2 with P = Σ f/(f+50)·0.5^rank·affinity, ranked by fame descending;
+ * ties keep principal seat order then committed guest order (C7). Principals carry affinity 1.
+ */
+export function cameoPublicityDelta(principals: readonly { fame: number }[], guests: readonly PublicityName[], segments: readonly Segment[]): Record<SegmentId, number> {
+  const out = {} as Record<SegmentId, number>
+  for (const seg of segments) {
+    const base = principals.map((p, i) => ({ fame: p.fame, affinity: 1, order: i }))
+    const all = [...base, ...guests.map((g, i) => ({ fame: g.fame, affinity: cameoProfileAffinity(g.profession, seg.id), order: principals.length + i }))]
+    const byFame = (a: { fame: number; order: number }, b: { fame: number; order: number }) => (b.fame - a.fame) || (a.order - b.order)
+    const pAll = pool([...all].sort(byFame))
+    const pPrincipals = pool([...base].sort(byFame))
+    out[seg.id] = guests.length === 0 ? 0 : (pAll - pPrincipals) / TUNING.P17_CAMEO_POOL_NORMALIZER
+  }
+  return out
+}
+
+/** The share-weighted delta for the existing secondary star-attention driver (standing.ts). */
+export function cameoAttentionDelta(delta: Record<SegmentId, number>, segments: readonly Segment[]): number {
+  let d = 0
+  for (const seg of segments) d += seg.share * delta[seg.id]
+  return d
+}
+
+// ── §4/§5 booking lifecycle ───────────────────────────────────────────────────
+export type CameoQuoteCommit = {
+  studioId: string
+  productionId: string
+  talentId: string
+  workWeek: number
+  bookedWeek: number
+  basis: 'employee' | 'freelance'
+  profession: CreativeRole
+  fee: number
+  perceivedActingOVR: number
+  fame: number
+}
+
+export function commitCameoBooking(root: CameoRoot, q: CameoQuoteCommit): CameoRoot {
+  const booking: CameoBooking = {
+    bookingId: `cameo-${root.nextOrdinal}`,
+    studioId: q.studioId,
+    productionId: q.productionId,
+    talentId: q.talentId,
+    workWeek: q.workWeek,
+    bookedWeek: q.bookedWeek,
+    basis: q.basis,
+    profession: q.profession,
+    fee: q.fee,
+    retained: cameoRetained(q.fee),
+    quote: { perceivedActingOVR: q.perceivedActingOVR, fame: q.fame, ruleVersion: P17_CAMEO_RULE_VERSION, capabilityVersion: P17_CAMEO_CAPABILITY_VERSION, profileVersion: P17_CAMEO_PROFILE_VERSION },
+    status: 'reserved',
+    completedWeek: null,
+    completedExecution: null,
+    cancelledWeek: null,
+    cancelReason: null,
+    refund: null,
+    releasedWeek: null,
+    careerEvent: null,
+  }
+  return { ...root, nextOrdinal: root.nextOrdinal + 1, bookings: [...root.bookings, booking] }
+}
+
+function cancelled(b: CameoBooking, week: number, reason: CameoCancelReason): CameoBooking {
+  return { ...b, status: 'cancelled', cancelledWeek: week, cancelReason: reason, refund: b.fee - b.retained }
+}
+
+/** Cancel one reserved booking: one linked refund of fee − retained; completed or already-cancelled work refuses. */
+export function cancelCameoBooking(root: CameoRoot, bookingId: string, week: number, reason: CameoCancelReason): { root: CameoRoot; refund: number } {
+  const b = root.bookings.find((x) => x.bookingId === bookingId)
+  if (!b) throw new Error(`cameo: no booking ${bookingId}`)
+  if (b.status === 'completed') throw new Error(`cameo: ${bookingId} is completed work and cannot be cancelled`)
+  if (b.status === 'cancelled') throw new Error(`cameo: ${bookingId} is already cancelled`)
+  const next = cancelled(b, week, reason)
+  return { root: { ...root, bookings: root.bookings.map((x) => (x === b ? next : x)) }, refund: next.refund! }
+}
+
+export type CameoRefund = { bookingId: string; talentId: string; productionId: string; amount: number }
+
+/** Cancel every reserved booking matching `where`; completed work is preserved. */
+export function cancelReservedBookings(root: CameoRoot, where: (b: CameoBooking) => boolean, week: number, reason: CameoCancelReason): { root: CameoRoot; refunds: CameoRefund[] } {
+  const refunds: CameoRefund[] = []
+  let changed = false
+  const bookings = root.bookings.map((b) => {
+    if (b.status !== 'reserved' || !where(b)) return b
+    changed = true
+    const next = cancelled(b, week, reason)
+    refunds.push({ bookingId: b.bookingId, talentId: b.talentId, productionId: b.productionId, amount: next.refund! })
+    return next
+  })
+  return { root: changed ? { ...root, bookings } : root, refunds }
+}
+
+export type CameoWorkWeek = {
+  productionId: string
+  week: number
+  shootingWeek: boolean
+  execution: number | ((talentId: string) => number) | null
+  /** The picture is held this week because its producing studio lost the continuation grant (review F10). */
+  rightsHeld?: boolean
+}
+
+/**
+ * The booked week of one production: real shooting work completes the appearance and freezes the guest's
+ * actual-skill execution; a picture held by rights loss closes the booking with `rightsLoss`; any other outcome
+ * (not a shooting week, no allocated unit, or the week already passed while still reserved) cancels with
+ * `missedWork`. Every closure retains the declared charge and refunds the remainder once.
+ */
+export function resolveCameoWorkWeekWithRefunds(root: CameoRoot, args: CameoWorkWeek): { root: CameoRoot; refunds: CameoRefund[]; completed: CameoBooking[] } {
+  const refunds: CameoRefund[] = []
+  const completed: CameoBooking[] = []
+  let changed = false
+  const bookings = root.bookings.map((b) => {
+    if (b.status !== 'reserved' || b.productionId !== args.productionId || b.workWeek > args.week) return b
+    changed = true
+    if (!args.rightsHeld && b.workWeek === args.week && args.shootingWeek && args.execution !== null) {
+      const execution = typeof args.execution === 'function' ? args.execution(b.talentId) : args.execution
+      const done: CameoBooking = { ...b, status: 'completed', completedWeek: args.week, completedExecution: execution }
+      completed.push(done)
+      return done
+    }
+    const next = cancelled(b, args.week, args.rightsHeld ? 'rightsLoss' : 'missedWork')
+    refunds.push({ bookingId: b.bookingId, talentId: b.talentId, productionId: b.productionId, amount: next.refund! })
+    return next
+  })
+  return { root: changed ? { ...root, bookings } : root, refunds, completed }
+}
+
+/** The root-only form; the same reference comes back when nothing resolved. */
+export function resolveCameoWorkWeek(root: CameoRoot, args: CameoWorkWeek): CameoRoot {
+  return resolveCameoWorkWeekWithRefunds(root, args).root
+}
+
+/** The release credits every completed appearance on the picture exactly once; unperformed work earns nothing. */
+export function releaseCameoBookings(root: CameoRoot, productionId: string, week: number): CameoRoot {
+  let changed = false
+  const bookings = root.bookings.map((b) => {
+    if (b.productionId !== productionId || b.status !== 'completed' || b.releasedWeek !== null) return b
+    changed = true
+    return { ...b, releasedWeek: week }
+  })
+  return changed ? { ...root, bookings } : root
+}
+
+/** The release-careers pipeline's cameo records land on their bookings, once (eventId `${filmId}:${talentId}`). */
+export function attachCameoCareerEvents(root: CameoRoot, events: readonly CameoCareerEvent[]): CameoRoot {
+  if (events.length === 0) return root
+  const byKey = new Map(events.map((e) => [`${e.filmId}:${e.talentId}`, e]))
+  const bookings = root.bookings.map((b) => {
+    const event = b.status === 'completed' ? byKey.get(`${b.productionId}:${b.talentId}`) : undefined
+    if (event === undefined) return b
+    if (b.careerEvent !== null) throw new Error(`cameo: ${b.bookingId} already carries its release career credit`)
+    if (b.releasedWeek !== event.releaseWeek) throw new Error(`cameo: ${b.bookingId} career credit week ${event.releaseWeek} is not its release week ${b.releasedWeek}`)
+    byKey.delete(`${b.productionId}:${b.talentId}`)
+    return { ...b, careerEvent: event }
+  })
+  if (byKey.size > 0) throw new Error(`cameo: career credit names no completed booking: ${[...byKey.keys()].join(', ')}`)
+  return { ...root, bookings }
+}
+
+export function completedGuestsFor(root: CameoRoot, productionId: string): CameoBooking[] {
+  return root.bookings.filter((b) => b.productionId === productionId && b.status === 'completed')
+}
+
+export function committedGuestsFor(root: CameoRoot, productionId: string): CameoBooking[] {
+  return root.bookings.filter((b) => b.productionId === productionId && b.status !== 'cancelled')
+}
+
+/** Guests holding a RESERVED one-week appearance inside `[fromWeek, untilWeekExclusive)` — the obligation interval
+ * resolver (cameo contract §4; Codex finding 5a). A production or research seat beginning at `fromWeek` is open-ended
+ * (the default bound); a screenplay assignment passes its own due week, so unrelated weeks stay usable; a one-week
+ * guest booking checks its own week in `cameoEligibility`. Hiring, markets and employment status never read this: a
+ * booking accepted while freelance survives later employment and the person stays signable. */
+export function reservedCameoTalentIds(root: CameoRoot, fromWeek: number, untilWeekExclusive = Number.POSITIVE_INFINITY): Set<string> {
+  const ids = new Set<string>()
+  for (const b of root.bookings) if (b.status === 'reserved' && b.workWeek >= fromWeek && b.workWeek < untilWeekExclusive) ids.add(b.talentId)
+  return ids
+}
