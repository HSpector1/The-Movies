+
+const fn = <T>(name: string): T => {
+  const f = (saveModule as unknown as Record<string, unknown>)[name]
+  if (typeof f !== 'function') throw new Error(`save.ts does not export ${name}`)
+  return f as T
+}
+const validateLive = (s: unknown): LiveSaveFile => validateSaveP17(s)
+const validatePred = fn<(s: unknown) => SaveFile>(`validateSaveV${P17_PREDECESSOR_SAVE_VERSION}`)
+const downgrade = (s: unknown): SaveFile => convertP17ToPredecessor(s as LiveSaveFile)
+const upgrade = (s: unknown): LiveSaveFile => convertPredecessorToP17(s as Parameters<typeof convertPredecessorToP17>[0])
+const migrateToStep = (s: unknown): LiveSaveFile => migrateToP17(s as SaveFile)
+
+const GENUINE_V45 = new URL('./fixtures/p14/genuine-v45-binding-cash-1363/genuine-v45-binding-cash-count12.json.gz', import.meta.url)
+const genuineV45 = () => JSON.parse(gunzipSync(readFileSync(GENUINE_V45)).toString('utf8')) as { saveVersion: number; state: Record<string, unknown> }
+
+describe('P17 save step — constants and fresh worlds', () => {
+  it('the live version is the P17 step and its predecessor is one below', () => {
+    expect(LIVE_SAVE_VERSION).toBe(P17_SAVE_VERSION)
+    expect(P17_PREDECESSOR_SAVE_VERSION).toBe(P17_SAVE_VERSION - 1)
