+// ── P17 r2 — continuations and featured guests ride the Bridge's greenlight intent (F06/F33) ────────────────
+//
+// Review r1 findings F06/F33: the Bridge's only greenlight (`greenlightPicture` → `greenlightScriptProject`) could
+// carry neither a continuation nor a cameo booking. r2 (package PROGRESS D22) publishes bounded, digest-bound P17
+// variants of the SAME intent kind — one featured-guest variant per greenlightable package from the 1956 unlock, and
+// one DirectSequel variant per rights-held property — each validated by the engine before it is offered. No wire
+// schema change: the variant is the existing AvailableIntent shape with its own opaque id, label and detail.
+//
+// World: a lawful late managed studio (tests/helpers/p17-fixtures.ts `lateManagedStudio`), driven through
+// the Bridge's own guided journey (`selectJourneyIntent` + `applyAvailableIntent`) until packages are greenlightable.
+
+import { describe, expect, it } from 'vitest'
+import { applyAvailableIntent, availableIntents, selectJourneyIntent } from '../bridge/session.ts'
+import { snapshotBuildContextFor } from '../bridge/snapshot-build-context.ts'
+import type { GameState } from '../src/core/index.ts'
+import { P17_CAMEO_FEE_NOTE } from '../src/core/cameo.ts'
+import { lateManagedStudio } from './helpers/p17-fixtures.ts'
+
+function toGreenlight(start: GameState): GameState {
+  let state = start
+  for (let guard = 0; guard < 80; guard++) {
+    const candidates = availableIntents(state).filter((c) => c.kind !== 'startConstruction')
+    if (candidates.some((c) => c.kind === 'greenlightPicture')) return state
+    const selected = selectJourneyIntent(candidates, snapshotBuildContextFor(state).lotSnapshot().firstFilmJourney)
+    if (selected === undefined) throw new Error(`premise: the guided journey stalled at week ${state.market.tick}`)
+    const outcome = applyAvailableIntent(state, selected.intentId)
+    if (!outcome.ok) throw new Error(`premise: ${selected.kind} refused: ${outcome.error}`)
+    state = outcome.next
+  }
+  throw new Error('premise: no greenlightable package within 80 journey steps')
+}
+
+describe('P17 r2 — Bridge greenlight variants', () => {
+  it('from 1956 the Bridge offers a featured-guest variant of a package greenlight; accepting it books the guest and charges the fee once; with no rights producer no continuation variant is offered', () => {
+    const state = toGreenlight(lateManagedStudio('p17-r2-bridge-01'))
+    const greenlights = availableIntents(state).filter((c) => c.kind === 'greenlightPicture')
+    const featured = greenlights.filter((c) => /featured guest/i.test(c.label))
+    expect(featured.length, 'one featured-guest variant per greenlightable package').toBeGreaterThan(0)
+    expect(featured[0]!.detail).toMatch(/fee/i)
+    expect(featured[0]!.detail).toMatch(/retained/i)
+    expect(featured[0]!.detail).toMatch(/shooting/i)
+    expect(greenlights.some((c) => /sequel|continuation/i.test(c.label))).toBe(false)
+    const outcome = applyAvailableIntent(state, featured[0]!.intentId)
+    expect(outcome.ok).toBe(true)
+    if (!outcome.ok) return
+    const booking = outcome.next.cameos.bookings.at(-1)!
+    expect(booking.status).toBe('reserved')
+    expect(featured[0]!.label).toContain(outcome.next.talent.find((t) => t.id === booking.talentId)!.name)
+    expect(outcome.next.ledger.filter((e) => e.note === P17_CAMEO_FEE_NOTE).map((e) => e.amount)).toEqual([-booking.fee])
+  }, 240_000)
+})
