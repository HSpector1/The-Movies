+export function continuationAwareness(audienceAwareness: number, inheritedAwareness01: number): number {
+  const a = clamp(audienceAwareness, 0, 100) / 100
+  const i = clamp(inheritedAwareness01, 0, 1)
+  return 100 * (1 - (1 - a) * (1 - i))
+}
