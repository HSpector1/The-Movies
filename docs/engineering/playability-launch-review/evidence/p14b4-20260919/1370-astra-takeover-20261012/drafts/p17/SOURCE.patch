+    expect((live.state.studio.releasedFilms.length + (live.state.hollywood?.films.length ?? 0)) > 0).toBe(true) // the capture has history, and none of it became a franchise
+    // the whole chain agrees: migrateToLive lands on the same bytes, and a second migration is a no-op
