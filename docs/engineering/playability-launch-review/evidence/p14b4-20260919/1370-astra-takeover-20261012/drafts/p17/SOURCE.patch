+function pick(state: GameState, role: 'writer' | 'director' | 'actor', count: number, used: Set<string>): string[] {
+  const out: string[] = []
+  for (const person of [...state.talent].reverse()) {
+    if (out.length === count) break
+    if (person.role !== role || used.has(person.id)) continue
+    if (role !== 'writer' && assignmentRefusal(state, person.id, state.market.tick, role) !== null) continue
+    out.push(person.id)
+    used.add(person.id)
+  }
+  if (out.length !== count) throw new Error(`premise: not enough free ${role}s`)
+  return out
