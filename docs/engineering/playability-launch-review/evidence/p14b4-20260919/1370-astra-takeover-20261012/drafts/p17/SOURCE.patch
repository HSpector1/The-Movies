+// ── P17 r2 — a completed guest's cameo credit reaches Talent Profile and the film's Career Impact (F09/F18) ──
+//
+// Review r1 findings F09/F18 (Codex 5b: "one permanent cameo acting credit ... Use the existing career-event pipeline
+// once"; the r1 credit reached no reader). r2 writes the record through the release-careers builder and stores it on
+// the booking (package PROGRESS D17); these read models show it beside the frozen V8 records, as a "Cameo" row.
+// The booking below is a LABELED SYNTHETIC overlay on a generated world: the case isolates the read model, and the
+// producer side is proven in tests/p17-r2-cameo.test.ts (F09/F18, T07) through the real tick.
+
+import { describe, expect, it } from 'vitest'
+import { buildCameoCareerEvent, computeStarPowerDelta, generateWorld, TUNING } from '../../../src/core/index.ts'
+import type { GameState } from '../../../src/core/index.ts'
+import { filmCareerImpact, talentCareerHistory } from './careerImpact.ts'
+
+describe('P17 r2 — cameo credits in the career read models', () => {
