+    expect(() => downgrade(withFranchise)).toThrow(/cannot downgrade or discard 1 recorded franchise root/)
+    expect(exportSave(withFranchise)).toBe(franchiseBytes)
+    const guest = afterFirst.talent.filter((t) => t.role === 'director' && !used.has(t.id)).sort((a, b) => b.fame - a.fame || (a.id < b.id ? -1 : 1))[0]!
+    const withBooking = makeSave(applyActions(afterFirst, [{ kind: 'greenlight', production: sequel, cameos: [book(afterFirst, guest.id, afterFirst.market.tick + 4)] }]))
+    const bookingBytes = exportSave(withBooking)
+    expect(() => downgrade(withBooking)).toThrow(/cannot downgrade or discard 1 recorded cameo booking/)
+    expect(exportSave(withBooking)).toBe(bookingBytes)
+  }, 30_000)
+})
+
+describe('P17 save step — validators refuse malformed authority; identity walks join both roots', () => {
+  function liveRaw(): { saveVersion: number; state: Record<string, unknown> } {
+    return JSON.parse(exportSave(makeSave(generateWorld('p17-validate')))) as { saveVersion: number; state: Record<string, unknown> }
