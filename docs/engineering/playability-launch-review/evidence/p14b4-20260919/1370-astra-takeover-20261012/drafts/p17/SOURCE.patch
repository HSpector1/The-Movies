+// ── P17 pure-law fixtures: hand-built public FilmResults, frozen participants and a P16 stand-in ──
+// Paper convention (rev02 §5.4): expectedTotal $150M; a film "(c/a, k×)" has critic c, audience a and a
+// realized total of k × $150M. The audience view is the film's adult segment score (one segment mix).
+
+import { emptyFranchiseRoot, type ContinuationRights, type ContinuationWorld, type FranchiseRoot } from '../../src/core/continuation.js'
+import type { FilmParticipants, FilmResult } from '../../src/core/types.js'
+
+export const EXPECTED = 150_000_000
+export const PLAYER = 'studio-player'
+export const RIVAL = 'studio-rival-1'
+
+export type Cast = { writer: string; director: string; lead: string; antagonist: string; support: string }
+
+export function participantsOf(p: Cast): FilmParticipants {
+  const one = (talentId: string, role: FilmParticipants['writer']['role'], discipline: FilmParticipants['writer']['discipline']) => ({
+    talentId, name: talentId, role, discipline, greenlightOVR: 50, greenlightFit: 50, greenlightEP: { low: 40, high: 60, expected: 50 }, freelancer: false,
+  })
+  return {
+    writer: one(p.writer, 'writer', 'writing'),
+    director: one(p.director, 'director', 'directing'),
+    cast: { lead: one(p.lead, 'lead', 'acting'), antagonist: one(p.antagonist, 'antagonist', 'acting'), support: one(p.support, 'support', 'acting') },
+    craft: [one('craft-1', 'craft', 'craft')],
+  }
+}
+
+export function film(productionId: string, releaseTick: number, critic: number, audience: number, mult: number, cast?: Cast): FilmResult {
+  const participants = cast ? participantsOf(cast) : undefined
+  return {
+    productionId,
+    releaseTick,
+    delivered: { intimacy: 0, tonalWeight: 0, kineticEnergy: 0 },
+    cohesion: 0.5,
+    craft: 60,
+    criticMean: critic,
+    criticSigma: 4,
+    criticScore: critic,
+    reviewVariance: 0,
+    segmentScores: { youngAdult: audience, family: audience, adult: audience, prestige: audience },
+    boxOffice: { opening: (mult * EXPECTED) / 3, total: mult * EXPECTED },
+    conceptId: `concept-${productionId}`,
+    directorId: participants?.director.talentId ?? 'dir-1',
+    ...(participants ? { participants } : {}),
+    forecast: { expectedCriticScore: 60, expectedTotal: EXPECTED, expectedOpening: EXPECTED / 3 },
+  }
+}
+
+/** A film→property map and a studio→property grant set, answered as P16's `rightsAuthority(subject R1, 'R3', week, scope)`
+ * would answer; `until` ends every grant at that week (a dated licence term). */
+export function rightsOf(propertyOf: Record<string, string>, grants: Record<string, string[]>, until = Number.POSITIVE_INFINITY): ContinuationRights {
+  return {
+    storyPropertyOf: (filmId) => propertyOf[filmId] ?? null,
+    authority: ({ storyPropertyId, week }) => {
+      if (week >= until) return { kind: 'unavailable', reason: `licence term ended at week ${until}` }
+      const holder = Object.keys(grants).find((studioId) => grants[studioId]!.includes(storyPropertyId))
+      return holder === undefined ? { kind: 'unavailable', reason: 'noHolder' } : { kind: 'authority', studioId: holder }
+    },
+  }
+}
+
+export type WorldSpec = { week: number; root?: FranchiseRoot; rights: ContinuationRights; released?: FilmResult[]; locked?: string[] }
+export function world(spec: WorldSpec): ContinuationWorld {
+  const released = new Map((spec.released ?? []).map((r) => [r.productionId, r]))
+  return {
+    week: spec.week,
+    franchises: spec.root ?? emptyFranchiseRoot(),
+    rights: spec.rights,
+    releasedFilm: (id) => {
+      const r = released.get(id)
+      return r ? { result: r, audience01: r.segmentScores.adult / 100 } : null
+    },
+    isLocked: (id) => (spec.locked ?? []).includes(id),
+  }
+}
