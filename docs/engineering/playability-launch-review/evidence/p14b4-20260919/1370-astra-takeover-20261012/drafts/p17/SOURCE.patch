+// ── the cameo quote (cameo contract §4; review F28) ───────────────────────────
+/** The weeks a picture greenlit at `greenlightWeek` performs shooting work on the standard schedule (legacy operations:
+ * no holds). A managed picture shoots only once its take is scheduled, so these are a projection, never a promise. */
+export function nominalShootingWeeks(greenlightWeek: number): number[] {
+  const weeks: number[] = []
+  for (let k = 1; k <= TUNING.PRODUCTION_TICKS; k++) {
+    if (productionPhaseForRemainingTicksOrNull(TUNING.PRODUCTION_TICKS - (k - 1)) === 'shooting') weeks.push(greenlightWeek + k)
+  }
+  return weeks
+}
+
+export type CameoQuoteView = {
+  ok: true
+  talentId: string
+  name: string
+  profession: CreativeRole
+  basis: 'employee' | 'freelance'
+  greenlightWeek: number
+  workWeek: number
+  fee: number
+  retained: number
+  refundable: number
+  perceivedActingOVR: number
+  fame: number
+  nominalShootingWeeks: number[]
+  /** The readiness risk the contract requires every quote to state. */
+  readinessRisk: string
+  /** Other reserved weeks and the employment consequence the booking carries. */
+  disclosures: string[]
+  /** Accept exactly this quote: a booking request carries it; any changed input refuses as stale. */
+  quoteToken: string
+}
+export type CameoQuoteResult = CameoQuoteView | { ok: false; reason: string }
+
+const money = (n: number): string => `$${Math.round(n).toLocaleString('en-US')}`
+
+/** Person-level law shared by the quote and the greenlight: capability, span, retirement, overlapping work, employer
+ * exclusivity, the fee and the staleness token. Studio-agnostic: `studioId` is the booking studio, player or rival.
+ * Refuses with the exact reason; never mutates. */
+export function evaluateCameoPerson(state: GameState, args: { studioId: string; greenlightWeek: number; talentId: string; workWeek: number }): CameoQuoteResult {
+  const { greenlightWeek, workWeek } = args
+  if (featuredCapacity(greenlightWeek) === 0) return { ok: false, reason: `featured/cameo bookings unlock at week ${TUNING.P17_CAMEO_UNLOCK_WEEK} (1956 Week 1); week ${greenlightWeek} has no capability` }
+  const talent = state.talent.find((t) => t.id === args.talentId)
+  if (!talent) return { ok: false, reason: `guest ${args.talentId} is unknown` }
+  if (!(greenlightWeek < workWeek && workWeek <= greenlightWeek + TUNING.PRODUCTION_TICKS)) {
+    return { ok: false, reason: `work week ${workWeek} must satisfy ${greenlightWeek} < workWeek <= ${greenlightWeek + TUNING.PRODUCTION_TICKS}` }
+  }
+  // Retirement: the current profession AND any recorded actor episode (an actor who retired into writing takes no new
+  // acting job); an announced person may only take work completing at its right boundary by the effective week.
+  const current = retirementRecordFor(state, talent.id)
+  const actorEpisode = retirementRecordFor(state, talent.id, 'actor')
+  for (const record of new Set([current, actorEpisode])) {
+    if (record === undefined) continue
+    if (record.status !== 'announced') return { ok: false, reason: `${talent.id} is ${record.status} and takes no new appearance` }
+    if (workWeek + 1 > record.effectiveWeek) return { ok: false, reason: `${talent.id} retires at week ${record.effectiveWeek}; a week-${workWeek} appearance would not complete before it` }
+  }
+  const root = cameosOf(state)
+  if (root.bookings.some((b) => b.status === 'reserved' && b.talentId === talent.id && b.workWeek === workWeek)) return { ok: false, reason: `${talent.id} already holds a reservation for week ${workWeek}` }
+  // Overlapping actual work (Codex 5a; review F05/F21). A production seat holds until its picture RELEASES: only a seat
+  // whose picture is committed to release (it leaves in this week's tick) ends before any lawful work week; any other
+  // seat — in production, held at Release Ready, stalled, rights-held — is open-ended.
+  const seat = seatingProduction(state, talent.id)
+  if (seat !== undefined && !state.releaseAuthority.commitments.some((r) => r.productionId === seat.id)) {
+    return { ok: false, reason: `${talent.id} is seated on production ${seat.id}, which has no committed release; a seat holds until its picture releases` }
+  }
+  const writing = state.scriptDevelopment.projects.find((p) => (p.status === 'drafting' || p.status === 'rewriting') && p.dueWeek !== null && workWeek < p.dueWeek && scriptProjectWriterIds(p).includes(talent.id))
+  if (writing !== undefined) return { ok: false, reason: `${talent.id} holds an active screenplay assignment (${writing.id}) due at week ${writing.dueWeek}, which covers week ${workWeek}` }
+  // ponytail: a rival seat or script is read as open-ended (its end week is not modelled here); a rival picture that
+  // would end before the work week over-refuses. Read business.productions[].remainingTicks if play needs the interval.
+  if (industryBusyTalentIds(state.hollywood).has(talent.id)) return { ok: false, reason: `${talent.id} is engaged by another studio's production or script` }
+  const research = (state.technology?.projects ?? []).some((p) => p.status === 'active' && p.seats.some((s) => s.talentId === talent.id && s.releasedWeek === null) && activeContract(state, talent.id) !== undefined)
+  if (research) return { ok: false, reason: `${talent.id} holds a research seat (an open-ended assignment)` }
+  // Studio-aware employer exclusivity (cameo contract §4 "the same studio-aware employment/availability law for player
+  // and rivals"): the booking studio's own employee over the work week books as an employee; anyone else's refuses.
+  const employer = activeContract(state, talent.id, workWeek) !== undefined ? p17StudioId(state) : rivalEmployment(state, talent.id, workWeek)?.studioId ?? null
+  if (employer !== null && employer !== args.studioId) return { ok: false, reason: `${talent.id} is another studio's employee at week ${workWeek}` }
+  const basis: 'employee' | 'freelance' = employer === null ? 'freelance' : 'employee'
+  const perceivedActingOVR = roleOVR(talent, 'acting')
+  const fee = cameoFee(perceivedActingOVR, talent.fame)
+  const retained = cameoRetained(fee)
+  const profession = professionAtWeek(state, talent.id, greenlightWeek)
+  const otherWeeks = root.bookings.filter((b) => b.status === 'reserved' && b.talentId === talent.id).map((b) => b.workWeek).sort((a, b) => a - b)
