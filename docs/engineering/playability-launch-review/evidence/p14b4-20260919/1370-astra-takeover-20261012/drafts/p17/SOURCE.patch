+    expect(state.cameos.bookings).toEqual([])
+    const save = makeSave(state)
+    expect(save.saveVersion).toBe(P17_SAVE_VERSION)
+    const bytes = exportSave(save)
+    expect(exportSave(importSave(bytes))).toBe(bytes)
+    expect(exportSave(migrateToLive(importSave(bytes)))).toBe(bytes)
+  })
+})
+
+describe('P17 save step — genuine predecessor migration seeds EMPTY roots and moves nothing else', () => {
+  it('migrates the recorded V45 capture; the stripped state is byte-identical; no franchise or booking is inferred from old films', () => {
+    const raw = genuineV45()
+    expect(raw.saveVersion).toBe(P17_PREDECESSOR_SAVE_VERSION)
+    const pred = validatePred(raw)
+    const live = migrateToStep(raw)
+    expect(live.saveVersion).toBe(P17_SAVE_VERSION)
