+  it('F31/T01: writing work blocks only the reserved guest weeks it covers — commissions, pooling and rewrites refuse a reserved week inside their interval; an unrelated reserved week stays usable', () => {
+    // a second contracted writer, booked as an own-employee guest on this week's greenlight for week W+3
+    const hire = hiringMarketIds(ready.state).find((id) => ready.state.talent.find((t) => t.id === id)!.role === 'writer' && id !== freelancer)!
+    let s = applyActions(ready.state, [{ kind: 'signContract', talentId: hire, termWeeks: TUNING.CONTRACT_MIN_WEEKS }])
+    s = applyActions(s, [{ kind: 'greenlightScriptProject', production: ownPackage(s, ready.projectId), cameos: [book(s, hire, W + 3)] }])
+    expect(s.cameos.bookings.at(-1)).toMatchObject({ talentId: hire, workWeek: W + 3, basis: 'employee', status: 'reserved' })
+    // week W: a pool draft due W+1 covers [W, W+1) — the reserved week W+3 is unrelated, so the commission starts
+    const pool = applyActions(s, [poolCommission(unusedConcept(s), hire)])
+    const poolProject = pool.scriptDevelopment.projects.at(-1)!
+    expect(poolProject).toMatchObject({ writerId: hire, status: 'drafting', dueWeek: W + 1 })
+    // week W+1: the draft is in review; a rewrite (due W+2) still leaves W+3 free — the r1 gate refused it
+    const w1 = tick(pool)
+    expect(w1.scriptDevelopment.projects.find((p) => p.id === poolProject.id)!.status).toBe('review')
+    const rewriting = applyActions(w1, [{ kind: 'requestScriptRewrite', projectId: poolProject.id }])
+    expect(rewriting.scriptDevelopment.projects.find((p) => p.id === poolProject.id)!.status).toBe('rewriting')
+    // week W+3, the reserved week, before its tick resolves the booking: every writing verb covering it refuses
+    let w3 = tick(tick(rewriting))
+    expect(w3.market.tick).toBe(W + 3)
+    expect(w3.cameos.bookings.find((b) => b.talentId === hire)!.status).toBe('reserved')
+    const bytes = exportSave(makeSave(w3))
+    expect(() => applyActions(w3, [poolCommission(unusedConcept(w3), hire)])).toThrow(/reserved guest appearance in weeks/)
+    expect(() => applyActions(w3, [originalScreenplay(unusedConcept(w3), hire)])).toThrow(/reserved guest appearance in weeks/)
+    const other = applyActions(w3, [originalScreenplay(unusedConcept(w3), writer)])
+    expect(() => applyActions(other, [{ kind: 'assignScreenplayWriter', projectId: other.scriptDevelopment.projects.at(-1)!.id, writerId: hire }])).toThrow(/reserved guest appearance in weeks/)
+    expect(exportSave(makeSave(w3))).toBe(bytes)
+    // the rewrite gate is the same interval law: a second pool script commissioned at W+2 is in review at W+3, and
+    // its rewrite (due W+4) covers the reserved week
+    w3 = tick(applyActions(tick(rewriting), [poolCommission(unusedConcept(tick(rewriting)), hire)]))
+    const second = w3.scriptDevelopment.projects.at(-1)!
+    expect(second).toMatchObject({ writerId: hire, status: 'review' })
+    expect(() => applyActions(w3, [{ kind: 'requestScriptRewrite', projectId: second.id }])).toThrow(/active assignment/)
+  }, 60_000)
+})
+
+/** One managed week toward release: Director + take at Shooting, the commitment at Release Ready, then the tick. */
+function managedStep(s: GameState, id: string, deps: Parameters<typeof applyActions>[2]): GameState {
+  const production = s.studio.activeProductions.find((p) => p.id === id)!
+  const workflow = s.operations.workflows.find((w) => w.productionId === id)!
+  let next = s
+  if (workflow.phase === 'shooting' && workflow.shootingTask?.status === 'unassigned') {
+    next = applyActions(next, [{ kind: 'assignShootingDirector', productionId: id, directorId: production.directorId }, { kind: 'scheduleShootingTake', productionId: id }], deps)
+  }
+  if (production.remainingTicks === 1 && !next.releaseAuthority.commitments.some((r) => r.productionId === id)) {
+    return applyActions(next, [{ kind: 'commitPictureToRelease', productionId: id }], deps)
+  }
+  return tick(next, deps)
+}
+
+/** A market concept no screenplay project has used yet. */
+function unusedConcept(state: GameState): FilmConcept {
+  const used = new Set(state.scriptDevelopment.projects.map((p) => p.conceptId))
+  const concept = state.concepts.find((c) => !used.has(c.id))
+  if (concept === undefined) throw new Error('premise: no unused concept')
+  return concept
+}
+
+const SCRIPT_SHAPE = { opening: 'slowSetup', midpoint: 'revelation', ending: 'bittersweet' } as const
+const promiseFor = (concept: FilmConcept) => ({ genre: concept.genre, intendedSegments: ['adult' as const], ranges: { intimacy: [-0.4, 0.6] as [number, number], tonalWeight: [0, 0.8] as [number, number], kineticEnergy: [-0.7, 0.2] as [number, number] } })
+const poolCommission = (concept: FilmConcept, writerId: string): Action => ({ kind: 'commissionScript', project: { conceptId: concept.id, writerId, shape: SCRIPT_SHAPE, promise: promiseFor(concept) } })
+const originalScreenplay = (concept: FilmConcept, writerId: string): Action => ({ kind: 'commissionOriginalScreenplay', screenplay: { genre: concept.genre, writerId, shape: SCRIPT_SHAPE, promise: promiseFor(concept) } })
