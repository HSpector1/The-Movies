+// ── P17 r2 — the save validators refuse every row no lawful producer writes ────────────────────────────
+//
+// Review r1 findings F15 (edge parents, peakInstallmentId, per-production guest count, work-week span, fee joins and
+// frozen versions unchecked) and F17 (a loaded save could create cash through a forged fee, bypass the rights gate
+// through a null edge studio, or collide ids through a stale nextOrdinal). Authority: cameo contract §5 ("quote
+// rule/capability/profile versions, frozen fee inputs ... linked refund/settlement facts") and §6 item 8 ("exact
+// identity/refund/fee/credit joins; duplicates/missing rows rejected from otherwise-valid baselines"); canonical rev02
+// §10 state-rot guards (ids minted from a monotonic ordinal; closed enums); charter r2 line 31.
+//
+// Baseline: one lawful save on the live 1956 world carrying a franchise root (a DirectSequel under the injected
+// grant) and two reserved bookings. Each case forges exactly one row of that save and must be refused by name.
+
+import { describe, expect, it } from 'vitest'
+import { applyActions } from '../src/core/actions.js'
+import { P17_CAMEO_FEE_NOTE } from '../src/core/cameo.js'
+import { exportSave, importSave, makeSave } from '../src/core/save.js'
+import { TUNING } from '../src/core/tuning.js'
+import type { GameState, Talent } from '../src/core/types.js'
+import { book, m0aWorldAt, payload, produceAndRelease, rightsFor } from './helpers/p17-fixtures.js'
+
+const famous = (state: GameState, role: Talent['role'], exclude: ReadonlySet<string>): Talent[] =>
+  [...state.talent].filter((t) => t.role === role && !exclude.has(t.id)).sort((a, b) => b.fame - a.fame || (a.id < b.id ? -1 : 1))
+
+type Json = Record<string, any> // eslint-disable-line @typescript-eslint/no-explicit-any
+
+describe('P17 r2 — exact-join save validators', () => {
+  const world = m0aWorldAt('p17-r2-validate-01', TUNING.P17_CAMEO_UNLOCK_WEEK)
+  const used = new Set<string>()
+  const afterFirst = produceAndRelease(world, { kind: 'greenlight', production: payload(world, world.concepts[0]!, used) })
+  const f1 = afterFirst.studio.releasedFilms.at(-1)!
+  const W = afterFirst.market.tick
+  const sequel = payload(afterFirst, afterFirst.concepts.find((c) => c.id !== f1.conceptId)!, used)
+  const [g1, g2] = famous(afterFirst, 'director', used)
+  const lawful = applyActions(afterFirst, [{
+    kind: 'greenlight', production: sequel, continuation: { type: 'directSequel', predecessorProductionId: f1.productionId },
+    cameos: [book(afterFirst, g1!.id, W + 4), book(afterFirst, g2!.id, W + 5)],
+  }], { continuationRights: rightsFor(f1.productionId) })
+  const text = exportSave(makeSave(lawful))
+  const forge = (edit: (save: Json) => void): string => {
+    const save = JSON.parse(text) as Json
+    edit(save)
+    return JSON.stringify(save)
+  }
+  const refuses = (edit: (save: Json) => void, pattern: RegExp) => expect(() => importSave(forge(edit))).toThrow(pattern)
+
+  it('the lawful baseline loads and round-trips byte for byte', () => {
+    expect(exportSave(importSave(text))).toBe(text)
+  })
+
+  it('cameos: a third live guest, the same guest twice, and a work week outside the nominal span are refused', () => {
+    refuses((s) => {
+      const b = s.state.cameos.bookings
+      b.push({ ...b[0], bookingId: `cameo-${s.state.cameos.nextOrdinal}`, talentId: famous(afterFirst, 'writer', used)[0]!.id })
+      s.state.cameos.nextOrdinal += 1
+    }, /carries 3 guests; at most 2 are ever booked/)
+    refuses((s) => { s.state.cameos.bookings[1].talentId = s.state.cameos.bookings[0].talentId }, /the same guest is booked twice on/)
+    refuses((s) => { s.state.cameos.bookings[0].workWeek = s.state.cameos.bookings[0].bookedWeek + 40 }, /work week \d+ must satisfy/)
+  })
+
+  it('cameos: a fee that is not the frozen quote\'s fee, a retained charge that is not round(0.25·fee), an unknown studio, and a booking whose fee was never charged are refused', () => {
+    refuses((s) => { s.state.cameos.bookings[0].fee = 50_000_000 }, /fee 50000000 is not the frozen quote's fee/)
+    refuses((s) => { s.state.cameos.bookings[0].retained = 0 }, /retained 0 is not the declared charge/)
+    refuses((s) => { s.state.cameos.bookings[0].studioId = 'nobody-studio' }, /studio nobody-studio was not the player studio at week/)
+    // re-point the first guest's fee row at the second guest: Σledger and cash still reconcile, so only the P17 join can see it
+    refuses((s) => {
+      const [b0, b1] = s.state.cameos.bookings
+      const row = s.state.ledger.find((e: Json) => e.note === P17_CAMEO_FEE_NOTE && e.talentId === b0.talentId)
+      row.talentId = b1.talentId
+    }, /has no fee ledger row/)
+  })
+
+  it('cameos: the quote freezes its rule, capability and profile versions; a stale nextOrdinal is refused', () => {
+    const save = JSON.parse(text) as Json
+    expect(save.state.cameos.bookings[0].quote).toMatchObject({ ruleVersion: 'p17-cameo/v1', capabilityVersion: expect.any(String), profileVersion: expect.any(String) })
+    refuses((s) => { s.state.cameos.nextOrdinal = 1 }, /nextOrdinal 1 is not one past the 2 minted bookings/)
+  })
+
+  it('T12 single-defect identity joins: an edge naming an unpersisted production, an edge naming an unknown branch, a booking naming an unpersisted production or an unknown person, a duplicate booking and a duplicate edge — each refused by its own check', () => {
+    const cont = (s: Json) => s.state.franchises.properties[0].installments.find((e: Json) => e.type !== 'origin')
+    refuses((s) => { cont(s).childProductionId = 'prod-ghost' }, /childProductionId prod-ghost is not a persisted production/)
+    refuses((s) => { cont(s).branchId = 'branch-99' }, /names branch branch-99, which the property does not have/)
+    refuses((s) => { s.state.cameos.bookings[0].productionId = 'prod-ghost' }, /productionId prod-ghost is not a persisted production/)
+    refuses((s) => { s.state.cameos.bookings[0].talentId = 'nobody' }, /talentId nobody is not a known person/)
+    refuses((s) => {
+      s.state.cameos.bookings.push({ ...s.state.cameos.bookings[0] })
+      s.state.cameos.nextOrdinal += 1
+    }, /is not the ordinal-minted cameo-3/)
+    refuses((s) => { s.state.franchises.properties[0].installments.push({ ...cont(s) }) }, /duplicate installment/)
+    refuses((s) => { s.state.franchises.properties.push({ ...s.state.franchises.properties[0], franchiseId: 'franchise-9' }) }, /duplicate storyPropertyId/)
+  })
+
+  it('franchises: a continuation edge naming a parent that is not an installment, a null exercising studio, a similarity off its type, a studio on the origin edge, an unknown peak, and a stale nextOrdinal are refused', () => {
+    const cont = (s: Json) => s.state.franchises.properties[0].installments.find((e: Json) => e.type !== 'origin')
+    const origin = (s: Json) => s.state.franchises.properties[0].installments.find((e: Json) => e.type === 'origin')
+    refuses((s) => { cont(s).parentProductionId = 'prod-ghost' }, /parent prod-ghost is not an earlier installment/)
+    refuses((s) => { cont(s).studioId = null }, /a directSequel records the player studio that greenlit it; found null/)
+    refuses((s) => { cont(s).similarity = 0.2 }, /similarity 0\.2 is not the directSequel similarity/)
+    refuses((s) => { origin(s).studioId = 'player' }, /an origin edge names no parent, no exercising studio and no greenlight week/)
+    refuses((s) => { s.state.franchises.properties[0].meter.peakInstallmentId = 'prod-ghost' }, /peakInstallmentId prod-ghost is not a released installment of the property/)
+    refuses((s) => { s.state.franchises.nextOrdinal = 1 }, /at or beyond nextOrdinal 1/)
+  })
+})
