+    const extra = liveRaw()
+    ;(extra.state.franchises as Record<string, unknown>).ownerStudioId = 'x'
+    expect(() => validateLive(extra)).toThrow(/expected exactly keys \[nextOrdinal,properties,version\]/)
+  })
+
+  // The duplicate-property and identity-join cases are single-defect forgeries of a LAWFUL save in
+  // tests/p17-r2-validate.test.ts (review T12: here each fixture carried two defects and the first check masked the second).
+
+  it('persistedProductionIds walks lineage children and booking productions', () => {
+    const state = generateWorld('p17-ids')
+    const week = state.market.tick
+    const withRoots: GameState = {
+      ...state,
+      franchises: { version: 1, nextOrdinal: 2, properties: [{ storyPropertyId: 'prop-1', franchiseId: 'franchise-1', mintedWeek: week,
+        meter: { bestScore: 0, residualScoreSum: 0, peakInstallmentId: null, rPeak: 0, fatigue: 0, fatigueUpdateWeek: week, fatigueLastQuality: null, releaseCount: 0, firstFilmExempt: true },
+        branches: [{ branchId: 'branch-1', kind: 'main', subPropertyId: null, openedAtWeek: week, momentum: 0, momentumUpdateWeek: week, lastReleaseWeek: null, priorGapWeeks: null }],
+        installments: [{ childProductionId: 'lineage-child', parentProductionId: null, type: 'origin', branchId: 'branch-1', similarity: 0, greenlitWeek: null, studioId: null, releasedWeek: null }],
+        subProperties: [], milestones: [] }] },
+      cameos: { version: 1, nextOrdinal: 2, bookings: [{
+        bookingId: 'cameo-1', studioId: 's', productionId: 'booked-production', talentId: state.talent[0]!.id, workWeek: week + 2, bookedWeek: week, basis: 'freelance', profession: 'actor',
+        fee: 10, retained: 3, quote: { perceivedActingOVR: 1, fame: 0, ruleVersion: 'p17-cameo/v1', capabilityVersion: 'p17-cameo-capability/v1', profileVersion: 'p17-cameo-profile/v1' },
+        status: 'reserved', completedWeek: null, completedExecution: null, cancelledWeek: null, cancelReason: null, refund: null, releasedWeek: null, careerEvent: null }] },
+    }
+    const ids = persistedProductionIds(withRoots)
+    expect(ids.has('lineage-child')).toBe(true)
+    expect(ids.has('booked-production')).toBe(true)
+  })
+})
