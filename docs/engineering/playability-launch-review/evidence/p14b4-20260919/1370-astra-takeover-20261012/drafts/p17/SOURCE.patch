@@ -0,0 +1,115 @@
+// ── P17 r2 — a lost right never throws or soft-locks the tick ──────────────────────────────────────
+//
+// Review r1 findings F04 (a dated grant that ends before release made every later tick throw; cancel left an
+// orphan commitment row; commitPictureToRelease never re-read the grant), F10 (between greenlight and release a
+// revoked right stopped nothing), F20 (the release compared the live holder with the stored greenlight studio).
+// Authority: charter r2 line 11 ("Rights loss stops unauthorized new work/continuation"; "at quote, accepted
+// greenlight, release and any rights-sensitive resume"); Codex reviews/p17-p18 §1 ("rights loss must use the
+// actual cancellation/claims owner"); the user's law: no lawful route may throw or soft-lock the tick.
+//
+// World: the headless M0A world (`generateWorld`, legacy operations), ticked naturally. Rights: the injected
+// P16 stand-in (package PROGRESS D2/D11).
+
+import { describe, expect, it } from 'vitest'
+import { applyActions } from '../src/core/actions.js'
+import { commitContinuationGreenlight, continuationQuote, continuationReleaseAuthority } from '../src/core/continuation.js'
+import { exportSave, makeSave } from '../src/core/save.js'
+import { tick } from '../src/core/tick.js'
+import { TUNING } from '../src/core/tuning.js'
+import { generateWorld } from '../src/core/worldgen.js'
+import type { GameState, Production } from '../src/core/types.js'
+import { payload, produceAndRelease, rightsFor, switchableRights } from './helpers/p17-fixtures.js'
+import { film, rightsOf, world } from './helpers/p17-law-fixtures.js'
+
+const newest = (s: GameState): string => s.studio.activeProductions[s.studio.activeProductions.length - 1]!.id
+const production = (s: GameState, id: string): Production => {
+  const p = s.studio.activeProductions.find((x) => x.id === id)
+  if (p === undefined) throw new Error(`premise: production ${id} is not active`)
+  return p
+}
+
+describe('P17 r2 — rights loss between greenlight and release (F04, F10)', () => {
+  const start = generateWorld('p17-r2-rights-01')
+  const afterFirst = produceAndRelease(start, { kind: 'greenlight', production: payload(start, start.concepts[0]!, new Set()) })
+  const f1 = afterFirst.studio.releasedFilms[0]!
+  const concept2 = afterFirst.concepts.find((c) => c.id !== f1.conceptId)!
+  const sequel = payload(afterFirst, concept2, new Set())
+  const W = afterFirst.market.tick
+  const request = { type: 'directSequel', predecessorProductionId: f1.productionId } as const
+
+  it('commitPictureToRelease re-reads the live grant: a licence that ended while the picture waited at Release Ready refuses the commitment and leaves the input unchanged', () => {
+    const deps = { continuationRights: rightsFor(f1.productionId, { until: W + TUNING.PRODUCTION_TICKS + 1 }) }
+    let s = applyActions(afterFirst, [{ kind: 'greenlight', production: sequel, continuation: request }], deps)
+    const id = newest(s)
+    for (let i = 0; i < TUNING.PRODUCTION_TICKS + 1; i++) s = tick(s, deps) // Release Ready at W+8, still waiting at W+9
+    expect(s.market.tick).toBe(W + TUNING.PRODUCTION_TICKS + 1)
+    expect(production(s, id).remainingTicks).toBe(1)
+    const bytes = exportSave(makeSave(s))
+    expect(() => applyActions(s, [{ kind: 'commitPictureToRelease', productionId: id }], deps)).toThrow(/licence term ended/)
+    expect(exportSave(makeSave(s))).toBe(bytes)
+  })
+
+  it('a grant lost between the commitment and the release tick HOLDS the committed picture (no throw, no release, commitment kept); the returning grant releases it', () => {
+    const live = { held: true }
+    const deps = { continuationRights: switchableRights(f1.productionId, live) }
+    let s = applyActions(afterFirst, [{ kind: 'greenlight', production: sequel, continuation: request }], deps)
+    const id = newest(s)
+    for (let i = 0; i < TUNING.PRODUCTION_TICKS; i++) s = tick(s, deps)
+    s = applyActions(s, [{ kind: 'commitPictureToRelease', productionId: id }], deps)
+    live.held = false
+    const held = tick(s, deps)
+    expect(held.market.tick).toBe(s.market.tick + 1)
+    expect(production(held, id).remainingTicks).toBe(1)
+    expect(held.releaseAuthority.commitments.map((r) => r.productionId)).toContain(id)
+    expect(held.studio.releasedFilms.some((f) => f.productionId === id)).toBe(false)
+    const again = tick(held, deps)
+    expect(production(again, id).remainingTicks).toBe(1)
+    // the default authority (no adapter wired) holds the same way: stored lineage is provenance, never permission
+    const unwired = tick(again)
+    expect(production(unwired, id).remainingTicks).toBe(1)
+    live.held = true
+    const released = tick(again, deps)
+    expect(released.studio.releasedFilms.some((f) => f.productionId === id)).toBe(true)
+    expect(released.franchises.properties[0]!.installments.find((e) => e.childProductionId === id)!.releasedWeek).toBe(again.market.tick)
+  })
+
+  it('rights lost mid-production stop the work: the picture does not advance while the grant is absent and resumes when it returns (F10)', () => {
+    const live = { held: true }
+    const deps = { continuationRights: switchableRights(f1.productionId, live) }
+    let s = applyActions(afterFirst, [{ kind: 'greenlight', production: sequel, continuation: request }], deps)
+    const id = newest(s)
+    for (let i = 0; i < 3; i++) s = tick(s, deps) // W (no advance), W+1, W+2
+    const before = production(s, id).remainingTicks
+    expect(before).toBe(TUNING.PRODUCTION_TICKS - 2)
+    live.held = false
+    s = tick(s, deps)
+    expect(production(s, id).remainingTicks).toBe(before)
+    s = tick(s, deps)
+    expect(production(s, id).remainingTicks).toBe(before)
+    live.held = true
+    s = tick(s, deps)
+    expect(production(s, id).remainingTicks).toBe(before - 1)
+  })
+
+  it('cancelling a committed picture removes its release commitment, so the next week advances (base orphan defect; probe A control 2)', () => {
+    let s = applyActions(afterFirst, [{ kind: 'greenlight', production: sequel }])
+    const id = newest(s)
+    for (let i = 0; i < TUNING.PRODUCTION_TICKS; i++) s = tick(s)
+    s = applyActions(s, [{ kind: 'commitPictureToRelease', productionId: id }])
+    const cancelled = applyActions(s, [{ kind: 'cancel', productionId: id }])
+    expect(cancelled.releaseAuthority.commitments.some((r) => r.productionId === id)).toBe(false)
+    expect(tick(cancelled).market.tick).toBe(s.market.tick + 1)
+  })
+})
+
+describe('P17 r2 — the exercising party is the producing studio (F20)', () => {
+  it('after an absorption moves the picture and the property together, the buyer\'s release is authorized; the old greenlight studio is not', () => {
+    const f1 = film('f1', 0, 80, 80, 1.2)
+    const w = world({ week: 4, rights: rightsOf({ f1: 'prop-A' }, { 'studio-a': ['prop-A'] }), released: [f1] })
+    const quote = continuationQuote(w, { studioId: 'studio-a', productionId: 'p2', request: { type: 'directSequel', predecessorProductionId: 'f1' } })
+    const root = commitContinuationGreenlight(w, quote, { studioId: 'studio-a', productionId: 'p2' })
+    const afterAbsorption = rightsOf({ f1: 'prop-A' }, { 'studio-b': ['prop-A'] })
+    expect(continuationReleaseAuthority(root, 'p2', afterAbsorption, 12, 'studio-b')?.refusal).toBeNull()
+    expect(continuationReleaseAuthority(root, 'p2', afterAbsorption, 12, 'studio-a')?.refusal).toMatch(/held by studio-b/)
+  })
+})
