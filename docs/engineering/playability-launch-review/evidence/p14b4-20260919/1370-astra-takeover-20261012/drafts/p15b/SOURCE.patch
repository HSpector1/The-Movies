+    projectId: null,
+    castingSessionId: null,
+    productionId: null,
+  }
+  const action = { kind: 'takeLoan' as const, principal }
+  return [{ option: option(authoritativeDigest(state), fields, action), apply: (current) => caught(() => ({ ok: true, next: applyActions(current, [action]) })) }]
+}
