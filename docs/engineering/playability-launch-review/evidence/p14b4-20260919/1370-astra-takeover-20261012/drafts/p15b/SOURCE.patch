diff --git a/ui/src/engine/p15b-lot-closure-gate.test.ts b/ui/src/engine/p15b-lot-closure-gate.test.ts
new file mode 100644
index 00000000..a0ef4783
--- /dev/null
+++ b/ui/src/engine/p15b-lot-closure-gate.test.ts
@@ -0,0 +1,46 @@
+// ── P15B closure/v1 (record 1370-ar, r3): the browser Studio Lot's closure gate (review C3/D8) ──────────
+// The Lot presents no Wave 5 corporate notices, no studio-loan verb and no read-only closure screen, so it never
+// runs the player's actual closure (Wave-4 contract §2; 1367-G: no playable closure before its Wave 5 route). The
+// player's closure due is recorded and left due; rivals borrow and close exactly as on every surface; a save holding
+// an actually closed player is refused on import by name. r2 closed the player here and the next advance threw.
+import { readFileSync } from 'node:fs'
+import { resolve } from 'node:path'
+import { gunzipSync } from 'node:zlib'
+import { describe, expect, it } from 'vitest'
+import { applyActions } from '../../../src/core/actions'
+import { exportSave, importSave, makeSave, migrateToLive } from '../../../src/core/save'
+import { tick } from '../../../src/core/tick'
+import type { Action, GameState } from '../../../src/core/types'
+import { closureOf, drainPlayer, drainRival, PLAYER, R04, R04_CLOSURE_WEEK, recordOf } from '../../../tests/helpers/p15b-live'
+import { advanceWeek, importSaveJson } from './adapter'
+
+// The genuine week-130 capture the core P15B routes use (tests/helpers/p15b-live.ts `base`), read by path: the jsdom
+// project serves `import.meta.url` over http, so the core loader's file URL cannot be used here.
+const week130 = (): GameState => migrateToLive(importSave(gunzipSync(readFileSync(resolve(process.cwd(),
+  'tests/fixtures/p14/genuine-v42-pre-shelving/genuine-v42-rival-stall-week-130.json.gz'))).toString('utf8'))).state as GameState
+
+describe('P15B closure/v1 in the browser Studio Lot', () => {
+  it('a closure-due player keeps playing in the Lot while rivals close', () => {
+    const start = week130()
+    let state = drainPlayer(drainRival(start, R04, 10_000_000), start.studio.cash + 1)
+    while (state.market.tick < R04_CLOSURE_WEEK + 2) state = advanceWeek(state).next
+    expect(closureOf(state, R04)?.closureWeek).toBe(R04_CLOSURE_WEEK)
+    expect(recordOf(state, PLAYER)!.condition).toMatchObject({ stage: 'closed', since: R04_CLOSURE_WEEK, week: R04_CLOSURE_WEEK })
+    expect(closureOf(state, PLAYER)).toBeUndefined()
+    expect(() => makeSave(state)).not.toThrow()
+  })
+
+  it('the Lot refuses a save holding a closed studio, by name', () => {
+    // The core player-closure route (one signed contract, drained to −1 at 130) advanced by the core tick.
+    const start = week130()
+    let state = drainPlayer(applyActions(start, [{ kind: 'signContract', talentId: start.freeAgents[0]!, termWeeks: 52 } as Action]), start.studio.cash + 1)
+    let before = state
+    while (closureOf(state, PLAYER) === undefined && state.market.tick < R04_CLOSURE_WEEK + 1) { before = state; state = tick(state) }
+    expect(closureOf(state, PLAYER)?.closureWeek).toBe(R04_CLOSURE_WEEK)
+    const outcome = importSaveJson(exportSave(makeSave(state)))
+    expect(outcome.ok).toBe(false)
+    if (!outcome.ok) expect(outcome.error).toMatch(new RegExp(`closed in Week ${R04_CLOSURE_WEEK}\\..*read-only history`))
+    // The same campaign one week earlier still imports.
+    expect(importSaveJson(exportSave(makeSave(before))).ok).toBe(true)
+  })
+})
