+/** The collection tariff this file fixes: 539 §1 `work = 1 + P + A + M×T` where P = promises rows, A = attached ids over
+ * all proposals, T = firstTakes rows and M = the members whose takes are scanned, which under refinement 3 are the LOCAL
+ * bound members only (bound prior claims plus the target when bound); current members and foreign debits read `count`. */
+function expectedWork(state: ClaimSource, claims: CollectedClaims): number {
+  const P = state.promises.length
+  const A = state.talentMarket.proposals.reduce((n, p) => n + p.promises.length, 0)
+  const M = claims.priorClaims.filter((c) => c.membership === 'bound').length + (claims.target.state === 'bound' ? 1 : 0)
+  return 1 + P + A + M * state.firstTakes.length
+}
