+    met: searchPromiseCapacity(target(input([picture('P', b(10), { lead: 'T', antagonist: 'A', support: 'B' }), // :292-299
+      picture('Q', b(24), { lead: 'T', antagonist: 'C', support: 'D' }, { existing: false })]),
+    { promiseId: 'bound-T', state: 'bound', count: 4, actualQualifiedCount: 4 })),
