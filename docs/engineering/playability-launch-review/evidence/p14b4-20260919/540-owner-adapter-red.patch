+// ── detached finite kernel fixtures: kernel test :12-52, 194-197 (copied, not imported) ──
+const b = (week: number, step = 0): Boundary => ({ week, step })
+const window = (startWeek = 0, dueWeekExclusive = 40) => ({ startWeek, dueWeekExclusive })
+const slots: readonly Slot[] = ANY
+function picture(name: string, take: Boundary | null, cast: Record<Slot, string>, options: {
+  path?: string; existing?: boolean; start?: Boundary; release?: Boundary; holds?: readonly Hold[]
+  replacements?: PictureAlternative['holdReplacements']
+} = {}): PictureAlternative {
+  const start = options.start ?? b(take === null ? 0 : Math.max(0, take.week - 1))
+  const release = options.release ?? b(take === null ? 1 : take.week + 1)
+  const pathKey = options.path ?? name
+  return { key: name, pathKey, issuerId: 'local', existingPath: options.existing ?? true,
+    greenlight: start, firstTake: take, personRelease: release, cast,
+    staffingWitnessKey: `detached-fixture-staffing:${name}`, ownerFactRefs: [`detached-finite-domain:${name}`],
+    additionalHolds: options.holds ?? slots.map((slot) => ({ holdId: `${name}:person:${slot}`, ownerKey: name,
+      ownerPathKey: pathKey, subject: { kind: 'person' as const, personId: cast[slot] }, from: start, until: release })),
+    holdReplacements: options.replacements ?? [] }
+}
+function prior(promiseId: string, personId: string, mask: PriorClaim['mask'] = ANY,
+  remaining = 1, start = 0, due = 40): PriorClaim {
+  return { promiseId, issuerId: 'local', personId, membership: 'current', mask, window: window(start, due), remaining }
