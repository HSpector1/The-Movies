+    expect(claims.work).toBe(1 + state.promises.length + state.talentMarket.proposals.reduce((n, p) => n + p.promises.length, 0)
+      + 3 * state.firstTakes.length) // three local bound members on w.ready: two prior claims and the bound target
+  })
+})
