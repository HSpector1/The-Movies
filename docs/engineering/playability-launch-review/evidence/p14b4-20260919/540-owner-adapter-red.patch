+/** The one explicit plan the Started producer accepts on w.ready: the take is already scheduled, so the
+ * command list is empty (started test :198-205; 538 scenario 1). */
+function startedRun(state: GameState, claimPersonIds: readonly string[], horizonEndWeek: number,
+  issuerId = player(state)): StartedOwnerReplayResult<Production> {
+  const input: StartedOwnerReplayInput<Production> = { source: startedSource(state), issuerId, claimPersonIds,
+    plans: [{ traceKey: TRACE_KEY, commands: [] }], horizonEndWeek, preparationWork: 0, limits: PRODUCER_LIMITS }
+  return replayStartedProductionPlans(input)
