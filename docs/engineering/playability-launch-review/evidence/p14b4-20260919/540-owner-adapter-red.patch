+function priorOf(w: World, state: GameState, slot: CastSlot, mask: PriorClaim['mask'], remaining = 1): PriorClaim {
+  const r = root(state, w.ids[slot])
+  return { promiseId: r.promiseId, issuerId: r.issuerStudioId, personId: r.beneficiaryPersonId,
+    membership: r.contractId === null ? 'current' : 'bound', mask,
+    window: { startWeek: r.windowStartWeek, dueWeekExclusive: r.dueWeekExclusive }, remaining }
