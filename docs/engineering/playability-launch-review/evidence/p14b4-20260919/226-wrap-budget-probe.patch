+    const kernel: JointTraceCapacityInput = { mode: 'jointOwnerTraces', now: { week: 4, step: 0 },
+      horizonEndWeek: 6, issuerId: value.issuerId,
+      target: { promiseId: null, personId: state.studio.activeProductions[0]!.cast.lead,
