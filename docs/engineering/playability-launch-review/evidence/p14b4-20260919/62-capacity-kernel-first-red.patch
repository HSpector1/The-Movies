+    expect(result.countWitness.credits).toEqual([{ demandKey: ['target'], pathKey: 'G', slot: 'lead' }])
+    expect(result.countWitness.targetTakeBoundaries).toEqual([b(18)])
+    impossible({ ...source, alternatives: source.alternatives.slice(1) })
+    impossible({ ...source, alternatives: source.alternatives.slice(0, 1) })
+  })
+  it('another owner hold survives the selected release, even if its owner key resembles the releasing owner', () => {
+    const source = released()
+    for (const ownerKey of ['other', 'owner-F', 'owner-F:suffix']) {
+      const other: FixedHold = { holdId: 'other-H', ownerKey, ownerPathKey: 'other-path',
+        subject: { kind: 'person', personId: 'T' }, from: b(15), until: b(19), replaceableFrom: null }
+      impossible({ ...source, fixedHolds: [...source.fixedHolds, other] })
+    }
+  })
+  it('empty replacement suffix is legal; malformed prefix/ownership/identity changes throw, never gameplay IMPOSSIBLE', () => {
+    const source = released(), f = source.alternatives[0]!
+    fragile({ ...source, alternatives: [{ ...f, personRelease: b(10), holdReplacements: [{ holdId: 'H', newUntil: b(10) }] }, source.alternatives[1]!] },
+      'achievableProbeFailed', profile(0, []))
+    const malformed: CapacityKernelInput[] = [
+      { ...source, alternatives: [{ ...f, holdReplacements: [{ holdId: 'H', newUntil: b(9) }] }] },
+      { ...source, alternatives: [{ ...f, holdReplacements: [{ holdId: 'H', newUntil: b(31) }] }] },
+      { ...source, alternatives: [{ ...f, pathKey: 'different-owner-path' }] },
+      { ...source, fixedHolds: [{ ...source.fixedHolds[0]!, replaceableFrom: null }] },
+      { ...source, fixedHolds: [source.fixedHolds[0]!, source.fixedHolds[0]!] },
+      { ...source, alternatives: [{ ...f, additionalHolds: [source.fixedHolds[0]!] }] },
+    ]
+    for (const invalid of malformed) expect(() => searchPromiseCapacity(freeze(invalid))).toThrow()
+  })
+})
