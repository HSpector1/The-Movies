+describe('kernel conservative foreign debits preserve local distinct seats and prior protection', () => {
+  function debited() {
+    return input([
+      picture('E10', b(10), { lead: 'A', antagonist: 'T', support: 'U' }),
+      picture('E20', b(20), { lead: 'T', antagonist: 'V', support: 'W' }),
+      picture('Q24', b(24), { lead: 'T', antagonist: 'Q1', support: 'Q2' }, { existing: false }),
+      picture('Q28', b(28), { lead: 'T', antagonist: 'R1', support: 'R2' }, { existing: false }),
+    ], { priorClaims: [prior('local-A', 'A', LEAD)], foreignDebits: [{ promiseId: 'foreign-T', issuerId: 'foreign', personId: 'T',
+      membership: 'current', sourceWindow: window(19, 50), remaining: 1 }] })
+  }
+  it('partial overlap withholds its FULL remainder; one local picture shares another person seat and credits no foreign fulfillment', () => {
+    const source = debited(), result = achievable(source, profile(2, [[10, 0, 2], [20, 0, 2]]))
+    expect(result.witness.credits).toContainEqual({ demandKey: ['foreignDebit', 'foreign-T'], pathKey: 'E10', slot: 'antagonist' })
+    expect(result.witness.credits).toContainEqual({ demandKey: ['prior', 'local-A'], pathKey: 'E10', slot: 'lead' })
+    // Normalization allows withholding an early LOCAL event before source19;
+    // this is explicitly not a foreign film, seat date, receipt or satisfaction.
+    expect(result.witness.credits.filter((c) => c.demandKey[0] === 'target').map((c) => c.pathKey)).toContain('E20')
+    expect(run(permuted(source))).toEqual(result)
+    fragile({ ...source, alternatives: source.alternatives.filter((a) => a.key !== 'E20') },
+      'achievableProbeFailed', profile(2, [[10, 0, 2]]))
+  })
+  it('full remaining2 is not prorated for one-week source overlap', () => {
+    const source = debited()
+    const changed = { ...source, foreignDebits: [{ ...source.foreignDebits[0]!, sourceWindow: window(39, 80), remaining: 2 }] }
+    fragile(changed, 'achievableProbeFailed', profile(3, [[10, 0, 2], [20, 0, 3]]))
+  })
+  it('foreign other-person, same-issuer, self, zero remainder and exact nonoverlap are neutral; source boundaries use max(now,start)', () => {
+    const source = target(input([picture('E', b(20), { lead: 'T', antagonist: 'A', support: 'B' }),
+      picture('Q', b(28), { lead: 'T', antagonist: 'C', support: 'D' }, { existing: false })], { now: b(15) }),
+    { promiseId: 'self', state: 'bound', window: window(10, 40) })
+    const d = { promiseId: 'd', issuerId: 'foreign', personId: 'T', membership: 'current' as const, sourceWindow: window(19, 50), remaining: 1 }
+    const irrelevant = [{ ...d, personId: 'someone-else' }, { ...d, issuerId: 'local' }, { ...d, promiseId: 'self' },
+      { ...d, remaining: 0 }, { ...d, sourceWindow: window(0, 15) }, { ...d, sourceWindow: window(40, 60) }]
+    for (const debit of irrelevant) {
+      const result = achievable({ ...source, foreignDebits: [debit] }, profile(0, [[20, 0, 0]]))
+      expect(result.witness.credits.every((c) => c.demandKey[0] === 'target')).toBe(true)
+    }
+  })
+  it('canonical tuple namespaces do not collide; duplicate source identity across prior/debit collections is invalid', () => {
+    const source = debited()
+    achievable({ ...source, priorClaims: [prior('foreignDebit:foreign-T', 'A', LEAD)] }, profile(2, [[10, 0, 2], [20, 0, 2]]))
+    expect(() => searchPromiseCapacity(freeze({ ...source, priorClaims: [prior('foreign-T', 'A', LEAD)] }))).toThrow()
+  })
+})
