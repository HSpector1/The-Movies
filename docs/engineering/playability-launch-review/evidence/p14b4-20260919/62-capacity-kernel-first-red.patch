+describe('kernel proof completeness and deterministic bounded work', () => {
+  it('missing FUTURE alternatives permits a positive witness only with the complete saturated prior profile proof', () => {
+    const source = shared()
+    achievable({ ...source, coverage: { ...source.coverage, allAlternatives: 'incomplete', omissions: ['future commissions not exhausted'] } },
+      profile(2, [[10, 0, 2]]))
+    for (const patch of [{ claimsAndHolds: 'incomplete' as const }, { existingAlternatives: 'incomplete' as const }]) {
+      const result = run({ ...source, coverage: { ...source.coverage, ...patch, allAlternatives: 'incomplete', omissions: ['relevant domain omitted'] } })
+      expect(result).toMatchObject({ status: 'UNCERTIFIED', reason: 'domainIncomplete' })
+    }
+  })
+  it('an observed X witness or partial failed count search proves neither FRAGILE nor IMPOSSIBLE', () => {
+    for (const alternatives of [[], shared().alternatives.slice(0, 1)]) {
+      const source = input(alternatives, { coverage: { claimsAndHolds: 'complete', existingAlternatives: 'incomplete',
+        allAlternatives: 'incomplete', omissions: ['unknown lawful existing paths'] } })
+      expect(run(source)).toMatchObject({ status: 'UNCERTIFIED', reason: 'domainIncomplete' })
+    }
+  })
+  it('even a best-so-far B witness cannot certify an unproved existing prior optimum', () => {
+    const source = shared()
+    expect(run({ ...source, coverage: { ...source.coverage, existingAlternatives: 'incomplete', allAlternatives: 'incomplete',
+      omissions: ['an earlier alternative for the prior people may exist'] } })).toMatchObject({ status: 'UNCERTIFIED', reason: 'domainIncomplete' })
+  })
+  it('large admitted count/window numbers remain bounded uncertainty when the domain supplies no sound upper proof', () => {
+    const source = input([], { coverage: { claimsAndHolds: 'complete', existingAlternatives: 'incomplete',
+      allAlternatives: 'incomplete', omissions: ['unexpanded finite domain'] } })
+    const huge = Number.MAX_SAFE_INTEGER
+    const cases = [target(source, { count: huge }), target({ ...source, horizonEndWeek: huge }, { window: window(0, huge) }),
+      { ...source, priorClaims: [prior('huge-prior', 'A', LEAD, huge)] }]
+    for (const candidate of cases) {
+      const result = run(candidate)
+      expect(result.status).toBe('UNCERTIFIED')
+      if (result.status !== 'UNCERTIFIED') throw new Error('incomplete huge domain cannot prove impossibility')
+      expect(['sizeLimit', 'domainIncomplete']).toContain(result.reason)
+      expect(candidate.target).not.toHaveProperty('outcome')
+    }
+    // No reason precedence is specified when BOTH facts apply. Nor do these
+    // fixtures forbid an optional sound direct bound on a DIFFERENT complete
+    // domain. The isolated lowered-cap cases below pin sizeLimit strictly.
+  })
+  it('large absolute safe weeks with a short span compare as ordered pairs, not unsafe packed arithmetic', () => {
+    const now = Number.MAX_SAFE_INTEGER - 40, due = Number.MAX_SAFE_INTEGER
+    const source = target(input([picture('E', b(now + 10, 2), { lead: 'T', antagonist: 'A', support: 'B' },
+      { start: b(now + 5), release: b(now + 14) }), picture('Q', b(now + 24), { lead: 'T', antagonist: 'C', support: 'D' },
+      { existing: false, start: b(now + 20), release: b(now + 28) })], { now: b(now), horizonEndWeek: due }),
+    { window: window(now, due) })
+    achievable(source, profile(0, [[now + 10, 2, 0]]))
+  })
+  it('size gates include target row and B, not only prior rows or X', () => {
+    const source = shared()
+    for (const limits of [{ ...source.limits, claims: 2 }, { ...source.limits, units: 3 }, { ...source.limits, alternatives: 1 },
+      { ...source.limits, span: 39 }]) {
+      expect(run({ ...source, limits })).toMatchObject({ status: 'UNCERTIFIED', reason: 'sizeLimit' })
+    }
+  })
+  it('preparation, scalar/string inspection and normalization consume the shared budget before search', () => {
+    const source = shared()
+    for (const candidate of [{ ...source, preparationWork: 64, limits: { ...source.limits, work: 64 } },
+      { ...source, limits: { ...source.limits, work: 1 } },
+      { ...source, alternatives: source.alternatives.map((a) => ({ ...a, staffingWitnessKey: 'x'.repeat(4096) })),
+        limits: { ...source.limits, work: 128 } }]) {
+      const result = run(candidate)
+      expect(result).toMatchObject({ status: 'UNCERTIFIED', reason: 'workLimit', workUsed: candidate.limits.work,
+        omissions: ['normalization work limit'] })
+    }
+  })
+  it.each([1, 64, 512, 2048, 200000])('permutations have identical complete result and workUsed at work cap%i', (work) => {
+    const source = shared(), limited = { ...source, limits: { ...source.limits, work },
+      coverage: { ...source.coverage, omissions: ['z note', 'a note'] } }
+    expect(run(permuted(limited))).toEqual(run(limited))
+  })
+  it('larger-than-governed budgets are invalid internal inputs, not a route to raised gameplay caps', () => {
+    const source = shared()
+    for (const limits of [{ ...source.limits, claims: 33 }, { ...source.limits, units: 65 },
+      { ...source.limits, alternatives: 1025 }, { ...source.limits, work: 200001 }, { ...source.limits, span: 221 }]) {
+      expect(() => searchPromiseCapacity(freeze({ ...source, limits }))).toThrow()
+    }
+  })
+})
