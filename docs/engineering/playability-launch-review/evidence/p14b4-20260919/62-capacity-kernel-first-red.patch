+// Installed exact independent first tranche57; mathematical fixtures, not owner or engine evidence. RED62.
+// INERT / UNEXECUTED. Intended tests/p14b4-capacity-kernel.test.ts.
+// Definitive interface49 + examples42/44 + reviewed B4 capacity appendix.
+// These are complete DETACHED FINITE SCHEDULING domains, never engine history,
+// owner admission proofs, real staffing receipts, saves, or beneficiary winners.
+import assert from 'node:assert/strict'
+import { describe, expect, it } from 'vitest'
+import { searchPromiseCapacity } from '../src/core/promiseCapacityKernel.js'
+import type { Boundary, CapacityKernelInput, CapacityKernelResult, DemandKey, FixedHold,
+  Hold, PictureAlternative, PriorClaim, PriorProfile, Slot, Witness } from '../src/core/promiseCapacityKernel.js'
+
+const ANY = ['lead', 'antagonist', 'support'] as const
+const FLEX = ['lead', 'antagonist'] as const
+const LEAD = ['lead'] as const
+const b = (week: number, step = 0): Boundary => ({ week, step })
+const window = (startWeek = 0, dueWeekExclusive = 40) => ({ startWeek, dueWeekExclusive })
+const clone = <T>(value: T): T => structuredClone(value)
+function freeze<T>(value: T): T {
+  if (value !== null && typeof value === 'object') {
+    for (const child of Object.values(value)) freeze(child)
+    Object.freeze(value)
+  }
+  return value
+}
+const compare = (a: Boundary, z: Boundary) => a.week < z.week ? -1 : a.week > z.week ? 1 : a.step < z.step ? -1 : a.step > z.step ? 1 : 0
+const key = (demand: DemandKey) => JSON.stringify(demand)
+const slots: readonly Slot[] = ANY
+function picture(name: string, take: Boundary | null, cast: Record<Slot, string>, options: {
+  path?: string; existing?: boolean; start?: Boundary; release?: Boundary; holds?: readonly Hold[]
+  replacements?: PictureAlternative['holdReplacements']
+} = {}): PictureAlternative {
+  const start = options.start ?? b(take === null ? 0 : Math.max(0, take.week - 1))
+  const release = options.release ?? b(take === null ? 1 : take.week + 1)
+  const pathKey = options.path ?? name
+  return { key: name, pathKey, issuerId: 'local', existingPath: options.existing ?? true,
+    greenlight: start, firstTake: take, personRelease: release, cast,
+    staffingWitnessKey: `detached-fixture-staffing:${name}`, ownerFactRefs: [`detached-finite-domain:${name}`],
+    additionalHolds: options.holds ?? slots.map((slot) => ({ holdId: `${name}:person:${slot}`, ownerKey: name,
+      ownerPathKey: pathKey, subject: { kind: 'person' as const, personId: cast[slot] }, from: start, until: release })),
+    holdReplacements: options.replacements ?? [] }
+}
+function prior(promiseId: string, personId: string, mask: PriorClaim['mask'] = ANY,
+  remaining = 1, start = 0, due = 40): PriorClaim {
+  return { promiseId, issuerId: 'local', personId, membership: 'current', mask, window: window(start, due), remaining }
+}
+function input(alternatives: readonly PictureAlternative[] = [], overrides: Partial<CapacityKernelInput> = {}): CapacityKernelInput {
+  return { now: b(0), horizonEndWeek: 40, issuerId: 'local', target: { promiseId: null, personId: 'T', mask: ANY,
+    window: window(), state: 'unbound', count: 1, actualQualifiedCount: 0 }, priorClaims: [], foreignDebits: [],
+    alternatives, fixedHolds: [], coverage: { claimsAndHolds: 'complete', existingAlternatives: 'complete',
+      allAlternatives: 'complete', omissions: [] }, preparationWork: 0,
+    limits: { claims: 32, units: 64, alternatives: 1024, work: 200000, span: 220 }, ...overrides }
+}
+const target = (source: CapacityKernelInput, patch: Partial<CapacityKernelInput['target']>): CapacityKernelInput =>
+  ({ ...source, target: { ...source.target, ...patch } })
+const profile = (existingUnits: number, entries: readonly (readonly [number, number, number])[]): PriorProfile =>
+  ({ existingUnits, cumulativeByBoundary: entries.map(([week, step, units]) => ({ boundary: b(week, step), units })) })
+function relevantDebits(source: CapacityKernelInput) {
+  // Literal membership clarification to49: original source window selects a
+  // local generic-cast token; it is NOT a foreign fulfillment date or class.
+  return source.foreignDebits.filter((d) => d.issuerId !== source.issuerId && d.personId === source.target.personId
+    && d.promiseId !== source.target.promiseId && d.remaining > 0
+    && d.sourceWindow.dueWeekExclusive > Math.max(source.now.week, source.target.window.startWeek)
+    && d.sourceWindow.startWeek < source.target.window.dueWeekExclusive)
+}
+
+// Independent witness CHECKER, not a search oracle. It verifies one returned
+// assignment against the literal fixture facts and exact hold/credit laws. It
+// never enumerates alternatives, calculates an optimum or calls a solver helper.
+function checkWitness(source: CapacityKernelInput, witness: Witness, targetUnits: number,
+  expectedProtectedProfile?: PriorProfile, achievable = false): void {
+  const selected = witness.selectedAlternativeKeys.map((name) => {
+    const matches = source.alternatives.filter((a) => a.key === name)
+    expect(matches).toHaveLength(1)
+    return matches[0]!
+  })
+  expect(new Set(witness.selectedAlternativeKeys).size).toBe(selected.length)
+  expect(new Set(selected.map((a) => a.pathKey)).size).toBe(selected.length)
+  const replaced = new Set<string>()
+  const effective = source.fixedHolds.map((hold) => ({ ...hold }))
+  for (const alternative of selected) {
+    expect(alternative.issuerId).toBe(source.issuerId)
+    expect(new Set(Object.values(alternative.cast)).size).toBe(3)
+    expect(alternative.staffingWitnessKey.length).toBeGreaterThan(0)
+    expect(alternative.ownerFactRefs.length).toBeGreaterThan(0)
+    for (const replacement of alternative.holdReplacements) {
+      const index = source.fixedHolds.findIndex((h) => h.holdId === replacement.holdId)
+      expect(index).toBeGreaterThanOrEqual(0)
+      const original = source.fixedHolds[index]!
+      assert.ok(original.replaceableFrom)
+      expect(original.ownerPathKey).toBe(alternative.pathKey)
+      expect(replaced.has(original.holdId)).toBe(false)
+      replaced.add(original.holdId)
+      expect(compare(replacement.newUntil, original.replaceableFrom)).toBeGreaterThanOrEqual(0)
+      expect(compare(replacement.newUntil, original.until)).toBeLessThanOrEqual(0)
+      effective[index] = { ...original, until: replacement.newUntil }
+    }
+  }
+  const holds: readonly Hold[] = [...effective, ...selected.flatMap((a) => a.additionalHolds)]
+  expect(new Set(holds.map((h) => h.holdId)).size).toBe(holds.length)
+  const sameSubject = (a: Hold, z: Hold): boolean => a.subject.kind === 'person'
+    ? z.subject.kind === 'person' && a.subject.personId === z.subject.personId
+    : z.subject.kind === 'resource' && a.subject.resourceKey === z.subject.resourceKey && a.subject.slot === z.subject.slot
+  for (let i = 0; i < holds.length; i++) for (let j = i + 1; j < holds.length; j++) {
+    const a = holds[i]!, z = holds[j]!
+    if (compare(a.from, a.until) === 0 || compare(z.from, z.until) === 0 || !sameSubject(a, z)) continue
+    expect(compare(a.from, z.until) < 0 && compare(z.from, a.until) < 0,
+      `conflicting actual intervals ${a.holdId} / ${z.holdId}; owner name is not an overlap waiver`).toBe(false)
+  }
+  type Demand = { demandKey: DemandKey; personId: string; mask: readonly Slot[]; window: CapacityKernelInput['target']['window']; units: number }
+  const demands: Demand[] = [{ demandKey: ['target'], personId: source.target.personId, mask: source.target.mask,
+    window: source.target.window, units: targetUnits },
+  ...source.priorClaims.map((p): Demand => ({ demandKey: ['prior', p.promiseId], personId: p.personId, mask: p.mask, window: p.window, units: p.remaining })),
+  ...relevantDebits(source).map((d): Demand => ({ demandKey: ['foreignDebit', d.promiseId], personId: d.personId,
+    mask: ANY, window: source.target.window, units: d.remaining }))]
+  const paid = new Map(demands.map((d) => [key(d.demandKey), 0]))
+  const personPaths = new Set<string>()
+  const targetEvents: { alternative: PictureAlternative; boundary: Boundary }[] = []
+  const priorEvents: Boundary[] = []
+  for (const credit of witness.credits) {
+    const demand = demands.find((d) => key(d.demandKey) === key(credit.demandKey))
+    assert.ok(demand, 'no invented or concatenation-colliding demand namespace')
+    const alternative = selected.find((a) => a.pathKey === credit.pathKey)
+    assert.ok(alternative)
+    assert.ok(alternative.firstTake, 'zero-event continuation cannot earn credit')
+    expect(alternative.cast[credit.slot]).toBe(demand.personId)
+    expect(demand.mask).toContain(credit.slot)
+    expect(alternative.firstTake.week).toBeGreaterThanOrEqual(demand.window.startWeek)
+    expect(alternative.firstTake.week).toBeLessThan(demand.window.dueWeekExclusive)
+    const personPath = JSON.stringify([demand.personId, credit.pathKey])
+    expect(personPaths.has(personPath), 'one person/event cannot pay two planning counters').toBe(false)
+    personPaths.add(personPath)
+    paid.set(key(demand.demandKey), paid.get(key(demand.demandKey))! + 1)
+    if (credit.demandKey[0] === 'target') targetEvents.push({ alternative, boundary: alternative.firstTake })
+    else if (alternative.existingPath) priorEvents.push(alternative.firstTake)
+  }
+  for (const demand of demands) expect(paid.get(key(demand.demandKey))).toBe(demand.units)
+  targetEvents.sort((a, z) => compare(a.boundary, z.boundary))
+  expect(witness.targetTakeBoundaries).toEqual(targetEvents.map((e) => e.boundary))
+  if (expectedProtectedProfile !== undefined) {
+    const boundaries = source.alternatives.filter((a) => a.existingPath && a.firstTake !== null).map((a) => a.firstTake!)
+      .filter((a, index, list) => list.findIndex((z) => compare(a, z) === 0) === index).sort(compare)
+    expect({ existingUnits: priorEvents.length, cumulativeByBoundary: boundaries.map((boundary) => ({ boundary,
+      units: priorEvents.filter((event) => compare(event, boundary) <= 0).length })) }).toEqual(expectedProtectedProfile)
+  }
+  if (achievable) {
+    const remaining = source.target.state === 'bound' ? Math.max(0, source.target.count - source.target.actualQualifiedCount) : source.target.count
+    expect(targetEvents).toHaveLength(remaining + Math.ceil(remaining / 3))
+    expect(targetEvents.slice(0, remaining).every((e) => e.alternative.existingPath)).toBe(true)
+    expect(source.target.window.dueWeekExclusive - targetEvents[remaining - 1]!.boundary.week).toBeGreaterThanOrEqual(8)
+  }
+}
+function run(source: CapacityKernelInput): CapacityKernelResult {
+  const before = clone(source)
+  const result = searchPromiseCapacity(freeze(source))
+  expect(source).toEqual(before)
+  expect(Number.isSafeInteger(result.workUsed)).toBe(true)
+  expect(result.workUsed).toBeGreaterThanOrEqual(0)
+  expect(result.workUsed).toBeLessThanOrEqual(source.limits.work)
+  if (result.status === 'CERTIFIED_ACHIEVABLE') checkWitness(source, result.witness, result.bufferDemand, result.priorOptimum, true)
+  if (result.status === 'PROVEN_FRAGILE') {
+    const x = source.target.state === 'bound' ? Math.max(0, source.target.count - source.target.actualQualifiedCount) : source.target.count
+    checkWitness(source, result.countWitness, x, result.reason === 'achievableProbeFailed' ? result.priorOptimum : undefined)
+  }
+  return result
+}
+function achievable(source: CapacityKernelInput, expected: PriorProfile) {
+  const result = run(source)
+  expect(result.status).toBe('CERTIFIED_ACHIEVABLE')
+  if (result.status !== 'CERTIFIED_ACHIEVABLE') throw new Error('expected constructive protected certificate')
+  expect(result.priorOptimum).toEqual(expected)
+  return result
+}
+function fragile(source: CapacityKernelInput, reason: 'achievableProbeFailed' | 'priorPathProtection', expected: PriorProfile) {
+  const result = run(source)
+  expect(result.status).toBe('PROVEN_FRAGILE')
+  if (result.status !== 'PROVEN_FRAGILE') throw new Error('expected count witness, not a false impossibility')
+  expect(result.reason).toBe(reason)
+  expect(result.priorOptimum).toEqual(expected)
+  return result
+}
+function impossible(source: CapacityKernelInput) {
+  const result = run(source)
+  expect(result).toMatchObject({ status: 'PROVEN_IMPOSSIBLE', scope: 'jointOfferOnly' })
+  return result
+}
+function permuted(source: CapacityKernelInput): CapacityKernelInput {
+  return { ...source, target: { ...source.target, mask: [...source.target.mask].reverse() },
+    priorClaims: [...source.priorClaims].reverse().map((p) => ({ ...p, mask: [...p.mask].reverse() })),
+    foreignDebits: [...source.foreignDebits].reverse(), fixedHolds: [...source.fixedHolds].reverse(),
+    alternatives: [...source.alternatives].reverse().map((a) => ({ ...a, additionalHolds: [...a.additionalHolds].reverse(),
+      holdReplacements: [...a.holdReplacements].reverse() })),
+    coverage: { ...source.coverage, omissions: [...source.coverage.omissions].reverse() } }
+}
+function shared() {
