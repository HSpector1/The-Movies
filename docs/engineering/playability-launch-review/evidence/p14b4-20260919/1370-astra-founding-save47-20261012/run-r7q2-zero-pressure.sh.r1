child_exit=$?
end=$(date +%s)
printf '{"name":"r7q2-zero-pressure-original3","exit":%d,"seconds":%d,"node":"%s","log":"%s"}\n' "$child_exit" "$((end-start))" "$(node --version)" "$OUT/run.log" > "$OUT/child.json" || exit 1
