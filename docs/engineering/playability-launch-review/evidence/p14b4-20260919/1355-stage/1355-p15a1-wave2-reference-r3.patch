diff --git a/src/core/marketIntegration.ts b/src/core/marketIntegration.ts
new file mode 100644
index 0000000..07dd356
--- /dev/null
+++ b/src/core/marketIntegration.ts
@@ -0,0 +1,271 @@
+// ── P15A.1 Wave 2: the shared market in the live release pipeline ─────────────
+// REFERENCE ONLY (records 1355-C, 1355-C2): scratch evidence that the 1355-C RED leaves can pass.
+// Not a production candidate; the single writer owns production (1355-A §8 item 5). r2 sits on
+// 1356-C's reference r2 (the landing order of 1355-F4): the allocator check below spans the market
+// rows and the Power Ranking archive's records.
+//
+// 1355-A §3 as amended by 1355-F, 1355-F2 and 1355-F3:
+// - step 2.5: one batch per week, frozen after the P06A witness and before any verdict;
+//   members are the player's releasing pictures and every rival picture at remainingTicks 1;
+//   exposures are the root's suffix with week > W − SHARED_MARKET_RETIRE_AFTER_WEEKS;
+// - the factor reaches reception at the two release sites only (reception.ts seam);
+// - the root `sharedMarket` appends the week's assessments at finalize, each with the next
+//   `p15DomainSequence` values in (week, releaseId) order and the v1 phase triple;
+// - the save validator: exact keys, ranges, order, sequences, phase triples, the film
+//   bijection and the law reconciled week by week, by era.
+
+import { P15_PHASE_TABLES, p15PhaseTriple } from './p15Phases.js'
+import {
+  assessBatch, SHARED_MARKET_DEFINITION, type MarketAssessment, type MarketBatchMember, type MarketExposure,
+} from './sharedMarket.js'
+import { GENRE_ORDER, TUNING } from './tuning.js'
+import type { GameState, Production } from './types.js'
+
+export const MARKET_PHASE_ID = 'p15a1.marketBatch'
+export type PersistedMarketAssessment = MarketAssessment & {
+  p15DomainSequence: number
+  phaseId: string
+  phaseOrdinal: number
+  phaseOrderVersion: number
+}
+export type SharedMarketRoot = { version: 1; recordedFromWeek: number; assessments: PersistedMarketAssessment[] }
+export const initialSharedMarket = (week: number): SharedMarketRoot => ({ version: 1, recordedFromWeek: week, assessments: [] })
+
+export type MarketBatchResult = {
+  week: number
+  assessments: MarketAssessment[]
+  /** Every member's frozen factor. */
+  factorById: ReadonlyMap<string, number>
+  /** The rival members' frozen factors: what `advanceHollywoodWeek` witnesses and applies. */
+  rivalFactorById: ReadonlyMap<string, number>
+}
+
+/** Active exposures (1355-A §3.3): the root's suffix with week > W − 26, by a backward scan. */
+export function activeMarketExposures(root: SharedMarketRoot, week: number): MarketExposure[] {
+  const out: MarketExposure[] = []
+  for (let i = root.assessments.length - 1; i >= 0; i--) {
+    const row = root.assessments[i]!
+    if (row.week <= week - TUNING.SHARED_MARKET_RETIRE_AFTER_WEEKS) break
+    out.push({ releaseId: row.releaseId, studioId: row.studioId, genre: row.genre, releaseWeek: row.week })
+  }
+  return out.reverse()
+}
+
+/** The rival due set (1355-A §3.1 item 3; fact 8): every rival picture at remainingTicks 1. */
+export function rivalDueMembers(hollywood: NonNullable<GameState['hollywood']>): MarketBatchMember[] {
+  const out: MarketBatchMember[] = []
+  for (const business of hollywood.businesses) {
+    for (const production of business.productions) {
+      if (production.remainingTicks !== 1) continue
+      const concept = hollywood.concepts.find((candidate) => candidate.id === production.conceptId)
+      if (concept === undefined) throw new Error(`shared market: rival picture ${production.id} has no concept`)
+      out.push({ releaseId: production.id, studioId: business.studioId, genre: concept.genre })
+    }
+  }
+  return out
+}
+
+export function requireSharedMarket(state: GameState): SharedMarketRoot {
+  const root = (state as { sharedMarket?: SharedMarketRoot }).sharedMarket
+  if (root === undefined) throw new Error('shared market: the state has no sharedMarket root')
+  return root
+}
+
+/** Step 2.5 (1355-A §3.1). Runs only with an industry; reads, never writes. */
+export function runMarketBatch(state: GameState, playerReleasing: readonly Production[], week: number): MarketBatchResult | null {
+  const hollywood = state.hollywood
+  if (hollywood === null) return null
+  const root = requireSharedMarket(state)
+  const player: MarketBatchMember[] = playerReleasing.map((production) => {
+    const concept = state.concepts.find((candidate) => candidate.id === production.conceptId)
+    if (concept === undefined) throw new Error(`shared market: release ${production.id} has no concept`)
+    return { releaseId: production.id, studioId: hollywood.playerStudioId, genre: concept.genre }
+  })
+  const rivals = rivalDueMembers(hollywood)
+  const assessments = assessBatch(activeMarketExposures(root, week), { week, members: [...player, ...rivals] })
+  const rivalIds = new Set(rivals.map((member) => member.releaseId))
+  return {
+    week,
+    assessments,
+    factorById: new Map(assessments.map((row) => [row.releaseId, row.factor])),
+    rivalFactorById: new Map(assessments.filter((row) => rivalIds.has(row.releaseId)).map((row) => [row.releaseId, row.factor])),
+  }
+}
+
+/** The frozen factor of one releasing picture; a release the batch did not freeze fails the week. */
+export function frozenFactor(batch: MarketBatchResult, releaseId: string): number {
+  const factor = batch.factorById.get(releaseId)
+  if (factor === undefined) throw new Error(`shared market: release ${releaseId} has no frozen batch factor`)
+  return factor
+}
+
+/** The one ordered append at finalize: rows in (week, releaseId) order, each taking the
+ * allocator's next value (1355-F2 item 2: the market batch takes the tick's first numbers). */
+export function appendMarketBatch(state: GameState, batch: MarketBatchResult): Pick<GameState, 'sharedMarket' | 'p15Sequence'> {
+  const root = requireSharedMarket(state)
+  if (batch.assessments.length === 0) return { sharedMarket: root, p15Sequence: state.p15Sequence }
+  let next = state.p15Sequence.next
+  const triple = p15PhaseTriple(MARKET_PHASE_ID)
+  const rows = batch.assessments.map((row) => ({ ...row, p15DomainSequence: next++, ...triple }))
+  return { sharedMarket: { ...root, assessments: [...root.assessments, ...rows] }, p15Sequence: { ...state.p15Sequence, next } }
+}
+
+// ── the save validator (1355-A §3.4; 1355-F3 RED 14) ─────────────────────────────
+const ROOT_KEYS = ['assessments', 'recordedFromWeek', 'version']
+const ROW_KEYS = ['definitionVersion', 'factor', 'genre', 'inputDigest', 'p15DomainSequence', 'phaseId', 'phaseOrderVersion',
+  'phaseOrdinal', 'pressure', 'reasons', 'releaseId', 'stockTerm', 'studioId', 'week', 'windowTerm']
+const REASON_KEYS = ['code', 'sourceReleaseIds', 'value']
+/** Era map (1355-A §3.4 item 5): each definition version to its law. v1 is the live TUNING. */
+const LAWS: Readonly<Record<string, typeof assessBatch>> = { [SHARED_MARKET_DEFINITION]: assessBatch }
+const LAW_FIELDS = ['pressure', 'factor', 'windowTerm', 'stockTerm', 'inputDigest'] as const
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  value !== null && typeof value === 'object' && !Array.isArray(value)
+const sameKeys = (value: Record<string, unknown>, keys: readonly string[]): boolean => {
+  const own = Object.keys(value).sort()
+  return own.length === keys.length && own.every((key, i) => key === keys[i])
+}
+const isWeek = (value: unknown): value is number => Number.isSafeInteger(value) && (value as number) >= 0
+
+/** Validates `sharedMarket` against the whole state; refuses by name. */
+export function validateSharedMarketRoot(raw: Record<string, unknown>, label: string): void {
+  const fail = (message: string): never => { throw new Error(`${label}: sharedMarket ${message}`) }
+  const root = raw.sharedMarket
+  if (!isRecord(root)) return fail('root is missing')
+  if (!sameKeys(root, ROOT_KEYS)) fail(`root must have exactly the keys ${ROOT_KEYS.join(', ')}`)
+  if (root.version !== 1) fail(`version ${String(root.version)} is unknown`)
+  const market = raw.market as { tick: number }
+  const tick = market.tick
+  if (!isWeek(root.recordedFromWeek) || root.recordedFromWeek > tick) fail(`recordedFromWeek ${String(root.recordedFromWeek)} is not a week in [0, ${tick}]`)
+  const recordedFromWeek = root.recordedFromWeek as number
+  if (!Array.isArray(root.assessments)) return fail('assessments must be an array')
+  const rows = root.assessments as unknown[]
+  const hollywood = raw.hollywood as GameState['hollywood']
+  if (hollywood === null && rows.length > 0) fail('holds assessments in a world with no industry')
+
+  const seen = new Set<string>()
+  rows.forEach((value, i) => {
+    if (!isRecord(value)) return fail(`assessment ${i} is not an object`)
+    const unexpected = Object.keys(value).filter((key) => !ROW_KEYS.includes(key))
+    if (!sameKeys(value, ROW_KEYS)) fail(`assessment ${i} must have exactly the persisted keys (unexpected key ${unexpected.join(', ') || 'none'})`)
+    const row = value as unknown as PersistedMarketAssessment
+    if (typeof row.releaseId !== 'string' || typeof row.studioId !== 'string' || !(GENRE_ORDER as readonly unknown[]).includes(row.genre) ||
+      !isWeek(row.week) || typeof row.inputDigest !== 'string' || !Array.isArray(row.reasons) ||
+      !LAW_FIELDS.filter((field) => field !== 'inputDigest').every((field) => Number.isFinite(row[field])) ||
+      !Number.isSafeInteger(row.p15DomainSequence) || typeof row.phaseId !== 'string' ||
+      !Number.isSafeInteger(row.phaseOrdinal) || !Number.isSafeInteger(row.phaseOrderVersion)) {
+      fail(`assessment ${i} has a malformed field`)
+    }
+    for (const reason of row.reasons) {
+      if (!isRecord(reason) || !sameKeys(reason, REASON_KEYS)) fail(`assessment ${row.releaseId} has a malformed reason`)
+    }
+    if (LAWS[row.definitionVersion] === undefined) fail(`assessment ${row.releaseId} definitionVersion ${row.definitionVersion} is unknown`)
+    // 1355-F5 item 1: the row's own version's entry, read through the exported binding.
+    if (row.phaseId !== MARKET_PHASE_ID ||
+      P15_PHASE_TABLES[row.phaseOrderVersion]?.find((entry) => entry.phaseId === MARKET_PHASE_ID)?.phaseOrdinal !== row.phaseOrdinal) {
+      fail(`assessment ${row.releaseId} phase triple (${row.phaseId}, ${row.phaseOrdinal}, ${row.phaseOrderVersion}) does not match its phaseOrderVersion's table entry`)
+    }
+    if (row.week < recordedFromWeek) fail(`assessment ${row.releaseId} week ${row.week} is before recordedFromWeek ${recordedFromWeek}`)
+    if (row.week >= tick) fail(`assessment ${row.releaseId} week ${row.week} is not before market.tick ${tick}`)
+    if (seen.has(row.releaseId)) fail(`holds a duplicate assessment of ${row.releaseId}`)
+    seen.add(row.releaseId)
+    const previous = i > 0 ? rows[i - 1] as PersistedMarketAssessment : null
+    if (previous !== null && (previous.week > row.week || (previous.week === row.week && previous.releaseId >= row.releaseId))) {
+      fail(`assessments are out of (week, releaseId) order at ${row.releaseId}`)
+    }
+    if (row.p15DomainSequence < 1) fail(`assessment ${row.releaseId} p15DomainSequence ${row.p15DomainSequence} is below 1`)
+    if (previous !== null && row.p15DomainSequence <= previous.p15DomainSequence) {
+      fail(`assessment ${row.releaseId} p15DomainSequence ${row.p15DomainSequence} does not ascend`)
+    }
+  })
+  const assessments = rows as PersistedMarketAssessment[]
+  validateP15Allocator(raw, assessments, label)
+  if (hollywood !== null) validateFilmBijection(raw, hollywood, assessments, recordedFromWeek, fail)
+  reconcileLaw(assessments, fail)
+}
+
+/** The allocator against every P15 native row (1355-F2 item 4). Scans the P15 roots this
+ * reference knows; a merged step lists every sibling root here. */
+function validateP15Allocator(raw: Record<string, unknown>, market: readonly PersistedMarketAssessment[], label: string): void {
+  const sequence = raw.p15Sequence
+  if (!isRecord(sequence) || !sameKeys(sequence, ['next', 'version']) || sequence.version !== 1 ||
+    !Number.isSafeInteger(sequence.next) || (sequence.next as number) < 1) {
+    throw new Error(`${label}: p15Sequence must be exactly {version: 1, next} with a whole next of at least 1`)
+  }
+  const next = sequence.next as number
+  const all = market.map((row) => row.p15DomainSequence)
+  const ranking = raw.powerRanking
+  if (isRecord(ranking) && Array.isArray(ranking.snapshots)) {
+    for (const record of ranking.snapshots) if (isRecord(record) && typeof record.p15DomainSequence === 'number') all.push(record.p15DomainSequence)
+  }
+  for (const row of market) {
+    if (row.p15DomainSequence >= next) {
+      throw new Error(`${label}: sharedMarket assessment ${row.releaseId} p15DomainSequence ${row.p15DomainSequence} is at or above p15Sequence.next ${next}`)
+    }
+  }
+  const seen = new Set<number>()
+  for (const n of all) {
+    if (seen.has(n)) throw new Error(`${label}: p15DomainSequence ${n} is held by two P15 rows (duplicate)`)
+    seen.add(n)
+  }
+  const largest = all.length === 0 ? 0 : Math.max(...all)
+  if (next !== largest + 1) throw new Error(`${label}: p15Sequence.next ${next} must be one more than the largest p15DomainSequence (${largest})`)
+}
+
+/** 1355-A §3.4 item 3: from max(recordedFromWeek, originWeek) every simulated release has exactly
+ * one assessment with its id, week, studio and genre, and no assessment lacks its film. */
+function validateFilmBijection(raw: Record<string, unknown>, hollywood: NonNullable<GameState['hollywood']>,
+  rows: readonly PersistedMarketAssessment[], recordedFromWeek: number, fail: (message: string) => never): void {
+  const from = Math.max(recordedFromWeek, hollywood.originWeek)
+  const concepts = new Map((raw.concepts as GameState['concepts']).map((concept) => [concept.id, concept]))
+  const films = new Map<string, { week: number; studioId: string; genre: string }>()
+  for (const film of (raw.studio as GameState['studio']).releasedFilms) {
+    const genre = concepts.get(film.conceptId)?.genre
+    if (genre !== undefined) films.set(film.productionId, { week: film.releaseTick, studioId: hollywood.playerStudioId, genre })
+  }
+  for (const film of hollywood.films) {
+    if (film.provenance === 'simulation/v1') films.set(film.filmId, { week: film.result.releaseTick, studioId: film.studioId, genre: film.genre })
+  }
+  const byId = new Map(rows.map((row) => [row.releaseId, row]))
+  for (const [id, film] of films) {
+    if (film.week < from) continue
+    const row = byId.get(id)
+    if (row === undefined) fail(`film ${id} released at week ${film.week} has no assessment`)
+    else if (row.week !== film.week || row.studioId !== film.studioId || row.genre !== film.genre) {
+      fail(`assessment ${id} disagrees with its film's week, studio or genre`)
+    }
+  }
+  for (const row of rows) if (!films.has(row.releaseId)) fail(`assessment ${row.releaseId} has no film`)
+}
+
+/** 1355-A §3.4 item 4: week by week, rebuild exposures and members from the stored rows and
+ * re-run the law of each row's definition; every law field must be exactly equal. */
+function reconcileLaw(rows: readonly PersistedMarketAssessment[], fail: (message: string) => never): void {
+  let start = 0
+  let windowStart = 0
+  while (start < rows.length) {
+    const week = rows[start]!.week
+    let end = start
+    while (end < rows.length && rows[end]!.week === week) end++
+    while (rows[windowStart]!.week <= week - TUNING.SHARED_MARKET_RETIRE_AFTER_WEEKS) windowStart++
+    const exposures = rows.slice(windowStart, start)
+      .map((row) => ({ releaseId: row.releaseId, studioId: row.studioId, genre: row.genre, releaseWeek: row.week }))
+    const members = rows.slice(start, end)
+    const law = LAWS[members[0]!.definitionVersion]!
+    const expected = law(exposures, { week, members: members.map((row) => ({ releaseId: row.releaseId, studioId: row.studioId, genre: row.genre })) })
+    members.forEach((row, k) => {
+      const lawRow = expected[k]!
+      for (const field of LAW_FIELDS) {
+        if (row[field] !== lawRow[field]) fail(`assessment ${row.releaseId} ${field} does not reconcile with ${row.definitionVersion}`)
+      }
+      const reasonsMatch = row.reasons.length === lawRow.reasons.length && row.reasons.every((reason, r) => {
+        const other = lawRow.reasons[r]!
+        return reason.code === other.code && reason.value === other.value &&
+          reason.sourceReleaseIds.length === other.sourceReleaseIds.length &&
+          reason.sourceReleaseIds.every((id, s) => id === other.sourceReleaseIds[s])
+      })
+      if (!reasonsMatch) fail(`assessment ${row.releaseId} reasons do not reconcile with ${row.definitionVersion}`)
+    })
+    start = end
+  }
+}
