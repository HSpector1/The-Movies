@@ -100,6 +100,11 @@ export type ReceptionInputs = {
   // figure, so C6 inherits a measured lever rather than a confound.
   setUplift?: number
   setNovelty?: number | null
+  // P15A.1 Wave 2 (REFERENCE ONLY, record 1355-C; 1355-A §3.2): the shared-market factor the
