+      dueWeekExclusive: 156, contractId: promiseById(f.lastAdmission, f.promiseId).contractId })
+    expect(promiseById(after, f.promiseId).outcomeCause).toMatch(/retir/i)
+    ownOutcomeReceipt(after, f.promiseId)
