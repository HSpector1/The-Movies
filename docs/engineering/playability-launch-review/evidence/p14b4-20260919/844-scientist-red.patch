@@ -0,0 +1,25 @@
+// Attribution probe on isolated pre-C.2c production (8f baseline). It does not
+// change the main test expectation; parent records its result before repair.
+import { expect, it } from 'vitest'
+import { c2cFixture, savedState, tick } from './helpers/p14c2c-fixtures.js'
+
+it('pre-C.2c fixture/tick/save already normalizes only signed zero in this round trip', () => {
+  const state = tick(c2cFixture().lastAdmission)
+  const restored = savedState(state)
+  const differences: { path: string; before: unknown; after: unknown; negativeZeroToZero: boolean }[] = []
+  function compare(before: unknown, after: unknown, path: string): void {
+    if (Object.is(before, after)) return
+    if (before !== null && after !== null && typeof before === 'object' && typeof after === 'object') {
+      const a = before as Record<string, unknown>, b = after as Record<string, unknown>
+      expect(Object.keys(a), `same structure at ${path}`).toEqual(Object.keys(b))
+      for (const key of Object.keys(a)) compare(a[key], b[key], `${path}.${key}`)
+      return
+    }
+    differences.push({ path, before, after, negativeZeroToZero: Object.is(before, -0) && Object.is(after, 0) })
+  }
+  compare(state, restored, 'state')
+  expect(differences.length).toBeGreaterThan(0)
+  expect(differences.every((difference) => difference.negativeZeroToZero)).toBe(true)
+  expect(JSON.stringify(restored)).toBe(JSON.stringify(state))
+  console.log('pre-C.2c signed-zero attribution', JSON.stringify({ week: state.market.tick, differences }))
+})
