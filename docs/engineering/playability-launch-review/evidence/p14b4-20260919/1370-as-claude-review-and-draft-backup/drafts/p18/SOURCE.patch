@@ -0,0 +1,122 @@
+// ── P18 bounded first season — the Save46 step (contract §8 "Old saves migrate with an empty TV root") ──
+//
+// RED MECHANISM: `validateSaveV46`, `convertV45ToV46`, `convertV46ToV45`, `migrateToV46` and the
+// `P18_SAVE_VERSION` / `P18_PREDECESSOR_SAVE_VERSION` constants do not exist at the base; each is
+// named through the module namespace so a missing export fails its own leaf with its own message.
+// SAVE VERSION: other lanes also mint 46 at this base; `P18_SAVE_VERSION` is the one constant the
+// parent renumbers (REPORT "save-version renumbering procedure").
+import { createHash } from 'node:crypto'
+import { readFileSync } from 'node:fs'
+import { gunzipSync } from 'node:zlib'
+import { describe, expect, it } from 'vitest'
+import * as saveModule from '../src/core/save.js'
+import { LIVE_SAVE_VERSION, exportSave, importSave, makeSave, makeSaveV18, migrateToLive, stableStringify, validateSave, validateSaveV45 } from '../src/core/save.js'
+import { generateWorld } from '../src/core/worldgen.js'
+import { p13aGeneratedStudio } from '../src/harness/p13a/fixtures.js'
+import { initialTelevisionRoot } from '../src/core/tvSeason.js'
+import type { GameState } from '../src/core/types.js'
+
+type SaveModule = typeof saveModule & {
+  P18_SAVE_VERSION: number
+  P18_PREDECESSOR_SAVE_VERSION: number
+  validateSaveV46: (save: unknown) => { saveVersion: number; state: GameState }
+  convertV45ToV46: (save: unknown) => { saveVersion: number; state: GameState }
+  convertV46ToV45: (save: unknown) => { saveVersion: number; state: GameState }
+  migrateToV46: (save: unknown) => { saveVersion: number; state: GameState }
+}
+const save = saveModule as SaveModule
+const sha = (value: string | Uint8Array): string => createHash('sha256').update(value).digest('hex')
+
+// Genuine Save45 predecessor (1363-save45-predecessor/v1, generatingHead 689a69f3, seed
+// p13a-core-causal-01, week 53). Pinned by gzip sha256 of the checked-in file, recomputed by this
+// author against the bytes rather than copied from the manifest prose.
+const PREDECESSOR = new URL('./fixtures/p14/genuine-v45-recovery-predecessors-1363/p13a-week-53.save45.json.gz', import.meta.url)
+function genuineV45(): { raw: string; parsed: { saveVersion: number; state: GameState } } {
+  const gz = readFileSync(PREDECESSOR)
+  expect(gz.byteLength).toBe(90405)
+  expect(sha(gz)).toBe('fd4b8f0986453d1b735dda8410ffd05c841289d0fd51d9fe1a6707128947dc68')
+  const raw = gunzipSync(gz).toString('utf8')
+  expect(Buffer.byteLength(raw, 'utf8')).toBe(774318)
+  expect(sha(raw)).toBe('d66a6809c3fc3dacf6a83386cad320d94c70264384f47e5f83a0bd0320768d07')
+  const parsed = importSave(raw) as { saveVersion: number; state: GameState }
+  expect(parsed.saveVersion).toBe(45)
+  return { raw, parsed }
+}
+
+describe('P18 Save46 — constants and dispatch', () => {
+  it('P18_SAVE_VERSION is the live version and its predecessor is the Save45 P15 step', () => {
+    expect(save.P18_PREDECESSOR_SAVE_VERSION).toBe(45)
+    expect(save.P18_SAVE_VERSION).toBe(save.P18_PREDECESSOR_SAVE_VERSION + 1)
+    expect(LIVE_SAVE_VERSION).toBe(save.P18_SAVE_VERSION)
+  })
+
+  it('makeSave stamps the live version, carries the television root, and migrateToLive is the identity on it', () => {
+    const state = p13aGeneratedStudio('p18-save46-fresh')
+    const envelope = makeSave(state)
+    expect(envelope.saveVersion).toBe(save.P18_SAVE_VERSION)
+    expect(Object.hasOwn(envelope.state, 'television')).toBe(true)
+    expect(stableStringify(migrateToLive(envelope))).toBe(stableStringify(envelope))
+    expect(stableStringify(validateSave(JSON.parse(exportSave(envelope))))).toBe(stableStringify(envelope))
+  })
+
+  it('a fresh world carries an empty television root recorded from week 0 with every allocator at 1', () => {
+    const world = generateWorld('p18-save46-world') as GameState & { television?: unknown }
+    expect(world.television).toEqual(initialTelevisionRoot(0))
+    expect(initialTelevisionRoot(0)).toEqual({
+      version: 1, recordedFromWeek: 0, nextSeries: 1, nextSeason: 1, nextAgreement: 1, nextReceipt: 1,
+      series: [], seasons: [], agreements: [], receipts: [],
+    })
+  })
+
+  it('validateSave refuses the version after the live one by name', () => {
+    expect(() => validateSave({ saveVersion: save.P18_SAVE_VERSION + 1, seed: 's', state: {}, broadcastCache: [] }))
+      .toThrow(new RegExp(`unknown saveVersion ${save.P18_SAVE_VERSION + 1}`))
+  })
+})
+
+describe('P18 Save46 — genuine predecessor migration and lossless downgrade', () => {
+  it('migrates the genuine Save45 week-53 capture with an empty root at the save\'s own week and nothing else moved', () => {
+    const { parsed } = genuineV45()
+    const migrated = migrateToLive(parsed) as unknown as { saveVersion: number; state: GameState & { television: unknown } }
+    expect(migrated.saveVersion).toBe(save.P18_SAVE_VERSION)
+    expect(migrated.state.television).toEqual(initialTelevisionRoot(53))
+    const { television: _television, ...rest } = migrated.state
+    expect(stableStringify(rest)).toBe(stableStringify(parsed.state))
+    // a second migration is a no-op
+    expect(stableStringify(save.migrateToV46(migrated))).toBe(stableStringify(migrated))
+  })
+
+  it('downgrades losslessly while the root is empty: the Save45 bytes come back exactly', () => {
+    const { parsed } = genuineV45()
+    const migrated = save.migrateToV46(parsed)
+    const back = save.convertV46ToV45(migrated)
+    expect(back.saveVersion).toBe(45)
+    expect(stableStringify(back)).toBe(stableStringify(parsed))
+    expect(stableStringify(validateSaveV45(back))).toBe(stableStringify(parsed))
+  })
+
+  it('validateSaveV46 requires the root and refuses a malformed one by name', () => {
+    const fresh = makeSave(p13aGeneratedStudio('p18-save46-shape'))
+    const { television: _television, ...withoutRoot } = fresh.state as GameState & { television: unknown }
+    expect(() => save.validateSaveV46({ ...fresh, state: withoutRoot })).toThrow(/television/)
+    expect(() => save.validateSaveV46({ ...fresh, state: { ...fresh.state, television: { version: 2 } } })).toThrow(/television/)
+    expect(() => save.validateSaveV46({ ...fresh, saveVersion: 45 })).toThrow(/expected version 46/)
+  })
+
+  it('the frozen Save45 reader refuses the live shape (the television key) and every TV ledger kind', () => {
+    const fresh = makeSave(p13aGeneratedStudio('p18-save46-era'))
+    expect(() => validateSaveV45({ ...fresh, saveVersion: 45 })).toThrow()
+    const { television: _television, ...stripped } = fresh.state as GameState & { television: unknown }
+    const row = { week: stripped.market.tick, kind: 'tvAdvance', amount: 120_000, note: 'forged', tvAgreementId: 'tv-agreement-0001' }
+    const forged = { ...stripped, studio: { ...stripped.studio, cash: stripped.studio.cash + 120_000 }, ledger: [...stripped.ledger, row] }
+    expect(() => validateSaveV45({ ...fresh, saveVersion: 45, state: forged })).toThrow(/kind/)
+  })
+
+  it('a frozen builder refuses a non-empty television root before any older refusal', () => {
+    const state = p13aGeneratedStudio('p18-save46-frozen')
+    const root = initialTelevisionRoot(state.market.tick)
+    const forgedSeries = { ...root, nextSeries: 2, series: [{ seriesId: 'tv-series-0001', title: 'x', propertyId: 'p', originProductionId: null,
+      producerStudioId: state.hollywood!.playerStudioId, createdWeek: state.market.tick, seasonIds: [] }] }
+    expect(() => makeSaveV18({ ...state, television: forgedSeries } as unknown as Parameters<typeof makeSaveV18>[0])).toThrow(/television/)
+  })
+})
