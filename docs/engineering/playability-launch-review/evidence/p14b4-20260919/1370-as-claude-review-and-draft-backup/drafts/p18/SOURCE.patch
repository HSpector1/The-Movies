@@ -0,0 +1,85 @@
+// ── P18 — the one distribution model (contract §6) and the public projection (§8) ─────────
+//
+// An exclusive fixed-fee licence window: the whole season is available to its named commissioner
+// during [deliveryWeek, deliveryWeek + 52), covered by the distribution authority. No weekly
+// royalties, viewers, advertising yields, platform balances, theatrical runs or synthetic
+// FilmResults. Expiry stops availability; it neither reverses earned fees nor remints the work.
+
+import { appendTvReceipt } from './tvSettlement.js'
+import type { GameState } from './types.js'
+import type { TelevisionRoot, TvRole, TvSeason, TvSeasonStatus } from './tvTypes.js'
+
+export function tvSeasonAvailableAt(season: TvSeason, week: number): boolean {
+  const window = season.distribution
+  if (season.status !== 'delivered' || window === null) return false
+  // the grant's own distribution term bounds availability too: a lawful early end stops it
+  if (week >= season.grant.distributionEndExclusive) return false
+  return week >= window.availableFromWeek && week < window.availableUntilExclusive
+}
+
+/** At boundary T, record the expiry of every delivered window that ends at or before T — once. */
+export function recordTvDistributionExpiry(root: TelevisionRoot, boundary: number): TelevisionRoot {
+  let next = root
+  for (const season of root.seasons) {
+    const window = season.distribution
+    if (season.status !== 'delivered' || window === null || window.expiredRecordedWeek !== null) continue
+    const ends = Math.min(window.availableUntilExclusive, season.grant.distributionEndExclusive)
+    if (boundary < ends) continue
+    next = {
+      ...next,
+      seasons: next.seasons.map((row) => row.seasonId === season.seasonId
+        ? { ...row, distribution: { ...window, expiredRecordedWeek: boundary } }
+        : row),
+    }
+    next = appendTvReceipt(next, { kind: 'distributionExpired', week: boundary, seasonId: season.seasonId,
+      agreementId: season.agreementId, availableUntilExclusive: window.availableUntilExclusive })
+  }
+  return next
+}
+
+/** Public facts only (contract §8): no fee, advance, cash, grant price or private terms. */
+export type TvPublicSeasonView = {
+  seasonId: string
+  seasonNumber: number
+  episodes: number
+  status: TvSeasonStatus
+  commitWeek: number
+  deliveredWeek: number | null
+  cancelledWeek: number | null
+  availableFromWeek: number | null
+  availableUntilExclusive: number | null
+  credits: readonly { talentId: string; name: string; role: TvRole }[]
+}
+export type TvPublicSeriesView = {
+  seriesId: string
+  title: string
+  producerStudioId: string
+  propertyId: string
+  originProductionId: string | null
+  seasons: TvPublicSeasonView[]
+}
+export type TvPublicView = { series: TvPublicSeriesView[] }
+
+export function televisionPublicView(state: Pick<GameState, 'television'>): TvPublicView {
+  return {
+    series: state.television.series.map((series) => ({
+      seriesId: series.seriesId,
+      title: series.title,
+      producerStudioId: series.producerStudioId,
+      propertyId: series.propertyId,
+      originProductionId: series.originProductionId,
+      seasons: state.television.seasons.filter((season) => season.seriesId === series.seriesId).map((season) => ({
+        seasonId: season.seasonId,
+        seasonNumber: season.seasonNumber,
+        episodes: season.episodes,
+        status: season.status,
+        commitWeek: season.commitWeek,
+        deliveredWeek: season.deliveredWeek,
+        cancelledWeek: season.cancelledWeek,
+        availableFromWeek: season.distribution?.availableFromWeek ?? null,
+        availableUntilExclusive: season.distribution?.availableUntilExclusive ?? null,
+        credits: season.credits.map((credit) => ({ talentId: credit.talentId, name: credit.name, role: credit.role })),
+      })),
+    })),
+  }
+}
diff --git a/src/core/tvReaders.ts b/src/core/tvReaders.ts
new file mode 100644
index 00000000..56b13088
--- /dev/null
+++ b/src/core/tvReaders.ts
@@ -0,0 +1,62 @@
+// ── P18 — leaf readers over the television root (no runtime imports beyond types) ────────
+//
+// Kept import-free so `employment.ts`, `occupancy.ts`, `sets.ts` and `worldgen.ts` can read
+// the root without a cycle through `tvSeason.ts`.
+
+import type { TelevisionRoot, TvSeason } from './tvTypes.js'
+
+export function initialTelevisionRoot(week: number): TelevisionRoot {
+  return { version: 1, recordedFromWeek: week, nextSeries: 1, nextSeason: 1, nextAgreement: 1, nextReceipt: 1,
+    series: [], seasons: [], agreements: [], receipts: [] }
+}
+
+export function liveTvSeason(root: TelevisionRoot | undefined): TvSeason | null {
+  return root?.seasons.find((season) => season.status === 'live') ?? null
+}
+
+/**
+ * The people a live season RESERVES (contract §4): the director, the three cast seats and the
+ * craft lead from commitment through delivery or cancellation, and the writer while the
+ * scripts block is incomplete. A released writer keeps a permanent credit and no seat.
+ */
+export function tvEngagedTalentIds(root: TelevisionRoot | undefined): Set<string> {
+  const ids = new Set<string>()
+  for (const season of root?.seasons ?? []) {
+    if (season.status !== 'live') continue
+    ids.add(season.roster.directorId)
+    ids.add(season.roster.cast.lead)
+    ids.add(season.roster.cast.antagonist)
+    ids.add(season.roster.cast.support)
+    ids.add(season.roster.craftId)
+    if (season.writerReleasedWeek === null) ids.add(season.roster.writerId)
+  }
+  return ids
+}
+
+/** The bare `facilityId:slot` keys a live season holds — the allocator's vocabulary. */
+export function televisionOccupiedFacilitySlots(root: TelevisionRoot | undefined): Set<string> {
+  const held = new Set<string>()
+  for (const season of root?.seasons ?? []) {
+    if (season.status !== 'live') continue
+    for (const reservation of season.reservations) held.add(`${reservation.facilityId}:${String(reservation.slot)}`)
+  }
+  return held
+}
+
+/** A set is held by a season exactly while the season holds the stage it stands on. */
+export function tvHeldSetIds(root: TelevisionRoot | undefined): Set<string> {
+  const held = new Set<string>()
+  for (const season of root?.seasons ?? []) {
+    if (season.status !== 'live' || season.setId === null) continue
+    if (season.reservations.some((reservation) => reservation.capability === 'soundstage')) held.add(season.setId)
+  }
+  return held
+}
+
+export function tvSeasonHoldingSet(root: TelevisionRoot | undefined, setId: string): string | null {
+  for (const season of root?.seasons ?? []) {
+    if (season.status !== 'live' || season.setId !== setId) continue
+    if (season.reservations.some((reservation) => reservation.capability === 'soundstage')) return season.seasonId
+  }
+  return null
+}
diff --git a/src/core/tvSeason.ts b/src/core/tvSeason.ts
new file mode 100644
index 00000000..4246c04a
--- /dev/null
+++ b/src/core/tvSeason.ts
@@ -0,0 +1,436 @@
+// ── P18 — one season workload: weekly work, money, delivery and cancellation (contract §4–§7) ──
+//
+// Twelve counted work units in five blocks (3/1/1/4/3), at most one unit per weekly advance.
+// A unit is credited only when the required valid people, the occupied capacity and the paid
+// weekly production cost all exist for that week. Block resources follow the production
+// resource-release law (`productionPhases.ts`): what the next block genuinely requires is
+// retained (rehearsal → shooting keeps the stage and its set); everything else releases the
+// week the block completes. The scenery load-in reuses the engine's own geometry.
+//
+// Pure: no RNG, no clock, no I/O. The caller (tick step 7.7, actions) owns the cash it hands
+// in and the ledger rows it gets back; this module never writes `operations.workflows`.
+
+import { boundedStableSort } from './boundedStableSort.js'
+import { lifecycleStatus } from './careerLifecycle.js'
+import { activeContract } from './employment.js'
+import { facilitySlotKey } from './occupancy.js'
+import { facilityBodyCentre, gridDistance, sceneryLoadInWeeksForDistance } from './sceneryLoadIn.js'
+import { bindableSetsOn, wearSetAtWrap } from './sets.js'
+import { TUNING } from './tuning.js'
+import { recordTvDistributionExpiry } from './tvDistribution.js'
+import {
+  initialTelevisionRoot, liveTvSeason, televisionOccupiedFacilitySlots, tvEngagedTalentIds, tvHeldSetIds, tvSeasonHoldingSet,
+} from './tvReaders.js'
+import {
+  appendTvReceipt, applyTvObligationPayment, assertTvMoneyInvariant, freezeTvCancellation, tvLateDeduction, tvLedgerRow,
+  tvMilestonePayment, tvOutstanding,
+} from './tvSettlement.js'
+import { TV_WORK_BLOCK_ORDER } from './tvTypes.js'
+import type {
+  TelevisionRoot, TvAgreement, TvCancellationCause, TvGrantFacts, TvMilestoneKind, TvReservation, TvSeason, TvStall, TvWorkBlock,
+} from './tvTypes.js'
+import type { FacilityCapability, GameState, LedgerEntry, StudioOperations, StudioSet } from './types.js'
+
+export { initialTelevisionRoot, liveTvSeason, televisionOccupiedFacilitySlots, tvEngagedTalentIds, tvHeldSetIds, tvSeasonHoldingSet }
+
+export type TvWorkBlockDefinition = { block: TvWorkBlock; units: number; capabilities: readonly FacilityCapability[] }
+
+/** Contract §4 table: counted units and the occupied capability of each block, in order. */
+export const TV_WORK_BLOCKS: readonly TvWorkBlockDefinition[] = Object.freeze([
+  Object.freeze({ block: 'scripts', units: TUNING.TV_SCRIPT_UNITS, capabilities: Object.freeze(['development-casting']) as readonly FacilityCapability[] }),
+  Object.freeze({ block: 'preparation', units: TUNING.TV_PREPARATION_UNITS, capabilities: Object.freeze(['development-casting']) as readonly FacilityCapability[] }),
+  Object.freeze({ block: 'rehearsal', units: TUNING.TV_REHEARSAL_UNITS, capabilities: Object.freeze(['soundstage']) as readonly FacilityCapability[] }),
+  Object.freeze({ block: 'shooting', units: TUNING.TV_SHOOTING_UNITS, capabilities: Object.freeze(['soundstage', 'set-scenery']) as readonly FacilityCapability[] }),
+  Object.freeze({ block: 'post', units: TUNING.TV_POST_UNITS, capabilities: Object.freeze(['post']) as readonly FacilityCapability[] }),
+]) as readonly TvWorkBlockDefinition[]
+
+export function tvWorkUnitsTotal(): number {
+  return TV_WORK_BLOCKS.reduce((sum, block) => sum + block.units, 0)
+}
+
+export function tvBlockDefinition(block: TvWorkBlock): TvWorkBlockDefinition {
+  const found = TV_WORK_BLOCKS.find((row) => row.block === block)
+  if (found === undefined) throw new Error(`tv season: unknown work block ${String(block)}`)
+  return found
+}
+
+export function nextTvBlock(block: TvWorkBlock): TvWorkBlock | null {
+  const index = TV_WORK_BLOCK_ORDER.indexOf(block)
+  return index >= 0 && index + 1 < TV_WORK_BLOCK_ORDER.length ? TV_WORK_BLOCK_ORDER[index + 1]! : null
+}
+
+/** Units credited by every block before `block`, plus `blockCredited` — the one derivation of `creditedUnits`. */
+export function tvUnitsThrough(block: TvWorkBlock, blockCredited: number): number {
+  let total = 0
+  for (const row of TV_WORK_BLOCKS) {
+    if (row.block === block) return total + blockCredited
+    total += row.units
+  }
+  return total + blockCredited
+}
+
+/** Half-open upstream terms: the authority covers `week` while week < its end. */
+export function tvGrantCovers(grant: TvGrantFacts, week: number, scope: 'production' | 'distribution'): boolean {
+  return week < (scope === 'production' ? grant.productionEndExclusive : grant.distributionEndExclusive)
+}
+
+/** The people a live season needs this week: the five company members and, until scripts complete, the writer. */
+export function tvRequiredParticipants(season: TvSeason): string[] {
+  const ids = [season.roster.directorId, season.roster.cast.lead, season.roster.cast.antagonist, season.roster.cast.support, season.roster.craftId]
+  if (season.writerReleasedWeek === null) ids.unshift(season.roster.writerId)
+  return ids
+}
+
+function compareId<T extends { id: string }>(a: T, b: T): number {
+  return a.id < b.id ? -1 : a.id > b.id ? 1 : 0
+}
+
+function reservationKey(reservation: TvReservation): string {
+  return facilitySlotKey(reservation.facilityId, reservation.slot)
+}
+
+export type TvAllocationContext = {
+  operations: StudioOperations
+  /** Candidate sets for the stage+set composite (the state as the advance found it). */
+  sets: readonly StudioSet[]
+  /** Every other owner's slot keys, bare `facilityId:slot`. The season's own slots are excluded. */
+  occupied: ReadonlySet<string>
+  /** Sets other holders stand on right now. */
+  heldSets: ReadonlySet<string>
+  stageFacilityId: string
+  postFacilityId: string
+}
+
+type TvAllocation = { ok: true; reservations: TvReservation[]; setId: string | null } | { ok: false; stall: TvStall }
+
+/**
+ * Acquire what `block` requires, retaining what the season already holds. The sound chain is
+ * exact: the soundstage must be the adoption's stage and Post its Post. Rehearsal acquires the
+ * stage+set composite atomically (`productionPhases.ts` §3.2); shooting retains both.
+ */
+export function allocateTvBlock(season: TvSeason, block: TvWorkBlockDefinition, context: TvAllocationContext): TvAllocation {
+  const occupied = new Set(context.occupied)
+  const facilities = boundedStableSort([...context.operations.facilities], compareId).filter((facility) =>
+    facility.capability === 'soundstage' ? facility.id === context.stageFacilityId
+      : facility.capability === 'post' ? facility.id === context.postFacilityId
+        : true)
+  const reservations: TvReservation[] = []
+  let setId = season.setId
+  const needsStage = block.capabilities.includes('soundstage')
+  const retainingStage = needsStage && season.reservations.some((reservation) => reservation.capability === 'soundstage')
+  if (needsStage && !retainingStage) {
+    const stage = facilities.find((facility) => facility.capability === 'soundstage')
+    if (stage === undefined) return { ok: false, stall: { kind: 'facility-capacity', capability: 'soundstage' } }
+    let free = -1
+    for (let slot = 0; slot < stage.capacity; slot++) {
+      if (!occupied.has(facilitySlotKey(stage.id, slot))) { free = slot; break }
+    }
+    if (free < 0) return { ok: false, stall: { kind: 'facility-capacity', capability: 'soundstage' } }
+    const candidates = bindableSetsOn(context.sets, stage.id, context.heldSets)
+    if (candidates.length === 0) return { ok: false, stall: { kind: 'set-unavailable' } }
+    setId = candidates[0]!.id
+  }
+  for (const capability of block.capabilities) {
+    const retained = season.reservations.find((reservation) => reservation.capability === capability)
+    if (retained !== undefined) {
+      reservations.push(retained)
+      occupied.add(reservationKey(retained))
+      continue
+    }
+    let allocated: TvReservation | null = null
+    for (const facility of facilities) {
+      if (facility.capability !== capability) continue
+      for (let slot = 0; slot < facility.capacity; slot++) {
+        const key = facilitySlotKey(facility.id, slot)
+        if (occupied.has(key)) continue
+        allocated = { facilityId: facility.id, capability, slot }
+        occupied.add(key)
+        break
+      }
+      if (allocated !== null) break
+    }
+    if (allocated === null) return { ok: false, stall: { kind: 'facility-capacity', capability } }
+    reservations.push(allocated)
+  }
+  return { ok: true, reservations, setId }
+}
+
+/** Weeks the scenery still has to travel from the shop to the stage; 0 when it is on the stage. */
+export function tvSceneryLoadInRemaining(state: Pick<GameState, 'placement' | 'property'>, season: TvSeason, week: number): number {
+  const stage = season.reservations.find((reservation) => reservation.capability === 'soundstage')
+  const scenery = season.reservations.find((reservation) => reservation.capability === 'set-scenery')
+  const called = season.work.stageHeldSinceWeek
+  if (stage === undefined || scenery === undefined || called === null) return 0
+  const to = facilityBodyCentre(state, stage.facilityId)
+  const from = facilityBodyCentre(state, scenery.facilityId)
+  // A body the property cannot place has no derivable trip. The film law withholds the whole
+  // derivation and leaves the legacy click; a season has no click, so an underivable trip costs
+  // no week rather than a guessed one (REPORT known limitations).
+  if (to === null || from === null) return 0
+  return Math.max(0, sceneryLoadInWeeksForDistance(gridDistance(from, to)) - (week - called))
+}
+
+function replaceSeason(root: TelevisionRoot, season: TvSeason): TelevisionRoot {
+  return { ...root, seasons: root.seasons.map((row) => row.seasonId === season.seasonId ? season : row) }
+}
+
+function replaceAgreement(root: TelevisionRoot, agreement: TvAgreement): TelevisionRoot {
+  return { ...root, agreements: root.agreements.map((row) => row.agreementId === agreement.agreementId ? agreement : row) }
+}
+
+function agreementFor(root: TelevisionRoot, season: TvSeason): TvAgreement {
+  const agreement = root.agreements.find((row) => row.agreementId === season.agreementId)
+  if (agreement === undefined) throw new Error(`tv season: season ${season.seasonId} names no agreement ${season.agreementId}`)
+  return agreement
+}
+
+type MoneyStep = { root: TelevisionRoot; cash: number; ledger: LedgerEntry[] }
+
+/** Earn a milestone at boundary T and pay max(0, E_new − P) at the advance week W. */
+function earnMilestone(step: MoneyStep, season: TvSeason, kind: TvMilestoneKind, amount: number, boundary: number, ledgerWeek: number): MoneyStep {
+  const agreement = agreementFor(step.root, season)
+  const earned = agreement.earned + amount
+  const pay = tvMilestonePayment(earned, agreement.received)
+  const next: TvAgreement = {
+    ...agreement,
+    earned,
+    received: agreement.received + pay,
+    milestones: [...agreement.milestones, { kind, week: boundary, earned: amount, paid: pay }],
+  }
+  let root = replaceAgreement(step.root, next)
+  root = appendTvReceipt(root, { kind: 'milestoneEarned', week: boundary, seasonId: season.seasonId, agreementId: agreement.agreementId, milestone: kind, amount })
+  const ledger = [...step.ledger]
+  let cash = step.cash
+  if (pay > 0) {
+    root = appendTvReceipt(root, { kind: 'milestonePaid', week: boundary, seasonId: season.seasonId, agreementId: agreement.agreementId, milestone: kind, amount: pay })
+    ledger.push(tvLedgerRow(ledgerWeek, 'tvMilestonePayment', pay, agreement.agreementId, `tv ${kind} milestone ${agreement.agreementId}`))
+    cash += pay
+  }
+  return { root, cash, ledger }
+}
+
+export type TvCancellationWeeks = { boundary: number; ledger: number }
+
+/**
+ * The one cancellation settlement (contract §7): freeze U0, assess K once, release capacity and
+ * people once, and — when `pay` — settle from available nonnegative cash, refund first. The
+ * closure/absorption path passes `pay: false`: P15's estate owns those payments and this
+ * module never debits an obligation inside a closure handler.
+ */
+export function cancelTvSeasonCore(root: TelevisionRoot, seasonId: string, weeks: TvCancellationWeeks, cause: TvCancellationCause,
+  cash: number, pay: boolean): MoneyStep {
+  const season = root.seasons.find((row) => row.seasonId === seasonId)
+  if (season === undefined) throw new Error(`tv season: no TV season "${seasonId}"`)
+  if (season.status !== 'live') throw new Error(`tv season: season "${seasonId}" is not live (status ${season.status})`)
+  let agreement = freezeTvCancellation(agreementFor(root, season), weeks.boundary)
+  const ledger: LedgerEntry[] = []
+  let refundPaid = 0
+  let chargePaid = 0
+  if (pay) {
+    const outstanding = tvOutstanding(agreement)
+    let available = Math.max(0, cash)
+    refundPaid = Math.min(outstanding.advanceRefund, available)
+    available -= refundPaid
+    chargePaid = Math.min(outstanding.cancellationCharge, available)
+    const total = refundPaid + chargePaid
+    if (total > 0) {
+      agreement = applyTvObligationPayment(agreement, total).agreement
+      cash -= total
+    }
+    if (refundPaid > 0) ledger.push(tvLedgerRow(weeks.ledger, 'tvAdvanceRefund', -refundPaid, agreement.agreementId, `tv advance refund ${agreement.agreementId}`))
+    if (chargePaid > 0) ledger.push(tvLedgerRow(weeks.ledger, 'tvCancellationCharge', -chargePaid, agreement.agreementId, `tv cancellation charge ${agreement.agreementId}`))
+  }
+  assertTvMoneyInvariant(agreement)
+  const cancelled: TvSeason = {
+    ...season,
+    status: 'cancelled',
+    cancelledWeek: weeks.boundary,
+    cancellationCause: cause,
+    reservations: [],
+    work: { ...season.work, stall: null },
+  }
+  let next = replaceAgreement(replaceSeason(root, cancelled), agreement)
+  const outstanding = tvOutstanding(agreement)
+  next = appendTvReceipt(next, { kind: 'cancelled', week: weeks.boundary, seasonId, agreementId: agreement.agreementId, cause,
+    refundFrozen: agreement.advanceRefundFrozen ?? 0, chargeAssessed: agreement.cancellationChargeAssessed, refundPaid, chargePaid })
+  if (refundPaid > 0) {
+    next = appendTvReceipt(next, { kind: 'advanceRefundPaid', week: weeks.boundary, seasonId, agreementId: agreement.agreementId, amount: refundPaid, remaining: outstanding.advanceRefund })
+  }
+  if (chargePaid > 0) {
+    next = appendTvReceipt(next, { kind: 'cancellationChargePaid', week: weeks.boundary, seasonId, agreementId: agreement.agreementId, amount: chargePaid, remaining: outstanding.cancellationCharge })
+  }
+  return { root: next, cash, ledger }
+}
+
+/** The public `cancelTvSeason` verb: the producer cancels explicitly before accepted delivery. */
+export function cancelTvSeason(state: GameState, seasonId: string): GameState {
+  const season = state.television.seasons.find((row) => row.seasonId === seasonId)
+  if (season === undefined) throw new Error(`applyActions: cancelTvSeason rejected — no TV season "${seasonId}"`)
+  if (season.status !== 'live') throw new Error(`applyActions: cancelTvSeason rejected — season "${seasonId}" is not live (status ${season.status})`)
+  const week = state.market.tick
+  const result = cancelTvSeasonCore(state.television, seasonId, { boundary: week, ledger: week }, 'voluntary', state.studio.cash, true)
+  return { ...state, television: result.root, studio: { ...state.studio, cash: result.cash }, ledger: [...state.ledger, ...result.ledger] }
+}
+
+/**
+ * Cancellation that moves no cash: the P15B closure handler and healthy-absorption nonassignment
+ * path (contract §7). Obligations are frozen for the estate's claim union (`tvObligations`).
+ */
+export function cancelTvSeasonWithoutPayment(state: GameState, seasonId: string, week: number, cause: TvCancellationCause): GameState {
+  const result = cancelTvSeasonCore(state.television, seasonId, { boundary: week, ledger: week }, cause, state.studio.cash, false)
+  return { ...state, television: result.root }
+}
+
+export type TelevisionAdvanceFacts = {
+  /** Cash after this week's mandatory studio charges. */
+  cash: number
+  /** The production root after this week's film sweep, with the facilities the week began with. */
+  operations: StudioOperations
+  /** The sets root this advance will finalize (wear applies here). */
+  sets: readonly StudioSet[]
+  /** The sets as the advance found them: a set finishing this week is not bindable yet. */
+  setsAtStart: readonly StudioSet[]
+  /** Every other owner's bare slot keys after this week's allocations. */
+  occupiedByOthers: ReadonlySet<string>
+  heldSetsByOthers: ReadonlySet<string>
+}
+
+export type TelevisionAdvance = { television: TelevisionRoot; cash: number; ledger: LedgerEntry[]; sets: readonly StudioSet[] }
+
+/**
+ * Tick step 7.7: at most one valid paid work unit for the live season at advance W → W+1, with
+ * milestones, delivery and the final-boundary cancellation resolved at T = W + 1. Runs after the
+ * film sweep and after the week's mandatory charges (contract §5), so "available cash" is literal
+ * and the season is the last requester of the week's capacity (REPORT contract gaps).
+ */
+export function advanceTelevisionWeek(state: GameState, facts: TelevisionAdvanceFacts, week: number): TelevisionAdvance {
+  const boundary = week + 1
+  let root = recordTvDistributionExpiry(state.television, boundary)
+  let cash = facts.cash
+  const ledger: LedgerEntry[] = []
+  let sets = facts.sets
+  const season = liveTvSeason(root)
+  if (season === null || state.founding !== null || state.operations.mode !== 'managed') return { television: root, cash, ledger, sets }
+  const done = (): TelevisionAdvance => ({ television: root, cash, ledger, sets })
+  const cancel = (cause: TvCancellationCause): TelevisionAdvance => {
+    const result = cancelTvSeasonCore(root, season.seasonId, { boundary, ledger: week }, cause, cash, true)
+    root = result.root
+    cash = result.cash
+    ledger.push(...result.ledger)
+    return done()
+  }
+  // No advance beginning at the final boundary performs work on this agreement.
+  if (week >= season.finalWeek) return cancel('deadline')
+  // Actual permission before each work unit: the production authority must cover the boundary.
+  if (!tvGrantCovers(season.grant, boundary, 'production')) return cancel('rightsLost')
+  for (const talentId of tvRequiredParticipants(season)) {
+    if (activeContract(state, talentId, week) === undefined || lifecycleStatus(state, talentId) === 'retired') return cancel('participantLost')
+  }
+  const adoption = state.technology.adoptions.find((row) => row.id === season.adoptionId)
+  if (adoption === undefined || adoption.postFacilityId === null) return cancel('rightsLost')
+
+  const block = tvBlockDefinition(season.work.block)
+  let working = season
+  const holdsAll = block.capabilities.every((capability) => working.reservations.some((reservation) => reservation.capability === capability))
+  if (!holdsAll) {
+    const allocation = allocateTvBlock(working, block, {
+      operations: facts.operations,
+      sets: facts.setsAtStart,
+      occupied: facts.occupiedByOthers,
+      heldSets: facts.heldSetsByOthers,
+      stageFacilityId: adoption.stageFacilityId,
+      postFacilityId: adoption.postFacilityId,
+    })
+    if (!allocation.ok) {
+      root = replaceSeason(root, { ...working, work: { ...working.work, stall: allocation.stall } })
+      return finishBoundary()
+    }
+    const acquiredStage = allocation.reservations.some((r) => r.capability === 'soundstage')
+      && !working.reservations.some((r) => r.capability === 'soundstage')
+    working = {
+      ...working,
+      reservations: allocation.reservations,
+      setId: allocation.setId,
+      work: { ...working.work, stageHeldSinceWeek: acquiredStage ? week : working.work.stageHeldSinceWeek },
+    }
+  }
+  if (working.work.block === 'shooting') {
+    const remaining = tvSceneryLoadInRemaining(state, working, week)
+    if (remaining > 0) {
+      root = replaceSeason(root, { ...working, work: { ...working.work, stall: { kind: 'scenery-load-in', weeksRemaining: remaining } } })
+      return finishBoundary()
+    }
+  }
+  const agreement = agreementFor(root, working)
+  if (cash < agreement.terms.unitSpend) {
+    root = replaceSeason(root, { ...working, work: { ...working.work, stall: { kind: 'cash', required: agreement.terms.unitSpend, available: cash } } })
+    return finishBoundary()
+  }
+  // The real expense and the unit, atomically.
+  cash -= agreement.terms.unitSpend
+  const creditedUnits = working.work.creditedUnits + 1
+  const blockCredited = working.work.blockCredited + 1
+  ledger.push(tvLedgerRow(week, 'tvProductionSpend', -agreement.terms.unitSpend, agreement.agreementId,
+    `tv unit ${creditedUnits}/${tvWorkUnitsTotal()} ${working.work.block} ${working.seasonId}`))
+  working = { ...working, work: { ...working.work, creditedUnits, blockCredited, lastCreditedWeek: boundary, stall: null } }
+  root = appendTvReceipt(root, { kind: 'unitCredited', week: boundary, seasonId: working.seasonId, agreementId: agreement.agreementId, block: working.work.block, creditedUnits })
+  if (blockCredited === block.units) {
+    root = appendTvReceipt(root, { kind: 'blockCompleted', week: boundary, seasonId: working.seasonId, agreementId: agreement.agreementId, block: working.work.block })
+    let money: MoneyStep = { root, cash, ledger: [] }
+    switch (working.work.block) {
+      case 'scripts': {
+        money = earnMilestone(money, working, 'scripts', agreement.terms.milestones.scripts, boundary, week)
+        working = { ...working, writerReleasedWeek: boundary }
+        money.root = appendTvReceipt(money.root, { kind: 'writerReleased', week: boundary, seasonId: working.seasonId, agreementId: agreement.agreementId, talentId: working.roster.writerId })
+        break
+      }
+      case 'shooting': {
+        money = earnMilestone(money, working, 'pictureLock', agreement.terms.milestones.pictureLock, boundary, week)
+        sets = wearSetAtWrap(sets, working.setId)
+        break
+      }
+      case 'post': {
+        const deduction = tvLateDeduction(agreement.terms, boundary)
+        money = earnMilestone(money, working, 'delivery', agreement.terms.milestones.delivery - deduction, boundary, week)
+        const settled = agreementFor(money.root, working)
+        money.root = replaceAgreement(money.root, { ...settled, status: 'settled' })
+        working = {
+          ...working,
+          status: 'delivered',
+          deliveredWeek: boundary,
+          reservations: [],
+          distribution: { availableFromWeek: boundary, availableUntilExclusive: boundary + agreement.terms.distributionWeeks, expiredRecordedWeek: null },
+        }
+        money.root = appendTvReceipt(money.root, { kind: 'delivered', week: boundary, seasonId: working.seasonId, agreementId: agreement.agreementId,
+          deliveryWeek: boundary, lateWeeks: Math.max(0, boundary - agreement.terms.dueWeek), deduction })
+        break
+      }
+      case 'preparation':
+      case 'rehearsal':
+        break
+    }
+    root = money.root
+    cash = money.cash
+    ledger.push(...money.ledger)
+    if (working.status === 'live') {
+      const next = nextTvBlock(working.work.block)
+      if (next === null) throw new Error(`tv season: block ${working.work.block} completed with no successor and no delivery`)
+      const retained = tvBlockDefinition(next).capabilities
+      working = {
+        ...working,
+        reservations: working.reservations.filter((reservation) => retained.includes(reservation.capability)),
+        work: { ...working.work, block: next, blockCredited: 0 },
+      }
+    }
+  }
+  root = replaceSeason(root, working)
+  assertTvMoneyInvariant(agreementFor(root, working))
+  return finishBoundary()
+
+  function finishBoundary(): TelevisionAdvance {
+    const current = root.seasons.find((row) => row.seasonId === season!.seasonId)!
+    // Resolve lawful delivery first; an incomplete season at T = C + 20 cancels for deadline failure.
+    if (current.status === 'live' && boundary >= current.finalWeek) return cancel('deadline')
+    return done()
+  }
+}
diff --git a/src/core/tvSettlement.ts b/src/core/tvSettlement.ts
new file mode 100644
index 00000000..afe52f71
--- /dev/null
+++ b/src/core/tvSettlement.ts
@@ -0,0 +1,191 @@
+// ── P18 — the pure money law of `tv-limited-season/v1` (contract §5, §7) ────────────────
+//
+// E = cumulative earned fee (noncash). P = gross commissioning cash received, advance
+// included. R = advance principal returned. Live: R = 0 and a milestone pays
+// max(0, E_new − P). Cancellation freezes U0 = max(0, A − E) and assesses K once; the
+// outstanding refund is max(0, U0 − R), never U0 again after a partial return. Invariant after
+// any settlement attempt: P − R = E + advanceRefundUnpaid and K = paid + unpaid.
+//
+// Pure: no RNG, no clock, no studio id read anywhere in the law (contract §1: the same law
+// and quote for player and rival producers). Errors carry no rival figure.
+
+import { TUNING } from './tuning.js'
+import { TV_COMMISSIONER_ID, TV_RULESET_VERSION } from './tvTypes.js'
+import type { TelevisionRoot, TvAgreement, TvAgreementTerms, TvObligation, TvReceipt } from './tvTypes.js'
+import type { GameState, LedgerEntry } from './types.js'
+
+export function tvTermsFor(commitWeek: number): TvAgreementTerms {
+  if (!Number.isSafeInteger(commitWeek) || commitWeek < 0) throw new Error(`tv settlement: commit week must be a whole week (got ${String(commitWeek)})`)
+  return {
+    fee: TUNING.TV_SEASON_FEE,
+    advance: TUNING.TV_SEASON_ADVANCE,
+    milestones: { scripts: TUNING.TV_MILESTONE_SCRIPTS, pictureLock: TUNING.TV_MILESTONE_PICTURE_LOCK, delivery: TUNING.TV_MILESTONE_DELIVERY },
+    unitSpend: TUNING.TV_UNIT_SPEND,
+    dueWeek: commitWeek + TUNING.TV_DUE_WEEKS,
+    finalWeek: commitWeek + TUNING.TV_FINAL_WEEKS,
+    lateDeductionPerWeek: TUNING.TV_LATE_DEDUCTION_PER_WEEK,
+    lateDeductionMax: TUNING.TV_LATE_DEDUCTION_MAX,
+    cancellationCharge: TUNING.TV_CANCELLATION_CHARGE,
+    distributionWeeks: TUNING.TV_DISTRIBUTION_WEEKS,
+  }
+}
+
+/** Live milestone payment: max(0, E_new − P). Ordinarily scripts pays $0 (the advance recoups). */
+export function tvMilestonePayment(earnedAfter: number, received: number): number {
+  return Math.max(0, earnedAfter - received)
+}
+
+/** 12,000 × max(0, T − (C+16)), at most 48,000. A delivery past C+20 is not priced: it is forbidden. */
+export function tvLateDeduction(terms: TvAgreementTerms, deliveryWeek: number): number {
+  if (!Number.isSafeInteger(deliveryWeek)) throw new Error(`tv settlement: delivery week must be a whole week (got ${String(deliveryWeek)})`)
+  if (deliveryWeek > terms.finalWeek) {
+    throw new Error(`tv settlement: delivery at week ${deliveryWeek} is past the final permitted boundary ${terms.finalWeek}`)
+  }
+  return Math.min(terms.lateDeductionMax, terms.lateDeductionPerWeek * Math.max(0, deliveryWeek - terms.dueWeek))
+}
+
+export function tvDeliveryMilestoneEarned(terms: TvAgreementTerms, deliveryWeek: number): number {
+  return terms.milestones.delivery - tvLateDeduction(terms, deliveryWeek)
+}
+
+export function tvOutstanding(agreement: TvAgreement): { advanceRefund: number; cancellationCharge: number; total: number } {
+  const frozen = agreement.advanceRefundFrozen ?? 0
+  const advanceRefund = Math.max(0, frozen - agreement.advanceReturned)
+  const cancellationCharge = Math.max(0, agreement.cancellationChargeAssessed - agreement.cancellationChargePaid)
+  return { advanceRefund, cancellationCharge, total: advanceRefund + cancellationCharge }
+}
+
+/** Freeze U0 and assess K once. A no-op on anything but a live agreement. */
+export function freezeTvCancellation(agreement: TvAgreement, week: number): TvAgreement {
+  if (agreement.status !== 'live') return agreement
+  return {
+    ...agreement,
+    status: 'cancelled',
+    cancelledWeek: week,
+    advanceRefundFrozen: Math.max(0, agreement.terms.advance - agreement.earned),
+    cancellationChargeAssessed: agreement.terms.cancellationCharge,
+  }
+}
+
+/** Apply a payment to the remaining refund first, then the remaining charge. */
+export function applyTvObligationPayment(agreement: TvAgreement, amount: number): { agreement: TvAgreement; refund: number; charge: number } {
+  if (agreement.status !== 'cancelled') throw new Error('tv settlement: only a cancelled agreement with outstanding obligations accepts a payment')
+  if (!Number.isSafeInteger(amount) || amount <= 0) throw new Error('tv settlement: amount must be a positive whole-dollar integer')
+  const outstanding = tvOutstanding(agreement)
+  if (amount > outstanding.total) throw new Error('tv settlement: amount exceeds the outstanding balance')
+  const refund = Math.min(amount, outstanding.advanceRefund)
+  const charge = amount - refund
+  const next: TvAgreement = {
+    ...agreement,
+    advanceReturned: agreement.advanceReturned + refund,
+    cancellationChargePaid: agreement.cancellationChargePaid + charge,
+  }
+  const settled = tvOutstanding(next).total === 0
+  return { agreement: settled ? { ...next, status: 'settled' } : next, refund, charge }
+}
+
+export function assertTvMoneyInvariant(agreement: TvAgreement): void {
+  const fail = (detail: string): never => { throw new Error(`tv money invariant (${agreement.agreementId}): ${detail}`) }
+  for (const [key, n] of Object.entries({ earned: agreement.earned, received: agreement.received, advanceReturned: agreement.advanceReturned,
+    cancellationChargeAssessed: agreement.cancellationChargeAssessed, cancellationChargePaid: agreement.cancellationChargePaid })) {
+    if (!Number.isSafeInteger(n) || n < 0) fail(`${key} must be a non-negative integer`)
+  }
+  if (agreement.advanceRefundFrozen !== null && (!Number.isSafeInteger(agreement.advanceRefundFrozen) || agreement.advanceRefundFrozen < 0)) {
+    fail('advanceRefundFrozen must be null or a non-negative integer')
+  }
+  if (agreement.earned > agreement.terms.fee) fail('earned exceeds the contracted fee')
+  if (agreement.cancellationChargePaid > agreement.cancellationChargeAssessed) fail('charge paid exceeds the charge assessed')
+  if (agreement.advanceReturned > (agreement.advanceRefundFrozen ?? 0)) fail('advance returned exceeds the frozen refund principal')
+  const outstanding = tvOutstanding(agreement)
+  const unearned = agreement.status === 'live' || agreement.advanceRefundFrozen === null
+    ? Math.max(0, agreement.terms.advance - agreement.earned)
+    : outstanding.advanceRefund
+  if (agreement.received - agreement.advanceReturned !== agreement.earned + unearned) fail('P − R must equal E + the unearned advance')
+  if (agreement.cancellationChargeAssessed !== agreement.cancellationChargePaid + outstanding.cancellationCharge) fail('K must equal paid + unpaid')
+  if (agreement.status === 'live' && (agreement.advanceReturned !== 0 || agreement.cancellationChargeAssessed !== 0 || agreement.advanceRefundFrozen !== null)) {
+    fail('a live agreement has no return, charge or frozen principal')
+  }
+  if (agreement.status === 'settled' && outstanding.total !== 0) fail('a settled agreement has nothing outstanding')
+  if (agreement.status === 'cancelled' && outstanding.total === 0) fail('a cancelled agreement with nothing outstanding is settled')
+  if (agreement.status !== 'live' && agreement.status !== 'settled' && agreement.status !== 'cancelled') fail('unknown status')
+}
+
+/** Every outstanding claim, oldest cancellation first then agreement id — the P15 closed-claims record. */
+export function tvObligations(state: Pick<GameState, 'television'>): TvObligation[] {
+  const rows: TvObligation[] = []
+  const cancelled = state.television.agreements
+    .filter((agreement) => agreement.status === 'cancelled' && agreement.cancelledWeek !== null)
+    .sort((a, b) => (a.cancelledWeek! - b.cancelledWeek!) || (a.agreementId < b.agreementId ? -1 : a.agreementId > b.agreementId ? 1 : 0))
+  for (const agreement of cancelled) {
+    const outstanding = tvOutstanding(agreement)
+    const base = { agreementId: agreement.agreementId, studioId: agreement.studioId, counterpartyId: agreement.commissionerId, cancelledWeek: agreement.cancelledWeek! }
+    if (outstanding.advanceRefund > 0) {
+      rows.push({ ...base, kind: 'advanceRefund', total: agreement.advanceRefundFrozen ?? 0, paid: agreement.advanceReturned, outstanding: outstanding.advanceRefund })
+    }
+    if (outstanding.cancellationCharge > 0) {
+      rows.push({ ...base, kind: 'cancellationCharge', total: agreement.cancellationChargeAssessed, paid: agreement.cancellationChargePaid, outstanding: outstanding.cancellationCharge })
+    }
+  }
+  return rows
+}
+
+/** True while any unpaid refund or cancellation charge stands: no new season may be admitted. */
+export function tvArrearsOutstanding(state: Pick<GameState, 'television'>): number {
+  return tvObligations(state).reduce((sum, row) => sum + row.outstanding, 0)
+}
+
+// ── receipts and ledger rows: the two correlated records every payment writes ──────────
+
+export type TvReceiptDraft = Omit<TvReceipt, 'receiptId'>
+
+export function appendTvReceipt(root: TelevisionRoot, draft: TvReceiptDraft): TelevisionRoot {
+  const receiptId = `tv-receipt-${String(root.nextReceipt).padStart(4, '0')}`
+  return { ...root, nextReceipt: root.nextReceipt + 1, receipts: [...root.receipts, { ...draft, receiptId } as TvReceipt] }
+}
+
+export function tvLedgerRow(week: number, kind: LedgerEntry['kind'] & `tv${string}`, amount: number, agreementId: string, note: string): LedgerEntry {
+  if (!Number.isSafeInteger(amount) || amount === 0) throw new Error(`tv ledger: ${kind} amount must be a non-zero whole-dollar integer`)
+  return { week, kind, amount, note, tvAgreementId: agreementId } as LedgerEntry
+}
+
+export type SettleTvObligationsRequest = { agreementId: string; expectedRemaining: number; amount: number }
+
+/** The public `settleTvObligations` refusal, or null. Reads no closure root: the parent gates actual closure. */
+export function settleTvObligationsRefusal(state: GameState, request: SettleTvObligationsRequest): string | null {
+  const agreement = state.television.agreements.find((row) => row.agreementId === request.agreementId)
+  if (agreement === undefined) return `no TV agreement "${request.agreementId}"`
+  if (agreement.status !== 'cancelled') return `agreement "${request.agreementId}" has no outstanding obligation (status ${agreement.status})`
+  const remaining = tvOutstanding(agreement).total
+  if (!Number.isSafeInteger(request.expectedRemaining) || request.expectedRemaining !== remaining) {
+    return `expectedRemaining ${String(request.expectedRemaining)} is stale; the outstanding balance of "${request.agreementId}" differs`
+  }
+  if (!Number.isSafeInteger(request.amount) || request.amount <= 0) return 'amount must be a positive whole-dollar integer'
+  if (request.amount > remaining) return `amount ${request.amount} exceeds the outstanding balance`
+  const available = Math.max(0, state.studio.cash)
+  if (request.amount > available) return `amount ${request.amount} exceeds available nonnegative cash`
+  return null
+}
+
+/** Pay a lawful portion: refund first, then the charge; exact receipts; no interest, refinancing or forgiveness. */
+export function settleTvObligations(state: GameState, request: SettleTvObligationsRequest): GameState {
+  const refusal = settleTvObligationsRefusal(state, request)
+  if (refusal !== null) throw new Error(`applyActions: settleTvObligations rejected — ${refusal}`)
+  const week = state.market.tick
+  const agreement = state.television.agreements.find((row) => row.agreementId === request.agreementId)!
+  const paid = applyTvObligationPayment(agreement, request.amount)
+  assertTvMoneyInvariant(paid.agreement)
+  let root: TelevisionRoot = { ...state.television, agreements: state.television.agreements.map((row) => row === agreement ? paid.agreement : row) }
+  const ledger: LedgerEntry[] = []
+  const outstanding = tvOutstanding(paid.agreement)
+  if (paid.refund > 0) {
+    ledger.push(tvLedgerRow(week, 'tvAdvanceRefund', -paid.refund, agreement.agreementId, `tv advance refund ${agreement.agreementId}`))
+    root = appendTvReceipt(root, { kind: 'advanceRefundPaid', week, seasonId: agreement.seasonId, agreementId: agreement.agreementId, amount: paid.refund, remaining: outstanding.advanceRefund })
+  }
+  if (paid.charge > 0) {
+    ledger.push(tvLedgerRow(week, 'tvCancellationCharge', -paid.charge, agreement.agreementId, `tv cancellation charge ${agreement.agreementId}`))
+    root = appendTvReceipt(root, { kind: 'cancellationChargePaid', week, seasonId: agreement.seasonId, agreementId: agreement.agreementId, amount: paid.charge, remaining: outstanding.cancellationCharge })
+  }
+  return { ...state, television: root, studio: { ...state.studio, cash: state.studio.cash - request.amount }, ledger: [...state.ledger, ...ledger] }
+}
+
+export { TV_COMMISSIONER_ID, TV_RULESET_VERSION }
