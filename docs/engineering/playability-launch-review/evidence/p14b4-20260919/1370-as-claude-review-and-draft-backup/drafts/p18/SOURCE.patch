+
+  it('a settled or live agreement refuses settlement; a cash-bounded request can never drive cash negative', () => {
+    const { committedState, C } = committed()
+    const delivered = deliver(committedState, C)
+    const agreementId = tv(delivered).agreements[0]!.agreementId
+    expect(() => applyActions(delivered, [{ kind: 'settleTvObligations', agreementId, expectedRemaining: 0, amount: 1 }])).toThrow()
+    expect(() => applyActions(committedState, [{ kind: 'settleTvObligations', agreementId, expectedRemaining: 0, amount: 1 }])).toThrow()
+    expect(() => applyActions(committedState, [{ kind: 'settleTvObligations', agreementId: 'tv-agreement-9999', expectedRemaining: 0, amount: 1 }])).toThrow(/agreement/)
+  })
+})
+
+describe('P18 shared capacity — films and the season see each other', () => {
+  it('a film whose sound chain is the stage the season holds waits on soundstage capacity until the season wraps', () => {
+    const { committedState, roster, adoptionId, C } = committed()
+    let state = ticks(committedState, 5) // T = C+5: the season holds Soundstage 12 and its set (rehearsal done, shooting begins)
+    const seasonId = liveSeason(state).seasonId
+    expect(seasonById(state, seasonId).reservations.some((r) => r.facilityId === SOUND_STAGE)).toBe(true)
+    const exclude = new Set([roster.writerId, roster.directorId, roster.craftId, ...Object.values(roster.cast)])
+    const film = greenlightSoundFilm(state, adoptionId, exclude)
+    state = film.state
+    // development (8), pre-production (7), then the rehearsal entry needs Soundstage 12: blocked while the season holds it
+    state = ticks(state, 3)
+    const workflow = () => state.operations.workflows.find((w) => w.productionId === film.productionId)!
+    expect(workflow().blocker).toEqual({ kind: 'facility-capacity', capability: 'soundstage', targetPhase: 'rehearsal' })
+    expect(() => assertNoDoubleBookedResourceSlots(state)).not.toThrow()
+    // once shooting completes the season releases the stage; the film takes it in the same visible week's sweep
+    state = tickUntil(state, (s) => seasonById(s, seasonId).work.block === 'post', 12, 'season post block')
+    expect(seasonById(state, seasonId).reservations.some((r) => r.facilityId === SOUND_STAGE)).toBe(false)
+    state = tick(state)
+    expect(workflow().phase).toBe('rehearsal')
+    expect(workflow().reservations.some((r) => r.facilityId === SOUND_STAGE)).toBe(true)
+    expect(() => assertNoDoubleBookedResourceSlots(state)).not.toThrow()
+    expect(C).toBeLessThan(state.market.tick)
+  })
+
+  it('a film holding the sound stage first makes the season stall on soundstage capacity, then the season recovers when the film wraps', () => {
+    const { committedState, roster, adoptionId } = committed()
+    const exclude = new Set([roster.writerId, roster.directorId, roster.craftId, ...Object.values(roster.cast)])
+    const film = greenlightSoundFilm(committedState, adoptionId, exclude)
+    let state = film.state
+    const seasonId = liveSeason(state).seasonId
+    // the film reaches rehearsal at the C+2→C+3 advance and keeps the stage through shooting; the season needs it at C+4→C+5
+    state = ticks(state, 5)
+    const season = seasonById(state, seasonId)
+    expect(season.work).toMatchObject({ block: 'rehearsal', creditedUnits: 4 })
+    expect(season.work.stall).toEqual({ kind: 'facility-capacity', capability: 'soundstage' })
+    expect(state.operations.workflows.find((w) => w.productionId === film.productionId)!.reservations.some((r) => r.facilityId === SOUND_STAGE)).toBe(true)
+    expect(() => assertNoDoubleBookedResourceSlots(state)).not.toThrow()
+    // the film needs its Director's take to shoot; schedule it so the picture wraps and the stage comes back
+    const production = state.studio.activeProductions.find((p) => p.id === film.productionId)!
+    state = tickUntil(state, (s) => s.studio.activeProductions.find((p) => p.id === film.productionId)!.remainingTicks === 5, 10, 'film shooting entry')
+    state = tickUntil(state, (s) => s.operations.workflows.find((w) => w.productionId === film.productionId)!.blocker === null
+      && s.operations.workflows.find((w) => w.productionId === film.productionId)!.shootingTask?.status === 'unassigned', 10, 'film take ready to assign')
+    state = applyActions(state, [{ kind: 'assignShootingDirector', productionId: film.productionId, directorId: production.directorId }])
+    state = tickUntil(state, (s) => s.operations.workflows.find((w) => w.productionId === film.productionId)!.shootingTask?.status === 'ready', 10, 'scenery arrived')
+    state = applyActions(state, [{ kind: 'scheduleShootingTake', productionId: film.productionId }])
+    state = tickUntil(state, (s) => seasonById(s, seasonId).work.creditedUnits >= 5, 12, 'season rehearsal unit after the film wraps')
+    expect(seasonById(state, seasonId).reservations.some((r) => r.facilityId === SOUND_STAGE)).toBe(true)
+    expect(() => assertNoDoubleBookedResourceSlots(state)).not.toThrow()
+  })
+})
