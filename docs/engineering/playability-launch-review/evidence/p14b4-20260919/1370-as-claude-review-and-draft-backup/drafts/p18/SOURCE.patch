+++ b/tests/helpers/p18-fixtures.ts
@@ -0,0 +1,178 @@
+// ── P18 bounded first season — shared RED fixtures (1370-ar-p18, 2026-10-10) ──
+//
+// Authority: `1367-stage/p18-prep/P18-FIRST-SEASON-CONTRACT.md` (adopted 1367-G under
+// 1342-O ruling 10). Every state below is driven through real engine actions and `tick`:
+// nothing is hand-shaped. The natural route to an admissible setup is
+//   p13aGeneratedStudio -> advance to the synchronized-sound commercial week ->
+//   purchaseTechnology -> adoptSynchronizedSound (stage 12 + Post) -> tick until the
+//   chain is operational -> sign six distinct idle people on 208-week contracts.
+// The TV grant is the injected `TvGrantFacts` adapter (P16 is not landed at this base);
+// the ids are opaque strings the engine validates for exact identity and window cover.
+
+import { expect } from 'vitest'
+import { applyActions } from '../../src/core/actions.js'
+import { hiringMarketIds } from '../../src/core/employment.js'
+import { stableStringify } from '../../src/core/save.js'
+import { adoptionChainOperational } from '../../src/core/technologyAdoption.js'
+import { technologyEntry } from '../../src/core/technologyCatalogue.js'
+import { tick } from '../../src/core/tick.js'
+import { TV_COMMISSIONER_ID } from '../../src/core/tvTypes.js'
+import type {
+  CommissionTvSeasonPayload,
+  TelevisionRoot,
+  TvAgreement,
+  TvGrantFacts,
+  TvRoster,
+  TvSeason,
+} from '../../src/core/tvTypes.js'
+import type { CreativeRole, GameState, LedgerEntry } from '../../src/core/types.js'
+import { advanceTo, p13aGeneratedStudio } from '../../src/harness/p13a/fixtures.js'
+
+export const SEED = 'p18-first-season-01'
+export const SOUND_STAGE = 'facility-soundstage-12'
+export const POST = 'facility-post-building'
+export const PROPERTY_ID = 'property-p16-adapter-0001'
+export const PRODUCTION_AUTHORITY_ID = 'p16-authority-production-0001'
+export const DISTRIBUTION_AUTHORITY_ID = 'p16-authority-distribution-0001'
+
+export const clone = <T>(value: T): T => structuredClone(value)
+export const player = (state: GameState): string => state.hollywood!.playerStudioId
+export const sig = (value: unknown): string => stableStringify(value)
+
+export type TvRouteFixture = {
+  state: GameState
+  roster: TvRoster
+  adoptionId: string
+}
+
+function signRole(state: GameState, role: CreativeRole, taken: ReadonlySet<string>, termWeeks = 208): { state: GameState; id: string } {
+  for (let i = 0; i < 80; i++) {
+    const id = hiringMarketIds(state, state.market.tick)
+      .find((candidate) => !taken.has(candidate) && state.talent.find((p) => p.id === candidate)?.role === role)
+    if (id !== undefined) {
+      return { state: applyActions(state, [{ kind: 'signContract', talentId: id, termWeeks }]), id }
+    }
+    state = tick(state)
+  }
+  throw new Error(`p18 fixture: no signable ${role} within 80 weeks`)
+}
+
+export function adoptionOperational(state: GameState, adoptionId: string): boolean {
+  const adoption = state.technology.adoptions.find((a) => a.id === adoptionId)
+  return adoption !== undefined && adoptionChainOperational(state, adoption)
+}
+
+let cache: TvRouteFixture | undefined
+
+/** The natural route, built once per test file and cloned on every read. */
+export function tvNaturalStudio(): TvRouteFixture {
+  if (cache === undefined) {
+    let state = p13aGeneratedStudio(SEED)
+    state = applyActions(state, [{ kind: 'activateScriptDevelopment' }, { kind: 'activateCastingSessions' }])
+    state = advanceTo(state, technologyEntry('synchronized-sound').commercialWeek)
+    state = applyActions(state, [{ kind: 'purchaseTechnology', technologyId: 'synchronized-sound' }])
+    state = applyActions(state, [{ kind: 'adoptSynchronizedSound', stageFacilityId: SOUND_STAGE, postFacilityId: POST }])
+    const adoption = state.technology.adoptions.find((a) => a.studioId === player(state) && a.stageFacilityId === SOUND_STAGE)
+    if (adoption === undefined) throw new Error('p18 fixture: the sound adoption was not recorded')
+    for (let guard = 0; !adoptionOperational(state, adoption.id); guard++) {
+      if (guard > 60) throw new Error('p18 fixture: the sound chain did not become operational within 60 weeks')
+      state = tick(state)
+    }
+    const taken = new Set<string>()
+    const pick = (role: CreativeRole): string => {
+      const signed = signRole(state, role, taken)
+      state = signed.state
+      taken.add(signed.id)
+      return signed.id
+    }
+    const writerId = pick('writer')
+    const directorId = pick('director')
+    const lead = pick('actor')
+    const antagonist = pick('actor')
+    const support = pick('actor')
+    const craftId = pick('craft')
+    cache = { state, roster: { writerId, directorId, cast: { lead, antagonist, support }, craftId }, adoptionId: adoption.id }
+  }
+  return { state: clone(cache.state), roster: clone(cache.roster), adoptionId: cache.adoptionId }
+}
+
+export function grantFor(state: GameState, commitWeek: number, overrides: Partial<TvGrantFacts> = {}): TvGrantFacts {
+  return {
+    propertyId: PROPERTY_ID,
+    producerStudioId: player(state),
+    productionAuthorityId: PRODUCTION_AUTHORITY_ID,
+    productionEndExclusive: commitWeek + 21,
+    commissionerId: TV_COMMISSIONER_ID,
+    distributionAuthorityId: DISTRIBUTION_AUTHORITY_ID,
+    distributionEndExclusive: commitWeek + 72,
+    ...overrides,
+  }
+}
+
+export function payloadFor(fixture: TvRouteFixture, overrides: Partial<CommissionTvSeasonPayload> = {}): CommissionTvSeasonPayload {
+  return {
+    series: { kind: 'new', title: 'The Long Night' },
+    propertyId: PROPERTY_ID,
+    originProductionId: null,
+    grant: grantFor(fixture.state, fixture.state.market.tick),
+    roster: fixture.roster,
+    adoptionId: fixture.adoptionId,
+    ...overrides,
+  }
+}
+
+export function commission(fixture: TvRouteFixture, overrides: Partial<CommissionTvSeasonPayload> = {}): GameState {
+  return applyActions(fixture.state, [{ kind: 'commissionTvSeason', commission: payloadFor(fixture, overrides) }])
+}
+
+export function tv(state: GameState): TelevisionRoot {
+  const root = (state as GameState & { television?: TelevisionRoot }).television
+  if (root === undefined) throw new Error('RED (P18): state.television root is absent')
+  return root
+}
+
+export function liveSeason(state: GameState): TvSeason {
+  const season = tv(state).seasons.find((s) => s.status === 'live')
+  if (season === undefined) throw new Error('p18 fixture: no live season')
+  return season
+}
+
+export function seasonById(state: GameState, seasonId: string): TvSeason {
+  const season = tv(state).seasons.find((s) => s.seasonId === seasonId)
+  if (season === undefined) throw new Error(`p18 fixture: no season ${seasonId}`)
+  return season
+}
+
+export function agreementOf(state: GameState, season: TvSeason): TvAgreement {
+  const agreement = tv(state).agreements.find((a) => a.agreementId === season.agreementId)
+  if (agreement === undefined) throw new Error(`p18 fixture: no agreement ${season.agreementId}`)
+  return agreement
+}
+
+export function tvRows(state: GameState, kind?: LedgerEntry['kind']): LedgerEntry[] {
+  return state.ledger.filter((row) => row.kind.startsWith('tv') && (kind === undefined || row.kind === kind))
+}
+
+export function receipts(state: GameState, kind?: string) {
+  return tv(state).receipts.filter((r) => kind === undefined || r.kind === kind)
+}
+
+export function ticks(state: GameState, n: number): GameState {
+  for (let i = 0; i < n; i++) state = tick(state)
+  return state
+}
+
+export function tickUntil(state: GameState, done: (s: GameState) => boolean, maxTicks: number, label: string): GameState {
+  for (let i = 0; i < maxTicks; i++) {
+    if (done(state)) return state
+    state = tick(state)
+  }
+  if (done(state)) return state
+  throw new Error(`p18 fixture: ${label} not reached within ${maxTicks} ticks`)
+}
+
+/** The six people are a studio's contracted roster and each other's only colleagues. */
+export function expectRosterDistinct(roster: TvRoster): void {
+  const ids = [roster.writerId, roster.directorId, roster.cast.lead, roster.cast.antagonist, roster.cast.support, roster.craftId]
+  expect(new Set(ids).size).toBe(6)
+}
