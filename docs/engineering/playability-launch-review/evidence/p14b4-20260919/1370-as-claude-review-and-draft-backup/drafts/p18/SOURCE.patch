+    const renewed = applyActions(third, [{ kind: 'commissionTvSeason', commission: payloadFor({ ...fixture, state: third }, { grant: grantFor(third, third.market.tick) }) }])
+    expect(liveSeason(renewed).seasonId).toBe('tv-season-0002')
+    roundTrips(second)
+    roundTrips(renewed)
