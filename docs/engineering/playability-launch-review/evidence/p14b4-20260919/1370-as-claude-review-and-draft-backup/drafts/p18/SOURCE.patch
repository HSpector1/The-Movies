+    for (const id of [roster.writerId, roster.directorId, roster.craftId, ...Object.values(roster.cast)]) expect(busyTalentIds(state).has(id)).toBe(false)
+    expect(() => applyActions(state, [{ kind: 'cancelTvSeason', seasonId }])).toThrow(/not live/)
+    // the cancelled identities stay reserved; a fresh commitment mints the next ids and may continue the series
+    const fixture = tvNaturalStudio()
+    const again = applyActions(state, [{ kind: 'commissionTvSeason', commission: payloadFor({ ...fixture, state }, {
+      series: { kind: 'existing', seriesId: season.seriesId }, grant: grantFor(state, state.market.tick) }) }])
+    const next = liveSeason(again)
+    expect(next.seasonId).toBe('tv-season-0002')
+    expect(next.agreementId).toBe('tv-agreement-0002')
+    expect(next.seriesId).toBe(season.seriesId)
+    expect(next.seasonNumber).toBe(2)
+    expect(tv(again).series[0]!.seasonIds).toEqual(['tv-season-0001', 'tv-season-0002'])
+    expect(tv(again).seasons).toHaveLength(2)
+    roundTrips(again)
+  })
+
+  it('two series with the same title are two identities', () => {
+    const { committedState } = committed()
+    const cancelled = applyActions(committedState, [{ kind: 'cancelTvSeason', seasonId: 'tv-season-0001' }])
+    const fixture = tvNaturalStudio()
+    const again = applyActions(cancelled, [{ kind: 'commissionTvSeason', commission: payloadFor({ ...fixture, state: cancelled }, {
+      series: { kind: 'new', title: 'The Long Night' }, grant: grantFor(cancelled, cancelled.market.tick) }) }])
+    expect(tv(again).series.map((s) => s.seriesId)).toEqual(['tv-series-0001', 'tv-series-0002'])
+    expect(tv(again).series.map((s) => s.title)).toEqual(['The Long Night', 'The Long Night'])
+  })
+
+  it('an unrecoverable participant loss cancels on the next advance with everything incurred retained', () => {
+    const { committedState, roster, C } = committed()
+    const working = ticks(committedState, 2)
+    const seasonId = liveSeason(working).seasonId
+    const released = applyActions(working, [{ kind: 'releaseTalent', talentId: roster.directorId }])
+    const state = tick(released)
+    const season = seasonById(state, seasonId)
+    expect(season.status).toBe('cancelled')
+    expect(season.cancellationCause).toBe('participantLost')
+    expect(season.cancelledWeek).toBe(C + 3)
+    expect(season.work.creditedUnits).toBe(2)
+    expect(tvRows(state, 'tvProductionSpend')).toHaveLength(2)
+    const agreement = agreementOf(state, season)
+    expect(agreement).toMatchObject({ earned: 0, advanceRefundFrozen: 120_000, cancellationChargeAssessed: 120_000 })
+    expect(agreement.milestones).toEqual([])
+    expect(season.credits.map((c) => c.talentId)).toContain(roster.directorId)
+  })
+
+  it('arrears: the closure path records exact unpaid obligations, admission refuses, and settlement pays refund first with stale and over-cash requests refused', () => {
+    const { committedState } = committed()
+    const working = tick(committedState)
+    const seasonId = liveSeason(working).seasonId
+    const week = working.market.tick
+    const state = cancelTvSeasonWithoutPayment(working, seasonId, week, 'closure')
+    const season = seasonById(state, seasonId)
+    expect(season.status).toBe('cancelled')
+    expect(season.cancellationCause).toBe('closure')
+    const agreement = agreementOf(state, season)
+    expect(agreement).toMatchObject({ advanceReturned: 0, cancellationChargePaid: 0, advanceRefundFrozen: 120_000, cancellationChargeAssessed: 120_000 })
+    expect(state.studio.cash).toBe(working.studio.cash)
+    expect(tvRows(state)).toHaveLength(tvRows(working).length)
+    expect(tvObligations(state)).toEqual([
+      { agreementId: agreement.agreementId, studioId: player(state), counterpartyId: TV_COMMISSIONER_ID, kind: 'advanceRefund', total: 120_000, paid: 0, outstanding: 120_000, cancelledWeek: week },
+      { agreementId: agreement.agreementId, studioId: player(state), counterpartyId: TV_COMMISSIONER_ID, kind: 'cancellationCharge', total: 120_000, paid: 0, outstanding: 120_000, cancelledWeek: week },
+    ])
+    const fixture = tvNaturalStudio()
+    expect(() => applyActions(state, [{ kind: 'commissionTvSeason', commission: payloadFor({ ...fixture, state }, { grant: grantFor(state, week) }) }]))
+      .toThrow(/outstanding/)
+    const settle = (s: GameState, expectedRemaining: number, amount: number) =>
+      applyActions(s, [{ kind: 'settleTvObligations', agreementId: agreement.agreementId, expectedRemaining, amount }])
+    expect(() => settle(state, 240_001, 1)).toThrow(/expectedRemaining/)
+    expect(() => settle(state, 240_000, 0)).toThrow(/amount/)
+    expect(() => settle(state, 240_000, 240_001)).toThrow(/amount/)
+    expect(() => settle(state, 240_000, 1.5)).toThrow(/amount/)
+    const first = settle(state, 240_000, 50_000)
+    expect(agreementOf(first, season)).toMatchObject({ advanceReturned: 50_000, cancellationChargePaid: 0 })
+    expect(tvRows(first, 'tvAdvanceRefund')).toEqual([expect.objectContaining({ amount: -50_000 })])
+    expect(first.studio.cash).toBe(state.studio.cash - 50_000)
+    // the same request again is stale: the balance moved, nothing mutates
+    expect(() => settle(first, 240_000, 50_000)).toThrow(/expectedRemaining/)
+    const second = settle(first, 190_000, 100_000)
+    expect(agreementOf(second, season)).toMatchObject({ advanceReturned: 120_000, cancellationChargePaid: 30_000 })
+    expect(tvRows(second, 'tvAdvanceRefund').reduce((sum, r) => sum + r.amount, 0)).toBe(-120_000)
+    expect(tvRows(second, 'tvCancellationCharge')).toEqual([expect.objectContaining({ amount: -30_000 })])
+    expect(tvObligations(second).map((o) => o.outstanding)).toEqual([0, 90_000].filter((n) => n > 0))
+    expect(() => applyActions(second, [{ kind: 'commissionTvSeason', commission: payloadFor({ ...fixture, state: second }, { grant: grantFor(second, second.market.tick) }) }]))
+      .toThrow(/outstanding/)
+    const third = settle(second, 90_000, 90_000)
+    expect(agreementOf(third, season).status).toBe('settled')
