+// ── P18 bounded first season — the pure money law (contract §5, §7) ─────────────────────
+//
+// Earned fee E is a noncash fact; P is gross commissioning cash received (advance included);
+// R is advance principal returned. Live milestone payment is max(0, E_new − P). Cancellation
+// freezes U0 = max(0, A − E); outstanding refund is max(0, U0 − R); K is assessed once.
+// Invariant after any settlement attempt: P − R = E + advanceRefundUnpaid and
+// K = cancellationChargePaid + cancellationChargeUnpaid. The law reads no studio id: the same
+// functions settle a rival-shaped agreement (contract §1 "same law and quote").
+import { describe, expect, it } from 'vitest'
+import { TUNING } from '../src/core/tuning.js'
+import {
+  applyTvObligationPayment,
+  assertTvMoneyInvariant,
+  freezeTvCancellation,
+  tvDeliveryMilestoneEarned,
+  tvLateDeduction,
+  tvMilestonePayment,
+  tvOutstanding,
+  tvTermsFor,
+} from '../src/core/tvSettlement.js'
+import type { TvAgreement } from '../src/core/tvTypes.js'
+
+const C = 1000
+
+function liveAgreement(studioId = 'studio-x-player', earned = 0, received = TUNING.TV_SEASON_ADVANCE): TvAgreement {
+  return {
+    agreementId: 'tv-agreement-0001',
+    seasonId: 'tv-season-0001',
+    studioId,
+    commissionerId: 'p18-limited-season-commissioner-v1',
+    rulesetVersion: 'tv-limited-season/v1',
+    terms: tvTermsFor(C),
+    earned,
+    received,
+    advanceReturned: 0,
+    advanceRefundFrozen: null,
+    cancellationChargeAssessed: 0,
+    cancellationChargePaid: 0,
+    milestones: [],
+    status: 'live',
+    cancelledWeek: null,
+  }
+}
+
+describe('P18 terms and milestone arithmetic', () => {
+  it('terms for a commitment week are the contract table with integer boundaries', () => {
+    const terms = tvTermsFor(C)
+    expect(terms).toEqual({
+      fee: 600_000,
+      advance: 120_000,
+      milestones: { scripts: 120_000, pictureLock: 240_000, delivery: 240_000 },
+      unitSpend: 25_000,
+      dueWeek: C + 16,
+      finalWeek: C + 20,
+      lateDeductionPerWeek: 12_000,
+      lateDeductionMax: 48_000,
+      cancellationCharge: 120_000,
+      distributionWeeks: 52,
+    })
+  })
+
+  it('live milestone payment is max(0, E_new − P): scripts consumes the advance, picture lock and delivery pay their increments', () => {
+    expect(tvMilestonePayment(120_000, 120_000)).toBe(0)
+    expect(tvMilestonePayment(360_000, 120_000)).toBe(240_000)
+    expect(tvMilestonePayment(600_000, 360_000)).toBe(240_000)
+    expect(tvMilestonePayment(576_000, 360_000)).toBe(216_000)
+    expect(tvMilestonePayment(100_000, 120_000)).toBe(0)
+  })
+
+  it('late deduction is 12,000 × max(0, T − (C+16)), capped at 48,000; delivery at C+16 is on time', () => {
+    const terms = tvTermsFor(C)
+    expect(tvLateDeduction(terms, C + 12)).toBe(0)
+    expect(tvLateDeduction(terms, C + 16)).toBe(0)
+    expect(tvLateDeduction(terms, C + 17)).toBe(12_000)
+    expect(tvLateDeduction(terms, C + 18)).toBe(24_000)
+    expect(tvLateDeduction(terms, C + 20)).toBe(48_000)
+    expect(tvDeliveryMilestoneEarned(terms, C + 16)).toBe(240_000)
+    expect(tvDeliveryMilestoneEarned(terms, C + 18)).toBe(216_000)
+    expect(tvDeliveryMilestoneEarned(terms, C + 20)).toBe(192_000)
+    // C+21 is forbidden: the law refuses to price a delivery past the final boundary
+    expect(() => tvLateDeduction(terms, C + 21)).toThrow(/final/)
+  })
+
+  it('the worked contract examples reconcile: on-time E=P=600,000; C+18 E=P=576,000 with the 24,000 reduction', () => {
+    const terms = tvTermsFor(C)
+    const onTime = terms.milestones.scripts + terms.milestones.pictureLock + tvDeliveryMilestoneEarned(terms, C + 16)
+    expect(onTime).toBe(600_000)
+    const late = terms.milestones.scripts + terms.milestones.pictureLock + tvDeliveryMilestoneEarned(terms, C + 18)
+    expect(late).toBe(576_000)
+    expect(600_000 - late).toBe(24_000)
+  })
+})
+
+describe('P18 cancellation freeze and settlement ordering', () => {
+  it('before the first milestone: E=0, P=120,000, refund obligation 120,000 and K=120,000', () => {
+    const frozen = freezeTvCancellation(liveAgreement(), C + 1)
+    expect(frozen.status).toBe('cancelled')
+    expect(frozen.cancelledWeek).toBe(C + 1)
+    expect(frozen.advanceRefundFrozen).toBe(120_000)
+    expect(frozen.cancellationChargeAssessed).toBe(120_000)
+    expect(tvOutstanding(frozen)).toEqual({ advanceRefund: 120_000, cancellationCharge: 120_000, total: 240_000 })
+    assertTvMoneyInvariant(frozen)
+  })
+
+  it('after scripts: U0 = 0 (the advance is earned), K = 120,000; after picture lock E=P=360,000, U=0, K=120,000', () => {
+    const afterScripts = freezeTvCancellation(liveAgreement('studio-x-player', 120_000, 120_000), C + 4)
+    expect(afterScripts.advanceRefundFrozen).toBe(0)
+    expect(tvOutstanding(afterScripts)).toEqual({ advanceRefund: 0, cancellationCharge: 120_000, total: 120_000 })
+    const afterLock = freezeTvCancellation(liveAgreement('studio-x-player', 360_000, 360_000), C + 10)
+    expect(afterLock.earned).toBe(360_000)
+    expect(afterLock.received).toBe(360_000)
+    expect(afterLock.advanceRefundFrozen).toBe(0)
+    expect(afterLock.cancellationChargeAssessed).toBe(120_000)
+    assertTvMoneyInvariant(afterLock)
+  })
+
+  it('freezing twice is a no-op: K is assessed once and U0 never moves', () => {
+    const once = freezeTvCancellation(liveAgreement(), C + 1)
+    const twice = freezeTvCancellation(once, C + 2)
+    expect(twice).toEqual(once)
+  })
+
+  it('a payment applies to the remaining refund first, then the charge; a partial return never restores U0', () => {
+    const frozen = freezeTvCancellation(liveAgreement(), C + 1)
+    const first = applyTvObligationPayment(frozen, 50_000)
+    expect(first).toMatchObject({ refund: 50_000, charge: 0 })
+    expect(first.agreement.advanceReturned).toBe(50_000)
+    expect(tvOutstanding(first.agreement)).toEqual({ advanceRefund: 70_000, cancellationCharge: 120_000, total: 190_000 })
+    assertTvMoneyInvariant(first.agreement)
+    const second = applyTvObligationPayment(first.agreement, 100_000)
+    expect(second).toMatchObject({ refund: 70_000, charge: 30_000 })
+    expect(second.agreement.advanceReturned).toBe(120_000)
+    expect(second.agreement.cancellationChargePaid).toBe(30_000)
+    expect(tvOutstanding(second.agreement)).toEqual({ advanceRefund: 0, cancellationCharge: 90_000, total: 90_000 })
+    assertTvMoneyInvariant(second.agreement)
+    const third = applyTvObligationPayment(second.agreement, 90_000)
+    expect(third.agreement.status).toBe('settled')
+    expect(tvOutstanding(third.agreement).total).toBe(0)
+    assertTvMoneyInvariant(third.agreement)
+    // P − R = E + advanceRefundUnpaid at every step
+    for (const a of [frozen, first.agreement, second.agreement, third.agreement]) {
+      expect(a.received - a.advanceReturned).toBe(a.earned + tvOutstanding(a).advanceRefund)
+      expect(a.cancellationChargeAssessed).toBe(a.cancellationChargePaid + tvOutstanding(a).cancellationCharge)
+    }
+  })
+
+  it('refuses a non-positive, non-integer or over-balance amount, and a payment against a live agreement', () => {
+    const frozen = freezeTvCancellation(liveAgreement(), C + 1)
+    expect(() => applyTvObligationPayment(frozen, 0)).toThrow()
+    expect(() => applyTvObligationPayment(frozen, -1)).toThrow()
+    expect(() => applyTvObligationPayment(frozen, 10.5)).toThrow()
+    expect(() => applyTvObligationPayment(frozen, 240_001)).toThrow()
+    expect(() => applyTvObligationPayment(liveAgreement(), 1)).toThrow()
+  })
+
+  it('the same economics for a rival-shaped agreement: the law reads no studio id', () => {
+    const rival = freezeTvCancellation(liveAgreement('studio-x-r03', 120_000, 120_000), C + 5)
+    const playerSide = freezeTvCancellation(liveAgreement('studio-x-player', 120_000, 120_000), C + 5)
+    expect({ ...rival, studioId: 'same' }).toEqual({ ...playerSide, studioId: 'same' })
+    expect(applyTvObligationPayment(rival, 40_000).charge).toBe(40_000)
+  })
+
+  it('the invariant assertion refuses a forged agreement', () => {
+    const forged = { ...freezeTvCancellation(liveAgreement(), C + 1), advanceReturned: 130_000 }
+    expect(() => assertTvMoneyInvariant(forged)).toThrow()
+  })
+})
diff --git a/tests/p18-first-season-tuning.test.ts b/tests/p18-first-season-tuning.test.ts
