@@ -0,0 +1,709 @@
+// ── P18 bounded first season — the measured route (contract §3–§9; 1367-G boundaries; ruling 10) ──
+//
+// One natural fixture (tests/helpers/p18-fixtures.ts) built once per file and cloned per leaf:
+// commercial synchronized-sound purchase at its own commercial week, a real adoption on
+// Soundstage 12 + Post, six studio-contracted idle people. The TV grant is the injected
+// `TvGrantFacts` adapter (P16 absent at this base; see REPORT "adapter"). Every leaf drives the
+// live engine through `applyActions` and `tick`; nothing is hand-shaped except the one disclosed
+// cash bootstrap row the affordability-refusal leaf uses (the p14b2 house pattern) and the
+// explicit no-payment cancellation (the exported P15B closure path) the arrears leaves use.
+//
+// RED MECHANISM: `src/core/tvTypes.ts`, `tvSeason.ts`, `tvCommission.ts`, `tvSettlement.ts`,
+// `tvDistribution.ts` and the three actions do not exist at the base; the helper import fails
+// this whole file by name.
+import { describe, expect, it } from 'vitest'
+import { applyActions } from '../src/core/actions.js'
+import { busyTalentIds, freelancerMarketIds } from '../src/core/employment.js'
+import { assertNoDoubleBookedResourceSlots, occupiedResourceSlots, resourceClaimsOf } from '../src/core/occupancy.js'
+import { persistedProductionIds } from '../src/core/productionIdentity.js'
+import { exportCurrentState, importSave, LIVE_SAVE_VERSION, makeSave, migrateToLive, stableStringify } from '../src/core/save.js'
+import { facilityBodyCentre, gridDistance, sceneryLoadInWeeksForDistance } from '../src/core/sceneryLoadIn.js'
+import { setById } from '../src/core/sets.js'
+import { tick } from '../src/core/tick.js'
+import { SET_BLUEPRINTS, TUNING } from '../src/core/tuning.js'
+import { tvAdmissionQuote, tvCommissionPreview } from '../src/core/tvCommission.js'
+import { televisionPublicView, tvSeasonAvailableAt } from '../src/core/tvDistribution.js'
+import { cancelTvSeasonWithoutPayment, televisionOccupiedFacilitySlots } from '../src/core/tvSeason.js'
+import { tvObligations, tvOutstanding } from '../src/core/tvSettlement.js'
+import { TV_COMMISSIONER_ID, TV_RULESET_VERSION } from '../src/core/tvTypes.js'
+import type { CastSlot, GameState, SegmentId } from '../src/core/types.js'
+import {
+  agreementOf, clone, commission, expectRosterDistinct, grantFor, liveSeason, payloadFor, player, POST, PRODUCTION_AUTHORITY_ID,
+  receipts, seasonById, sig, SOUND_STAGE, tickUntil, ticks, tv, tvNaturalStudio, tvRows, type TvRouteFixture,
+} from './helpers/p18-fixtures.js'
+
+/** The fixture's six people, the commit week and the scenery load-in the engine's own geometry implies. */
+function base(): TvRouteFixture & { C: number; loadInWeeks: number } {
+  const fixture = tvNaturalStudio()
+  const centre = (facilityId: string) => {
+    const cell = facilityBodyCentre(fixture.state, facilityId)
+    if (cell === null) throw new Error(`fixture: no body for ${facilityId}`)
+    return cell
+  }
+  const loadInWeeks = sceneryLoadInWeeksForDistance(gridDistance(centre('facility-scenery-shop'), centre(SOUND_STAGE)))
+  return { ...fixture, C: fixture.state.market.tick, loadInWeeks }
+}
+
+function committed(): ReturnType<typeof base> & { committedState: GameState } {
+  const b = base()
+  return { ...b, committedState: commission(b) }
+}
+
+/** Run the natural route to accepted delivery. */
+function deliver(start: GameState, C: number): GameState {
+  return tickUntil(start, (s) => tv(s).seasons[0]?.status === 'delivered', TUNING.TV_FINAL_WEEKS + 1,
+    `delivery after week ${C}`)
+}
+
+function roundTrips(state: GameState): void {
+  const envelope = makeSave(state)
+  expect(envelope.saveVersion).toBe(LIVE_SAVE_VERSION)
+  const back = migrateToLive(importSave(exportCurrentState(state))).state as GameState
+  expect(sig(back)).toBe(sig(state))
+  expect(sig(envelope.state)).toBe(sig(state))
+}
+
+function pickFreelancer(state: GameState, role: 'actor' | 'director' | 'craft', exclude: ReadonlySet<string>): string {
+  const id = freelancerMarketIds(state).find((candidate) => !exclude.has(candidate) && state.talent.find((t) => t.id === candidate)?.role === role)
+  if (id === undefined) throw new Error(`fixture: no ${role} in the freelancer market this week`)
+  return id
+}
+
+/** A film greenlit through the legacy door on freelancers, selecting the TV adoption's sound chain. */
+function greenlightSoundFilm(state: GameState, adoptionId: string, exclude: ReadonlySet<string>): { state: GameState; productionId: string } {
+  const taken = new Set(exclude)
+  const take = (role: 'actor' | 'director' | 'craft'): string => { const id = pickFreelancer(state, role, taken); taken.add(id); return id }
+  const directorId = take('director')
+  const cast: Record<CastSlot, string> = { lead: take('actor'), antagonist: take('actor'), support: take('actor') }
+  const craftId = take('craft')
+  const writer = state.talent.find((t) => t.role === 'writer' && !taken.has(t.id))
+  if (writer === undefined) throw new Error('fixture: no writer for the film credit')
+  const concept = state.concepts[0]!
+  const next = applyActions(state, [{ kind: 'greenlight', production: {
+    conceptId: concept.id, shape: { opening: 'slowSetup', midpoint: 'revelation', ending: 'bittersweet' },
+    promise: { genre: concept.genre, intendedSegments: ['adult'] as SegmentId[],
+      ranges: { intimacy: [-0.5, 0.5], tonalWeight: [-0.5, 0.5], kineticEnergy: [-0.5, 0.5] } },
+    writerId: writer.id, directorId, cast, craftIds: [craftId], budget: { negative: concept.baseNegativeCost, marketing: 0 },
+  } }])
+  const productionId = next.studio.activeProductions.at(-1)!.id
+  return { state: applyActions(next, [{ kind: 'setProductionTechnology', productionId, method: 'synchronized-dialogue', adoptionId }]), productionId }
+}
+
+describe('P18 admission — every guard refuses without mutation, RNG or allocator movement', () => {
+  it('the natural fixture is admissible: an engaged, founded studio with an operational sound chain and six idle contracted people', () => {
+    const b = base()
+    expectRosterDistinct(b.roster)
+    expect(b.state.founding).toBeNull()
+    expect(b.state.economyEngagedEver).toBe(true)
+    const preview = tvCommissionPreview(b.state, payloadFor(b))
+    expect(preview.refusal).toBeNull()
+    expect(preview.quote.ok).toBe(true)
+    expect(preview.terms.fee).toBe(TUNING.TV_SEASON_FEE)
+    expect(preview.commitWeek).toBe(b.C)
+    expect(preview.dueWeek).toBe(b.C + TUNING.TV_DUE_WEEKS)
+    expect(preview.finalWeek).toBe(b.C + TUNING.TV_FINAL_WEEKS)
+  })
+
+  it('the admission quote is cash ≥ 300,000 + twenty advances of mandatory fixed obligations + the 120,000 provision, before the advance', () => {
+    const b = base()
+    const quote = tvAdmissionQuote(b.state, b.C)
+    expect(quote.weeks).toBe(TUNING.TV_ADMISSION_QUOTE_WEEKS)
+    expect(quote.payroll).toBeGreaterThan(0)
+    expect(quote.overhead).toBeGreaterThan(0)
+    expect(quote.required).toBe(TUNING.TV_ADMISSION_CASH_FLOOR + quote.payroll + quote.overhead + quote.facilityOpex
+      + quote.research + quote.loanInstallments + quote.committedWork + TUNING.TV_ADMISSION_CANCELLATION_PROVISION)
+    expect(quote.cash).toBe(b.state.studio.cash)
+    expect(quote.ok).toBe(quote.cash >= quote.required)
+    // the advance is not counted: the same quote with the advance credited would not be more affordable here
+    expect(quote.required).toBeGreaterThan(TUNING.TV_SEASON_ADVANCE)
+  })
+
+  const refusals: [string, (b: ReturnType<typeof base>) => Parameters<typeof payloadFor>[1], RegExp][] = [
+    ['wrong party', () => ({ grant: undefined }), /commissioner/],
+    ['one authority named twice', (b) => ({ grant: grantFor(b.state, b.C, { distributionAuthorityId: PRODUCTION_AUTHORITY_ID }) }), /separately identified/],
+    ['production authority ending at C+20', (b) => ({ grant: grantFor(b.state, b.C, { productionEndExclusive: b.C + TUNING.TV_FINAL_WEEKS }) }), /production authority/],
+    ['distribution authority ending before C+72', (b) => ({ grant: grantFor(b.state, b.C, { distributionEndExclusive: b.C + 71 }) }), /distribution authority/],
+    ['grant for another producer', (b) => ({ grant: grantFor(b.state, b.C, { producerStudioId: 'studio-somebody-else' }) }), /producer/],
+    ['grant for another property', (b) => ({ grant: grantFor(b.state, b.C, { propertyId: 'property-same-name-other-id' }) }), /property/],
+    ['missing sound chain', () => ({ adoptionId: 'no-such-adoption' }), /operational synchronized-dialogue chain/],
+    ['writer without a writing profile', (b) => ({ roster: { ...b.roster, writerId: b.roster.cast.lead, cast: { ...b.roster.cast, lead: b.roster.writerId } } }), /writing skill profile/],
+    ['one person in two roles', (b) => ({ roster: { ...b.roster, craftId: b.roster.directorId } }), /distinct/],
+  ]
+  for (const [label, overrides, pattern] of refusals) {
+    it(`refuses ${label} by its own guard and leaves the state byte-identical`, () => {
+      const b = base()
+      const before = sig(b.state)
+      const payload = label === 'wrong party'
+        ? { grant: grantFor(b.state, b.C, { commissionerId: 'studio-rival-pretending-to-commission' }) }
+        : overrides(b)
+      const preview = tvCommissionPreview(b.state, payloadFor(b, payload))
+      expect(preview.refusal).toMatch(pattern)
+      expect(() => commission(b, payload)).toThrow(pattern)
+      expect(sig(b.state)).toBe(before)
+      expect(tv(b.state).seasons).toHaveLength(0)
+      expect(tv(b.state).nextSeason).toBe(1)
+    })
+  }
+
+  it('refuses a person who is not studio-contracted and a contract that does not cover [C, C+20)', () => {
+    const b = base()
+    const outsider = freelancerMarketIds(b.state).find((id) => b.state.talent.find((t) => t.id === id)?.role === 'craft')
+    if (outsider !== undefined) {
+      expect(() => commission(b, { roster: { ...b.roster, craftId: outsider } })).toThrow(/not studio-contracted/)
+    }
+    // shorten the craft lead's cover: a one-year contract signed now runs to C+52; advance so fewer than 20 weeks remain
+    const short = applyActions(b.state, [{ kind: 'releaseTalent', talentId: b.roster.craftId }])
+    const resigned = applyActions(short, [{ kind: 'signContract', talentId: b.roster.craftId, termWeeks: TUNING.CONTRACT_MIN_WEEKS }])
+    const late = ticks(resigned, TUNING.CONTRACT_MIN_WEEKS - TUNING.TV_FINAL_WEEKS + 1)
+    const fixture: TvRouteFixture = { ...b, state: late }
+    expect(() => commission(fixture, { grant: grantFor(late, late.market.tick) })).toThrow(/does not cover/)
+  })
+
+  it('refuses a busy person: a seat on an active film is an engagement the TV roster cannot double', () => {
+    const b = base()
+    const film = greenlightSoundFilm(b.state, b.adoptionId, new Set())
+    const seated = film.state.studio.activeProductions.at(-1)!
+    const roster = { ...b.roster, directorId: seated.directorId }
+    expect(() => commission({ ...b, state: film.state }, { roster, grant: grantFor(film.state, film.state.market.tick) })).toThrow(/already engaged/)
+  })
+
+  it('refuses an occupied initial Development & Casting slot without queueing or moving any claim', () => {
+    const b = base()
+    let state = b.state
+    const exclude = new Set<string>([b.roster.writerId, b.roster.directorId, b.roster.craftId, ...Object.values(b.roster.cast)])
+    const first = greenlightSoundFilm(state, b.adoptionId, exclude)
+    state = first.state
+    for (const id of state.studio.activeProductions.at(-1)!.craftIds) exclude.add(id)
+    exclude.add(state.studio.activeProductions.at(-1)!.directorId)
+    for (const id of Object.values(state.studio.activeProductions.at(-1)!.cast)) exclude.add(id)
+    const second = greenlightSoundFilm(state, b.adoptionId, exclude)
+    state = second.state
+    expect(occupiedResourceSlots(state, { capability: 'development-casting' }).size).toBe(TUNING.FOUNDING_DEVELOPMENT_CASTING_CAPACITY)
+    const before = sig(state)
+    expect(() => commission({ ...b, state }, { grant: grantFor(state, state.market.tick) })).toThrow(/development-casting/)
+    expect(sig(state)).toBe(before)
+    expect(state.productionQueue).toHaveLength(0)
+  })
+
+  it('refuses a studio still in its founding draft', () => {
+    const b = base()
+    const founding = { ...b.state, founding: { applicantIds: [], budget: 0, spentBonus: 0 } }
+    expect(tvCommissionPreview(founding, payloadFor(b)).refusal).toMatch(/founding/)
