+    if (!Array.isArray(v)) throw new Error('rival facility disposal shape: array required')
+    return v.map(record)
+  }
+  const array = (v: unknown): void => {
+    if (!Array.isArray(v)) throw new Error('rival facility disposal shape: array required')
+  }
