+// ── P17 save step — the `franchises` and `cameos` roots ────────────────────────
+//
+// Rev02 §10 save law: the next governed version after the accepted predecessor, forward-only and
+// root-additive; a migration seeds EMPTY roots (no franchise, work, fee or meter is inferred from old
+// films); downgrade refuses recorded authority the target cannot retain. P16's concurrent lane also
+// allocated 46 — the parent renumbers by moving these two constants (REPORT.md §e).
+
+import { emptyCameoRoot } from './cameo.js'
+import { emptyFranchiseRoot } from './continuation.js'
+import { validateCameoRoot, validateFranchiseRoot } from './continuationValidate.js'
+import { persistedProductionIds } from './productionIdentity.js'
+import type { CameoRoot, FranchiseRoot, GameState, P17StepRoots } from './types.js'
+
+export const P17_SAVE_VERSION = 46 as const
+export const P17_PREDECESSOR_SAVE_VERSION = 45 as const
+export const P17_ROOT_KEYS = ['franchises', 'cameos'] as const satisfies readonly (keyof P17StepRoots)[]
+
+export function initialP17Roots(): P17StepRoots {
+  return { franchises: emptyFranchiseRoot(), cameos: emptyCameoRoot() }
+}
+
+/** The state without the step's roots, every other key kept in its order. */
+export function stripP17Roots(raw: object): Record<string, unknown> {
+  return Object.fromEntries(Object.entries(raw).filter(([key]) => !(P17_ROOT_KEYS as readonly string[]).includes(key)))
+}
+
+/** Non-empty P17 authority refuses a downgrade, naming every recorded root. */
+export function p17DowngradeRefusal(state: Record<string, unknown>): string | null {
+  const reasons: string[] = []
+  const franchises = state.franchises as FranchiseRoot | undefined
+  const cameos = state.cameos as CameoRoot | undefined
+  if (franchises && franchises.properties.length > 0) reasons.push(`cannot downgrade or discard ${franchises.properties.length} recorded franchise root(s)`)
+  if (cameos && cameos.bookings.length > 0) reasons.push(`cannot downgrade or discard ${cameos.bookings.length} recorded cameo booking(s)`)
+  return reasons.length === 0 ? null : reasons.join('; ')
+}
+
+/** A live in-memory state that predates the step carries no P17 authority: the empty roots are its exact meaning.
+ * DISCLOSED NORMALIZATION (package PROGRESS D1): applied only by `makeSave`; a V46 FILE without the roots refuses. */
+export function withP17Roots<T extends object>(state: T): T & P17StepRoots {
+  const s = state as T & Partial<P17StepRoots>
+  return { ...state, franchises: s.franchises ?? emptyFranchiseRoot(), cameos: s.cameos ?? emptyCameoRoot() }
+}
+
+/** Both roots present and leaf-exact, joined to the productions and people the (already validated) rest of the state persists. */
+export function validateP17Roots(raw: Record<string, unknown>, label: string): void {
+  for (const key of P17_ROOT_KEYS) {
+    if (!Object.hasOwn(raw, key)) throw new Error(`${label}: the ${key} root is missing`)
+  }
+  const rest = { ...stripP17Roots(raw), ...initialP17Roots() } as unknown as GameState
+  const ctx = {
+    productionIds: persistedProductionIds(rest),
+    talentIds: new Set((rest.talent ?? []).map((t) => t.id)),
+  }
+  validateFranchiseRoot(raw.franchises, `${label}.franchises`, ctx)
+  validateCameoRoot(raw.cameos, `${label}.cameos`, ctx)
+}
