+    const later = applyContinuationRelease(promoted, { productionId: 's1', week: 94, result: result('s1', 94, 75, 74, 1.4), audience01: 0.74 }) // already released: refused
+    void later
+  })
+})
+
+describe('P17 talent associations and continuity credit (§11) — derived on read, never stored, never salary', () => {
+  const rights = rightsOf({ f1: 'prop-A' }, { [PLAYER]: ['prop-A'] })
+  const castA = { writer: 'w1', director: 'd1', lead: 'a1', antagonist: 'a2', support: 'a3' }
+  const f1 = result('f1', 0, 85, 80, 2.2, participantsOf(castA))
+
+  function threeFilms() {
