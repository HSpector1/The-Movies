+import type { Action, FilmConcept, FilmShape, GameState } from '../src/core/types.js'
+
+const SHAPE: FilmShape = { opening: 'slowSetup', midpoint: 'reversal', ending: 'bittersweet' }
+type GreenlightPayload = Extract<Action, { kind: 'greenlight' }>['production']
+
+function pick(state: GameState, role: 'writer' | 'director' | 'actor', count: number, used: Set<string>): string[] {
+  const out: string[] = []
+  for (const person of [...state.talent].reverse()) {
+    if (out.length === count) break
+    if (person.role !== role || used.has(person.id)) continue
+    if (role !== 'writer' && assignmentRefusal(state, person.id, state.market.tick, role) !== null) continue
+    out.push(person.id)
+    used.add(person.id)
+  }
+  if (out.length !== count) throw new Error(`premise: not enough free ${role}s`)
+  return out
+}
+
+function payload(state: GameState, concept: FilmConcept, used: Set<string>): GreenlightPayload {
+  const [writerId] = pick(state, 'writer', 1, used)
+  const [directorId] = pick(state, 'director', 1, used)
+  const [lead, antagonist, support] = pick(state, 'actor', 3, used)
+  return {
+    conceptId: concept.id,
+    shape: SHAPE,
+    promise: { genre: concept.genre, intendedSegments: ['adult'], ranges: { intimacy: [-1, 1], tonalWeight: [-1, 1], kineticEnergy: [-1, 1] } },
+    writerId: writerId!,
+    directorId: directorId!,
+    craftIds: [],
+    cast: { lead: lead!, antagonist: antagonist!, support: support! },
+    budget: { negative: concept.baseNegativeCost * resolveShape(SHAPE).budgetDemandMultiplier * state.era.costScale, marketing: MARKETING_BUDGET_LEVELS[0] },
+  }
+}
+
+/** Greenlight, run the production to Release Ready, commit it, and release it. Returns the state after the release tick. */
+function produceAndRelease(state: GameState, action: Extract<Action, { kind: 'greenlight' }>, deps?: Parameters<typeof applyActions>[2]): GameState {
+  let s = applyActions(state, [action], deps)
+  const id = s.studio.activeProductions[s.studio.activeProductions.length - 1]!.id
+  for (let i = 0; i < TUNING.PRODUCTION_TICKS; i++) s = tick(s)
+  expect(s.studio.activeProductions.find((p) => p.id === id)?.remainingTicks).toBe(1)
+  s = applyActions(s, [{ kind: 'commitPictureToRelease', productionId: id }])
+  s = tick(s)
+  expect(s.studio.releasedFilms.some((f) => f.productionId === id)).toBe(true)
+  return s
+}
+
+const rightsFor = (filmId: string): ContinuationRights => ({
+  storyPropertyOf: (id) => (id === filmId ? `prop-${filmId}` : null),
+  mayContinue: (_studioId, propertyId) => propertyId === `prop-${filmId}`,
+})
+
