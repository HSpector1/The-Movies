+} from '../src/core/continuation.js'
+import { recognitionReported, fatigueAt, momentumAt } from '../src/core/continuationSignals.js'
+import { stableStringify } from '../src/core/save.js'
+import type { FilmParticipants, FilmResult } from '../src/core/types.js'
+
+const EXPECTED = 150_000_000
+
+function result(productionId: string, releaseTick: number, critic: number, audience: number, mult: number, participants?: FilmParticipants): FilmResult {
+  return {
+    productionId,
+    releaseTick,
+    delivered: { intimacy: 0, tonalWeight: 0, kineticEnergy: 0 },
+    cohesion: 0.5,
+    craft: 60,
+    criticMean: critic,
+    criticSigma: 4,
+    criticScore: critic,
+    reviewVariance: 0,
+    segmentScores: { youngAdult: audience, family: audience, adult: audience, prestige: audience },
+    boxOffice: { opening: (mult * EXPECTED) / 3, total: mult * EXPECTED },
+    conceptId: `concept-${productionId}`,
+    directorId: participants?.director.talentId ?? 'dir-1',
+    ...(participants ? { participants } : {}),
+    forecast: { expectedCriticScore: 60, expectedTotal: EXPECTED, expectedOpening: EXPECTED / 3 },
+  }
+}
+
+function participantsOf(p: { writer: string; director: string; lead: string; antagonist: string; support: string }): FilmParticipants {
+  const one = (talentId: string, role: FilmParticipants['writer']['role'], discipline: FilmParticipants['writer']['discipline']) => ({
+    talentId, name: talentId, role, discipline, greenlightOVR: 50, greenlightFit: 50, greenlightEP: { low: 40, high: 60, expected: 50 }, freelancer: false,
+  })
+  return {
+    writer: one(p.writer, 'writer', 'writing'),
+    director: one(p.director, 'director', 'directing'),
+    cast: { lead: one(p.lead, 'lead', 'acting'), antagonist: one(p.antagonist, 'antagonist', 'acting'), support: one(p.support, 'support', 'acting') },
+    craft: [one('craft-1', 'craft', 'craft')],
+  }
+}
+
+/** Hand-built P16 stand-in: a film→property map and a studio→property grant set. */
+function rightsOf(propertyOf: Record<string, string>, grants: Record<string, string[]>): ContinuationRights {
+  return {
+    storyPropertyOf: (filmId) => propertyOf[filmId] ?? null,
+    mayContinue: (studioId, propertyId) => (grants[studioId] ?? []).includes(propertyId),
+  }
+}
+
+type WorldSpec = { week: number; root?: FranchiseRoot; rights: ContinuationRights; released?: FilmResult[]; locked?: string[] }
+function world(spec: WorldSpec): ContinuationWorld {
+  const released = new Map((spec.released ?? []).map((r) => [r.productionId, r]))
+  return {
+    week: spec.week,
+    franchises: spec.root ?? emptyFranchiseRoot(),
+    rights: spec.rights,
+    releasedFilm: (id) => {
+      const r = released.get(id)
+      return r ? { result: r, audience01: r.segmentScores.adult / 100 } : null
+    },
+    isLocked: (id) => (spec.locked ?? []).includes(id),
+  }
+}
