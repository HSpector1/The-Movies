+describe('P17 cameo performance (contract §3) — weight 0.10, support-fit convention, no cohesion movement', () => {
+  it('a completed guest execution enters castExecution at 0.10 in numerator and denominator; cohesion/delivered untouched; perceived at forecast, frozen actual at release', () => {
