+    expect(JSON.stringify(absent)).toBe(JSON.stringify(plain))
+    const delta = cameoPublicityDelta([{ fame: 70 }, { fame: 30 }, { fame: 10 }], [{ fame: 90, profession: 'actor' }], SEGMENTS)
