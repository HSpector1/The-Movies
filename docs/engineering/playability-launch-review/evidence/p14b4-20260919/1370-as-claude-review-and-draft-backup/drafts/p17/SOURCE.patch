+    expect(continuityCredit([], { writerId: 'w1', directorId: 'd1', cast: { lead: 'a1', antagonist: 'a2', support: 'a3' } })).toBeNull()
+    // a single released film on a branch yields no association at all
+    const single = talentAssociations(prop, prop.branches[0]!.branchId, (id) => (id === 'f1' ? f1 : null))
+    expect(single).toEqual([])
+    // the quote applies the multiplier once: a full-return sequel reads the plain awareness, a full recast reads 0.75+0.25·0.35 of it
+    const w = world({ week: 70, root, rights: rightsOf({ f1: 'prop-A', p2: 'prop-A' }, { [PLAYER]: ['prop-A'] }), released: [f1, films.p2!] })
+    const full = continuationQuote(w, { studioId: PLAYER, productionId: 'p3', request: { type: 'directSequel', predecessorProductionId: 'p2' }, proposed: { writerId: 'w1', directorId: 'd1', cast: { lead: 'a1', antagonist: 'a2', support: 'a3' } } })
