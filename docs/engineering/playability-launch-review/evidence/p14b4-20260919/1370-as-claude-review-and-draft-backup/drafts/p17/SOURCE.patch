+    const appealGuest = computeSegmentAppeal({ ...inp, cameoPublicityDelta: delta }, plain.delivered, plain.craft, plain.timelinessContribution, true)
+    expect(appealGuest.segmentAppealOpening.adult - appealPlain.segmentAppealOpening.adult).toBeCloseTo(0.25 * 100 * delta.adult, 9)
+    expect(appealGuest.segmentAppeal.adult).toBe(appealPlain.segmentAppeal.adult)
