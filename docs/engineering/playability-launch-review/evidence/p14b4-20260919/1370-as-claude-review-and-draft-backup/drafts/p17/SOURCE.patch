+
+describe('P17 cameo booking lifecycle (contract §4) — one reservation, one charge, one linked refund', () => {
+  const quote = { bookingId: 'cameo-1', studioId: 's', productionId: 'prod-1', talentId: 't1', workWeek: 1880, bookedWeek: 1875, basis: 'freelance' as const, profession: 'director' as const, fee: 162_575, perceivedActingOVR: 20, fame: 85 }
+
+  function reserved(): { root: ReturnType<typeof emptyCameoRoot>; booking: CameoBooking } {
+    const root = commitCameoBooking(emptyCameoRoot(), quote)
+    return { root, booking: root.bookings[0]! }
+  }
+
+  it('commit freezes the quote, rule version, basis, fee and retained share; status reserved', () => {
+    const { root, booking } = reserved()
+    expect(root.nextOrdinal).toBe(2)
+    expect(booking.status).toBe('reserved')
+    expect(booking.quote).toEqual({ perceivedActingOVR: 20, fame: 85, ruleVersion: P17_CAMEO_RULE_VERSION })
+    expect(booking.fee).toBe(162_575)
+    expect(booking.retained).toBe(40_644)
+    expect(booking.basis).toBe('freelance')
+    expect(booking.profession).toBe('director')
+    expect(booking.completedWeek).toBeNull()
+    expect(booking.refund).toBeNull()
+    expect(booking.releasedWeek).toBeNull()
+  })
+
+  it('cancel before work: one refund of fee − retained; the charge stays in history; a duplicate cancel refuses', () => {
+    const { root } = reserved()
+    const { root: next, refund } = cancelCameoBooking(root, 'cameo-1', 1877, 'explicit')
+    expect(refund).toBe(162_575 - 40_644)
+    const b = next.bookings[0]!
+    expect(b.status).toBe('cancelled')
+    expect(b.cancelledWeek).toBe(1877)
+    expect(b.cancelReason).toBe('explicit')
+    expect(b.refund).toBe(refund)
+    expect(b.fee).toBe(162_575) // history preserved
+    expect(() => cancelCameoBooking(next, 'cameo-1', 1878, 'explicit')).toThrow()
+    expect(() => cancelCameoBooking(next, 'cameo-9', 1878, 'explicit')).toThrow()
+  })
+
+  it('the booked week passing WITHOUT a shooting work unit cancels with the declared partial refund and earns nothing', () => {
+    const { root } = reserved()
+    const early = resolveCameoWorkWeek(root, { productionId: 'prod-1', week: 1879, shootingWeek: true, execution: 50 })
+    expect(early).toBe(root) // not its week yet: nothing happens
+    const missed = resolveCameoWorkWeek(root, { productionId: 'prod-1', week: 1880, shootingWeek: false, execution: null })
+    const b = missed.bookings[0]!
+    expect(b.status).toBe('cancelled')
+    expect(b.cancelReason).toBe('missedWork')
+    expect(b.refund).toBe(162_575 - 40_644)
+    expect(b.completedWeek).toBeNull()
+    expect(b.completedExecution).toBeNull()
+    // a week already past with the booking still reserved is also a miss
+    const late = resolveCameoWorkWeek(root, { productionId: 'prod-1', week: 1881, shootingWeek: true, execution: 50 })
+    expect(late.bookings[0]!.cancelReason).toBe('missedWork')
+  })
+
+  it('real shooting work in the booked week completes the appearance: fee earned, actual execution frozen, no new payment; later cancel refuses', () => {
+    const { root } = reserved()
+    const done = resolveCameoWorkWeek(root, { productionId: 'prod-1', week: 1880, shootingWeek: true, execution: 37.5 })
+    const b = done.bookings[0]!
+    expect(b.status).toBe('completed')
+    expect(b.completedWeek).toBe(1880)
+    expect(b.completedExecution).toBe(37.5)
+    expect(b.refund).toBeNull()
+    expect(() => cancelCameoBooking(done, 'cameo-1', 1881, 'explicit')).toThrow(/completed/i)
+    // a film cancellation after completed work preserves the work and the earned fee
+    expect(() => cancelCameoBooking(done, 'cameo-1', 1881, 'productionCancelled')).toThrow(/completed/i)
+    // release credits exactly once; an unreleased film grants no release credit
+    expect(b.releasedWeek).toBeNull()
+    const released = releaseCameoBookings(done, 'prod-1', 1890)
+    expect(released.bookings[0]!.releasedWeek).toBe(1890)
+    expect(releaseCameoBookings(released, 'prod-1', 1891).bookings[0]!.releasedWeek).toBe(1890)
+    // a cancelled (unperformed) booking never earns a release credit
+    const { root: other } = reserved()
+    const cancelled = cancelCameoBooking(other, 'cameo-1', 1877, 'explicit').root
+    expect(releaseCameoBookings(cancelled, 'prod-1', 1890).bookings[0]!.releasedWeek).toBeNull()
+  })
+})
