+      const b = (prop.branches as Rec[]).find((x) => x.branchId === id)!
+      if (kind === 'spinoff' && !subIds.has(b.subPropertyId as string)) fail(pl, `spinoff branch ${id} names an unknown SubProperty`)
+    }
+  })
+}
