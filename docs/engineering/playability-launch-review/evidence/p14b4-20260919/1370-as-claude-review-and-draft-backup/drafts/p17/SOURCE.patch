+// ── P17 greenlight/release composition — what actions.ts and tick.ts call ──────
+//
+// Binds the pure continuation and cameo law to the live GameState: the world view a quote reads, the
+// Shape A eligibility matrix (cameo contract §4), the forecast-time inputs, the fee ledger rows, the
+// atomic commit, and the release-time inputs. Everything here is deterministic and pure.
+
+import { filmAudienceScore } from './receptionVerdict.js'
+import {
+  cameoAttentionDelta,
+  cameoFee,
+  cameoPublicityDelta,
+  cameosOf,
+  commitCameoBooking,
+  committedGuestsFor,
+  completedGuestsFor,
+  featuredCapacity,
+  P17_CAMEO_FEE_NOTE,
+  P17_CAMEO_REFUND_NOTE,
+  type CameoBookingRequest,
+  type CameoQuoteCommit,
+  type CameoRefund,
+} from './cameo.js'
+import {
+  commitContinuationGreenlight,
+  continuationQuote,
+  franchisesOf,
+  installmentEdgeFor,
+  continuationInputsAtRelease,
+  NO_RIGHTS_AUTHORITY,
+  type ContinuationQuote,
+  type ContinuationRights,
+  type ContinuationWorld,
+  type ReleasedFilmView,
+} from './continuation.js'
+import { retirementRecordFor } from './careerLifecycle.js'
+import { activeContract, busyTalentIds } from './employment.js'
+import { rivalEmployment } from './hollywood.js'
+import { professionAtWeek } from './professionTransitions.js'
+import { castSlotExecution, roleOVR } from './talentSummary.js'
+import { TUNING } from './tuning.js'
+import type { Action, CastSlot, FilmConcept, FilmResult, FilmShape, GameState, LedgerEntry, Promise as FilmPromise, SegmentId, ShapeEffects, Talent } from './types.js'
+
+export function p17StudioId(state: Pick<GameState, 'hollywood'>): string {
+  return state.hollywood?.playerStudioId ?? 'player'
+}
+
+/** Every public FilmResult in the world (player library and living-industry simulation films). */
+export function publicFilmById(state: GameState): (id: string) => FilmResult | null {
+  return (id) => {
+    const own = state.studio.releasedFilms.find((f) => f.productionId === id)
+    if (own) return own
+    for (const film of state.hollywood?.films ?? []) {
+      if (film.provenance === 'simulation/v1' && film.filmId === id) return film.result
+    }
+    return null
+  }
+}
+
+export function continuationWorldOf(state: GameState, rights: ContinuationRights, week = state.market.tick): ContinuationWorld {
+  const film = publicFilmById(state)
+  return {
+    week,
+    franchises: franchisesOf(state),
+    rights,
+    releasedFilm: (id): ReleasedFilmView | null => {
+      const result = film(id)
+      return result ? { result, audience01: filmAudienceScore(state, result) / 100 } : null
+    },
+    isLocked: (id) => state.studio.activeProductions.some((p) => p.id === id) || (state.hollywood?.businesses ?? []).some((b) => b.productions.some((p) => p.id === id)),
+  }
+}
+
+export type P17GreenlightContext = {
+  productionId: string
+  week: number
+  studioId: string
+  writer: Talent
+  director: Talent
+  cast: Record<CastSlot, Talent>
+  craftHires: readonly Talent[]
+  concept: FilmConcept
+  shapeEffects: ShapeEffects
+  promise: FilmPromise
+  shape: FilmShape
+  rights: ContinuationRights | undefined
+}
+
+export type P17GreenlightPrep = {
+  inputs: { inheritedAwareness01?: number; cameoPublicityDelta?: Record<SegmentId, number>; cameoExecutions?: number[] }
+  continuation: { world: ContinuationWorld; quote: ContinuationQuote } | null
+  cameoCommits: CameoQuoteCommit[]
+  cameoFees: number
+}
+
+const reject = (reason: string): never => {
+  throw new Error(`applyActions: greenlight rejected — ${reason}`)
+}
+
+/** Cameo contract §4 eligibility for one request; refuses loudly, never mutates. */
+export function cameoEligibility(
+  state: GameState,
+  args: { studioId: string; productionId: string; greenlightWeek: number; principalIds: ReadonlySet<string>; request: CameoBookingRequest; committed: number; requestedTalentIds: ReadonlySet<string> },
+): CameoQuoteCommit {
+  const { request, greenlightWeek } = args
+  if (featuredCapacity(greenlightWeek) === 0) reject(`featured/cameo bookings unlock at week ${TUNING.P17_CAMEO_UNLOCK_WEEK} (1956 Week 1); week ${greenlightWeek} has no capability`)
+  if (args.committed >= TUNING.P17_CAMEO_MAX_GUESTS) reject(`at most ${TUNING.P17_CAMEO_MAX_GUESTS} guests per production (two already committed)`)
+  if (args.requestedTalentIds.has(request.talentId)) reject(`guest ${request.talentId} is requested twice`)
+  if (args.principalIds.has(request.talentId)) reject(`guest ${request.talentId} is already credited on this picture`)
+  const talent = state.talent.find((t) => t.id === request.talentId)
+  if (!talent) reject(`guest ${request.talentId} is unknown`)
+  if (!(greenlightWeek < request.workWeek && request.workWeek <= greenlightWeek + TUNING.PRODUCTION_TICKS)) {
+    reject(`work week ${request.workWeek} must satisfy ${greenlightWeek} < workWeek <= ${greenlightWeek + TUNING.PRODUCTION_TICKS}`)
+  }
+  for (const record of new Set([retirementRecordFor(state, talent.id), retirementRecordFor(state, talent.id, 'actor')])) {
+    if (record === undefined) continue
+    if (record.status !== 'announced') reject(`${talent.id} is ${record.status} and takes no new appearance`)
+    if (request.workWeek + 1 > record.effectiveWeek) reject(`${talent.id} retires at week ${record.effectiveWeek}; a week-${request.workWeek} appearance would not complete before it`)
+  }
+  if (cameosOf(state).bookings.some((b) => b.status === 'reserved' && b.talentId === talent.id && b.workWeek === request.workWeek)) reject(`${talent.id} already holds a reservation for week ${request.workWeek}`)
+  if (busyTalentIds(state).has(talent.id)) reject(`${talent.id} holds an existing production, writing, research or booking obligation`)
+  let basis: 'employee' | 'freelance'
+  if (activeContract(state, talent.id, request.workWeek) !== undefined) basis = 'employee'
+  else if (rivalEmployment(state, talent.id, request.workWeek) !== null) reject(`${talent.id} is another studio's employee at week ${request.workWeek}`)
+  else basis = 'freelance'
+  const perceivedActingOVR = roleOVR(talent, 'acting')
+  const fee = cameoFee(perceivedActingOVR, talent.fame)
+  if (request.expectedFee !== undefined && request.expectedFee !== fee) reject(`stale cameo quote for ${talent.id}: expected fee ${request.expectedFee}, evaluated ${fee}`)
+  return {
+    studioId: args.studioId,
+    productionId: args.productionId,
+    talentId: talent.id,
+    workWeek: request.workWeek,
+    bookedWeek: greenlightWeek,
+    basis,
+    profession: professionAtWeek(state, talent.id, greenlightWeek),
+    fee,
+    perceivedActingOVR,
+    fame: talent.fame,
+  }
+}
+
+/** Everything the greenlight needs before it mutates: refuses atomically, returns the forecast inputs and the commits. */
+export function prepareP17Greenlight(state: GameState, action: Action & { kind: 'greenlight' }, ctx: P17GreenlightContext): P17GreenlightPrep {
+  const prep: P17GreenlightPrep = { inputs: {}, continuation: null, cameoCommits: [], cameoFees: 0 }
+  if (action.continuation) {
+    const world = continuationWorldOf(state, ctx.rights ?? NO_RIGHTS_AUTHORITY, ctx.week)
+    const quote = continuationQuote(world, {
+      studioId: ctx.studioId,
+      productionId: ctx.productionId,
+      request: action.continuation,
+      proposed: { writerId: ctx.writer.id, directorId: ctx.director.id, cast: { lead: ctx.cast.lead.id, antagonist: ctx.cast.antagonist.id, support: ctx.cast.support.id } },
+    })
+    if (!quote.ok) reject(`continuation refused: ${quote.reason}`)
+    prep.continuation = { world, quote }
+    prep.inputs.inheritedAwareness01 = quote.inheritedAwareness01
+  }
+  if (action.cameos && action.cameos.length > 0) {
+    const principalIds = new Set([ctx.writer.id, ctx.director.id, ctx.cast.lead.id, ctx.cast.antagonist.id, ctx.cast.support.id, ...ctx.craftHires.map((c) => c.id)])
+    const requested = new Set<string>()
+    const committed = committedGuestsFor(cameosOf(state), ctx.productionId).length
+    for (const request of action.cameos) {
+      const commit = cameoEligibility(state, { studioId: ctx.studioId, productionId: ctx.productionId, greenlightWeek: ctx.week, principalIds, request, committed: committed + prep.cameoCommits.length, requestedTalentIds: requested })
+      requested.add(commit.talentId)
+      prep.cameoCommits.push(commit)
+      prep.cameoFees += commit.fee
+    }
+    const guests = prep.cameoCommits.map((c) => state.talent.find((t) => t.id === c.talentId)!)
+    prep.inputs.cameoPublicityDelta = cameoPublicityDelta(
+      [ctx.cast.lead, ctx.cast.antagonist, ctx.cast.support].map((t) => ({ fame: t.fame })),
+      prep.cameoCommits.map((c, i) => ({ fame: guests[i]!.fame, profession: c.profession })),
+      state.market.segments,
+    )
+    // the forecast reads PERCEIVED acting against the screenplay's support requirement (the explicit cameo fit convention)
+    prep.inputs.cameoExecutions = guests.map((g) => castSlotExecution(g, ctx.concept, 'support', ctx.shapeEffects, ctx.promise, 'perceived', ctx.shape))
+  }
+  return prep
+}
+
+export function p17CameoFeeRows(prep: P17GreenlightPrep, week: number, productionId: string): LedgerEntry[] {
+  return prep.cameoCommits.map((c) => ({ week, kind: 'freelancerFee', amount: -c.fee, talentId: c.talentId, productionId, note: P17_CAMEO_FEE_NOTE }))
+}
+
+export function p17RefundRows(refunds: readonly CameoRefund[], week: number): LedgerEntry[] {
+  return refunds.map((r) => ({ week, kind: 'freelancerFee', amount: r.amount, talentId: r.talentId, productionId: r.productionId, note: P17_CAMEO_REFUND_NOTE }))
+}
+
+/** The atomic commit after the main production exists: the lineage edge and the bookings. */
+export function commitP17Greenlight(state: GameState, prep: P17GreenlightPrep, args: { productionId: string; studioId: string }): GameState {
+  let next = state
+  if (prep.continuation) {
+    next = { ...next, franchises: commitContinuationGreenlight({ ...prep.continuation.world, franchises: franchisesOf(next) }, prep.continuation.quote, { studioId: args.studioId, productionId: args.productionId }) }
+  }
+  if (prep.cameoCommits.length > 0) {
+    let cameos = cameosOf(next)
+    for (const c of prep.cameoCommits) cameos = commitCameoBooking(cameos, c)
+    next = { ...next, cameos }
+  }
+  return next
+}
+
+/** The release-time inputs for one picture: the live continuation read and the COMPLETED guests' publicity, frozen executions and attention delta. */
+export function p17ReleaseInputs(
+  state: GameState,
+  args: { productionId: string; week: number; cast: Record<CastSlot, Talent>; writerId: string; directorId: string },
+): { inputs: { inheritedAwareness01?: number; cameoPublicityDelta?: Record<SegmentId, number>; cameoExecutions?: number[] }; attentionDelta: number | undefined; guests: { talentId: string }[] } {
+  const inputs: { inheritedAwareness01?: number; cameoPublicityDelta?: Record<SegmentId, number>; cameoExecutions?: number[] } = {}
+  const franchises = franchisesOf(state)
+  if (installmentEdgeFor(franchises, args.productionId)) {
+    const live = continuationInputsAtRelease(franchises, args.productionId, args.week, { writerId: args.writerId, directorId: args.directorId, cast: { lead: args.cast.lead.id, antagonist: args.cast.antagonist.id, support: args.cast.support.id } }, publicFilmById(state))
+    if (live !== null) inputs.inheritedAwareness01 = live
+  }
+  const completed = completedGuestsFor(cameosOf(state), args.productionId)
+  let attentionDelta: number | undefined
+  if (completed.length > 0) {
+    const guests = completed.map((b) => ({ fame: state.talent.find((t) => t.id === b.talentId)?.fame ?? b.quote.fame, profession: b.profession }))
+    const delta = cameoPublicityDelta([args.cast.lead, args.cast.antagonist, args.cast.support].map((t) => ({ fame: t.fame })), guests, state.market.segments)
+    inputs.cameoPublicityDelta = delta
+    inputs.cameoExecutions = completed.map((b) => b.completedExecution!)
+    attentionDelta = cameoAttentionDelta(delta, state.market.segments)
+  }
+  return { inputs, attentionDelta, guests: completed.map((b) => ({ talentId: b.talentId })) }
+}
