+// ── P17 integration — continuation greenlight/release and Shape A bookings on a live M0A world ──
+//
+// Authority: charter r2 RED items (1) refused quote/greenlight leaves state/cash/RNG/IDs unchanged,
+// (3) same field at lock and release, (4) zero-continuation / zero-cameo identity, (6) save/replay;
+// cameo contract §4 (quote/commit atomic with the main production; charge once; missed week refunds
+// the remainder), §6 items 1, 2, 5, 6, 7, 8. The world is the headless M0A world (`generateWorld`), the
+// only full state a bounded specialist can route without the recorded heavy lane; the rights authority
+// is the injected adapter (package PROGRESS D2). Every route is seeded; no state surgery.
+
+import { describe, expect, it } from 'vitest'
+import { applyActions } from '../src/core/actions.js'
+import { assignmentRefusal } from '../src/core/careerLifecycle.js'
+import { NO_RIGHTS_AUTHORITY, type ContinuationRights } from '../src/core/continuation.js'
+import { MARKETING_BUDGET_LEVELS } from '../src/core/grid.js'
