+// ── P17 continuation law — five typed lineages, legality, SubProperties/promotion, associations, symmetry ──
+//
+// Authority: canonical rev02 §5.2 (C6 derived types), §8 (remake/reboot), §9 (SubProperties, promotion),
+// §10 (lazy root, branches, open-continuity cap, legality matrix, rights live lookup, no kill switch),
+// §11 (associations, continuity credit); charter r2 §"P16 authority and five typed lineages" and RED items
+// (1), (2), (4), (5); Owner choices (healthy reboot legal; dormant DirectSequel not a sixth type).
+// Rights are an injected adapter (D2 in the package PROGRESS): P16's producer is not yet code, and a
+// continuation never infers rights from the producing studio.
+
+import { describe, expect, it } from 'vitest'
+import {
+  applyContinuationRelease,
+  applySubPropertyPromotion,
+  commitContinuationGreenlight,
+  continuationQuote,
+  continuityCredit,
