+// ── P16B: permitted bidders, reserve, commitment reservations and exact P16 cash moves ──
+//
+// Authority: P16 integration contract §6 ("stable-stage-only bidders for the first slice: an
+// entered, operating studio, with founding completed, condition exactly stable, and no outstanding
+// P15B distress loan ... Cash after all actual closing charges must cover the versioned
+// post-purchase reserve ... a commitment reservation against spendable cash while a binding bid/
+// offer is outstanding, released on rejection/expiry and consumed once on closing"); 1362-O §5.4
+// (cash funded with reserve; rescue principal cannot fund purchases; outstanding distress loan bars
+// bidding; no acquisition financing product).
+//
+// Pure. One law for player and rivals: the player's cash moves through `studio.cash` + a ledger
+// row of a P16 kind; a rival's through `moveRivalMoney` on a copied account. Every move names its
+// rights transaction in the note, and the rights root validator reconciles the two.
+
+import type { ConditionStage } from './corporateCondition.js'
+import { moveRivalMoney } from './hollywood.js'
+import { studioWeeklyFixedCost } from './powerRankingArchive.js'
+import { TUNING } from './tuning.js'
+import type { GameState, P16LedgerKind } from './types.js'
+
+export type BidderFacts = { stage: ConditionStage; hasOutstandingLoan: boolean }
+export type BidderFactsLookup = (state: GameState, studioId: string) => BidderFacts
+
+/**
+ * CONTRACT GAP (P16B): the permitted-bidder rule reads the P15B condition stage and the outstanding
+ * distress loan, but at base 6510c971 P15B Wave 2 has not landed a persisted condition/loan root
+ * (`studioLoan.ts`/`corporateCondition.ts` are pure law only). Narrowest lawful reading: with no
+ * condition root, every studio stands at the pure law's first evaluation (`stepCondition(null, ...)`
+ * starts `stable`) with no loan. The moment a `corporateCondition` root exists this adapter refuses
+ * loudly rather than guess; the parent replaces it with the P15B reader at landing (the one adapter
+ * point: every P16 transaction takes a `BidderFactsLookup` and defaults to this binding).
+ */
+export const bidderFacts: BidderFactsLookup = (state, studioId) => {
+  if (Object.hasOwn(state, 'corporateCondition')) {
+    throw new Error(`rights: a corporateCondition root is present but no P16 facts adapter reads it for ${studioId}; wire the P15B stage/loan reader at landing`)
+  }
+  return { stage: 'stable', hasOutstandingLoan: false }
+}
+
+/** The first-slice permitted-bidder matrix; null when permitted. */
+export function permittedBidderRefusal(state: GameState, studioId: string, week: number, facts: BidderFactsLookup = bidderFacts): string | null {
+  const h = state.hollywood
+  if (!h) return 'noIndustry'
+  const identity = h.identities.find((i) => i.studioId === studioId)
+  if (identity === undefined) return 'unknownStudio'
+  if (identity.enteredWeek === null || identity.enteredWeek > week) return 'notOperating'
+  if (studioId === h.playerStudioId) {
+    if (state.founding !== null) return 'founding'
+  } else if (!h.businesses.some((b) => b.studioId === studioId)) {
+    return 'notOperating'
+  }
+  if (state.rights.estates.some((e) => e.studioId === studioId)) return 'terminal'
+  const f = facts(state, studioId)
+  if (f.stage !== 'stable') return `stageNotStable:${f.stage}`
+  if (f.hasOutstandingLoan) return 'outstandingDistressLoan'
+  return null
+}
+
+/** The studio's present weekly fixed cost (the P15 fact adapter the Power Ranking already uses). */
+export function weeklyFixedCost(state: GameState, studioId: string): number {
+  return studioWeeklyFixedCost(state, studioId)
+}
+
+export function studioCash(state: GameState, studioId: string): number {
+  const h = state.hollywood
+  if (!h) throw new Error('rights: no industry')
+  if (studioId === h.playerStudioId) return state.studio.cash
+  const business = h.businesses.find((b) => b.studioId === studioId)
+  if (business === undefined) throw new Error(`rights: ${studioId} has no operating account`)
+  return business.account.cash
+}
+
+/** Cash committed by this studio's open binding buy offers and sealed estate bids. */
+export function reservedCash(state: GameState, studioId: string): number {
+  let reserved = 0
+  for (const o of state.rights.offers) if (o.status === 'open' && o.direction === 'buy' && o.offerorId === studioId) reserved += o.price
+  for (const e of state.rights.estates) for (const b of e.bids) if (b.status === 'sealed' && b.bidderId === studioId) reserved += b.amount
+  return reserved
+}
+
+export function spendableCash(state: GameState, studioId: string): number {
+  return studioCash(state, studioId) - reservedCash(state, studioId)
+}
+
+/** The versioned post-purchase reserve: RIGHTS_RESERVE_WEEKS of the buyer's weekly fixed cost. */
+export function postPurchaseReserve(state: GameState, studioId: string): number {
+  return TUNING.RIGHTS_RESERVE_WEEKS * weeklyFixedCost(state, studioId)
+}
+
+/** Null when spendable cash after `outlay` still covers the reserve. */
+export function affordabilityRefusal(state: GameState, studioId: string, outlay: number): string | null {
+  return spendableCash(state, studioId) - outlay >= postPurchaseReserve(state, studioId) ? null : 'insufficientCashAfterReserve'
+}
+
+/** One signed P16 cash move on the studio's authoritative account, with its receipt. Zero moves nothing. */
+export function moveStudioCash(state: GameState, studioId: string, kind: P16LedgerKind, amount: number, week: number, note: string): GameState {
+  if (!Number.isSafeInteger(amount)) throw new Error(`rights: ${kind} amount must be a whole amount`)
+  if (amount === 0) return state
+  const h = state.hollywood
+  if (!h) throw new Error('rights: no industry')
+  if (studioId === h.playerStudioId) {
+    return { ...state, studio: { ...state.studio, cash: state.studio.cash + amount }, ledger: [...state.ledger, { week, kind, amount, note }] }
+  }
+  const index = h.businesses.findIndex((b) => b.studioId === studioId)
+  if (index < 0) throw new Error(`rights: ${studioId} has no operating account`)
+  const business = h.businesses[index]!
+  const account = { ...business.account, periods: business.account.periods.map((p) => ({ ...p, movements: { ...p.movements } })) }
+  moveRivalMoney(account, kind, amount, week)
+  const businesses = h.businesses.map((b, i) => (i === index ? { ...b, account } : b))
+  return { ...state, hollywood: { ...h, businesses } }
+}
diff --git a/src/core/rightsTick.ts b/src/core/rightsTick.ts
new file mode 100644
index 00000000..5c77dced
--- /dev/null
+++ b/src/core/rightsTick.ts
@@ -0,0 +1,47 @@
+// ── P16: the one weekly rights step, called once from tick.ts on the finalized week ──
+//
+// Runs on the state the advance PRODUCES (market.tick already incremented), before the Power
+// Ranking record reads final cash. Deterministic and RNG-free:
+//   P16A — mint the R1 property of every rival greenlight accepted this week (the player's
+//   greenlight mints inside `applyGreenlight`, atomically with the action) and the R2 film title
+//   of every actual release this week (player and rival), each exactly once.
+// A world without an industry has no rights and is returned unchanged.
+
+import { answerRivalOffers, expireOffers } from './assetSale.js'
+import { closeDueEstates } from './estate.js'
+import { mintFilmTitleAtRelease, mintStoryPropertyAtGreenlight, storyPropertyId } from './rights.js'
+import type { GameState } from './types.js'
+
+/** `week` is the week that was advanced (releases and rival greenlights are dated to it). */
+export function advanceRightsWeek(state: GameState, week: number): GameState {
+  const h = state.hollywood
+  if (!h) return state
+  let next = state
+  for (const b of h.businesses) {
+    for (const production of b.productions) {
+      if (production.startTick !== week) continue
+      const existing = next.rights.properties.find((p) => p.propertyId === storyPropertyId(production.conceptId))
+      if (existing !== undefined && existing.workLinks.includes(production.id)) continue
+      next = mintStoryPropertyAtGreenlight(next, { studioId: b.studioId, production, week })
+    }
+  }
+  for (const film of next.studio.releasedFilms) {
+    if (film.releaseTick !== week || next.rights.filmTitles.some((t) => t.filmId === film.productionId)) continue
+    const row = next.studioHistory.rows.find((r) => r.kind === 'filmReleased' && r.productionId === film.productionId)
+    const concept = next.concepts.find((c) => c.id === film.conceptId)
+    next = mintFilmTitleAtRelease(next, { studioId: h.playerStudioId, filmId: film.productionId, conceptId: film.conceptId,
+      title: row !== undefined && row.kind === 'filmReleased' ? row.title : concept?.title ?? '', week })
+  }
+  for (const film of h.films) {
+    if (film.provenance !== 'simulation/v1' || film.result.releaseTick !== week || next.rights.filmTitles.some((t) => t.filmId === film.filmId)) continue
+    next = mintFilmTitleAtRelease(next, { studioId: film.studioId, filmId: film.filmId, conceptId: film.conceptId, title: film.title, week })
+  }
+  // P16B — rival counterparties answer open bilateral offers under the willingness policy on the
+  // produced week, then offers at or past their expiry expire and release their reservations.
+  // P16C — every estate whose close boundary D is the produced week runs its close ceremony once.
+  const produced = next.market.tick
+  next = answerRivalOffers(next, produced)
+  next = expireOffers(next, produced)
+  next = closeDueEstates(next, produced)
+  return next
+}
diff --git a/tests/helpers/p16-fixtures.ts b/tests/helpers/p16-fixtures.ts
