diff --git a/src/core/acquisition.ts b/src/core/acquisition.ts
new file mode 100644
index 00000000..32ab7783
--- /dev/null
+++ b/src/core/acquisition.ts
@@ -0,0 +1,159 @@
+// ── P16C: healthy whole-studio absorption — pure law, quote and retention preview ──
+//
+// Authority: P16 integration contract §5 ("The initial healthy target must be willing and
+// stable-stage both at quote and at closing. It may reject the offer ... the operating player studio
+// is NotForSale ... The player explicitly chooses retention with a disclosed no-action default.
+// Iterate the target's authoritative contract order, keeping only lawful contracts fitting usable
+// capacity and the complete transaction's affordability ... Non-retained healthy staff get the lawful
+// capped exit once, charged to the target in its closing account. Retained work cannot outlive its
+// lawful required participants ... consideration is the agreed non-cash asset/business price; target
+// cash transfers at par after its actual closing exits, including a negative amount. Closing outlay
+// is consideration minus that post-exit cash, plus separately named real charges exactly once.
+// Guarantees are disclosed beside value, never subtracted ... There is no max(0, price - guarantees)
+// shortcut ... A healthy target carrying an outstanding v1 distress loan is refused ... Cancel target
+// in-flight research while retaining verified work ... Facilities do not move to the buyer"), §7
+// group H; 1362-O §5.4, §5.6, §5.8, §5.9.
+//
+// CONTRACT GAP (P16C): executable closing is DEFERRED. Contract §2 names its producer prerequisites
+// — the P12 operating-state discriminator with terminal provenance, employer-bound continuation
+// contract ids with exact employment reason values and linked validation, and Wave 4's typed
+// dispositions — none of which exist at base 6510c971 (P15B Wave 4 is concurrent work). The pure
+// law below (eligibility, consent policy, money separation, retention preview, dispositions) is the
+// complete quote; `closeAbsorption` refuses loudly and names the prerequisites.
+
+import { contractEndRefusal } from './careerLifecycle.js'
+import { guaranteedComp, terminationCost, weeklySalary } from './employment.js'
+import { libraryValuationV1 } from './propertyValuation.js'
+import { bidderFacts, permittedBidderRefusal, spendableCash, weeklyFixedCost, type BidderFactsLookup } from './rightsFinance.js'
+import { resolveTitles, subjectsHeldBy, type RightSubject } from './rights.js'
+import { TUNING } from './tuning.js'
+import type { GameState } from './types.js'
+
+export type RetentionChoice = { kind: 'default' } | { kind: 'explicit'; contractIds: string[] }
+export type AbsorptionInput = { buyerId: string; targetId: string; consideration: number; retention: RetentionChoice }
+export type AbsorptionContractQuote = {
+  contractId: string; talentId: string; annualSalary: number; signingBonus: number; startWeek: number; endWeekExclusive: number; weeklySalary: number
+  retained: boolean; reason: 'personRefusal' | 'unaffordable' | 'notSelected' | null
+  /** The lawful capped exit, charged once to the target when not retained. */
+  exitCost: number
+  /** Remaining guaranteed salary: DISCLOSED beside value, never netted against consideration. */
+  guarantee: number
+}
+export type AbsorptionProductionQuote = { productionId: string; disposition: 'continues' | 'cancelRequired'; missingParticipants: string[] }
+export type AbsorptionQuote = {
+  kind: 'quote'
+  buyerId: string; targetId: string; week: number; consideration: number
+  rights: RightSubject[]; rightsValue: number | null
+  contracts: AbsorptionContractQuote[]
+  exitCharges: number; targetCashBeforeExits: number; postExitCash: number; guarantees: number; outlay: number
+  resultingWeeklyFixedCost: number; reserveAfter: number; affordable: boolean
+  productions: AbsorptionProductionQuote[]
+  research: { projectId: string; disposition: 'cancelRetainingVerifiedProgress' }[]
+  facilities: { facilityId: string; disposition: 'remainsWithTargetHistory' }[]
+}
+export type AbsorptionRefusal = { kind: 'refusal'; refusal: string }
+
+export const ABSORPTION_CLOSING_PREREQUISITES: readonly string[] = [
+  'P12 operating-state discriminator and terminal provenance for the absorbed identity',
+  'P12/P14 employer-bound continuation contract ids and the exact employment reason values with linked validation',
+  'P15B Wave 4 typed dispositions for the target\'s work, runs, research and facilities',
+]
+
+export function absorptionRefusal(state: GameState, buyerId: string, targetId: string, week: number, facts: BidderFactsLookup = bidderFacts): string | null {
+  const h = state.hollywood
+  if (!h) return 'noIndustry'
+  if (targetId === h.playerStudioId) return 'playerNotForSale'
+  if (buyerId === targetId) return 'selfDealing'
+  const identity = h.identities.find((i) => i.studioId === targetId)
+  if (identity === undefined || identity.enteredWeek === null || !h.businesses.some((b) => b.studioId === targetId)) return 'unknownTarget'
+  if (state.rights.estates.some((e) => e.studioId === targetId)) return 'targetTerminal'
+  const buyer = permittedBidderRefusal(state, buyerId, week, facts)
+  if (buyer !== null) return `buyerNotPermitted:${buyer}`
+  const target = facts(state, targetId)
+  if (target.stage !== 'stable') return `targetNotStable:${target.stage}`
+  if (target.hasOutstandingLoan) return 'targetOutstandingLoan'
+  return null
+}
+
+/** The provisional consent policy: a rival sells its business at or above its rights value × (100 + p) / 100; cash transfers at par and is not priced. */
+export function rivalAbsorptionWillingness(state: GameState, targetId: string, consideration: number, week: number): { willing: boolean; reason: string; value: number | null } {
+  const value = libraryValuationV1(state, targetId, week)
+  if (value.kind !== 'available') return { willing: false, reason: `valueUnavailable:${value.reason}`, value: null }
+  const ask = Math.ceil((value.total * (100 + TUNING.RIGHTS_WILLINGNESS_PREMIUM_PERCENT)) / 100)
+  return consideration >= ask ? { willing: true, reason: 'willing', value: value.total } : { willing: false, reason: `notWilling:considerationBelowAsk:${ask}`, value: value.total }
+}
+
+type Row = Omit<AbsorptionContractQuote, 'retained' | 'reason'>
+
+export function quoteAbsorption(state: GameState, input: AbsorptionInput, week: number, facts: BidderFactsLookup = bidderFacts): AbsorptionQuote | AbsorptionRefusal {
+  const refusal = absorptionRefusal(state, input.buyerId, input.targetId, week, facts)
+  if (refusal !== null) return { kind: 'refusal', refusal }
+  if (!Number.isSafeInteger(input.consideration) || input.consideration < 0) return { kind: 'refusal', refusal: 'invalidConsideration' }
+  const h = state.hollywood!
+  const business = h.businesses.find((b) => b.studioId === input.targetId)!
+  // The target's authoritative contract order: its live employment intervals in root order.
+  const rows: Row[] = h.activeEmploymentOrdinals.map((i) => h.employment[i]!)
+    .filter((e) => e.studioId === input.targetId && e.endedWeek === null && e.terms.startWeek <= week && week < e.terms.endWeekExclusive)
+    .map((e) => ({ contractId: e.contractId, talentId: e.terms.talentId, annualSalary: e.terms.annualSalary, signingBonus: e.terms.signingBonus,
+      startWeek: e.terms.startWeek, endWeekExclusive: e.terms.endWeekExclusive, weeklySalary: weeklySalary(e.terms.annualSalary),
+      exitCost: terminationCost(e.terms, week), guarantee: guaranteedComp(e.terms, week) }))
+  if (input.retention.kind === 'explicit') {
+    for (const id of input.retention.contractIds) if (!rows.some((r) => r.contractId === id)) return { kind: 'refusal', refusal: `unknownContract:${id}` }
+  }
+  const buyerFixed = weeklyFixedCost(state, input.buyerId)
+  const spendable = spendableCash(state, input.buyerId)
+  const targetCash = business.account.cash
+  const money = (retained: ReadonlySet<string>) => {
+    const exitCharges = rows.filter((r) => !retained.has(r.contractId)).reduce((s, r) => s + r.exitCost, 0)
+    const postExitCash = targetCash - exitCharges
+    const outlay = input.consideration - postExitCash
+    const kept = rows.filter((r) => retained.has(r.contractId))
+    const resultingWeeklyFixedCost = buyerFixed + kept.reduce((s, r) => s + r.weeklySalary, 0) + TUNING.OVERHEAD_PER_EMPLOYEE * kept.length
+    const reserveAfter = TUNING.RIGHTS_RESERVE_WEEKS * resultingWeeklyFixedCost
+    return { exitCharges, postExitCash, outlay, resultingWeeklyFixedCost, reserveAfter, affordable: spendable - outlay >= reserveAfter,
+      guarantees: kept.reduce((s, r) => s + r.guarantee, 0) }
+  }
+  const lawful = (r: Row): boolean => contractEndRefusal(state, r.talentId, r.endWeekExclusive) === null
+  const reasons = new Map<string, AbsorptionContractQuote['reason']>()
+  const retained = new Set<string>()
+  if (input.retention.kind === 'default') {
+    // The disclosed no-action default: target order, lawful, and affordable for the COMPLETE transaction.
+    for (const r of rows) {
+      if (!lawful(r)) { reasons.set(r.contractId, 'personRefusal'); continue }
+      const trial = new Set([...retained, r.contractId])
+      if (money(trial).affordable) retained.add(r.contractId)
+      else reasons.set(r.contractId, 'unaffordable')
+    }
+  } else {
+    const chosen = new Set(input.retention.contractIds)
+    for (const r of rows) {
+      if (!chosen.has(r.contractId)) { reasons.set(r.contractId, 'notSelected'); continue }
+      if (!lawful(r)) { reasons.set(r.contractId, 'personRefusal'); continue }
+      retained.add(r.contractId)
+    }
+  }
+  const m = money(retained)
+  const contracts: AbsorptionContractQuote[] = rows.map((r) => ({ ...r, retained: retained.has(r.contractId), reason: retained.has(r.contractId) ? null : reasons.get(r.contractId) ?? 'notSelected' }))
+  const employees = new Map(rows.map((r) => [r.talentId, r.contractId]))
+  const productions: AbsorptionProductionQuote[] = business.productions.map((p) => {
+    const participants = [p.writerId, p.directorId, ...p.craftIds, ...Object.values(p.cast)]
+    const missing = [...new Set(participants.filter((id) => employees.has(id) && !retained.has(employees.get(id)!)))]
+    return { productionId: p.id, disposition: missing.length === 0 ? 'continues' : 'cancelRequired', missingParticipants: missing }
+  })
+  const resolved = resolveTitles(state)
+  const rights = subjectsHeldBy(resolved, state.rights.estates, input.targetId, week)
+  const value = libraryValuationV1(state, input.targetId, week)
+  const research = (state.technology.projects ?? []).filter((p) => p.studioId === input.targetId && p.status !== 'completed' && p.status !== 'cancelled')
+    .map((p) => ({ projectId: p.id, disposition: 'cancelRetainingVerifiedProgress' as const }))
+  const facilities = business.operations.facilities.map((f) => ({ facilityId: f.id, disposition: 'remainsWithTargetHistory' as const }))
+  return { kind: 'quote', buyerId: input.buyerId, targetId: input.targetId, week, consideration: input.consideration, rights,
+    rightsValue: value.kind === 'available' ? value.total : null, contracts, exitCharges: m.exitCharges, targetCashBeforeExits: targetCash,
+    postExitCash: m.postExitCash, guarantees: m.guarantees, outlay: m.outlay, resultingWeeklyFixedCost: m.resultingWeeklyFixedCost,
+    reserveAfter: m.reserveAfter, affordable: m.affordable, productions, research, facilities }
+}
+
+/** Deferred by contract §2: refuses loudly, names the producer prerequisites, changes nothing. */
+export function closeAbsorption(_state: GameState, input: AbsorptionInput, week: number): never {
+  throw new Error(`absorption closing of ${input.targetId} by ${input.buyerId} at week ${week} is deferred: it requires the ${ABSORPTION_CLOSING_PREREQUISITES.join('; ')}. ` +
+    'Use quoteAbsorption for the preview (P16 contract §2, §5).')
+}
diff --git a/src/core/assetSale.ts b/src/core/assetSale.ts
new file mode 100644
index 00000000..67789339
--- /dev/null
+++ b/src/core/assetSale.ts
@@ -0,0 +1,255 @@
+// ── P16B: bilateral rights offers — whole-title sales (R1/R2) and R3 exclusive term licences ──
+//
+// Authority: P16 integration contract §3 (instruments; refuse overlapping exclusive scopes, unknown
+// subjects, over-wide grants, sublicensing; a title sale preserves live licences; an R1 sale or
+// exclusive R3 grant touching an active production refuses; an R2 sale during an active run refuses
+// until a receipt-assignment producer exists), §6 (permitted bidder at submission AND closing;
+// commitment reservation; bilateral quote -> acceptance -> atomic close or refusal/expiry; no
+// auction; anti-flip holdback; cooldown), §7 groups R/M; 1362-O §5.4/§5.7; P16A r3 (R4 has no
+// executable grant before a real P18 consumer).
+//
+// Pure. The same functions serve player and rival on either side. A refusal is a string reason;
+// the verb that acts on it throws and returns nothing else changed.
+
+import { bidderFacts, affordabilityRefusal, moveStudioCash, permittedBidderRefusal, postPurchaseReserve, spendableCash, type BidderFactsLookup } from './rightsFinance.js'
+import { allocateRightsId, appendTitleEvent, currentHolder, licenceInForce, parseStoryPropertyId, sameSubject, subjectKey,
+  type Licence, type RightSubject, type RightsInstrument, type RightsOffer, type RightsTransaction } from './rights.js'
+import { subjectValueV1 } from './propertyValuation.js'
+import { TUNING } from './tuning.js'
+import type { GameState } from './types.js'
+
+export type OfferInput = {
+  offerorId: string
+  counterpartyId: string
+  direction: 'buy' | 'sell'
+  instrument: RightsInstrument
+  price: number
+  disclosureId?: string | null
+}
+/** The player's verb payload: the offeror is always the player. */
+export type PlayerOfferInput = Omit<OfferInput, 'offerorId'>
+
+export const R3_USES: readonly string[] = ['sequel', 'remake', 'spinoff']
+
+export const instrumentSubject = (instrument: RightsInstrument): RightSubject => instrument.subject
+const buyerOf = (o: { direction: 'buy' | 'sell'; offerorId: string; counterpartyId: string }): string => (o.direction === 'buy' ? o.offerorId : o.counterpartyId)
+const sellerOf = (o: { direction: 'buy' | 'sell'; offerorId: string; counterpartyId: string }): string => (o.direction === 'buy' ? o.counterpartyId : o.offerorId)
+
+/** A title bought by `sellerId` cannot be resold inside RIGHTS_RESALE_HOLDBACK_WEEKS of its acquisition. */
+export function resaleHoldbackRefusal(state: GameState, subject: RightSubject, sellerId: string, week: number): string | null {
+  const acquired = state.rights.titleEvents
+    .filter((e) => sameSubject(e.subject, subject) && e.newHolder === sellerId && (e.cause === 'sale' || e.cause === 'estateSale') && e.date.kind === 'campaign')
+    .map((e) => (e.date as { week: number }).week)
+  if (acquired.length === 0) return null
+  return week - Math.max(...acquired) < TUNING.RIGHTS_RESALE_HOLDBACK_WEEKS ? 'resaleHoldback' : null
+}
+
+/** After a rejection the same offeror waits RIGHTS_OFFER_COOLDOWN_WEEKS before re-offering on the subject. */
+export function offerCooldownRefusal(state: GameState, offerorId: string, subject: RightSubject, week: number): string | null {
+  const rejected = state.rights.offers.filter((o) => o.offerorId === offerorId && o.status === 'rejected' && o.resolvedWeek !== null && sameSubject(instrumentSubject(o.instrument), subject))
+  if (rejected.length === 0) return null
+  return week - Math.max(...rejected.map((o) => o.resolvedWeek!)) < TUNING.RIGHTS_OFFER_COOLDOWN_WEEKS ? 'offerCooldown' : null
+}
+
+function activeProductionOn(state: GameState, propertyId: string): boolean {
+  const conceptId = parseStoryPropertyId(propertyId)
+  if (conceptId === null) return false
+  if (state.studio.activeProductions.some((p) => p.conceptId === conceptId)) return true
+  return (state.hollywood?.businesses ?? []).some((b) => b.productions.some((p) => p.conceptId === conceptId))
+}
+function activeRunOn(state: GameState, filmId: string): boolean {
+  if (state.theatricalRuns.some((r) => r.productionId === filmId && r.status === 'active')) return true
+  return (state.hollywood?.businesses ?? []).some((b) => b.runs.some((r) => r.productionId === filmId))
+}
+
+/** The instrument's own law for a seller/buyer pair at `week`; null when lawful. */
+export function instrumentRefusal(state: GameState, sellerId: string, direction: 'buy' | 'sell', instrument: RightsInstrument, week: number): string | null {
+  const subject = instrumentSubject(instrument)
+  if (instrument.kind === 'licence') {
+    if (instrument.right === 'R4') return 'r4ConsumerNotLive'
+    if (subject.right !== 'R1') return 'r3RequiresProperty'
+    if (!R3_USES.includes(instrument.scope.use)) return 'invalidScope'
+    if (!Number.isSafeInteger(instrument.startWeek) || !Number.isSafeInteger(instrument.endWeekExclusive) || instrument.startWeek < week || instrument.endWeekExclusive <= instrument.startWeek) return 'invalidTerm'
+    if (typeof instrument.exclusive !== 'boolean') return 'invalidTerm'
+  }
+  const holder = currentHolder(state, subject, week)
+  if (holder.kind === 'unavailable') return holder.reason === 'unknownSubject' ? 'unknownSubject' : `holderUnavailable:${holder.reason}`
+  if (holder.archived || holder.estate !== undefined || !holder.tradeable) return 'notTradeable'
+  if (holder.holderId !== sellerId) return direction === 'buy' ? 'counterpartyNotHolder' : 'offerorNotHolder'
+  if (subject.right === 'R1' && (instrument.kind === 'title' || instrument.exclusive) && activeProductionOn(state, subject.propertyId)) return 'activeProductionEncumbrance'
+  if (subject.right === 'R2' && instrument.kind === 'title' && activeRunOn(state, subject.filmId)) return 'activeRunEncumbrance'
+  if (instrument.kind === 'licence') {
+    const clash = state.rights.licences.some((l) => l.right === instrument.right && sameSubject(l.subject, subject) && l.scope.use === instrument.scope.use
+      && (l.exclusive || instrument.exclusive) && l.startWeek < instrument.endWeekExclusive && instrument.startWeek < l.endWeekExclusive)
+    if (clash) return 'exclusiveOverlap'
+  } else {
+    const holdback = resaleHoldbackRefusal(state, subject, sellerId, week)
+    if (holdback !== null) return holdback
+  }
+  return null
+}
+
+function disclosureRefusal(state: GameState, offerorId: string, counterpartyId: string, disclosureId: string | null | undefined, week: number): string | null {
+  if (disclosureId === null || disclosureId === undefined) return null
+  const record = state.rights.diligence.find((d) => d.id === disclosureId)
+  if (record === undefined || record.recipientId !== offerorId || record.target.kind !== 'studio' || record.target.studioId !== counterpartyId) return 'disclosureNotHeld'
+  return week >= record.staleFromWeek ? 'staleDisclosure' : null
+}
+
+/** The complete submission law; null when the offer may be made. */
+export function offerRefusal(state: GameState, input: OfferInput, week: number, facts: BidderFactsLookup = bidderFacts): string | null {
+  const h = state.hollywood
+  if (!h) return 'noIndustry'
+  if (input.offerorId === input.counterpartyId) return 'selfDealing'
+  for (const id of [input.offerorId, input.counterpartyId]) if (!h.identities.some((i) => i.studioId === id)) return 'unknownStudio'
+  if (!Number.isSafeInteger(input.price) || input.price < 0) return 'invalidPrice'
+  const buyer = buyerOf(input)
+  const seller = sellerOf(input)
+  const permitted = permittedBidderRefusal(state, buyer, week, facts)
+  if (permitted !== null) return `buyerNotPermitted:${permitted}`
+  const sellerIdentity = h.identities.find((i) => i.studioId === seller)!
+  if (sellerIdentity.enteredWeek === null) return 'sellerNotOperating'
+  const instrument = instrumentRefusal(state, seller, input.direction, input.instrument, week)
+  if (instrument !== null) return instrument
+  const subject = instrumentSubject(input.instrument)
+  const cooldown = offerCooldownRefusal(state, input.offerorId, subject, week)
+  if (cooldown !== null) return cooldown
+  if (state.rights.offers.some((o) => o.status === 'open' && o.offerorId === input.offerorId && o.counterpartyId === input.counterpartyId
+    && o.instrument.kind === input.instrument.kind && sameSubject(instrumentSubject(o.instrument), subject))) return 'duplicateOpenOffer'
+  const disclosure = disclosureRefusal(state, input.offerorId, input.counterpartyId, input.disclosureId, week)
+  if (disclosure !== null) return disclosure
+  if (input.direction === 'buy') {
+    const affordable = affordabilityRefusal(state, buyer, input.price)
+    if (affordable !== null) return affordable
+  }
+  return null
+}
+
+/** A binding offer: refuses loudly, else records it open with its reservation (a buy offer) until expiry. */
+export function makeOffer(state: GameState, input: OfferInput, week: number, facts: BidderFactsLookup = bidderFacts): { state: GameState; offer: RightsOffer } {
+  const refusal = offerRefusal(state, input, week, facts)
+  if (refusal !== null) throw new Error(`rights offer refused: ${refusal}`)
+  const allocated = allocateRightsId(state.rights, 'rights-offer')
+  const offer: RightsOffer = { id: allocated.id, week, offerorId: input.offerorId, counterpartyId: input.counterpartyId, direction: input.direction,
+    instrument: input.instrument, price: input.price, expiresWeek: week + TUNING.RIGHTS_OFFER_DURATION_WEEKS, status: 'open', resolvedWeek: null, transactionId: null, refusal: null }
+  return { state: { ...state, rights: { ...allocated.root, offers: [...allocated.root.offers, offer] } }, offer }
+}
+
+function requireOpenOffer(state: GameState, offerId: string, week: number): RightsOffer {
+  const offer = state.rights.offers.find((o) => o.id === offerId)
+  if (offer === undefined) throw new Error(`rights: unknown offer ${offerId}`)
+  if (offer.status !== 'open') throw new Error(`rights: offer ${offerId} is not open (${offer.status})`)
+  if (week >= offer.expiresWeek) throw new Error(`rights: offer ${offerId} is not open (expired at week ${offer.expiresWeek})`)
+  return offer
+}
+
+function resolveOffer(state: GameState, offerId: string, status: RightsOffer['status'], week: number, transactionId: string | null, refusal: string | null): GameState {
+  return { ...state, rights: { ...state.rights, offers: state.rights.offers.map((o) => (o.id === offerId ? { ...o, status, resolvedWeek: week, transactionId, refusal } : o)) } }
+}
+
+/** Everything the close must hold again at acceptance; null when the close may proceed. */
+export function closingRefusal(state: GameState, offer: RightsOffer, week: number, facts: BidderFactsLookup = bidderFacts): string | null {
+  const buyer = buyerOf(offer)
+  const permitted = permittedBidderRefusal(state, buyer, week, facts)
+  if (permitted !== null) return `buyerNotPermitted:${permitted}`
+  const instrument = instrumentRefusal(state, sellerOf(offer), offer.direction, offer.instrument, week)
+  if (instrument !== null) return instrument
+  // A buy offer's own reservation already sits inside spendable cash; a sell offer's buyer has committed nothing yet.
+  const afterPrice = offer.direction === 'buy' ? spendableCash(state, buyer) : spendableCash(state, buyer) - offer.price
+  if (afterPrice < postPurchaseReserve(state, buyer)) return 'insufficientCashAfterReserve'
+  return null
+}
+
+/** The atomic close: title event or licence, both cash moves, one transaction, the offer accepted. */
+function closeOffer(state: GameState, offer: RightsOffer, week: number): GameState {
+  const buyer = buyerOf(offer)
+  const seller = sellerOf(offer)
+  const subject = instrumentSubject(offer.instrument)
+  const txAllocated = allocateRightsId(state.rights, 'rights-tx')
+  let next: GameState = { ...state, rights: txAllocated.root }
+  const titleEventIds: string[] = []
+  let licenceId: string | null = null
+  if (offer.instrument.kind === 'title') {
+    const appended = appendTitleEvent(next, { subject, priorHolder: seller, newHolder: buyer, cause: 'sale', date: { kind: 'campaign', week }, source: { kind: 'transaction', transactionId: txAllocated.id } })
+    next = appended.state
+    titleEventIds.push(appended.event.id)
+  } else {
+    const licenceAllocated = allocateRightsId(next.rights, 'rights-licence')
+    const licence: Licence = { id: licenceAllocated.id, right: offer.instrument.right, subject, scope: offer.instrument.scope, exclusive: offer.instrument.exclusive,
+      grantorId: seller, granteeId: buyer, startWeek: offer.instrument.startWeek, endWeekExclusive: offer.instrument.endWeekExclusive, grantedWeek: week, transactionId: txAllocated.id }
+    licenceId = licence.id
+    next = { ...next, rights: { ...licenceAllocated.root, licences: [...licenceAllocated.root.licences, licence] } }
+  }
+  next = moveStudioCash(next, buyer, 'rightsConsideration', -offer.price, week, txAllocated.id)
+  next = moveStudioCash(next, seller, 'rightsConsideration', offer.price, week, txAllocated.id)
+  const transaction: RightsTransaction = { id: txAllocated.id, week, kind: offer.instrument.kind === 'title' ? 'titleSale' : 'licenceGrant', payerId: buyer, payeeId: seller,
+    estateId: null, amount: offer.price, subject, licenceId, offerId: offer.id, lotId: null, bidId: null, titleEventIds }
+  next = { ...next, rights: { ...next.rights, transactions: [...next.rights.transactions, transaction] } }
+  return resolveOffer(next, offer.id, 'accepted', week, txAllocated.id, null)
+}
+
+/** The counterparty accepts: every closing condition is held again, then the close is atomic. */
+export function acceptOffer(state: GameState, offerId: string, studioId: string, week: number, facts: BidderFactsLookup = bidderFacts): GameState {
+  const offer = requireOpenOffer(state, offerId, week)
+  if (offer.counterpartyId !== studioId) throw new Error(`rights: only the counterparty ${offer.counterpartyId} may accept offer ${offerId}`)
+  const refusal = closingRefusal(state, offer, week, facts)
+  if (refusal !== null) throw new Error(`rights offer refused at acceptance: ${refusal}`)
+  return closeOffer(state, offer, week)
+}
+
+export function rejectOffer(state: GameState, offerId: string, studioId: string, week: number): GameState {
+  const offer = requireOpenOffer(state, offerId, week)
+  if (offer.counterpartyId !== studioId) throw new Error(`rights: only the counterparty ${offer.counterpartyId} may reject offer ${offerId}`)
+  return resolveOffer(state, offerId, 'rejected', week, null, 'rejectedByCounterparty')
+}
+
+export function withdrawOffer(state: GameState, offerId: string, studioId: string, week: number): GameState {
+  const offer = requireOpenOffer(state, offerId, week)
+  if (offer.offerorId !== studioId) throw new Error(`rights: only the offeror ${offer.offerorId} may withdraw offer ${offerId}`)
+  return resolveOffer(state, offerId, 'withdrawn', week, null, null)
+}
+
+/** The provisional rival policy: sells at or above value × (100 + p) / 100, buys at or below value × (100 − p) / 100. */
+export function rivalWillingness(state: GameState, offer: Pick<RightsOffer, 'direction' | 'instrument' | 'price' | 'offerorId' | 'counterpartyId'>, week: number): { willing: boolean; reason: string; value: number | null } {
+  const subject = instrumentSubject(offer.instrument)
+  const valued = subjectValueV1(state, subject, week)
+  if (valued.kind !== 'available') return { willing: false, reason: `valueUnavailable:${valued.reason}`, value: null }
+  const p = TUNING.RIGHTS_WILLINGNESS_PREMIUM_PERCENT
+  const rivalSells = offer.direction === 'buy'
+  const threshold = rivalSells ? Math.ceil((valued.value * (100 + p)) / 100) : Math.floor((valued.value * (100 - p)) / 100)
+  const willing = rivalSells ? offer.price >= threshold : offer.price <= threshold
+  return { willing, reason: willing ? 'willing' : `notWilling:${rivalSells ? 'priceBelowAsk' : 'priceAboveBid'}:${threshold}`, value: valued.value }
+}
+
+/** Every open offer addressed to a rival is answered at the week boundary: closed when willing and lawful, else rejected with its reason. */
+export function answerRivalOffers(state: GameState, week: number, facts: BidderFactsLookup = bidderFacts): GameState {
+  const h = state.hollywood
+  if (!h) return state
+  let next = state
+  for (const offer of [...state.rights.offers].sort((a, b) => (a.id < b.id ? -1 : 1))) {
+    if (offer.status !== 'open' || offer.counterpartyId === h.playerStudioId || week >= offer.expiresWeek) continue
+    const willingness = rivalWillingness(next, offer, week)
+    if (!willingness.willing) { next = resolveOffer(next, offer.id, 'rejected', week, null, willingness.reason); continue }
+    const refusal = closingRefusal(next, offer, week, facts)
+    if (refusal !== null) { next = resolveOffer(next, offer.id, 'rejected', week, null, refusal); continue }
+    next = closeOffer(next, offer, week)
+  }
+  return next
+}
+
+/** Open offers at or past their expiry expire; their reservations release with them. */
+export function expireOffers(state: GameState, week: number): GameState {
+  let next = state
+  for (const offer of state.rights.offers) {
+    if (offer.status === 'open' && week >= offer.expiresWeek) next = resolveOffer(next, offer.id, 'expired', week, null, null)
+  }
+  return next
+}
+
+/** The buyer, seller and subject of an offer, for read models. */
+export function offerParties(offer: RightsOffer): { buyerId: string; sellerId: string; subject: RightSubject; key: string } {
+  const subject = instrumentSubject(offer.instrument)
+  return { buyerId: buyerOf(offer), sellerId: sellerOf(offer), subject, key: subjectKey(subject) }
+}
+
+export { licenceInForce }
