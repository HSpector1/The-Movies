+    const forgedLedger = clone(down)
+    ;(forgedLedger.state.ledger as Record<string, unknown>[]).push({ week: BASE_WEEK, kind: 'loanPrincipal', amount: 1000, note: 'forged' })
+    ;(forgedLedger.state.studio as { cash: number }).cash += 1000
