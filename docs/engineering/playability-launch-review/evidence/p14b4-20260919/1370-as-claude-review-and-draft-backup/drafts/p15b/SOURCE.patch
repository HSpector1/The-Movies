+    refuses(() => validateSaveV46(tampered((s) => { root(s).events.push({ ...root(s).events[0]! }) })), 'corporateCondition')
+    refuses(() => validateSaveV46(tampered((s) => { root(s).events[0]!.eventId = 'corporate-event-99' })), 'corporateCondition')
+    refuses(() => validateSaveV46(tampered((s) => { root(s).nextEvent = 1 })), 'corporateCondition')
