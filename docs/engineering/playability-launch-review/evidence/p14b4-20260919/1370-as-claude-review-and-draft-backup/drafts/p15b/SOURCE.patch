+    const wfc = studioWeeklyFixedCost(s138, R04)
+    const loan = loans[0]!
+    expect(loan).toMatchObject({ studioId: R04, contractedWeek: 138, weeklyFixedCostAtContract: wfc, principal: loanMaxPrincipal(wfc), lawVersion: 'studio-loan/v1' })
+    expect(loan.loanId).toMatch(/^corporate-loan-\d+$/)
+    expect(rivalMovement(s138, R04, 'loanPrincipal')).toBe(loan.principal)
+    expect(rivalCash(s137, R04)).toBeLessThan(0)
+    expect(rivalCash(s138, R04)).toBeGreaterThan(0)
+    // The distress event precedes the loan in the one sequence; the player never receives an automatic loan.
+    expect(loan.p15DomainSequence).toBeGreaterThan(eventsOf(s138, R04).find((e) => e.to === 'distress')!.p15DomainSequence)
+    expect(loansOf(negativePlayer(138).get(138)!, PLAYER)).toEqual([])
+    // §6.4/§3.2: the next boundary's facts carry the installment, cover is restored and the rival recovers.
