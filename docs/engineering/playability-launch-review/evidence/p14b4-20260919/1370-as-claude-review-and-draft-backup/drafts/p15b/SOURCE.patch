+
+describe('p15b2 save step: the root validator (1357-A §4.1; S3-S6)', () => {
+  it('condition-validate-records-and-ids', async () => {
+    const validateSaveV46 = step<(save: unknown) => Save>(await saveModule(), 'validateSaveV46')
+    expect(() => validateSaveV46(makeSave(borrowed()))).not.toThrow()
