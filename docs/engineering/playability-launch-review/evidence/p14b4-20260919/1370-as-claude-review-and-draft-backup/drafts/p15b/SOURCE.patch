+    refuses(() => validateSaveV46(tampered((s) => { root(s).events[1]!.from = 'recovery' })), 'corporateCondition')
+    refuses(() => validateSaveV46(tampered((s) => { (root(s).events[0]!.causes as { weeks: number }[])[0]!.weeks = 3 })), 'corporateCondition')
+    refuses(() => validateSaveV46(tampered((s) => { root(s).events[0]!.definitionVersion = 'corporate-condition/v9' })), 'corporateCondition')
