+    refuses(() => validateSaveV46(tampered((s) => { (root(s).studios[0]!.condition as { lowRun: number }).lowRun = -1 })), 'corporateCondition')
+    refuses(() => validateSaveV46(tampered((s) => { root(s).studios.push({ ...root(s).studios[0]!, studioId: 'studio-aca408ec-r05' }) })), 'corporateCondition')
+    refuses(() => validateSaveV46(tampered((s) => { root(s).version = 2 })), 'corporateCondition')
