+function initial309() {
+  const raw = gunzipSync(readFileSync(new URL(INPUT, import.meta.url))).toString('utf8')
+  expect(sha(raw)).toBe(INPUT_RAW_SHA)
+  const parsed: unknown = JSON.parse(raw), before = bytes(parsed)
