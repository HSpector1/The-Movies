+describe('580 case 1 — C7 witness: facility array order moves the prepare bill (RED on unchanged source)', () => {
+  it('a [0]<->[1] facility swap keeps every result field (facilities normalised) and, after C7, costs strictly more', () => {
+    const base = world().unscheduled
+    const facilities = base.operations.facilities
+    assert.ok(facilities.length >= 3, `UNCONSTRUCTIBLE: ${facilities.length} facilities; the swap needs a target at index >= 2`)
+    assert.notEqual(facilities[0]!.id, facilities[1]!.id, 'UNCONSTRUCTIBLE: facilities [0] and [1] share an id')
+    // 579-B Q7 fixture pin: every reservation sits at facility index >= 2, so the linear `find` (replay :526) visits
+    // BOTH [0] and [1] in either order and its `equal` charges (:319) sum identically today.
+    const reserved = base.operations.workflows.flatMap((row) => row.reservations.map((reservation) => reservation.facilityId))
+    assert.ok(reserved.length >= 1, 'UNCONSTRUCTIBLE: world().unscheduled holds no facility reservation')
+    for (const id of reserved) {
+      const index = facilities.findIndex((row) => row.id === id)
+      assert.ok(index >= 2, `UNCONSTRUCTIBLE: reservation on ${id} sits at facility index ${index}; the swap must not reach it`)
+    }
+    const swappedState: GameState = { ...base, operations: { ...base.operations,
+      facilities: [facilities[1]!, facilities[0]!, ...facilities.slice(2)] } }
+    // Horizon now+1, no commands: no owner-granted hold and no release inside one frame on this fixture (the wrap is
+    // the SECOND frame, 538 "2-week wrap"), so no grant/release-time `find` can reach index 0/1; asserted below.
+    const now = base.market.tick, horizon = now + 1
+    const original = replayStartedProductionPlans(startedInput(base, horizon, '580-c7-facility-order'))
+    const swapped = replayStartedProductionPlans(startedInput(swappedState, horizon, '580-c7-facility-order'))
+    console.log(`B4_BILL_580 ${JSON.stringify({ fixture: 'enumerator world().unscheduled (558/576 copy)', now, horizon,
+      plan: 'one plan, no commands', swap: [facilities[0]!.id, facilities[1]!.id],
+      original: original.preparationWork, swapped: swapped.preparationWork,
+      delta: swapped.preparationWork - original.preparationWork,
+      equalToday: swapped.preparationWork === original.preparationWork })}`)
+    const originalComplete = completeAttempts(original, 'original now+1')
+    const swappedComplete = completeAttempts(swapped, 'swapped now+1')
+    for (const attempt of originalComplete) {
+      const events = attempt.provenance.filter((row) => row.kind === 'ownerEvent' &&
+        (row.draft.kind === 'reservationGranted' || row.draft.kind === 'reservationReleased'))
+      assert.equal(events.length, 0, `UNCONSTRUCTIBLE: the now+1 route grants/releases a reservation ${JSON.stringify(events)}`)
+    }
+    // The projection carries the source facilities array by construction; pin that, then compare normalised.
+    expect(originalComplete.map((attempt) => attempt.projection.operations.facilities)).toStrictEqual([facilities])
+    expect(swappedComplete.map((attempt) => attempt.projection.operations.facilities)).toStrictEqual([swappedState.operations.facilities])
+    expect(normalised(swapped)).toStrictEqual(normalised(original))
+    // RED on unchanged source (both bills equal, printed above); GREEN once uniqueIds walks through sortedOutput:
+    // the swapped array inverts at index 1, so it pays the walk prefix PLUS the entire unchanged sort (579 §1).
+    expect(swapped.preparationWork).toBeGreaterThan(original.preparationWork)
+  })
+})
