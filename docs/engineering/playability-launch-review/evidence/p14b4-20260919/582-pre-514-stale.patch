+describe('580 case 2 — C7 protection: duplicate consumed identity refused in-order and out-of-order (GREEN both sides)', () => {
+  it('operations.facilities: an appended (in-order) and a prepended (out-of-order) duplicate both throw', () => {
+    const base = world().unscheduled
+    const facilities = base.operations.facilities
+    assert.ok(facilities.length >= 2, 'UNCONSTRUCTIBLE: fewer than two facilities')
+    for (let index = 1; index < facilities.length; index++) {
+      assert.ok(facilities[index - 1]!.id < facilities[index]!.id,
+        `UNCONSTRUCTIBLE: facilities not in ascending id order at ${index} (founding order, operations.ts :85-116)`)
+    }
+    const control = replayStartedProductionPlans(startedInput(base, base.market.tick, '580-c7-dup-control'))
+    completeAttempts(control, 'facilities control (zero span)')
+    const top = facilities[facilities.length - 1]!
+    const withFacilities = (rows: GameState['operations']['facilities']): GameState =>
+      ({ ...base, operations: { ...base.operations, facilities: rows } })
+    const run = (state: GameState): void => { replayStartedProductionPlans(startedInput(state, state.market.tick, '580-c7-dup')) }
+    expect(() => run(withFacilities([...facilities, top]))).toThrow(DUPLICATE) // in order: adjacent equal pair
+    expect(() => run(withFacilities([top, ...facilities]))).toThrow(DUPLICATE) // out of order: inversion at index 1
+  })
+  it('studio.activeProductions and operations.workflows: in-order and out-of-order duplicates each throw', () => {
+    const base = trio()
+    const control = replayStartedProductionPlans(startedInput(base, base.market.tick, '580-c7-dup-control'))
+    completeAttempts(control, 'trio control (zero span)')
+    const [p0, p1, p2] = sortBy(base.studio.activeProductions, (row) => row.id)
+    const [w0, w1, w2] = sortBy(base.operations.workflows, (row) => row.productionId)
+    assert.ok(p0 && p1 && p2 && w0 && w1 && w2, 'UNCONSTRUCTIBLE: trio lacks three productions/workflows')
+    assert.ok(p0.id < p1.id && p1.id < p2.id, 'UNCONSTRUCTIBLE: trio production ids are not strictly ascending after sort')
+    const withRows = (productions: GameState['studio']['activeProductions'], workflows: GameState['operations']['workflows']): GameState =>
+      ({ ...base, studio: { ...base.studio, activeProductions: productions }, operations: { ...base.operations, workflows } })
+    const run = (state: GameState): void => { replayStartedProductionPlans(startedInput(state, state.market.tick, '580-c7-dup')) }
+    // Productions: equal cardinality (replay :660) against the REAL unique workflows; :662 refuses before :663.
+    expect(() => run(withRows([p0, p1, p1], [w0, w1, w2]))).toThrow(DUPLICATE) // in order
+    expect(() => run(withRows([p1, p0, p1], [w0, w1, w2]))).toThrow(DUPLICATE) // out of order
+    // Workflows: the REAL unique productions pass :662; :663 refuses the duplicate productionId.
+    expect(() => run(withRows([p0, p1, p2], [w0, w1, w1]))).toThrow(DUPLICATE) // in order
+    expect(() => run(withRows([p0, p1, p2], [w1, w0, w1]))).toThrow(DUPLICATE) // out of order
+  })
+})
