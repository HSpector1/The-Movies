+// Staged only. Install byte-for-byte as tests/p14c3-force-order.test.ts after review.
+// Pure-input canonical outputs are captured on unchanged source before the writer;
+// parent separately pins their full bytes/RNG for the matched GREEN comparison.
+import assert from 'node:assert/strict'
+import { createHash } from 'node:crypto'
+import { readFileSync } from 'node:fs'
+import { afterAll, describe, expect, it } from 'vitest'
+import { applyActions } from '../src/core/actions.js'
+import { computeForecast, forecastCenters } from '../src/core/forecast.js'
+import { resolveReception } from '../src/core/reception.js'
+import type { ReceptionInputs } from '../src/core/reception.js'
+import { RngStream } from '../src/core/rng.js'
+import { exportSave, importSave, makeSave, stableStringify, validateSaveV38 } from '../src/core/save.js'
+import { tick } from '../src/core/tick.js'
+import type { Action, CulturalForce, GameState } from '../src/core/types.js'
+import { FORCE_ORDER } from '../src/core/worldgen.js'
+import { makeMarket, makeReceptionInputs, makeShapeEffects, makeTalent } from './_fixtures.js'
+
+const ORDER = ['escapism', 'patriotism', 'realism', 'darkness', 'optimism', 'spectacle'] as const
+const SORTED = [...ORDER].sort(), REVERSED = [...ORDER].reverse()
+const RNG = '1,2,3,4'
+const sha = (value: string | Buffer) => createHash('sha256').update(value).digest('hex')
+const canonical = (value: unknown) => stableStringify(value)
+const identity = (value: unknown) => { const bytes = canonical(value); return { bytes: Buffer.byteLength(bytes), sha256: sha(bytes) } }
+const values = [
+  { label: 'ordinary-nonuniform', weights: [13, 29, 47, 61, 83, 97] },
+  // Legal [0,100] values. Five 1e-16 normalized weights straddle one full
+  // darkness weight, so floating denominator order is a genuine discriminator.
+  { label: 'small-weight-denominator', weights: [1e-14, 1e-14, 1e-14, 100, 1e-14, 1e-14] },
+] as const
+function forceRecord(weights: readonly number[], order: readonly CulturalForce[]) {
+  expect(weights).toHaveLength(6)
+  expect(weights.every(value => Number.isFinite(value) && value >= 0 && value <= 100)).toBe(true)
+  return Object.fromEntries(order.map(key => [key, weights[ORDER.indexOf(key)]])) as Record<CulturalForce, number>
+}
+function pureInput(weights: readonly number[]): ReceptionInputs {
+  // Existing analytic ReceptionInputs fixture builders, explicitly synthetic;
+  // no generated campaign, historical facts, assignment or save is claimed here.
+  return makeReceptionInputs({
+    market: makeMarket({ forces: forceRecord(weights, ORDER) }),
+    writer: makeTalent({ id: 'force-writer', name: 'Force writer', role: 'writer', skill: 51,
+      actual: { warmth: 0.83, gravity: -0.37, physicality: 0.29 } }),
+    director: makeTalent({ id: 'force-director', name: 'Force director', role: 'director', skill: 63,
+      actual: { warmth: -0.47, gravity: 0.71, physicality: 0.11 } }),
+    cast: {
+      lead: makeTalent({ id: 'force-lead', name: 'Force lead', role: 'actor', skill: 67,
+        actual: { warmth: 0.27, gravity: -0.59, physicality: 0.61 } }),
+      antagonist: makeTalent({ id: 'force-antagonist', name: 'Force antagonist', role: 'actor', skill: 59,
+        actual: { warmth: -0.73, gravity: 0.43, physicality: 0.19 } }),
+      support: makeTalent({ id: 'force-support', name: 'Force support', role: 'actor', skill: 57,
+        actual: { warmth: 0.31, gravity: 0.17, physicality: -0.41 } }),
+    },
+    shapeEffects: makeShapeEffects({ expression: { intimacy: 0.13, tonalWeight: -0.23, kineticEnergy: 0.37 } }),
+  })
+}
+function orderInput(input: ReceptionInputs, order: readonly CulturalForce[]): ReceptionInputs {
+  const copy = structuredClone(input)
+  copy.market.forces = Object.fromEntries(order.map(key => [key, copy.market.forces[key]])) as Record<CulturalForce, number>
+  expect(canonical(copy)).toBe(canonical(input))
+  expect(Object.keys(copy.market.forces)).toEqual(order)
+  return copy
+}
+function emit(name: string, value: unknown) {
+  const line = JSON.stringify({ marker: 'C3_FORCE_ORDER_CONTROL', name, value })
+  expect(Buffer.byteLength(line)).toBeLessThanOrEqual(64 * 1024)
+  console.info(line)
+}
+const pureCalls = { reception: 0, centers: 0, forecast: 0 }
+function reception(input: ReceptionInputs) {
+  const before = JSON.stringify(input), rng = RngStream.deserialize(RNG)
+  expect(++pureCalls.reception).toBeLessThanOrEqual(11)
+  const result = resolveReception(input, rng)
+  expect(JSON.stringify(input)).toBe(before)
+  const expectedDraws = RngStream.deserialize(RNG)
+  expectedDraws.next(); expectedDraws.next()
+  expect(rng.serialize()).toBe(expectedDraws.serialize())
+  return { result, rng: rng.serialize() }
+}
+function forecast(input: ReceptionInputs) {
+  const before = JSON.stringify(input)
+  const context = { seed: 'c3-force-order', productionId: 'force-film', directorId: input.director.id,
+    releasedFilms: [], concepts: [] }
+  const contextBefore = JSON.stringify(context)
+  expect(++pureCalls.centers).toBeLessThanOrEqual(11)
+  const centers = forecastCenters(input)
+  expect(++pureCalls.forecast).toBeLessThanOrEqual(11)
+  const full = computeForecast(input, context)
+  expect(JSON.stringify(input)).toBe(before); expect(JSON.stringify(context)).toBe(contextBefore)
+  return { centers, full }
+}
+
+describe('C3 exact cultural-force order — independent pure boundaries', () => {
+  it.each(values)('reception preserves exact values and RNG under $label force-key permutations', ({ label, weights }) => {
+    expect(FORCE_ORDER).toEqual(ORDER)
+    const input = pureInput(weights), untouched = JSON.stringify(input)
+    const expected = reception(input)
+    expect(expected.result.delivered.intimacy ** 2 + expected.result.delivered.tonalWeight ** 2
+      + expected.result.delivered.kineticEnergy ** 2).toBeGreaterThan(0)
+    expect(expected.result.forceAlignment).not.toBe(0)
+    const swap = structuredClone(input)
+    const old = swap.market.forces.darkness
+    swap.market.forces.darkness = swap.market.forces.realism; swap.market.forces.realism = old
+    const changed = reception(swap)
+    expect(changed.result.forceAlignment).not.toBe(expected.result.forceAlignment)
+    if (label === 'small-weight-denominator') {
+      const orderedWeight = ORDER.reduce((sum, key) => sum + input.market.forces[key] / 100, 0)
+      const sortedWeight = SORTED.reduce((sum, key) => sum + input.market.forces[key] / 100, 0)
+      expect(orderedWeight).not.toBe(sortedWeight)
+    }
+    emit(`reception/${label}`, { input: identity(input), forces: input.market.forces, initialRng: RNG, ...expected })
+    const sorted = reception(orderInput(input, SORTED)), reversed = reception(orderInput(input, REVERSED))
+    expect(JSON.stringify(input)).toBe(untouched)
+    expect(sorted).toEqual(expected); expect(reversed).toEqual(expected)
+  })
+
+  it.each(values)('forecast preserves its complete result under $label force-key permutations', ({ label, weights }) => {
+    const input = pureInput(weights), untouched = JSON.stringify(input), expected = forecast(input)
+    const swap = structuredClone(input), old = swap.market.forces.darkness
+    swap.market.forces.darkness = swap.market.forces.realism; swap.market.forces.realism = old
+    expect(forecast(swap).centers.core.timelinessContribution).not.toBe(expected.centers.core.timelinessContribution)
+    emit(`forecast/${label}`, { input: identity(input), forces: input.market.forces, ...expected })
+    const sorted = forecast(orderInput(input, SORTED)), reversed = forecast(orderInput(input, REVERSED))
+    expect(JSON.stringify(input)).toBe(untouched)
+    expect(sorted).toEqual(expected); expect(reversed).toEqual(expected)
+  })
+
+  it('zero force weight keeps the exact guarded result across all three orders', () => {
+    const input = pureInput([0, 0, 0, 0, 0, 0]), expectedReception = reception(input), expectedForecast = forecast(input)
+    expect(expectedReception.result.forceAlignment).toBe(0)
+    expect(expectedReception.result.timelinessContribution).toBe(0)
+    expect(expectedForecast.centers.core.timelinessContribution).toBe(0)
+    emit('zero-force', { input: identity(input), initialRng: RNG, reception: expectedReception, forecast: expectedForecast })
+    for (const order of [SORTED, REVERSED]) {
+      const variant = orderInput(input, order)
+      expect(reception(variant)).toEqual(expectedReception)
+      expect(forecast(variant)).toEqual(expectedForecast)
+    }
+  })
+})
