+const E = '../docs/engineering/playability-launch-review/evidence/p14b4-20260919/'
+const INPUTS = {
+  failure: { path: '1052-c3-endurance-C-recording-v1/authority-failure.json', bytes: 3799064,
+    sha256: 'f1a7a70941b1d2804efd9173359a72d78330284c968afa53a9fbad26ecda085a' },
+  commands: { path: '1052-c3-endurance-A-observer-fixed/commands.jsonl', bytes: 352939,
+    sha256: 'd27e0ff3d1ed7132f0b68a2619b3b98123591f319a3a29fe3a3a4cb1f1c8e93c' },
+  authority: { path: '1052-c3-endurance-A-observer-fixed/authority-3120.json', bytes: 3644208,
+    sha256: '5fea7fc04ef6a16a636f376fcc4791f75f77926ead08ae0b598e566db9091050' },
+} as const
+type Trace = { week: number; ordinal: number; purpose: string; command: { kind: 'action'; action: Action };
+  status: string; reason: string | null; engineInvoked: boolean }
+function pinned(key: keyof typeof INPUTS): string {
+  const pin = INPUTS[key], raw = readFileSync(new URL(E + pin.path, import.meta.url))
+  expect(raw.length).toBe(pin.bytes); expect(sha(raw)).toBe(pin.sha256)
+  return raw.toString('utf8')
+}
+function authority(state: GameState) {
+  const save = makeSave(state)
+  expect(save.saveVersion).toBe(38)
+  return exportSave(save)
+}
+type Boundary = { phase: string; week: number; save: string; roots: Record<string, string> }
+function boundary(state: GameState, phase: string): Boundary {
+  const raw = authority(state)
+  return { phase, week: state.market.tick, save: sha(raw), roots: Object.fromEntries(
+    Object.entries(state).map(([key, value]) => [key, sha(canonical(value))])) }
+}
+let fixtureCache: ReturnType<typeof buildFixture> | undefined, fixtureFailure: unknown
+function buildFixture() {
+  const recorded = JSON.parse(pinned('failure')) as { lastQualifiedWeek: number; lastQualifiedSaveJson: string; observedWeek: number }
+  expect(recorded.lastQualifiedWeek).toBe(1300); expect(recorded.observedWeek).toBe(1352)
+  const raw = recorded.lastQualifiedSaveJson
+  expect(Buffer.byteLength(raw)).toBe(1658932)
+  expect(sha(raw)).toBe('da9b59ba6c453fa07c17560aa3001bbe9a9ce6ebb3d12695471b7fecbbd71d5d')
+  const accepted = validateSaveV38(importSave(raw))
+  expect(exportSave(accepted)).toBe(raw); expect(accepted.state.market.tick).toBe(1300)
+  expect(Object.keys(accepted.state.market.forces)).toEqual(SORTED)
+  expect(Object.values(accepted.state.market.forces)).toEqual([50, 50, 50, 50, 50, 50])
+  const allCommands = pinned('commands').trimEnd().split('\n').map(line => JSON.parse(line) as Trace)
+  const prior = allCommands.filter(row => row.ordinal === 240)
+  expect(prior).toHaveLength(1)
+  expect(prior[0]).toMatchObject({ week: 1300, purpose: 'slot-27-commission', status: 'ACCEPTED' })
+  expect(accepted.state.scriptDevelopment.projects.find(row => row.id === 'script-0027')).toMatchObject({
+    status: 'drafting', commissionedWeek: 1300,
+  })
+  const commands = allCommands.filter(row => row.ordinal >= 241 && row.ordinal <= 245)
+  expect(commands.map(row => [row.week, row.ordinal, row.command.kind, row.command.action.kind])).toEqual([
+    [1303, 241, 'action', 'acceptScript'], [1303, 242, 'action', 'greenlightScriptProject'],
+    [1307, 243, 'action', 'assignShootingDirector'], [1307, 244, 'action', 'scheduleShootingTake'],
+    [1311, 245, 'action', 'commitPictureToRelease'],
+  ])
+  expect(commands.every(row => row.status === 'ACCEPTED' && row.reason === null && row.engineInvoked)).toBe(true)
+  const old = validateSaveV38(importSave(pinned('authority'))).state
+  const films = old.studio.releasedFilms.filter(row => row.productionId === 'prod-1303')
+  expect(films).toHaveLength(1); expect(old.studio.releasedFilms[27]).toEqual(films[0])
+  expect(films[0]).toMatchObject({ releaseTick: 1311, criticMean: 66.97542585609143, criticScore: 52.82440066110527 })
+  const events = old.careerEvents.filter(row => row.filmId === 'prod-1303')
+  expect(events).toHaveLength(6); expect(old.careerEvents.slice(162, 168)).toEqual(events)
+  const history = old.studioHistory.rows.filter(row => row.kind === 'standingChanged'
+    && row.source.kind === 'releaseResult' && row.source.productionId === 'prod-1303')
+  expect(history).toHaveLength(1); expect(old.studioHistory.rows[87]).toEqual(history[0])
+  return { raw, commands, film: films[0]!, events, history: history[0]! }
+}
+function fixture() {
+  if (fixtureFailure !== undefined) throw fixtureFailure
+  if (fixtureCache !== undefined) return fixtureCache
+  try { return fixtureCache = buildFixture() } catch (error) { fixtureFailure = error; throw error }
+}
+type Route = { state: GameState; finalBytes: string; boundaries: Boundary[]; ticks: number; commands: number }
+const routes = new Map<string, Route>(), failures = new Map<string, unknown>()
+const routeCounts = { tickAttempts: 0, ticks: 0, commandAttempts: 0, commands: 0 }
+function route(kind: 'canonical-reconstruction' | 'actual-import'): Route {
+  if (failures.has(kind)) throw failures.get(kind)
+  const cached = routes.get(kind); if (cached !== undefined) return cached
+  try {
+    const f = fixture()
+    let state = validateSaveV38(importSave(f.raw)).state
+    if (kind === 'canonical-reconstruction') state = { ...state, market: { ...state.market,
+      forces: Object.fromEntries(ORDER.map(key => [key, state.market.forces[key]])) as Record<CulturalForce, number> } }
+    expect(Object.keys(state.market.forces)).toEqual(kind === 'actual-import' ? SORTED : ORDER)
+    expect(authority(state)).toBe(f.raw)
+    const boundaries = [boundary(state, 'initial1300')]
+    let ticks = 0, commands = 0
+    while (state.market.tick < 1312) {
+      for (const row of f.commands.filter(row => row.week === state.market.tick)) {
+        expect(commands).toBeLessThan(5); expect(routeCounts.commandAttempts).toBeLessThan(10)
+        routeCounts.commandAttempts++
+        state = applyActions(state, [structuredClone(row.command.action)])
+        commands++; routeCounts.commands++
+        expect(state.market.tick).toBe(row.week)
+        boundaries.push(boundary(state, `command${row.ordinal}`))
+      }
+      const from = state.market.tick
+      expect(ticks).toBeLessThan(12); expect(routeCounts.tickAttempts).toBeLessThan(24)
+      routeCounts.tickAttempts++
+      state = tick(state, { develop: true })
+      ticks++; routeCounts.ticks++
+      expect(state.market.tick).toBe(from + 1)
+      boundaries.push(boundary(state, `tick${from}->${state.market.tick}`))
+    }
+    expect(ticks).toBe(12); expect(commands).toBe(5)
+    const result = { state, finalBytes: authority(state), boundaries, ticks, commands }
+    routes.set(kind, result)
+    emit(`route/${kind}`, { ticks, commands, returnedWeek: state.market.tick, releaseWeek: state.studio.releasedFilms.at(-1)?.releaseTick,
+      final: { bytes: Buffer.byteLength(result.finalBytes), sha256: sha(result.finalBytes) }, rngState: state.rngState })
+    return result
+  } catch (error) { failures.set(kind, error); throw error }
+}
+function historicalWitness(state: GameState) {
+  const f = fixture(), film = state.studio.releasedFilms.filter(row => row.productionId === 'prod-1303')
+  expect(film).toHaveLength(1)
+  expect(state.studio.releasedFilms).toHaveLength(28)
+  expect(film[0]).toEqual(f.film)
+  expect(state.careerEvents.filter(row => row.filmId === 'prod-1303')).toEqual(f.events)
+  expect(state.studioHistory.rows.filter(row => row.kind === 'standingChanged'
+    && row.source.kind === 'releaseResult' && row.source.productionId === 'prod-1303')).toEqual([f.history])
+}
+
+describe('C3 genuine accepted1300 to release1311 — two reconstructed bounded branches', () => {
+  it('canonical insertion reconstruction preserves immutable A film27 and its actual six career events/history', () => {
+    historicalWitness(route('canonical-reconstruction').state)
+  })
+  it('actual canonical import produces exactly the same historical A release and development evidence', () => {
+    historicalWitness(route('actual-import').state)
+  })
+  it('both admitted branches agree at every complete-save boundary and in final bytes/RNG', () => {
+    const a = route('canonical-reconstruction'), b = route('actual-import')
+    expect(a.boundaries.map(row => [row.phase, row.week])).toEqual(b.boundaries.map(row => [row.phase, row.week]))
+    const differences = a.boundaries.flatMap((row, index) => {
+      const other = b.boundaries[index]!
+      return row.save === other.save ? [] : [{ phase: row.phase, week: row.week,
+        roots: Object.keys(row.roots).filter(key => row.roots[key] !== other.roots[key]), a: row.save, b: other.save }]
+    })
+    emit('paired-boundaries', { compared: a.boundaries.length, firstDifference: differences[0] ?? null,
+      differingBoundaries: differences.length, counts: routeCounts, rngEqual: a.state.rngState === b.state.rngState })
+    expect(differences).toEqual([])
+    expect(b.finalBytes).toBe(a.finalBytes); expect(b.state.rngState).toBe(a.state.rngState)
+  })
+})
+
+afterAll(() => {
+  for (const key of Object.keys(INPUTS) as (keyof typeof INPUTS)[]) pinned(key)
+  assert.ok(routeCounts.tickAttempts <= 24 && routeCounts.commandAttempts <= 10)
+  emit('bounded-counts', { pureCalls, routeCounts, succeededRoutes: [...routes.keys()], failedRoutes: [...failures.keys()] })
+})
