+it('ONE-SHOT: mint nine genuine outgoing-V29 fixtures only after accepted B-F2 and before P2', () => {
+  mintV29Corpus(APPROVED_FINAL_V29, import.meta.url, 9, snapshots)
+}, 180_000)
