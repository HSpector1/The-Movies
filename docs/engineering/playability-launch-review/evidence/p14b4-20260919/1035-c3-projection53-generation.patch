+        : evaluation?.reason === 'strongerPublicTuple' ? `Chose ${change.to} on the stronger public professional record.`
+          : `Recorded a change from acting to ${change.to}.`,
+    } : null,
+    industryRetiredWeek: final?.week ?? null,
