+
+// ── P15A.2 Wave 2 slice 2a — the Power Ranking archive and the one P15 allocator, Save44 ──
+// REFERENCE ONLY (record 1356-C): the step number is allocated at execution (1356-A §9,
+// 1355-F Amendment 4). Two top-level roots, the V40 pattern: `powerRanking` (1356-A §5) and
+// `p15Sequence` (1355-F2 item 1). The V44 validator proves the frozen V43 chain on the
+// stripped state, then the archive (1356-A §5 "after the frozen chain").
+function stripV44Roots(raw: Record<string, unknown>): Record<string, unknown> {
+  const { powerRanking: _archive, p15Sequence: _sequence, ...legacy } = raw;
+  return legacy;
+}
+
+export function validateSaveV44(save: unknown): SaveFileV44 {
+  if (!isRecord(save)) throw new Error('validateSaveV44: object required');
+  v12ExactKeys(save, ['saveVersion', 'seed', 'state', 'broadcastCache'], 'save');
+  if (save.saveVersion !== 44) throw new Error('validateSaveV44: expected version 44');
+  const raw = v14Record(checkEnvelope(save, 'validateSaveV44'), 'state');
+  if (!Object.hasOwn(raw, 'powerRanking')) throw new Error('validateSaveV44: the Power Ranking archive root is missing');
+  if (!Object.hasOwn(raw, 'p15Sequence')) throw new Error('validateSaveV44: the p15Sequence root is missing');
+  validateSaveV43({ ...save, saveVersion: 43, state: stripV44Roots(raw) });
+  validatePowerRankingArchive(raw);
+  return save as SaveFileV44;
+}
+
+/** Adds the empty archive at the save's own week and the allocator at 1. No past quarter is
+ * recorded (annex G.2); a second migration is a no-op. */
+export function convertV43ToV44(save: SaveFileV43): SaveFileV44 {
+  const validated = validateSaveV43(save);
+  const old = JSON.parse(JSON.stringify(validated)) as SaveFileV43;
+  return validateSaveV44({ ...old, saveVersion: 44, state: { ...old.state,
+    powerRanking: { version: 1, recordedFromWeek: old.state.market.tick, snapshots: [] },
+    p15Sequence: initialP15Sequence() } });
+}
+
+/** Lossless only while nothing is recorded: the empty archive and the allocator at 1 drop;
+ * a recorded quarter refuses by name. A round trip can only claim less history. */
+export function convertV44ToV43(save: SaveFileV44): SaveFileV43 {
+  const validated = validateSaveV44(save);
+  if (validated.state.powerRanking.snapshots.length > 0) {
+    throw new Error('migrateToV43: cannot downgrade or discard a recorded Power Ranking quarter');
+  }
+  const detached = JSON.parse(JSON.stringify(validated)) as SaveFileV44;
+  return validateSaveV43({ ...detached, saveVersion: 43,
+    state: stripV44Roots(detached.state as unknown as Record<string, unknown>) });
+}
+
+export function migrateToV44(save: SaveFile | { saveVersion: number }): SaveFileV44 {
+  if (save.saveVersion === 44) return validateSaveV44(save);
+  return convertV43ToV44(migrateToV43(save));
