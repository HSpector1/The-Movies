+  }
+  return fn as T
+}
+function requireConst<T>(mod: Record<string, unknown>, name: string): T {
+  if (!Object.hasOwn(mod, name)) {
+    throw new Error(`RED: src/core/relationshipLabels.ts does not export '${name}'.`)
+  }
+  return mod[name] as T
+}
