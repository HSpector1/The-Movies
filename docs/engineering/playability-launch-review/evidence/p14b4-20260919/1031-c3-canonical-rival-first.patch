+    .toEqual([{ personId: id, profession: 'actor', kind: 'entrant', recordedWeek: 0 }])
+  expect(state.talentProvenance.rows.find(row => row.personId === id)).toEqual(initial.talentProvenance.rows.find(row => row.personId === id))
