+    expect(committed.operations).toEqual(state.operations)
+    expect(committed.releaseAuthority.commitments).toHaveLength(1)
+    const detail = releaseModule.commitPictureToReleaseRefusal(committed, id)
+    assert.ok(detail !== null)
+    expect(detail).toContain('already committed to release')
+    expect(detail).toContain(committed.releaseAuthority.commitments[0]!.commitmentId)
+    const committedBefore = clone(committed)
+    assert.throws(() => applyActions(committed, [{ kind: 'commitPictureToRelease', productionId: id }]),
+      { message: `applyActions: commitPictureToRelease rejected — ${detail}` })
+    expect(committed).toEqual(committedBefore)
+    const first: StartedProductionCommand = { week, ordinal: 0, productionId: id, kind: 'commitRelease' }
+    const second: StartedProductionCommand = { week, ordinal: 1, productionId: id, kind: 'commitRelease' }
+    const value = input(state, 1, [first, second]), beforeInput = clone(value)
