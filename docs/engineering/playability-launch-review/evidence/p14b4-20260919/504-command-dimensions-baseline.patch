+    try {
+      const seen = observed(value), attempt = seen.attempt
+      if (attempt.kind !== 'cut') throw new Error('504 duplicate same-week commit unexpectedly completed')
+      expect(attempt.reason).toBe('commandRefused')
+      expect(attempt.detail).toBe(detail)
+      expect(attempt.through.week).toBe(week)
+      expect(commitSpy.mock.calls).toEqual([[state.releaseAuthority, id, week]])
+      expect(writes).toEqual([committed.releaseAuthority])
+      expect(seen.calls).toEqual([])
+      expect(attempt.provenance.filter((row) => row.kind === 'sweepStarted' || row.kind === 'releaseAdmitted' || row.kind === 'firstTake')).toEqual([])
+      const firstCommands = attempt.provenance.filter((row) => row.kind === 'command' && row.command.ordinal === 0)
