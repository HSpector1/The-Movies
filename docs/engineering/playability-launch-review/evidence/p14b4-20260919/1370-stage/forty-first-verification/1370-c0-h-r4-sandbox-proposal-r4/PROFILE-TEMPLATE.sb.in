(version 1)
(deny default)
(allow process*)
(allow file-read*)
(allow mach-lookup)
(deny file-write* (subpath "{{CANONICAL_PRODUCTION}}"))
(deny file-write* (subpath "{{CANONICAL_PROTECTED_H}}"))
(deny file-write* (subpath "{{CANONICAL_EVIDENCE_CHECKOUT_IF_ANY}}"))
(deny file-write* (subpath "{{CANONICAL_DENIED_CANARY}}"))
(allow file-write* (subpath "{{EXACT_CONTROL_SOURCE}}"))
(allow file-write* (subpath "{{EXACT_CONTROL_DEPENDENCIES}}"))
(allow file-write* (subpath "{{EXACT_INSTRUMENTED_SOURCE}}"))
(allow file-write* (subpath "{{EXACT_INSTRUMENTED_DEPENDENCIES}}"))
(allow file-write* (subpath "{{EXACT_ONE_SHOT_OUTPUT}}"))
(allow file-write* (subpath "{{EXACT_ONE_SHOT_LOGS}}"))
(allow file-write* (subpath "{{EXACT_ONE_SHOT_TEMP}}"))
