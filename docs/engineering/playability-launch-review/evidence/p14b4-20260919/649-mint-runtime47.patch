+  assert.equal(sha(readFileSync(new URL('MANIFEST.json', originDirectory))), LEGACY_ORIGIN.manifestSha256)
+  const originRaw = gunzipSync(originCompressed).toString('utf8')
+  assert.equal(sha(originRaw), LEGACY_ORIGIN.uncompressedSha256)
+  const originProvenance = JSON.parse(readFileSync(new URL(LEGACY_ORIGIN.filename.replace('.json.gz', '.provenance.json'), originDirectory), 'utf8'))
+  assert.equal(originProvenance.compressedSha256, LEGACY_ORIGIN.compressedSha256)
+  assert.equal(originProvenance.uncompressedSha256, LEGACY_ORIGIN.uncompressedSha256)
+  assert.equal(originProvenance.authority.testedSourceSha, LEGACY_ORIGIN.testedSourceSha)
+  assert.equal(originProvenance.authority.publishedRecoverySha, LEGACY_ORIGIN.publishedRecoverySha)
+  assert.equal(originProvenance.authority.saveVersion, 29)
+  assert.equal(originProvenance.authority.promiseRulesVersion, 3)
+  const originSave = validateSaveV29(JSON.parse(originRaw)) // the actual frozen old reader first
+  assert.equal(exportSave(originSave), originRaw)
+  const migrated = migrateToV30(importSave(originRaw)) // the real live load-to-play route
+  assert.equal(migrated.saveVersion, 30)
+  assert.deepEqual(migrated.state, originSave.state) // every root and receipt carried unchanged
+  assert.deepEqual(JSON.parse(exportSave(migrated)), { ...JSON.parse(originRaw), saveVersion: 30 })
+  const legacyId: unknown = originProvenance.focus[0].promiseId
+  assert.ok(typeof legacyId === 'string')
+  const legacy = root(migrated.state, legacyId)
+  assert.equal(legacy.family, 'LEAD_OR_SIGNIFICANT_ROLE_COUNT')
+  assert.deepEqual(legacy.predicate, { count: 1 })
+  assert.equal(legacy.version, 3)
+  assert.equal(legacy.feasibilityReceipt.rulesVersion, 3)
+  assert.equal(legacy.feasibilityReceipt.classification, 'IMPOSSIBLE')
+  assert.equal(legacy.contractId, null)
+  assert.equal(legacy.outcome, null)
+  assert.deepEqual(legacy.feasibilityReceipt, originProvenance.focus[0].originalFeasibilityReceipt)
+  assert.ok(currentProposals(migrated.state, legacy.beneficiaryPersonId).some((p) => p.promises.includes(legacyId)))
+
+  // Selection changes only provenance focus, never the saved campaign. Retain
+  // ALL historical roots, including abandoned unbound ones, and their receipts.
+  assert.equal(JSON.stringify(rival.open), rivalOpenBefore, 'rival open snapshot changed while preparing focus')
+  for (const focus of rivalCurrentFocus) assert.deepEqual(root(rival.open, focus.promiseId).feasibilityReceipt, focus.originalFeasibilityReceipt)
+  const rivalFamilies = [...new Set(rivalCurrentFocus.map((focus) => focus.family))].sort()
+  return [
