+export function validateSaveV42(save: unknown): SaveFileV42 {
+  if (!isRecord(save)) throw new Error('validateSaveV42: object required');
+  v12ExactKeys(save, ['saveVersion', 'seed', 'state', 'broadcastCache'], 'save');
