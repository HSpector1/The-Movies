+def validate_null_device():
+    path = Path('/dev/null')
+    before = path.lstat()
+    if (path.resolve(strict=True) != path or not stat.S_ISCHR(before.st_mode) or
+            before.st_uid != 0 or before.st_gid != 0 or before.st_nlink != 1 or
+            stat.S_IMODE(before.st_mode) != 0o666 or before.st_rdev != 50331650):
+        raise RuntimeError('STOP_DEVNULL_IDENTITY')
+    after = path.lstat()
+    # Character-device I/O timestamps are not protected regular-file metadata.
+    if ((before.st_dev, before.st_ino, before.st_mode, before.st_uid,
+         before.st_gid, before.st_nlink, before.st_rdev) !=
+            (after.st_dev, after.st_ino, after.st_mode, after.st_uid,
+             after.st_gid, after.st_nlink, after.st_rdev)):
+        raise RuntimeError('STOP_DEVNULL_IDENTITY_RACE')
+    return {'path': str(path), 'type': 'character', 'device': before.st_dev,
+            'inode': before.st_ino, 'mode': '0666', 'uid': 0, 'gid': 0,
+            'links': 1, 'rdev': before.st_rdev}
+
