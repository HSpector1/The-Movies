+// ── the Started producer input: enumerator-slice :243-251 source, started-owner-replay :121-127 shape ──
+function startedSource(state: GameState): StartedOwnerSource<Production> {
+  return { technology: state.technology, market: { tick: state.market.tick },
+    placement: state.placement, property: state.property, hollywood: state.hollywood,
+    operations: state.operations, sets: state.sets, releaseAuthority: state.releaseAuthority,
+    scriptDevelopment: state.scriptDevelopment, castingSessions: state.castingSessions,
+    construction: state.construction, physicalPlans: state.physicalPlans,
+    productionQueue: state.productionQueue, founding: state.founding, firstTakes: state.firstTakes,
+    concepts: state.concepts, studio: { activeProductions: state.studio.activeProductions } }
+}
+/** ONE plan with no commands (the enumerator's own Started run shape, enumerator-slice :253-258). */
+function startedInput(state: GameState, horizonEndWeek: number, traceKey: string): StartedOwnerReplayInput<Production> {
+  return { source: startedSource(state), issuerId: player(state),
+    claimPersonIds: state.studio.activeProductions.map((row) => row.cast.lead),
+    plans: [{ traceKey, commands: [] }], horizonEndWeek, preparationWork: 0,
+    limits: { work: LIMITS.work, span: LIMITS.span, alternatives: LIMITS.alternatives } }
+}
+function completeAttempts(result: Result, label: string): Complete[] {
+  assert.ok(result.attempts.length >= 1, `UNCONSTRUCTIBLE: ${label} produced no attempt; omissions ${JSON.stringify(result.omissions)}`)
+  return result.attempts.map((attempt) => {
+    assert.ok(attempt.kind === 'complete', `UNCONSTRUCTIBLE: ${label} was cut ` +
+      `(${attempt.kind === 'cut' ? `${attempt.reason}: ${attempt.detail}` : attempt.kind}); omissions ${JSON.stringify(result.omissions)}`)
+    return attempt
+  })
+}
+/** Every result field except preparationWork, with projection.operations.facilities sorted by id (579-B Q7: the
+ * projection carries the source array by construction, replay :2723 / :2782). */
+function normalised(result: Result) {
+  const { preparationWork: _bill, ...rest } = result
+  return { ...rest, attempts: result.attempts.map((attempt) => attempt.kind !== 'complete' ? attempt : { ...attempt,
+    projection: { ...attempt.projection, operations: { ...attempt.projection.operations,
+      facilities: sortBy(attempt.projection.operations.facilities, (row) => row.id) } } }) }
+}
