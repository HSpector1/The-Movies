+    phase: 'shooting', blocker: null, shootingTask: { status: 'ready' } })
+  state = applyActions(state, [{ kind: 'scheduleShootingTake', productionId: film.id }])
+  expect(state.operations.workflows.find((w) => w.productionId === film.id)).toMatchObject({
+    phase: 'shooting', blocker: null, shootingTask: { status: 'scheduled' } })
+  expect(state.firstTakes.filter((t) => t.productionId === film.id)).toEqual([])
+  cached = { opened: live(opened), unscheduled: live(unscheduled), ready: live(state), actors, ids, productionId: film.id,
+    projects: [first.projectId, second.projectId], directorId: director.id, craftId: craft.id, writerId: writer.id, start }
+  return structuredClone(cached)
+}
+
+// ── trio(): three distinct real productions (case 2's workflow rows), started-owner-replay :66-75 pattern ──
+let trioCache: GameState | undefined
+function trio(): GameState {
+  if (trioCache !== undefined) return structuredClone(trioCache)
+  // richFoundedStudio depth widens the founding roster (contract fixtures :174-195); operations managed, legacy scripts;
+  // fresh industry initialised at ACTUAL week 0 before any greenlight (started-owner-replay :69-70).
+  let state = initializeHollywood(applyActions(richFoundedStudio('p13a-production-consumer',
+    { actor: 9, director: 3, writer: 3, craft: 3 }), [{ kind: 'activateStudioOperations' }]), 'fresh')
+  for (const role of ['actor', 'director', 'writer', 'craft'] as const) {
+    const needed = role === 'actor' ? 9 : 3
+    assert.ok(contractedByRole(state, role).length >= needed,
+      `UNCONSTRUCTIBLE: trio needs ${needed} contracted ${role}s, founding signed ${contractedByRole(state, role).length}`)
+  }
+  for (let offset = 0; offset < 2; offset++) state = applyActions(state, [{ kind: 'greenlight', production: productionPayload(state, offset) }])
+  // Development & Casting has two founding slots (tuning :632) held through Development AND preProduction (contract
+  // fixtures :58-66): tick until neither picture holds a development-casting reservation, then greenlight the third.
+  const holdsDevelopment = (): boolean => state.operations.workflows.some((row) =>
+    row.reservations.some((reservation) => reservation.capability === 'development-casting'))
+  for (let guard = 0; guard < 8 && holdsDevelopment(); guard++) state = tick(state)
+  assert.ok(!holdsDevelopment(), 'UNCONSTRUCTIBLE: the first two trio pictures never released Development & Casting within 8 real ticks')
+  state = applyActions(state, [{ kind: 'greenlight', production: productionPayload(state, 2) }])
+  assert.equal(state.studio.activeProductions.length, 3, 'UNCONSTRUCTIBLE: the third trio greenlight was not admitted')
+  assert.deepEqual(state.productionQueue, [], 'UNCONSTRUCTIBLE: trio left a production queued (replay :629 would context-cut first)')
+  assert.equal(new Set(state.studio.activeProductions.map((row) => row.id)).size, 3, 'UNCONSTRUCTIBLE: trio production ids are not distinct')
+  assert.deepEqual(sortBy(state.operations.workflows.map((row) => row.productionId), (id) => id),
+    sortBy(state.studio.activeProductions.map((row) => row.id), (id) => id), 'UNCONSTRUCTIBLE: trio workflows do not join its productions 1:1')
+  makeSave(state)
+  trioCache = structuredClone(state)
+  return structuredClone(trioCache)
+}
