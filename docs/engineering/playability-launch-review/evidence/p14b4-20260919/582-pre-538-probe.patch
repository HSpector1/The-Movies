+/** Pins the three module-built schemas on every complete attempt and derives close counts from the outputs
+ * (579-B Q6): fixed closes = fixedHoldReplacements.length; non-fixed closes = additionalHolds whose `until` is
+ * no longer the prepared end { week: horizonEndWeek, step: 0 } (replay :542; :755 / :1647 run every hold to it). */
+function keySetsAndCloses(result: Result, horizonEndWeek: number, label: string): { fixedCloses: number; nonFixedCloses: number } {
+  const isEnd = (boundary: Readonly<{ week: number; step: number }>): boolean => boundary.week === horizonEndWeek && boundary.step === 0
+  for (const hold of result.fixedHolds) {
+    expect(Object.keys(hold)).toEqual([...FIXED_HOLD_KEYS])
+    assert.ok(isEnd(hold.until), `UNCONSTRUCTIBLE: ${label} fixed hold ${hold.holdId} does not run to the prepared end ${JSON.stringify(hold.until)}`)
+  }
+  let fixedCloses = 0, nonFixedCloses = 0
+  for (const attempt of completeAttempts(result, label)) {
+    for (const hold of attempt.trace.additionalHolds) {
+      expect(Object.keys(hold)).toEqual([...HOLD_KEYS])
+      if (!isEnd(hold.until)) nonFixedCloses++
+    }
+    for (const row of attempt.trace.fixedHoldReplacements) expect(Object.keys(row)).toEqual([...REPLACEMENT_KEYS])
+    fixedCloses += attempt.trace.fixedHoldReplacements.length
+  }
+  return { fixedCloses, nonFixedCloses }
+}
