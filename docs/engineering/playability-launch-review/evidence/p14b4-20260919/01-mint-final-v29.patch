+// DRAFT / DO NOT RUN before qualified B-F2 / final outgoing-V29 publication.
+// Future ONE-SHOT installation: tests/bridge-p14b4-mint-v29.test.ts.
+// Run only this file, one worker, then archive/remove it from test discovery.
+// Uses existing B2 Vitest-backed fixture builders unchanged; not a vite-node job.
+import assert from 'node:assert/strict'
+import { it } from 'vitest'
+import { BridgeSession } from '../bridge/session.ts'
+import { PROTOCOL_VERSION, SCHEMA_ID } from '../bridge/protocol.ts'
+import type { BridgeMarketProposalDraftPayload } from '../bridge/schema/bridge-schema.ts'
+import { attachPromise } from '../src/core/promises.js'
+import { currentProposals, submitProposal } from '../src/core/talentMarket.js'
