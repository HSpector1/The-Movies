+import { p13aGeneratedStudio, player, retentionFixture, rivalFixture } from './helpers/p14b2-fixtures.js'
+import { mintV29Corpus, type MinterAuthority, type Snapshot } from '../scripts/v29-mint-support.js'
+
+// These invalid sentinels intentionally make the draft non-executable. ONLY the
+// parent fills them after accepted B-F2 (or exact final-V29 upstream) tested
+// source, closeout, push and remote verification, BEFORE P2 changes the writer.
+const APPROVED_FINAL_V29: MinterAuthority = {
+  phase: 'qualified B-F2 / exact last-V29 upstream before P2',
+  testedSourceSha: '89b5ad2cfc6947ea07fb043ef5b23eba38d7dbde',
+  publishedRecoverySha: 'c06db6eae2a1350317c018c6f108d115dcba7b19',
