+  // B3 revision2 and B-F2 revision3 plan no wire/save change. Reconcile any
+  // later authorized upstream change against acceptance, never restamp bytes.
+  schemaId: 'sha256:584bdd8565030f049d548b1af4fcbf8c517ca7c9150016736f632f1ef8fcb98c',
+  projectionVersion: 46,
+  protocolVersion: 4,
+  saveVersion: 29,
