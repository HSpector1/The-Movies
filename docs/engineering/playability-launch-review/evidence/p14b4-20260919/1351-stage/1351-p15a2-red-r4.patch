+    //         that same film also counts as 1 release -> releasesTenths=25.
+    //         pointsTenths = 50+25 = 75.
+    //   HIGH: 0 finished films (filmsTenths=0); 3 unfinished releases ->
+    //         releasesTenths = 10*min(3,4)/4*10 = 75. pointsTenths = 0+75 = 75.
+    // Presentation order among a tie is studioId ascending ('ALPHA' < 'ZETA'),
+    // so the ID-STRING SEQUENCE in `rows` is ['ALPHA','ZETA'] in BOTH setups
+    // below (it is a property of the two ID strings, not of the facts
+    // attached to them) -- ranks stay 1,1 in both setups too, trivially,
+    // since the pair is tied either way. What the charter's clause actually
+    // pins is that WHICH FACT-SET occupies the first ('ALPHA') vs second
+    // ('ZETA') slot swaps when the IDs attached to the two fact-sets are
+    // swapped -- i.e. presentation position tracks the ID label alone, never
+    // an internal identity that persists across the swap.
+    const lowFilm = (owner: string) => film({ filmId: `${owner}-LOWFILM`, studioId: owner, releaseTick: 10, criticScore: 0, totalGross: BMV })
+    const highReleases = (owner: string) =>
+      Array.from({ length: 3 }, (_, i) => film({ filmId: `${owner}-HR${i}`, studioId: owner, releaseTick: 10, runEndedByWeek: false }))
+    function buildInput(lowOwner: string, highOwner: string): InputFixture {
+      return {
+        week: 52,
+        originWeek: 0,
+        baseMarketValue: BMV,
+        studios: [studio({ studioId: lowOwner }), studio({ studioId: highOwner })],
+        films: [lowFilm(lowOwner), ...highReleases(highOwner)],
+      }
+    }
+    const setupA = computePowerRanking(buildInput('ALPHA', 'ZETA')) // ALPHA=LOW, ZETA=HIGH
+    const setupB = computePowerRanking(buildInput('ZETA', 'ALPHA')) // ZETA=LOW, ALPHA=HIGH -- IDs swapped
+    for (const snapshot of [setupA, setupB]) {
+      expect(snapshot.rows.map((r: any) => r.studioId)).toEqual(['ALPHA', 'ZETA']) // ID-sequence invariant
+      for (const row of snapshot.rows) {
+        expect(row.ranked).toBe(true)
+        expect(row.rank).toBe(1) // ranks stay 1,1 in both setups
+        expect(row.pointsTenths).toBe(75)
+      }
+    }
+    // the presentation order of the FACTS flips: the 'ALPHA' slot holds LOW's
+    // facts in setup A but HIGH's facts in setup B, and vice versa for 'ZETA'.
+    expect(rowFor(setupA.rows, 'ALPHA').filmsTenths).toBe(50) // LOW
+    expect(rowFor(setupA.rows, 'ZETA').filmsTenths).toBe(0) // HIGH
+    expect(rowFor(setupB.rows, 'ALPHA').filmsTenths).toBe(0) // HIGH now
+    expect(rowFor(setupB.rows, 'ZETA').filmsTenths).toBe(50) // LOW now
+  })
+
+  it('compute-power-ranking-id-and-owner-swap-symmetry', async () => {
+    const mod = await loadPowerRanking()
+    const computePowerRanking = requireFn<(input: InputFixture) => any>(mod, 'computePowerRanking')
+    // RankingStudio/RankingInput carry no role/player field at all (see the
+    // standing-independence structural leaves below), so "owner swap" and "id
+    // swap" collapse to the same check: the same facts, relabelled under a
+    // different studioId, must produce the same lanes/band/rank -- proving no
+    // special-cased identity exists anywhere in the pure law.
+    const factsA = { cash: 5_000, weeklyFixedCost: 1_000, criticScore: 80, totalGross: BMV, releases: 2 }
+    const factsB = { cash: 50_000, weeklyFixedCost: 500, criticScore: 20, totalGross: 0, releases: 0 }
+    // filmId is built from a fact-set-fixed LABEL ('FACTSA'/'FACTSB'), not
+    // from the owning studioId -- so swapping which studioId currently holds
+    // a fact-set does not change that fact-set's own filmId strings, and
+    // `countedFilmIds` becomes directly comparable across the swap (1351-D
+    // non-blocking note 3).
+    function buildInput(idOfA: string, idOfB: string): InputFixture {
+      const filmsFor = (owner: string, label: string, f: typeof factsA) => [
+        film({ filmId: `${label}-main`, studioId: owner, releaseTick: 10, criticScore: f.criticScore, totalGross: f.totalGross }),
+        ...Array.from({ length: f.releases }, (_, i) => film({ filmId: `${label}-rel${i}`, studioId: owner, releaseTick: 10, runEndedByWeek: false })),
+      ]
+      return {
+        week: 52,
+        originWeek: 0,
+        baseMarketValue: BMV,
+        studios: [
+          studio({ studioId: idOfA, cash: factsA.cash, weeklyFixedCost: factsA.weeklyFixedCost }),
+          studio({ studioId: idOfB, cash: factsB.cash, weeklyFixedCost: factsB.weeklyFixedCost }),
+        ],
+        films: [...filmsFor(idOfA, 'FACTSA', factsA), ...filmsFor(idOfB, 'FACTSB', factsB)],
+      }
+    }
+    const original = computePowerRanking(buildInput('A', 'B'))
+    const swapped = computePowerRanking(buildInput('B', 'A'))
+    const rowAOriginal = rowFor(original.rows, 'A')
+    const rowASwapped = rowFor(swapped.rows, 'A') // now holds factsB's data
+    const rowBOriginal = rowFor(original.rows, 'B')
+    const rowBSwapped = rowFor(swapped.rows, 'B') // now holds factsA's data
+    for (const key of ['ranked', 'rank', 'filmsTenths', 'releases', 'releasesTenths', 'pointsTenths', 'band'] as const) {
+      expect(rowASwapped[key]).toEqual(rowBOriginal[key])
+      expect(rowBSwapped[key]).toEqual(rowAOriginal[key])
+    }
+    // countedFilmIds: order-insensitive (Set) comparison, now meaningful
+    // because filmId no longer embeds the (swapped) owner id.
+    expect(new Set(rowASwapped.countedFilmIds)).toEqual(new Set(rowBOriginal.countedFilmIds))
+    expect(new Set(rowBSwapped.countedFilmIds)).toEqual(new Set(rowAOriginal.countedFilmIds))
+  })
+
+  it('compute-power-ranking-determinism-byte-identical-two-calls', async () => {
+    const mod = await loadPowerRanking()
+    const computePowerRanking = requireFn<(input: InputFixture) => any>(mod, 'computePowerRanking')
+    const buildInput = (): InputFixture => ({
+      week: 78,
+      originWeek: 0,
+      baseMarketValue: BMV,
+      studios: [studio({ studioId: 'X', cash: 3_000, weeklyFixedCost: 250 }), studio({ studioId: 'Y', cash: 9_000, weeklyFixedCost: 100 })],
+      films: [
+        film({ filmId: 'X1', studioId: 'X', releaseTick: 30, criticScore: 55, totalGross: 0.3 * BMV }),
+        film({ filmId: 'Y1', studioId: 'Y', releaseTick: 40, criticScore: 90, totalGross: BMV }),
+      ],
+    })
+    // Two independently-constructed, structurally-identical inputs (via
+    // JSON round-trip to guarantee no shared object references).
+    const inputA = JSON.parse(JSON.stringify(buildInput()))
+    const inputB = JSON.parse(JSON.stringify(buildInput()))
+    const snapshotA = computePowerRanking(inputA)
+    const snapshotB = computePowerRanking(inputB)
+    expect(canonicalJSON(snapshotA)).toBe(canonicalJSON(snapshotB))
+  })
+})
