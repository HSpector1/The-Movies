+// ═══════════════════════════════════════════════════════════════════════
+// I. eligibility
+// ═══════════════════════════════════════════════════════════════════════
+describe('p15a2 power ranking: eligibility', () => {
+  it('compute-power-ranking-eligibility-available-false-when-origin-week-exceeds-threshold', async () => {
+    const mod = await loadPowerRanking()
+    const computePowerRanking = requireFn<(input: InputFixture) => any>(mod, 'computePowerRanking')
+    // available=false when originWeek > week-52. At week=52, threshold=0;
+    // originWeek=1 > 0, so available=false and every row is unranked.
+    const input: InputFixture = {
+      week: 52,
+      originWeek: 1,
+      baseMarketValue: BMV,
+      studios: [studio({ studioId: 'Z' }), studio({ studioId: 'A' })],
+      films: [],
+    }
+    const snapshot = computePowerRanking(input)
+    expect(snapshot.available).toBe(false)
+    for (const row of snapshot.rows) {
+      expect(row.ranked).toBe(false)
+      expect(row.rank).toBeNull()
+    }
+    // studioId ascending when every row is unranked.
+    expect(snapshot.rows.map((r: any) => r.studioId)).toEqual(['A', 'Z'])
+  })
+
+  it('compute-power-ranking-eligibility-available-true-at-exact-threshold', async () => {
+    const mod = await loadPowerRanking()
+    const computePowerRanking = requireFn<(input: InputFixture) => any>(mod, 'computePowerRanking')
+    // originWeek === week-52 exactly (0 === 52-52) -> available=true.
+    const input: InputFixture = { week: 52, originWeek: 0, baseMarketValue: BMV, studios: [studio({ studioId: 'A' })], films: [] }
+    const snapshot = computePowerRanking(input)
+    expect(snapshot.available).toBe(true)
+    expect(rowFor(snapshot.rows, 'A').ranked).toBe(true)
+  })
+
+  it('compute-power-ranking-eligibility-entrant-unranked-lanes-shown-excluded-from-comparison', async () => {
+    const mod = await loadPowerRanking()
+    const computePowerRanking = requireFn<(input: InputFixture) => any>(mod, 'computePowerRanking')
+    // W=104, window=[52,104), threshold = W-52 = 52. EARLY and MID entered at
+    // week 0 (eligible). LATE, ABLE and ZOOM entered after week 52
+    // (ineligible/unranked).
+    // LATE is given a very strong film so its points would eclipse EARLY/MID
+    // if it were (wrongly) included in the ranked comparison -- pinning that
+    // "ranked studios with strictly more points" excludes unranked rows.
+    // 1351-E/1351-F (F2): EARLY's and MID's releases must sit INSIDE the
+    // window (releaseTick=60, matching LATE-FILM's own tick) -- releaseTick=10
+    // silently fell outside [52,104), the window-filtering leaf's own rule
+    // (see compute-power-ranking-window-edge-release-tick-w52-counts-w53-excluded),
+    // which zeroed both studios' points and wrongly tied them at rank 1.
+    //   EARLY: 2 releases, no films -> releasesTenths=50, pointsTenths=50
+    //   MID:   1 release,  no films -> releasesTenths=25, pointsTenths=25
+    //   LATE:  critic=100, gross=BMV (reach=1) -> tenths=0.5*100+50*1=100,
+    //          plus that same film also counts as 1 release (25) ->
+    //          pointsTenths=125 (highest of all, but must not count).
+    const releases = (id: string, n: number) =>
+      Array.from({ length: n }, (_, i) => film({ filmId: `${id}-${i}`, studioId: id, releaseTick: 60, runEndedByWeek: false }))
+    const input: InputFixture = {
+      week: 104,
+      originWeek: 0,
+      studios: [
+        studio({ studioId: 'EARLY', enteredWeek: 0 }),
+        studio({ studioId: 'MID', enteredWeek: 0 }),
+        studio({ studioId: 'LATE', enteredWeek: 60 }),
+        studio({ studioId: 'ABLE', enteredWeek: 80 }),
+        studio({ studioId: 'ZOOM', enteredWeek: 70 }),
+      ],
+      baseMarketValue: BMV,
+      films: [
+        ...releases('EARLY', 2),
+        ...releases('MID', 1),
+        film({ filmId: 'LATE-FILM', studioId: 'LATE', releaseTick: 60, criticScore: 100, totalGross: BMV }),
+      ],
+    }
+    const snapshot = computePowerRanking(input)
+    const early = rowFor(snapshot.rows, 'EARLY')
+    const mid = rowFor(snapshot.rows, 'MID')
+    const late = rowFor(snapshot.rows, 'LATE')
+    const able = rowFor(snapshot.rows, 'ABLE')
+    const zoom = rowFor(snapshot.rows, 'ZOOM')
+    expect(early.ranked).toBe(true)
+    expect(early.rank).toBe(1)
+    expect(mid.ranked).toBe(true)
+    expect(mid.rank).toBe(2)
+    expect(late.ranked).toBe(false)
+    expect(late.rank).toBeNull()
+    // lanes are still shown for the unranked entrant.
+    expect(late.pointsTenths).toBe(125)
+    expect(late.countedFilmIds).toEqual(['LATE-FILM'])
+    expect(able.ranked).toBe(false)
+    expect(able.rank).toBeNull()
+    expect(zoom.ranked).toBe(false)
+    expect(zoom.rank).toBeNull()
+    // presentation: ranked block (rank asc) then unranked block (studioId asc).
+    expect(snapshot.rows.map((r: any) => r.studioId)).toEqual(['EARLY', 'MID', 'ABLE', 'LATE', 'ZOOM'])
+  })
