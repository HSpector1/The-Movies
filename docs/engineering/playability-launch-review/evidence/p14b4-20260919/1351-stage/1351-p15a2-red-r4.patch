+    // Three films, reach=1 for all (gross=BMV), so raw tenths = 0.5*critic+50.
+    // Chosen so each film's raw (pre-rounding) tenths sits near the TOP of its
+    // own rounding bucket -- individually each still rounds to the parent's
+    // own worked example (55, 56, 58) -- but the raw values themselves are
+    // high enough within their buckets that averaging them BEFORE rounding
+    // (the rejected Method B) crosses a different rounding boundary than
+    // averaging the already-rounded integers (the adopted Method A).
+    //   critic=10.98 -> raw tenths = 0.5*10.98+50 = 55.49 -> rounds to 55
+    //   critic=12.98 -> raw tenths = 0.5*12.98+50 = 56.49 -> rounds to 56
+    //   critic=16.98 -> raw tenths = 0.5*16.98+50 = 58.49 -> rounds to 58
+    // Method A (adopted): mean(55, 56, 58) = 169/3 = 56.333... -> round half
+    //   up = 56.  (Exactly the parent's own worked example: "55, 56, 58 ->
+    //   mean 56.333... -> 56".)
+    // Method B (rejected): mean(55.49, 56.49, 58.49) = 170.47/3 = 56.8233...
+    //   -> round half up = 57.
+    // 56 !== 57: a genuine divergence, so this leaf actually discriminates
+    // between the two orders, not merely restates the charter prose.
+    const films = [
+      film({ filmId: 'FR1', studioId: 'FRAC', releaseTick: 10, criticScore: 10.98, totalGross: BMV }),
+      film({ filmId: 'FR2', studioId: 'FRAC', releaseTick: 10, criticScore: 12.98, totalGross: BMV }),
+      film({ filmId: 'FR3', studioId: 'FRAC', releaseTick: 10, criticScore: 16.98, totalGross: BMV }),
