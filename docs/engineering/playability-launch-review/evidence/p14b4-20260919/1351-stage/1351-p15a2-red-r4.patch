+// ── P15A.2 Wave 1 — the pure Power Ranking law, RED tests (record 1351-C) ──
+//
+// Authority: 1350-A-p15a2-power-ranking-charter.md §3 (the formula "power-ranking/v1")
+// and §5 (test intents 2-13, 16); 1350-B-power-ranking-charter-review.md (ACCEPT,
+// non-blocking notes on band boundaries and the pre-1920 exclusion); 1350-F
+// (parent adoption: the RED additions for band boundaries incl. zero fixed cost,
+// the authored-pre-1920 Releases exclusion, and the founding zero-fixed-cost pin).
+//
+// SCOPE (brief-1351-p15a2-red): Wave 1 only, the pure law as a function of
+// explicit `RankingInput` facts. No GameState, no save root, no Bridge, no tick
+// hook. `isPowerRankingWeek`/entrant-tick behaviour are exercised only as pure
+// functions of the week numbers passed in, never against a real tick.
+//
+// RED-BY-DESIGN: `src/core/powerRanking.ts` does not exist yet. Every leaf below
+// is expected to fail. Dynamic per-test import (`loadPowerRanking()`), not a
+// static top-level import, so each leaf gets its own attributed failure instead
+// of one whole-file collection error (1346-C precedent, directly verified against
+// this tree during method setup). The one exception is the TUNING leaf, which
+// imports the real, already-existing `src/core/tuning.ts` and gets a genuine
+// value-mismatch RED reason instead of a load failure.
+//
+// EXPECTED VALUES: computed independently in this file from the formula text in
+// 1350-A §3, never imported from production (none exists yet). Every non-trivial
+// number is derived in a comment at its call site.
+
+import { describe, expect, it } from 'vitest'
+import { TUNING } from '../src/core/tuning.js'
+
+// ── module loading (per-leaf attributed failure; see header) ──────────────
+async function loadPowerRanking(): Promise<Record<string, unknown>> {
+  return (await import('../src/core/powerRanking.js')) as unknown as Record<string, unknown>
+}
+
+function requireFn<T extends (...a: any[]) => any>(mod: Record<string, unknown>, name: string): T {
+  const fn = mod[name]
+  if (typeof fn !== 'function') {
+    throw new Error(
+      `RED: src/core/powerRanking.ts does not export a function named '${name}' (got ${typeof fn}). ` +
+        'This guard exists so a partially-implemented module fails loudly per-leaf instead of a vacuous pass.',
+    )
+  }
+  return fn as T
+}
+
+function requireValue(mod: Record<string, unknown>, name: string): unknown {
+  if (!(name in mod)) {
+    throw new Error(`RED: src/core/powerRanking.ts does not export a binding named '${name}'.`)
+  }
+  return mod[name]
+}
+
+function canonicalize(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonicalize)
+  if (value && typeof value === 'object') {
+    const out: Record<string, unknown> = {}
+    for (const k of Object.keys(value as object).sort()) out[k] = canonicalize((value as Record<string, unknown>)[k])
+    return out
+  }
+  return value
+}
+
+function canonicalJSON(value: unknown): string {
+  return JSON.stringify(canonicalize(value))
+}
+
+// ── formula constants, per 1350-A §3, NOT imported from production ────────
+const CRITIC_SHARE = 0.5
+const REACH_SCALE = 0.9
+const FILM_CAP = 4
+const RELEASE_CAP = 4
+
+function roundHalfUp(x: number): number {
+  // All values in this law are nonnegative (criticScore>=0, reach in [0,1]),
+  // so floor(x+0.5) is exact half-up rounding for every case exercised here.
+  return Math.floor(x + 0.5)
+}
+
+function reachOf(totalGross: number, baseMarketValue: number): number {
+  return Math.min(1, totalGross / Math.max(baseMarketValue, 1) / REACH_SCALE)
+}
+
+// filmScore in TENTHS directly (0..100 integer scale), evaluated with a
+// SINGLE division (via reachOf), never by first computing a 0.0-10.0-scale
+// "raw" value and multiplying by 10 afterward. 1351-E/1351-F (F1): the
+// two-multiplication form `10 * (CRITIC_SHARE*(critic/100) + ...) * 10`
+// divides criticScore by 100 and then re-multiplies by 100 in two separate
+// float operations; for critic=61 this yields 80.49999999999999 instead of
+// the exact 80.5, and floor(x+0.5) then wrongly gives 80, not 81. The tenths
+// formula collapses algebraically to CRITIC_SHARE*critic + (1-CRITIC_SHARE)*
+// 100*reach (no division of criticScore at all), matching production's
+// design note 3 ("one division of exact products keeps every such tie
+// exact"). Verified this is the ONLY affected value anywhere this file
+// relies on: see 1351-C4-p15a2-red-writer-findings.md.
+function filmScoreTenths(criticScore: number, totalGross: number, baseMarketValue: number): number {
+  const reach = reachOf(totalGross, baseMarketValue)
+  return roundHalfUp(CRITIC_SHARE * criticScore + (1 - CRITIC_SHARE) * 100 * reach)
+}
+
+// Releases lane (0.0-10.0 scale) = 10 * min(n, RELEASE_CAP) / RELEASE_CAP,
+// stored as integer tenths, rounded half up once.
+function releasesTenthsOf(n: number): number {
+  const raw = (10 * Math.min(n, RELEASE_CAP)) / RELEASE_CAP
+  return roundHalfUp(raw * 10)
+}
+
+// ── local fixture shapes, mirroring the brief's pinned API field-for-field ─
+type FilmFixture = {
+  filmId: string
+  studioId: string
+  releaseTick: number
+  runEndedByWeek: boolean
+  criticScore: number
+  totalGross: number
+  authoredPreCampaign: boolean
+}
+type StudioFixture = { studioId: string; enteredWeek: number; cash: number; weeklyFixedCost: number }
+type InputFixture = {
+  week: number
+  originWeek: number
+  baseMarketValue: number
+  studios: StudioFixture[]
+  films: FilmFixture[]
+}
+
+function film(overrides: Partial<FilmFixture> & { filmId: string; studioId: string }): FilmFixture {
+  return {
+    releaseTick: 0,
+    runEndedByWeek: true,
+    criticScore: 50,
+    totalGross: 0,
+    authoredPreCampaign: false,
+    ...overrides,
+  }
+}
+
+function studio(overrides: Partial<StudioFixture> & { studioId: string }): StudioFixture {
+  return { enteredWeek: 0, cash: 100_000, weeklyFixedCost: 1_000, ...overrides }
+}
+
+const BMV = 1_000_000
+
+const ROW_KEYS = [
+  'band',
+  'countedFilmIds',
+  'distressStage',
+  'filmsTenths',
+  'honors',
+  'pointsTenths',
+  'rank',
+  'ranked',
+  'releases',
+  'releasesTenths',
+  'studioId',
+].sort()
+
+const SNAPSHOT_KEYS = ['available', 'definitionVersion', 'rows', 'week', 'windowStartWeek'].sort()
+
+function rowFor(rows: any[], studioId: string): any {
+  const row = rows.find((r) => r.studioId === studioId)
+  if (!row) throw new Error(`No row for studioId ${studioId}`)
+  return row
+}
+
+// ═══════════════════════════════════════════════════════════════════════
+// A. module surface and TUNING
+// ═══════════════════════════════════════════════════════════════════════
+describe('p15a2 power ranking: module surface', () => {
+  it('power-ranking-definition-version-export', async () => {
+    const mod = await loadPowerRanking()
+    expect(requireValue(mod, 'POWER_RANKING_DEFINITION')).toBe('power-ranking/v1')
+  })
+
+  it('is-power-ranking-week-boundaries', async () => {
+    const mod = await loadPowerRanking()
+    const isPowerRankingWeek = requireFn<(week: number) => boolean>(mod, 'isPowerRankingWeek')
+    // week % 13 === 0, per PARENT API DECISIONS and 1350-A §2 fact 4.
+    expect(isPowerRankingWeek(0)).toBe(true)
+    expect(isPowerRankingWeek(13)).toBe(true)
+    expect(isPowerRankingWeek(26)).toBe(true)
+    expect(isPowerRankingWeek(52)).toBe(true)
+    expect(isPowerRankingWeek(6227)).toBe(true) // 13*479
+    expect(isPowerRankingWeek(1)).toBe(false)
+    expect(isPowerRankingWeek(12)).toBe(false)
+    expect(isPowerRankingWeek(14)).toBe(false)
+    expect(isPowerRankingWeek(25)).toBe(false)
+  })
+})
+
+describe('p15a2 power ranking: TUNING (real, already-existing module)', () => {
+  it('tuning-power-ranking-bounded-terms', () => {
+    const t = TUNING as unknown as Record<string, unknown>
+    // Bounded-term test: values from 1350-A §3's constants table, and each
+    // key's stated provisional range.
+    expect(t.POWER_RANKING_WINDOW_WEEKS).toBe(52)
+    expect(t.POWER_RANKING_FILM_CAP).toBe(4)
+    expect(t.POWER_RANKING_RELEASE_CAP).toBe(4)
+    expect(t.POWER_RANKING_CRITIC_SHARE).toBe(0.5)
+    expect(t.POWER_RANKING_REACH_SCALE).toBe(0.9)
+    expect(t.POWER_RANKING_BAND_STABLE_WEEKS).toBe(13)
+    expect(t.POWER_RANKING_BAND_THRIVING_WEEKS).toBe(26)
+    // Ranges: caps are positive integers; shares/scales are in (0,1]; the
+    // thriving threshold sits strictly above the stable threshold.
+    expect(t.POWER_RANKING_WINDOW_WEEKS as number).toBeGreaterThan(0)
+    expect(t.POWER_RANKING_FILM_CAP as number).toBeGreaterThan(0)
+    expect(t.POWER_RANKING_RELEASE_CAP as number).toBeGreaterThan(0)
+    expect(t.POWER_RANKING_CRITIC_SHARE as number).toBeGreaterThan(0)
+    expect(t.POWER_RANKING_CRITIC_SHARE as number).toBeLessThanOrEqual(1)
+    expect(t.POWER_RANKING_REACH_SCALE as number).toBeGreaterThan(0)
+    expect(t.POWER_RANKING_BAND_THRIVING_WEEKS as number).toBeGreaterThan(t.POWER_RANKING_BAND_STABLE_WEEKS as number)
+  })
+})
+
+// ═══════════════════════════════════════════════════════════════════════
+// B. financialStrengthBand
+// ═══════════════════════════════════════════════════════════════════════
+describe('p15a2 power ranking: financialStrengthBand boundaries (1350-A §3 / 1350-F)', () => {
+  it('financial-strength-band-in-the-red-boundary', async () => {
+    const mod = await loadPowerRanking()
+    const financialStrengthBand = requireFn<(cash: number, weeklyFixedCost: number) => string>(mod, 'financialStrengthBand')
+    // "In the red: cash <= 0", tested at and below zero, including the
+    // fixed-cost-zero edge (interpretation: cash<=0 is checked before the
+    // fixed-cost-zero rule, since the four labels are mutually exclusive and
+    // the charter lists "In the red" first with no "cash>0" qualifier of its
+    // own — the other three labels each require cash>0 by elimination).
+    expect(financialStrengthBand(0, 1_000)).toBe('inTheRed')
+    expect(financialStrengthBand(-1, 1_000)).toBe('inTheRed')
+    expect(financialStrengthBand(-500_000, 1_000)).toBe('inTheRed')
+    expect(financialStrengthBand(0, 0)).toBe('inTheRed')
+    expect(financialStrengthBand(-1, 0)).toBe('inTheRed')
+  })
+
+  it('financial-strength-band-strained-and-stable-boundaries', async () => {
+    const mod = await loadPowerRanking()
+    const financialStrengthBand = requireFn<(cash: number, weeklyFixedCost: number) => string>(mod, 'financialStrengthBand')
+    // weeklyFixedCost = 100 for clean week arithmetic: weeks = floor(cash/100).
+    expect(financialStrengthBand(100, 100)).toBe('strained') // weeks=1 <13
+    expect(financialStrengthBand(1_200, 100)).toBe('strained') // weeks=12 <13
+    expect(financialStrengthBand(1_300, 100)).toBe('stable') // weeks=13
+    expect(financialStrengthBand(2_500, 100)).toBe('stable') // weeks=25
+    // floor behaviour: 1250/100=12.5 -> floor 12 -> strained, not stable.
+    expect(financialStrengthBand(1_250, 100)).toBe('strained')
+  })
+
+  it('financial-strength-band-thriving-boundary', async () => {
+    const mod = await loadPowerRanking()
+    const financialStrengthBand = requireFn<(cash: number, weeklyFixedCost: number) => string>(mod, 'financialStrengthBand')
+    expect(financialStrengthBand(2_600, 100)).toBe('thriving') // weeks=26
+    expect(financialStrengthBand(10_000, 100)).toBe('thriving') // weeks=100
+  })
+
+  it('financial-strength-band-zero-fixed-cost-founding-edge', async () => {
+    const mod = await loadPowerRanking()
+    const financialStrengthBand = requireFn<(cash: number, weeklyFixedCost: number) => string>(mod, 'financialStrengthBand')
+    // 1350-F: "a fixed cost of 0 [reads] Thriving" and "a test pins what
+    // happens if [the founding edge] does [show]" (cash>0, fixedCost=0).
+    expect(financialStrengthBand(500, 0)).toBe('thriving')
+    expect(financialStrengthBand(1, 0)).toBe('thriving')
+    // cash<=0 still wins over the fixed-cost-zero rule (see the in-the-red leaf).
+  })
+})
+
+// ═══════════════════════════════════════════════════════════════════════
+// C. computePowerRanking — worked examples, rounding
+// ═══════════════════════════════════════════════════════════════════════
+describe('p15a2 power ranking: computePowerRanking worked examples', () => {
+  it('compute-power-ranking-worked-example-critic60-gross045-reach05-score55', async () => {
+    const mod = await loadPowerRanking()
+    const computePowerRanking = requireFn<(input: InputFixture) => any>(mod, 'computePowerRanking')
+    // 1350-A §3 worked example, verbatim: "critic 60, gross 0.45 * baseMarketValue
+    // give reach 0.5 and a film score of 5.5."
+    // reach = min(1, 450000/1000000/0.9) = min(1, 0.5) = 0.5
+    // raw   = 10*(0.5*60/100 + 0.5*0.5) = 10*(0.30+0.25) = 10*0.55 = 5.5
+    // tenths = round_half_up(5.5*10) = 55
+    const input: InputFixture = {
+      week: 52,
+      originWeek: 0,
+      baseMarketValue: BMV,
+      studios: [studio({ studioId: 'M' })],
+      films: [film({ filmId: 'WORKED', studioId: 'M', releaseTick: 10, runEndedByWeek: true, criticScore: 60, totalGross: 0.45 * BMV })],
+    }
+    const snapshot = computePowerRanking(input)
+    const row = rowFor(snapshot.rows, 'M')
+    expect(row.filmsTenths).toBe(55)
+    expect(row.countedFilmIds).toEqual(['WORKED'])
+    expect(row.releases).toBe(1)
+    expect(row.releasesTenths).toBe(releasesTenthsOf(1)) // 25
+    expect(row.pointsTenths).toBe(55 + 25)
+  })
+
+  it('compute-power-ranking-film-score-rounds-half-up-at-exact-half-tenth', async () => {
+    const mod = await loadPowerRanking()
+    const computePowerRanking = requireFn<(input: InputFixture) => any>(mod, 'computePowerRanking')
+    // critic=61, gross=baseMarketValue exactly -> reach=min(1,1/0.9)=min(1,1.111)=1
+    // tenths = CRITIC_SHARE*61 + (1-CRITIC_SHARE)*100*1 = 0.5*61 + 0.5*100 = 30.5+50 = 80.5 exactly
+    // (both 0.5*61 and 0.5*100 are exact in float64; this is why filmScoreTenths
+    // must be evaluated this way -- see the helper's own comment / 1351-C4 F1)
+    // tenths = round_half_up(80.5) = 81 (half rounds up, not to-even/truncated 80)
+    expect(filmScoreTenths(61, BMV, BMV)).toBe(81) // sanity on the test's own helper
+    const input: InputFixture = {
+      week: 52,
+      originWeek: 0,
+      baseMarketValue: BMV,
+      studios: [studio({ studioId: 'R' })],
+      films: [film({ filmId: 'HALF', studioId: 'R', releaseTick: 10, runEndedByWeek: true, criticScore: 61, totalGross: BMV })],
+    }
+    const snapshot = computePowerRanking(input)
+    expect(rowFor(snapshot.rows, 'R').filmsTenths).toBe(81)
+  })
+
+  it('compute-power-ranking-window-start-week-and-definition-version-fields', async () => {
