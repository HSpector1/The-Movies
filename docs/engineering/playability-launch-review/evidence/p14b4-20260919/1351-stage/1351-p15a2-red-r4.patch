+    const individual = films.map((f) => filmScoreTenths(f.criticScore, f.totalGross, BMV))
+    expect(individual).toEqual([55, 56, 58])
+    const methodA = roundHalfUp(individual.reduce((a, b) => a + b, 0) / individual.length)
+    const rawTenths = films.map((f) => {
+      const reach = reachOf(f.totalGross, BMV)
+      return 10 * (10 * (CRITIC_SHARE * (f.criticScore / 100) + (1 - CRITIC_SHARE) * reach))
+    })
+    const methodB = roundHalfUp(rawTenths.reduce((a, b) => a + b, 0) / rawTenths.length)
+    expect(methodA).toBe(56)
+    expect(methodB).toBe(57)
+    expect(methodA).not.toBe(methodB) // the two orders genuinely diverge for this input
+
+    const input: InputFixture = {
+      week: 52,
+      originWeek: 0,
+      baseMarketValue: BMV,
