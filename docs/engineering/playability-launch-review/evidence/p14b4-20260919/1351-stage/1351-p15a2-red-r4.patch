+describe('p15a2 power ranking: Honors/distress notRecorded, explainability', () => {
+  it('compute-power-ranking-honors-and-distress-always-not-recorded-no-numeric-field', async () => {
+    const mod = await loadPowerRanking()
+    const computePowerRanking = requireFn<(input: InputFixture) => any>(mod, 'computePowerRanking')
+    const input: InputFixture = {
+      week: 52,
+      originWeek: 0,
+      baseMarketValue: BMV,
+      studios: [studio({ studioId: 'A' }), studio({ studioId: 'B', enteredWeek: 60 })],
+      films: [film({ filmId: 'A1', studioId: 'A', releaseTick: 10, criticScore: 50, totalGross: 0.2 * BMV })],
+    }
+    const rows = computePowerRanking(input).rows
+    expect(rows.length).toBeGreaterThan(0)
+    for (const row of rows) {
+      expect(row.honors).toBe('notRecorded')
+      expect(row.distressStage).toBe('notRecorded')
+      // exact key set: no numeric honors/distress field exists anywhere on the row.
+      expect(Object.keys(row).sort()).toEqual(ROW_KEYS)
+    }
+  })
+
+  it('compute-power-ranking-explainable-lanes-recompute-from-counted-films', async () => {
+    const mod = await loadPowerRanking()
+    const computePowerRanking = requireFn<(input: InputFixture) => any>(mod, 'computePowerRanking')
+    // Three finished films (critic 60/40/20, reach=1) -> tenths 80/70/60,
+    // mean = 210/3 = 70. A fourth unfinished film and a fifth film owned by a
+    // different studio must both be excluded from the recount.
+    const counted = [
+      film({ filmId: 'E1', studioId: 'X', releaseTick: 10, criticScore: 60, totalGross: BMV }), // 80
+      film({ filmId: 'E2', studioId: 'X', releaseTick: 10, criticScore: 40, totalGross: BMV }), // 70
+      film({ filmId: 'E3', studioId: 'X', releaseTick: 10, criticScore: 20, totalGross: BMV }), // 60
+    ]
+    const unfinished = film({ filmId: 'UNFIN', studioId: 'X', releaseTick: 10, runEndedByWeek: false, criticScore: 90, totalGross: BMV })
+    const otherStudioFilm = film({ filmId: 'OTHER', studioId: 'Y', releaseTick: 10, criticScore: 100, totalGross: BMV })
+    const input: InputFixture = {
+      week: 52,
+      originWeek: 0,
+      baseMarketValue: BMV,
+      studios: [studio({ studioId: 'X' }), studio({ studioId: 'Y' })],
+      films: [...counted, unfinished, otherStudioFilm],
+    }
+    const snapshot = computePowerRanking(input)
+    const row = rowFor(snapshot.rows, 'X')
+    expect(new Set(row.countedFilmIds)).toEqual(new Set(['E1', 'E2', 'E3']))
+    // recompute the lane exactly from the counted films' own public facts,
+    // looked up by filmId in the input -- the definition of explainability.
+    const byId = new Map(input.films.map((f) => [f.filmId, f]))
+    const recomputed = row.countedFilmIds
+      .map((id: string) => byId.get(id)!)
+      .map((f: FilmFixture) => filmScoreTenths(f.criticScore, f.totalGross, input.baseMarketValue))
+    const mean = recomputed.reduce((a: number, b: number) => a + b, 0) / recomputed.length
+    expect(row.filmsTenths).toBe(roundHalfUp(mean))
+    expect(row.filmsTenths).toBe(70)
+  })
+})
