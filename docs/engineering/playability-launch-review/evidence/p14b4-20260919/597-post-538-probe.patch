+describe('538-M scenario 2: achievable probe on world().opened over the 40-week window (B = 2)', () => {
+  const horizons = (w: World) => [
+    { label: 'now+20', horizon: w.opened.market.tick + 20 }, { label: 'now+40', horizon: w.opened.market.tick + 40 },
+    { label: 'due = start+40', horizon: w.start + 40 } ]
+  const variants = [{ label: 'retained (no commitRelease)', commit: false }, { label: 'committed at releaseReady', commit: true }]
+  it.each(variants.flatMap((v) => [0, 1, 2].map((h) => ({ ...v, h }))))('single plan, $label, horizon index $h', ({ label, commit, h }) => {
+    const w = world(), source = w.opened, now = source.market.tick, own = player(source), ref = readyReference(w, 0)
+    const { label: horizonLabel, horizon } = horizons(w)[h]!
+    const replay = readyReplay(w, [{ traceKey: '538-ready-probe-A', facts: ref, commit }], horizon)
+    // Kernel effective horizon is max(horizon, window due); a window past the producer
+    // horizon trips 'unknown release occupancy must cover the effective horizon', so the
+    // target window is clipped to the producer horizon and the clip is recorded.
+    const window = { startWeek: w.start, dueWeekExclusive: Math.min(w.start + 40, horizon) }
+    const kernel = 'result' in replay && window.startWeek < window.dueWeekExclusive ? runKernel({ now, horizon, issuerId: own, priorClaims: [],
+      traces: traces(replay.result), fixedHolds: replay.result.fixedHolds, preparationWork: replay.result.preparationWork, coverage: SUPPLIED,
+      target: { promiseId: null, personId: w.actors.lead, mask: MASKS.lead, window, state: 'unbound', count: 1, actualQualifiedCount: 0 } }) : null
+    log({ scenario: 2, name: `single plan, ${label}, horizon ${horizonLabel}`, route: 'replayReadyProductionPlans -> searchPromiseCapacityTraces',
+      fixture: FIXTURE_OPENED, now, start: w.start, horizonEndWeek: horizon, horizonWeeks: horizon - now, planCount: 1,
+      reference: referenceSummary(ref), commands: replay.commands,
+      target: { slot: 'lead', mask: MASKS.lead, window, windowClipped: window.dueWeekExclusive !== w.start + 40, bufferDemand: 2 },
