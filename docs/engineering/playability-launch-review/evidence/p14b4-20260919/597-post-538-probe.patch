+    const replay = watched.value
+    log({ scenario: 0, name: 'Ready admission + one frame, no commands', route: 'replayReadyProductionPlans', fixture: FIXTURE_OPENED,
+      now, horizonEndWeek: now + 1, horizonWeeks: 1, planCount: 1, commands: replay.commands, ownersReached: watched.reached,
