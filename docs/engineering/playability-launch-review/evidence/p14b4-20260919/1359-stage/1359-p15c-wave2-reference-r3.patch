+// proves the frozen V43 chain on the stripped state, then the Legacy (1359-A §5.1 "after the
+// frozen chain"), then the allocator.
+function stripV44Roots(raw: Record<string, unknown>): Record<string, unknown> {
+  const { campaignLegacy: _legacy, p15Sequence: _sequence, ...older } = raw;
+  return older;
+}
+
+/** The allocator's own law (1355-F2 item 1): version 1, and `next` one above every stored
+ * P15 sequence. In this reference the official Legacy is the only P15 row. */
+function validateP15Sequence(raw: Record<string, unknown>): void {
+  const sequence = raw.p15Sequence;
+  if (!isRecord(sequence)) throw new Error('validateSaveV44: p15Sequence must be an object');
+  v12ExactKeys(sequence, ['version', 'next'], 'p15Sequence');
+  if (sequence.version !== 1) throw new Error('validateSaveV44: p15Sequence.version must be 1');
+  if (!Number.isSafeInteger(sequence.next) || (sequence.next as number) < 1) {
+    throw new Error('validateSaveV44: p15Sequence.next must be a whole number from 1');
+  }
+  const legacy = raw.campaignLegacy as { official: { p15DomainSequence: number } | null };
+  const largest = legacy.official === null ? 0 : legacy.official.p15DomainSequence;
+  if (sequence.next !== largest + 1) {
+    throw new Error('validateSaveV44: p15Sequence.next must be one above the largest stored p15DomainSequence');
+  }
