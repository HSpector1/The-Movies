+
+/** Lossless only while the Legacy is empty: the root and the allocator drop. A frozen 2040
+ * Legacy refuses by name, before any other work (1359-A §5.2). */
+export function convertV44ToV43(save: SaveFileV44): SaveFileV43 {
+  const root = isRecord(save) && isRecord(save.state) ? (save.state as unknown as Record<string, unknown>).campaignLegacy : undefined;
