+const r = (fame: number) => fame / (fame + 50)
+const SEGMENTS: Segment[] = [
+  { id: 'youngAdult', share: 0.3, taste: { intimacy: 0, tonalWeight: 0, kineticEnergy: 0 } },
+  { id: 'family', share: 0.2, taste: { intimacy: 0, tonalWeight: 0, kineticEnergy: 0 } },
