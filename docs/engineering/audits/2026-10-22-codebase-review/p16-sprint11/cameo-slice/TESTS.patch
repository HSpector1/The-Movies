+describe('P17 Shape A law — the adopted provisional constants', () => {
+  it('pins every cameo term to the contract', () => {
+    expect(TUNING.P17_CAMEO_UNLOCK_WEEK).toBe(UNLOCK_WEEK)
+    expect(TUNING.P17_CAMEO_MAX_GUESTS).toBe(2)
