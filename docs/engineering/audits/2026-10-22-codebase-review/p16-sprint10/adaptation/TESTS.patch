+    if (!remake.ok) throw new Error(remake.reason)
+    expect(remake.branchId).toBe(locked.properties[0]!.branches[0]!.branchId)
+    expect(remake.similarity).toBe(0.7)
+    expect(remake.use).toBe('remake')
