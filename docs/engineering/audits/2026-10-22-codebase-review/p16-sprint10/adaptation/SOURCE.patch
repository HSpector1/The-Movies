+const METER_KEYS = ['bestScore', 'residualScoreSum', 'peakInstallmentId', 'rPeak', 'fatigue', 'fatigueUpdateWeek', 'fatigueLastQuality', 'releaseCount', 'firstFilmExempt'] as const
