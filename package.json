{
  "name": "project-studio-asset-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated asset-intake / conversion / visual-proof lab for Project: Studio (Meridian Pictures). NOT the game, NOT a branch or worktree of any protected repo. Owns no simulation truth. Read-only toward all protected repositories.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4320 --strictPort",
    "hash": "node tools/hash-archives.mjs",
    "inventory": "node tools/inventory.mjs",
    "validate": "node tools/validate-assets.mjs",
    "manifest": "node tools/build-manifest.mjs",
    "optimize": "node tools/optimize-gltf.mjs",
    "curate": "node tools/curate.mjs",
    "pipeline": "npm run hash && npm run inventory && npm run curate && npm run optimize && npm run manifest && npm run validate",
    "shots": "node tools/capture.mjs",
    "blender:build": "node tools/blender-run.mjs blender/build_all.py",
    "blender:characters": "node tools/blender-run.mjs blender/build_all.py -- --only characters",
    "blender:architecture": "node tools/blender-run.mjs blender/build_all.py -- --only architecture",
    "blender:props": "node tools/blender-run.mjs blender/build_all.py -- --only props",
    "blender:library": "node tools/blender-run.mjs blender/make_library.py",
    "blender:hero": "node tools/blender-run.mjs blender/make_hero_scene.py",
    "blender:validate": "node tools/validate-studio.mjs",
    "blender:factory": "npm run blender:build && npm run blender:hero && npm run blender:library && npm run blender:validate",
    "shots:lab05": "node tools/capture-lab05.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.109.2",
    "@react-three/fiber": "^8.16.8",
    "@react-three/postprocessing": "2.19.1",
    "postprocessing": "6.35.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.161.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/extensions": "^4.1.1",
    "@gltf-transform/functions": "^4.1.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.161.0",
    "@vitejs/plugin-react": "^4.3.1",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.33.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
