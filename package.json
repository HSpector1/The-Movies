{
  "name": "project-studio-core",
  "version": "0.1.0",
  "private": true,
  "description": "Project: Studio — pure simulation core (M0A/M1A build contract rev. 4)",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:core": "vitest run --project core",
    "test:ui": "vitest run --project ui",
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "dev": "vite --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts",
    "preview": "vite preview --config ui/vite.config.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
