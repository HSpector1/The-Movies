{
  "name": "project-studio-core",
  "version": "0.1.0",
  "private": true,
  "description": "Project: Studio — pure simulation core (M0A/M1A build contract rev. 4)",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:core": "vitest run --project core",
    "test:ui": "vitest run --project ui",
    "test:bridge": "npm run check:bridge-contract && vitest run tests/bridge*.test.ts",
    "generate:bridge-contract": "vite-node scripts/generate-bridge-contract.ts",
    "check:bridge-contract": "vite-node scripts/generate-bridge-contract.ts --check",
    "typecheck:bridge": "tsc -p tsconfig.bridge.json",
    "bridge": "vite-node bridge/server.ts",
    "studio": "vite-node --script bridge/supervisor/cli.ts",
    "proof:bridge": "vite-node bridge/proof.ts",
    "verify:bridge-inflight-evidence": "vite-node scripts/verify-bridge-inflight-evidence.ts",
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "audit:browser-deps": "npm audit --omit=dev --audit-level=high",
    "audit:repo-hygiene": "node scripts/audit-repository-hygiene.mjs",
    "audit:3d-assets": "node scripts/audit-3d-assets.mjs",
    "dev": "vite --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts",
    "preview": "vite preview --config ui/vite.config.ts",
    "capture:3d-baseline": "playwright test --config tests/three-visual-regression/playwright.config.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-node": "2.1.9",
    "vitest": "^2.1.0"
  }
}
