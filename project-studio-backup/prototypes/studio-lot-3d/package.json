{
  "name": "studio-3d-visual-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Isolated, throwaway real-time 3D vertical slice for Meridian Pictures. NOT the app; renderer-neutral view over a fixture StudioLotSnapshot. Owns no simulation truth.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4319 --strictPort",
    "verify-protected": "node tools/verify-protected.mjs",
    "shots": "node tools/capture.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.161.0",
    "@react-three/fiber": "^8.16.8",
    "@react-three/drei": "^9.109.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.161.0",
    "@vitejs/plugin-react": "^4.3.1",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
